  "frases": [
    {
      "clave": "zh.n3.r01.g1",
      "bloque": "b01",
      "frase": "天气 越来越 冷。",
      "conservar": "冷",
      "rom": "Tiānqì yuèláiyuè ___."
    },
    {
      "clave": "zh.n3.r01.g2",
      "bloque": "b01",
      "frase": "我 越来越 不 想 加班"
    },
    {
      "clave": "zh.n3.r01.e2",
      "bloque": "b01",
      "frase": "我 的 中文 越来越 流利 了。",
      "conservar": "越来越",
      "rom": "Wǒ de Zhōngwén ___ liúlì le."
    },
    {
      "clave": "zh.n3.r01.e3",
      "bloque": "b01",
      "frase": "我 的 工作 越来越 忙 了。"
    },
    {
      "clave": "zh.n3.r02.g1",
      "bloque": "b01",
      "frase": "我 终于 找 到 工作 了！",
      "conservar": "终于",
      "rom": "Wǒ ___ zhǎo dào gōngzuò le!"
    },
    {
      "clave": "zh.n3.r02.g2",
      "bloque": "b01",
      "frase": "我 刚 面试 完 就 收到 了 通知"
    },
    {
      "clave": "zh.n3.r02.e2",
      "bloque": "b01",
      "frase": "经理 刚才 来 过。",
      "conservar": "刚才",
      "rom": "Jīnglǐ ___ lái guo."
    },
    {
      "clave": "zh.n3.r02.e3",
      "bloque": "b01",
      "frase": "我 终于 签 合同 了。"
    },
    {
      "clave": "zh.n3.r02.e4",
      "bloque": "b01",
      "frase": "我 的 工作 越来越 忙 了。"
    },
    {
      "clave": "zh.n3.r02.e5",
      "bloque": "b01",
      "frase": "真 的 吗？恭喜 你！"
    },
    {
      "clave": "zh.n3.r03.g1",
      "bloque": "b01",
      "frase": "这里 变成 了 一 个 公园。",
      "conservar": "变成",
      "rom": "Zhèlǐ ___ le yí gè gōngyuán."
    },
    {
      "clave": "zh.n3.r03.g2",
      "bloque": "b01",
      "frase": "他 当 上 了 经理"
    },
    {
      "clave": "zh.n3.r03.e2",
      "bloque": "b01",
      "frase": "她 成为 了 医生。",
      "conservar": "成为",
      "rom": "Tā ___ le yīshēng."
    },
    {
      "clave": "zh.n3.r03.e3",
      "bloque": "b01",
      "frase": "我 终于 拿 到 驾照 了。"
    },
    {
      "clave": "zh.n3.r04.g1",
      "bloque": "b01",
      "frase": "祝 你 工作 顺利！",
      "conservar": "祝",
      "rom": "___ nǐ gōngzuò shùnlì!"
    },
    {
      "clave": "zh.n3.r04.e2",
      "bloque": "b01",
      "frase": "祝 你 工作 顺利"
    },
    {
      "clave": "zh.n3.r04.e3",
      "bloque": "b01",
      "frase": "你 先 熟悉 新 工作，再 认识 新 同事。",
      "conservar": "再",
      "rom": "Nǐ xiān shúxī xīn gōngzuò, ___ rènshi xīn tóngshì."
    },
    {
      "clave": "zh.n3.r04.e4",
      "bloque": "b01",
      "frase": "我 终于 拿 到 驾照 了。"
    },
    {
      "clave": "zh.n3.r04.e5",
      "bloque": "b01",
      "frase": "我 终于 签 合同 了。"
    },
    {
      "clave": "zh.n3.r05.g1",
      "bloque": "b01",
      "frase": "好久 不 见，你 变 了 很 多！",
      "conservar": "好久",
      "rom": "___ bú jiàn, nǐ biàn le hěn duō!"
