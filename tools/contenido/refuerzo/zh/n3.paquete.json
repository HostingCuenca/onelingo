    {
      "clave": "zh.n3.r05.e2",
      "bloque": "b01",
      "frase": "毕业 以后 我们 很 少 联系。",
      "conservar": "联系",
      "rom": "Bìyè yǐhòu wǒmen hén shǎo ___."
    },
    {
      "clave": "zh.n3.r05.e3",
      "bloque": "b01",
      "frase": "真 的 吗？恭喜 你！"
    },
