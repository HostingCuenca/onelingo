  {
   "id": "u07",
   "titulo": {
    "es": "Nasales I: on y an",
    "en": "Nasal vowels I: on and an"
   },
   "objetivo": {
    "es": "Leer on/om (ballon) y an/en/am/em (dent): el aire sale por la nariz y la n no suena.",
    "en": "Read on/om (ballon) and an/en/am/em (dent): air flows through your nose and the n stays silent."
   },
   "lecciones": [
    {
     "id": "u07.l01",
     "titulo": {
      "es": "on de ballon",
      "en": "on as in ballon"
     },
     "pasos": [
      {
       "tipo": "lumo",
       "pose": "sorprendido",
       "texto": {
        "es": "Ahora, vocales que suenan por la nariz: las nasales. La n escrita no se pronuncia, solo avisa.",
        "en": "Now, vowels that sound through your nose: nasal vowels. The written n isn't pronounced, it's just a signal."
       }
      },
      {
       "tipo": "mira",
       "m": "b(a:a)ll(on:on)",
       "sonido": "on",
       "texto": {
        "es": "On índigo: di una o con labios redondos y deja salir el aire por la nariz. No cierres con n.",
        "en": "Indigo on: say o with rounded lips and let air out through your nose. Don't close with an n."
       }
      },
      {
       "tipo": "escucha",
       "palabras": [
