     "pasos": [
      {
       "tipo": "lumo",
       "pose": "pensando",
       "texto": {
        "es": "¿Recuerdas la v que vibra? Hoy la comparamos con la b y conocemos la c con colita: ç.",
        "en": "Remember the buzzing v? Today we compare it with b and meet c with a little tail: ç."
       }
