    {
     "id": "u06.l04",
     "titulo": {
      "es": "gu, qu, h, ph",
      "en": "gu, qu, h, ph"
     },
     "pasos": [
      {
       "tipo": "mira",
       "m": "(gu:=)(i:i)t(a:a)r(e:_)",
       "texto": {
        "es": "Antes de e o i, gu suena g, como en guitarra: la u no se oye.",
        "en": "Before e or i, gu is a hard g, as in guitar: the u is silent."
       }
      },
      {
       "tipo": "mira",
       "m": "(qu:=)(i:i)",
       "texto": {
        "es": "Qu suena k, como en «queso»: qui (quién), quatre (cuatro).",
        "en": "Qu sounds like k, and the u is silent: qui (who), quatre (four)."
       }
      },
      {
       "tipo": "escucha",
       "palabras": [
        {
         "m": "(gu:=)(i:i)t(a:a)r(e:_)",
