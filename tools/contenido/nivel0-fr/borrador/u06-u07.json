      {
       "tipo": "mira",
       "m": "(i:i)c(i:i)",
       "texto": {
        "es": "Antes de e o i, la c suena s: ici (aquí), merci (gracias). Antes de a, o, u suena k.",
        "en": "Before e or i, c sounds like s: ici (here), merci (thank you). Before a, o, u it's a k."
       }
      },
      {
       "tipo": "mira",
       "m": "ç(a:a)",
       "texto": {
        "es": "Para que la c suene s antes de a, o, u, lleva una colita: ç. Ça significa eso.",
        "en": "To make c sound like s before a, o, u, French adds a tail: ç. Ça means that."
       }
      },
