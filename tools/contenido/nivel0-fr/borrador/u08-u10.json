      {"tipo": "mira", "m": "l’(a:a)m(i:i)", "sonido": "a", "texto": {"es": "L’ami (el amigo) se dice como una sola palabra.", "en": "L’ami (the friend) is said as one word."}},
      {"tipo": "escucha", "palabras": [{"m": "l’(a:a)m(i:i)", "t": {"es": "el amigo", "en": "the friend"}}, {"m": "l’(eau:o)", "e": "1f4a7", "t": {"es": "el agua", "en": "the water"}}, {"m": "l’(é:e)c(o:oo)l(e:_)", "e": "1f3eb", "t": {"es": "la escuela", "en": "the school"}}, {"m": "l’(h:_)(o:oo)mm(e:_)", "t": {"es": "el hombre", "en": "the man"}}]},
      {"tipo": "lumo", "pose": "pensando", "texto": {"es": "La h no suena, así que casi siempre también se pega: l’homme (el hombre).", "en": "The h is silent, so words almost always link through it: l’homme (the man)."}},
      {"tipo": "escucha", "palabras": [{"m": "j’(ai:e)", "t": {"es": "tengo", "en": "I have"}}, {"m": "j’(ai:eh)m(e:_)", "t": {"es": "me gusta, amo", "en": "I like, I love"}}, {"m": "c’(e:eh)(st:_)", "t": {"es": "es, está", "en": "it is"}}, {"m": "d’(a:a)cc(o:oo)r(d:_)", "t": {"es": "de acuerdo", "en": "OK"}}]},
      {"tipo": "escucha_elige", "audio": "l’eau", "pregunta": {"es": "¿Qué oíste?", "en": "What did you hear?"}, "opciones": [{"m": "l’(eau:o)", "e": "1f4a7"}, {"m": "l(e:schwa) l(ai:eh)(t:_)", "e": "1f95b"}], "correcta": 0},
      {"tipo": "elige_significado", "m": "c’(e:eh)(st:_) b(on:on)", "pregunta": {"es": "¿Qué significa?", "en": "What does it mean?"}, "opciones": [{"es": "está rico", "en": "it's good"}, {"es": "tengo hambre", "en": "I'm hungry"}, {"es": "es mío", "en": "it's mine"}], "correcta": 0},
