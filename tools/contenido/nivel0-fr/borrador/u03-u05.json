      {"tipo": "toca_sonido", "sonido": "oeu", "pregunta": "¿Cuál tiene la eu abierta de fleur?", "opciones": [{"m": "f(eu:eu)", "e": "1f525"}, {"m": "c(œu:oeu)r", "e": "2764"}, {"m": "bl(eu:eu)", "e": "1f535"}], "correcta": 1},
      {"tipo": "toca_sonido", "sonido": "eu", "pregunta": "¿Cuál tiene la eu de feu?", "opciones": [{"m": "s(œu:oeu)r"}, {"m": "d(eu:eu)(x:_)"}, {"m": "(h:_)(eu:oeu)r(e:_)", "e": "1f550"}], "correcta": 1},
      {"tipo": "construye", "m": "p(eu:oeu)r", "fichas": ["p", "e", "u", "r", "o"]},
      {"tipo": "cambia", "de": "j(eu:eu)", "a": "f(eu:eu)", "opciones": ["j", "f", "b"]},
      {"tipo": "repite", "m": "fl(eu:oeu)r", "t": "flor"}
     ]
    },
    {
     "id": "u05.l03",
     "titulo": "o de gâteau, o de pomme",
     "pasos": [
