      },
      {
       "tipo": "lee",
       "m": "(E:e)mm(a:a) (v:b)(i:i)(v:b)(e:e) (c:k)(o:o)n l(a:a) f(a:a)m(i:i)l(i:i)(a:a) (A:a)n(d:d)(r:r)(a:a)(d:d)(e:e).",
       "t": {
