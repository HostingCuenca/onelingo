{
  "modulo": "en.f0",
  "unidades": [
    {
      "id": "en.f0.primer-contacto",
      "orden": 0,
      "titulo": {"es": "Primer contacto"},
      "objetivo": {"es": "Saludar, despedirte, agradecer y pedir perdón en inglés."},
      "cefr": "Pre-A1",
      "nivelInterno": 0,
      "concepto": "saludos",
      "prerequisitos": [],
      "habilidades": ["escucha", "vocabulario", "pronunciacion"],
      "gramatica": ["en-g-sound-text"],
      "vocabulario": [
        {"id": "v-hello", "texto": "hello", "traduccion": {"es": "hola"}},
        {"id": "v-hi", "texto": "hi", "traduccion": {"es": "hola (informal)"}},
        {"id": "v-good-morning", "texto": "good morning", "traduccion": {"es": "buenos días"}},
        {"id": "v-goodbye", "texto": "goodbye", "traduccion": {"es": "adiós"}},
        {"id": "v-bye", "texto": "bye", "traduccion": {"es": "chao"}},
        {"id": "v-please", "texto": "please", "traduccion": {"es": "por favor"}},
        {"id": "v-thank-you", "texto": "thank you", "traduccion": {"es": "gracias"}},
        {"id": "v-yes", "texto": "yes", "traduccion": {"es": "sí"}},
        {"id": "v-no", "texto": "no", "traduccion": {"es": "no"}},
        {"id": "v-sorry", "texto": "sorry", "traduccion": {"es": "perdón / lo siento"}},
        {"id": "v-excuse-me", "texto": "excuse me", "traduccion": {"es": "disculpe (para llamar la atención)"}}
      ],
      "erroresFrecuentes": [
        {"incorrecto": "Good night!", "correcto": "Hello!", "explicacion": {"es": "Al llegar no se dice «Good night»: solo se usa para despedirse por la noche. Para saludar di «Hello!»."}},
        {"incorrecto": "Sorry!", "correcto": "Excuse me!", "explicacion": {"es": "Para llamar al camarero o pedir paso se dice «excuse me». «Sorry» es para disculparte por algo."}}
      ],
      "pasos": [
        {"id": "p1", "tipo": "explicacion", "icono": "saludo", "titulo": {"es": "Cómo aprendes aquí"},
         "texto": {"es": "Cada unidad sigue el mismo camino: primero te enseñamos con ejemplos, después practicas con pistas y al final compruebas lo que sabes. Toca el altavoz para escuchar cada palabra. En inglés la escritura no siempre indica cómo suena: escucha antes de leer en voz alta."}},
        {"id": "p2", "tipo": "vocabulario", "refs": ["v-hello", "v-hi", "v-good-morning", "v-goodbye", "v-bye", "v-please", "v-thank-you", "v-yes", "v-no", "v-sorry", "v-excuse-me"]},
        {"id": "p3", "tipo": "ejemplos", "items": [
          {"texto": "Hello!", "traduccion": {"es": "¡Hola!"}},
          {"texto": "Good morning!", "traduccion": {"es": "¡Buenos días!"}},
          {"texto": "Thank you!", "traduccion": {"es": "¡Gracias!"}, "nota": {"es": "La «th» suena con la lengua entre los dientes."}},
          {"texto": "Excuse me!", "traduccion": {"es": "¡Disculpe!"}},
          {"texto": "Goodbye!", "traduccion": {"es": "¡Adiós!"}}
        ]},
        {"id": "p4", "tipo": "practica_guiada", "items": [
          {"id": "g1", "formato": "escuchar", "consigna": {"es": "Escucha y elige la palabra que oyes."}, "audio": "hello", "opciones": ["hello", "goodbye"], "respuesta": 0,
           "pista": {"es": "Es la palabra para saludar."}, "feedback": {"es": "«Hello» es el saludo más común."}},
          {"id": "g2", "formato": "elegir", "consigna": {"es": "Elige la respuesta."}, "preguntaApoyo": {"es": "¿Qué dices para dar las gracias?"}, "opciones": ["thank you", "sorry", "please"], "respuesta": 0,
           "pista": {"es": "Suena parecido a «zenk iu»."}, "feedback": {"es": "«Thank you» = gracias. «Please» = por favor. «Sorry» = perdón."}},
          {"id": "g3", "formato": "relacionar", "consigna": {"es": "Une cada palabra con su significado."},
           "pares": [["hello", {"es": "hola"}], ["goodbye", {"es": "adiós"}], ["please", {"es": "por favor"}], ["thank you", {"es": "gracias"}]],
           "pista": {"es": "Vuelve a escuchar las tarjetas si dudas."}, "feedback": {"es": "Estas cuatro expresiones te sirven desde el primer día."}}
        ]},
        {"id": "p5", "tipo": "practica_independiente", "items": [
          {"id": "i1", "formato": "escuchar", "consigna": {"es": "Escucha y elige."}, "audio": "thank you", "opciones": ["please", "thank you", "sorry"], "respuesta": 1,
           "feedback": {"es": "Oíste «thank you»: gracias."}},
          {"id": "i2", "formato": "elegir", "consigna": {"es": "Elige la expresión adecuada."}, "preguntaApoyo": {"es": "Pisas a alguien sin querer. ¿Qué dices?"}, "opciones": ["sorry", "yes", "hello"], "respuesta": 0,
           "feedback": {"es": "«Sorry» sirve para disculparte."}}
        ]},
        {"id": "p6", "tipo": "situacion", "contexto": {"es": "Entras a una cafetería por la mañana. El barista te saluda y, al final, te entrega tu pedido."},
         "dialogo": [
           {"hablante": "Barista", "texto": "Good morning!", "traduccion": {"es": "¡Buenos días!"}},
           {"hablante": "Tú", "texto": "Hi! Good morning!", "traduccion": {"es": "¡Hola! ¡Buenos días!"}},
           {"hablante": "Tú", "texto": "Thank you!", "traduccion": {"es": "¡Gracias!"}},
           {"hablante": "Barista", "texto": "Bye!", "traduccion": {"es": "¡Chao!"}}
         ],
         "items": [
           {"id": "s1", "formato": "elegir", "consigna": {"es": "Elige tu respuesta."}, "preguntaApoyo": {"es": "El barista te entrega tu pedido. ¿Qué le dices?"}, "opciones": ["thank you", "sorry", "no"], "respuesta": 0,
            "feedback": {"es": "Agradecer con «thank you» es lo natural."}}
         ]},
        {"id": "p7", "tipo": "evaluacion", "items": [
          {"id": "e1", "formato": "escuchar", "consigna": {"es": "Escucha y elige."}, "audio": "goodbye", "opciones": ["hello", "goodbye", "please"], "respuesta": 1,
           "feedback": {"es": "«Goodbye» = adiós."}},
          {"id": "e2", "formato": "relacionar", "consigna": {"es": "Une cada palabra con su significado."},
           "pares": [["yes", {"es": "sí"}], ["no", {"es": "no"}], ["sorry", {"es": "perdón"}], ["excuse me", {"es": "disculpe"}]],
           "feedback": {"es": "«Excuse me» llama la atención; «sorry» pide perdón."}},
          {"id": "e3", "formato": "elegir", "consigna": {"es": "Elige la expresión adecuada."}, "preguntaApoyo": {"es": "Saludas a alguien a las 9 de la mañana."}, "opciones": ["good morning", "goodbye", "thank you"], "respuesta": 0,
           "feedback": {"es": "«Good morning» = buenos días."}},
          {"id": "e4", "formato": "escribir", "consigna": {"es": "Escribe en inglés: «gracias»."}, "respuesta": "thank you", "aceptadas": ["thanks"],
           "feedback": {"es": "Se escribe «thank you»."}},
          {"id": "e5", "formato": "escuchar", "consigna": {"es": "Escucha y elige."}, "audio": "excuse me", "opciones": ["excuse me", "sorry", "yes"], "respuesta": 0,
           "feedback": {"es": "«Excuse me» = disculpe."}}
        ]}
      ],
      "criterioDominio": {"umbral": 0.8},
      "tutor": {"objetivo": {"es": "Saludar y agradecer"}, "gramaticaPermitida": ["en-g-sound-text"], "longitudMaxFrase": 3}
    },
    {
      "id": "en.f0.pronombres",
      "orden": 1,
      "titulo": {"es": "Pronombres personales"},
      "objetivo": {"es": "Nombrar quién habla y de quién hablas: I, you, he, she, it, we, they."},
      "cefr": "Pre-A1",
      "nivelInterno": 0,
      "concepto": "pronombres",
      "prerequisitos": ["en.f0.primer-contacto"],
      "habilidades": ["vocabulario", "gramatica", "escucha"],
      "gramatica": ["en-g-subj-pron-1", "en-g-subj-pron-2"],
      "vocabulario": [
        {"id": "v-i", "texto": "I", "traduccion": {"es": "yo"}, "nota": {"es": "Siempre con mayúscula."}},
        {"id": "v-you", "texto": "you", "traduccion": {"es": "tú / usted / ustedes"}},
        {"id": "v-he", "texto": "he", "traduccion": {"es": "él"}},
        {"id": "v-she", "texto": "she", "traduccion": {"es": "ella"}},
        {"id": "v-it", "texto": "it", "traduccion": {"es": "eso (una cosa o un animal)"}},
        {"id": "v-we", "texto": "we", "traduccion": {"es": "nosotros / nosotras"}},
        {"id": "v-they", "texto": "they", "traduccion": {"es": "ellos / ellas"}},
        {"id": "v-and", "texto": "and", "traduccion": {"es": "y"}},
        {"id": "v-man", "texto": "man", "traduccion": {"es": "hombre"}},
        {"id": "v-woman", "texto": "woman", "traduccion": {"es": "mujer"}},
        {"id": "v-friend", "texto": "friend", "traduccion": {"es": "amigo / amiga"}},
        {"id": "v-dog", "texto": "dog", "traduccion": {"es": "perro"}}
      ],
      "erroresFrecuentes": [
        {"incorrecto": "i", "correcto": "I", "explicacion": {"es": "«I» (yo) se escribe siempre con mayúscula, aunque esté en medio de la frase."}},
        {"incorrecto": "he", "correcto": "it", "explicacion": {"es": "Para una cosa (una mesa) y, normalmente, para un animal se usa «it», no «he»."}}
      ],
      "pasos": [
        {"id": "p1", "tipo": "explicacion", "icono": "personas", "titulo": {"es": "¿Quién?"},
         "texto": {"es": "Los pronombres dicen quién hace algo. En inglés casi nunca se omiten: en español dices «soy Ana», pero en inglés siempre aparece «I» (yo). «You» sirve para tú, usted y ustedes. «It» se usa para cosas y animales."}},
        {"id": "p2", "tipo": "vocabulario", "refs": ["v-i", "v-you", "v-he", "v-she", "v-it", "v-we", "v-they", "v-and", "v-man", "v-woman", "v-friend", "v-dog"]},
        {"id": "p3", "tipo": "ejemplos", "items": [
          {"texto": "Leo: he", "traduccion": {"es": "Leo → él"}},
          {"texto": "Mia: she", "traduccion": {"es": "Mia → ella"}},
          {"texto": "Rex, dog: it", "traduccion": {"es": "Rex, un perro → eso (it)"}},
          {"texto": "Ana and I: we", "traduccion": {"es": "Ana y yo → nosotros"}},
          {"texto": "Leo and Mia: they", "traduccion": {"es": "Leo y Mia → ellos"}}
        ]},
        {"id": "p4", "tipo": "practica_guiada", "items": [
          {"id": "g1", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas de ti mismo: «yo»."}, "opciones": ["I", "you", "he"], "respuesta": 0,
           "pista": {"es": "Es una sola letra y va en mayúscula."}, "feedback": {"es": "«I» = yo."}},
          {"id": "g2", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas con tu amiga, directamente: «tú»."}, "opciones": ["she", "you", "we"], "respuesta": 1,
           "pista": {"es": "Es la persona que te escucha."}, "feedback": {"es": "«You» = tú (también usted y ustedes)."}},
          {"id": "g3", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas de Mia, una mujer."}, "opciones": ["he", "it", "she"], "respuesta": 2,
           "pista": {"es": "Mujer → ella."}, "feedback": {"es": "«She» = ella."}},
          {"id": "g4", "formato": "relacionar", "consigna": {"es": "Une cada pronombre con su significado."},
           "pares": [["he", {"es": "él"}], ["we", {"es": "nosotros"}], ["they", {"es": "ellos"}], ["it", {"es": "eso (cosa o animal)"}]],
           "pista": {"es": "Mira las tarjetas de vocabulario."}, "feedback": {"es": "Ya conoces los siete pronombres."}}
        ]},
        {"id": "p5", "tipo": "practica_independiente", "items": [
          {"id": "i1", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas de Rex, tu perro."}, "opciones": ["he", "it", "they"], "respuesta": 1,
           "feedback": {"es": "Para animales se usa normalmente «it»."}},
          {"id": "i2", "formato": "escuchar", "consigna": {"es": "Escucha y elige."}, "audio": "they", "opciones": ["we", "they", "he"], "respuesta": 1,
           "feedback": {"es": "Oíste «they»: ellos o ellas."}},
          {"id": "i3", "formato": "escribir", "consigna": {"es": "Escribe en inglés: «nosotros»."}, "respuesta": "we",
           "feedback": {"es": "«We» = nosotros / nosotras."}}
        ]},
        {"id": "p6", "tipo": "situacion", "contexto": {"es": "Tu amiga Ana te muestra una foto y señala a cada persona."},
         "dialogo": [
           {"hablante": "Ana", "texto": "Leo: he.", "traduccion": {"es": "Leo: él."}},
           {"hablante": "Ana", "texto": "Mia: she. Friend!", "traduccion": {"es": "Mia: ella. ¡Amiga!"}},
           {"hablante": "Ana", "texto": "Leo and Mia: they.", "traduccion": {"es": "Leo y Mia: ellos."}},
           {"hablante": "Ana", "texto": "Rex, dog: it.", "traduccion": {"es": "Rex, el perro: eso."}}
         ],
         "items": [
           {"id": "s1", "formato": "elegir", "consigna": {"es": "Completa lo que diría Ana."}, "preguntaApoyo": {"es": "Ana se señala a sí misma y a ti juntos."}, "opciones": ["we", "they", "you"], "respuesta": 0,
            "feedback": {"es": "Ana y tú = nosotros = «we»."}}
         ]},
        {"id": "p7", "tipo": "evaluacion", "items": [
          {"id": "e1", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas de Carlos, un hombre."}, "opciones": ["she", "he", "it"], "respuesta": 1,
           "feedback": {"es": "Hombre → «he»."}},
          {"id": "e2", "formato": "escuchar", "consigna": {"es": "Escucha y elige el significado."}, "audio": "she", "opciones": [{"es": "ella"}, {"es": "él"}, {"es": "nosotros"}], "respuesta": 0,
           "feedback": {"es": "«She» = ella."}},
          {"id": "e3", "formato": "relacionar", "consigna": {"es": "Une cada pronombre con su significado."},
           "pares": [["I", {"es": "yo"}], ["you", {"es": "tú / usted"}], ["they", {"es": "ellos"}], ["we", {"es": "nosotros"}]],
           "feedback": {"es": "«I» siempre en mayúscula."}},
          {"id": "e4", "formato": "escribir", "consigna": {"es": "Escribe el pronombre para «Sara y Tom»."}, "respuesta": "they",
           "feedback": {"es": "Dos personas de las que hablas → «they»."}},
          {"id": "e5", "formato": "elegir", "consigna": {"es": "Elige el pronombre."}, "preguntaApoyo": {"es": "Hablas de una mesa."}, "opciones": ["it", "he", "she"], "respuesta": 0,
           "feedback": {"es": "Cosas → «it»."}}
        ]}
      ],
      "criterioDominio": {"umbral": 0.8},
      "tutor": {"objetivo": {"es": "Identificar personas con pronombres"}, "gramaticaPermitida": ["en-g-subj-pron-1", "en-g-subj-pron-2"], "longitudMaxFrase": 4}
    },
    {
      "id": "en.f0.be-afirmativo",
      "orden": 2,
      "titulo": {"es": "El verbo «to be»: am, is, are"},
      "objetivo": {"es": "Decir quién eres y cómo estás con am, is, are y sus contracciones."},
      "cefr": "Pre-A1",
      "nivelInterno": 0,
      "concepto": "copula",
      "prerequisitos": ["en.f0.pronombres"],
      "habilidades": ["gramatica", "vocabulario", "escritura", "escucha"],
      "gramatica": ["en-g-be-affirm", "en-g-be-contractions", "en-g-be-adj-state"],
      "vocabulario": [
        {"id": "v-am", "texto": "am", "traduccion": {"es": "soy / estoy (con I)"}},
        {"id": "v-is", "texto": "is", "traduccion": {"es": "es / está (con he, she, it)"}},
        {"id": "v-are", "texto": "are", "traduccion": {"es": "eres / estás / somos / son (con you, we, they)"}},
        {"id": "v-im", "texto": "I'm", "traduccion": {"es": "I am"}},
        {"id": "v-youre", "texto": "you're", "traduccion": {"es": "you are"}},
        {"id": "v-hes", "texto": "he's", "traduccion": {"es": "he is"}},
        {"id": "v-shes", "texto": "she's", "traduccion": {"es": "she is"}},
        {"id": "v-its", "texto": "it's", "traduccion": {"es": "it is"}},
        {"id": "v-were", "texto": "we're", "traduccion": {"es": "we are"}},
        {"id": "v-theyre", "texto": "they're", "traduccion": {"es": "they are"}},
        {"id": "v-a", "texto": "a", "traduccion": {"es": "un / una"}},
        {"id": "v-student", "texto": "student", "traduccion": {"es": "estudiante"}},
        {"id": "v-teacher", "texto": "teacher", "traduccion": {"es": "profesor / profesora"}},
        {"id": "v-happy", "texto": "happy", "traduccion": {"es": "feliz, contento"}},
        {"id": "v-tired", "texto": "tired", "traduccion": {"es": "cansado"}},
        {"id": "v-here", "texto": "here", "traduccion": {"es": "aquí"}},
        {"id": "v-at-home", "texto": "at home", "traduccion": {"es": "en casa"}}
      ],
      "erroresFrecuentes": [
        {"incorrecto": "I is Ana.", "correcto": "I am Ana.", "explicacion": {"es": "Con «I» siempre va «am»."}},
        {"incorrecto": "She teacher.", "correcto": "She is a teacher.", "explicacion": {"es": "En inglés el verbo no se omite y las profesiones llevan «a»."}},
        {"incorrecto": "Am happy.", "correcto": "I am happy.", "explicacion": {"es": "El pronombre es obligatorio: no se puede quitar «I»."}}
      ],
      "pasos": [
        {"id": "p1", "tipo": "explicacion", "icono": "verbo", "titulo": {"es": "Un verbo para «ser» y «estar»"},
         "texto": {"es": "En inglés «to be» significa a la vez «ser» y «estar». Tiene tres formas en presente: «am» solo con I; «is» con he, she, it; «are» con you, we, they. Las profesiones llevan «a» delante: «a student»."}},
        {"id": "p2", "tipo": "patron", "texto": {"es": "Así se construye la frase:"},
         "formula": [{"texto": "I", "nota": {"es": "quién"}}, {"texto": "am", "nota": {"es": "verbo be"}}, {"texto": "happy", "nota": {"es": "cómo / qué"}}],
         "ejemplos": [
           {"texto": "I am Ana.", "traduccion": {"es": "Soy Ana."}},
           {"texto": "You are a student.", "traduccion": {"es": "Eres estudiante."}},
           {"texto": "She is a teacher.", "traduccion": {"es": "Ella es profesora."}},
           {"texto": "We are happy.", "traduccion": {"es": "Estamos contentos."}},
           {"texto": "They are at home.", "traduccion": {"es": "Están en casa."}}
         ]},
        {"id": "p3", "tipo": "vocabulario", "refs": ["v-am", "v-is", "v-are", "v-a", "v-student", "v-teacher", "v-happy", "v-tired", "v-here", "v-at-home"]},
        {"id": "p4", "tipo": "explicacion", "icono": "contraccion", "titulo": {"es": "Contracciones"},
         "texto": {"es": "Al hablar, el verbo se une al pronombre con un apóstrofo: I am → I'm, you are → you're, he is → he's, she is → she's, it is → it's, we are → we're, they are → they're. Significan lo mismo."}},
        {"id": "p5", "tipo": "vocabulario", "refs": ["v-im", "v-youre", "v-hes", "v-shes", "v-its", "v-were", "v-theyre"]},
        {"id": "p6", "tipo": "practica_guiada", "items": [
          {"id": "g1", "formato": "completar", "consigna": {"es": "Completa: «Soy Ana»."}, "texto": "I ___ Ana.", "respuesta": "am", "opciones": ["am", "is", "are"],
           "pista": {"es": "Con «I» siempre va la misma forma."}, "feedback": {"es": "I + am."}},
          {"id": "g2", "formato": "completar", "consigna": {"es": "Completa: «Eres Leo»."}, "texto": "You ___ Leo.", "respuesta": "are", "opciones": ["am", "is", "are"],
           "pista": {"es": "Con «you» va «are»."}, "feedback": {"es": "You + are."}},
          {"id": "g3", "formato": "completar", "consigna": {"es": "Completa: «Ella es profesora»."}, "texto": "She ___ a teacher.", "respuesta": "is", "opciones": ["am", "is", "are"],
           "pista": {"es": "He, she, it llevan «is»."}, "feedback": {"es": "She + is."}},
          {"id": "g4", "formato": "elegir", "consigna": {"es": "Elige la frase correcta."}, "preguntaApoyo": {"es": "«Estoy cansado.»"}, "opciones": ["I am tired.", "I is tired."], "respuesta": 0,
           "pista": {"es": "Mira qué forma va con «I»."}, "feedback": {"es": "«I am tired»: aquí «am» significa «estoy»."}},
          {"id": "g5", "formato": "relacionar", "consigna": {"es": "Une cada contracción con su forma completa."},
           "pares": [["I'm", {"es": "I am (yo soy / estoy)"}], ["she's", {"es": "she is (ella es / está)"}], ["we're", {"es": "we are (somos / estamos)"}], ["they're", {"es": "they are (son / están)"}]],
           "pista": {"es": "El apóstrofo sustituye la primera letra del verbo."}, "feedback": {"es": "Las contracciones son muy frecuentes al hablar."}}
        ]},
        {"id": "p7", "tipo": "practica_independiente", "items": [
          {"id": "i1", "formato": "ordenar", "consigna": {"es": "Ordena: «Estoy feliz»."}, "tokens": ["happy.", "I", "am"], "respuesta": "I am happy.",
           "feedback": {"es": "Quién + verbo + cómo."}},
