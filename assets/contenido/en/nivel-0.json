{"idioma":"en","nivel":0,"generado":"2026-09-08T04:19:15.448Z","unidades":[{"numero":1,"tipo":"escritura","titulo":"Las letras A-M","descripcion":"El alfabeto inglés tiene las mismas letras que el español (sin la ñ), pero se nombran distinto. Aprende el nombre de cada letra y su sonido más común.","items":[{"simbolo":"A a","romanizacion":"ei","significado":"nombre \"ei\"; suena /a/ corta en \"apple\"","ejemplo":"apple (manzana)"},{"simbolo":"B b","romanizacion":"bi","significado":"suena como la b española","ejemplo":"book (libro)"},{"simbolo":"C c","romanizacion":"si","significado":"suena \"k\" en \"cat\" y \"s\" en \"city\"","ejemplo":"cat (gato)"},{"simbolo":"D d","romanizacion":"di","significado":"suena como la d española, más fuerte","ejemplo":"dog (perro)"},{"simbolo":"E e","romanizacion":"i","significado":"nombre \"i\"; suena /e/ en \"egg\"","ejemplo":"egg (huevo)"},{"simbolo":"F f","romanizacion":"ef","significado":"suena como la f española","ejemplo":"fish (pez)"},{"simbolo":"G g","romanizacion":"yi","significado":"suena \"g\" en \"go\" y \"y\" en \"gym\"","ejemplo":"go (ir)"},{"simbolo":"H h","romanizacion":"eich","significado":"se pronuncia: aire suave, como una j muy suave","ejemplo":"house (casa)"},{"simbolo":"I i","romanizacion":"ai","significado":"nombre \"ai\"; suena /i/ corta en \"sit\"","ejemplo":"ice (hielo)"},{"simbolo":"J j","romanizacion":"yei","significado":"suena como \"y\" fuerte (como en \"yo\" argentino)","ejemplo":"juice (jugo)"},{"simbolo":"K k","romanizacion":"kei","significado":"suena \"k\"","ejemplo":"key (llave)"},{"simbolo":"L l","romanizacion":"el","significado":"suena \"l\"","ejemplo":"love (amor)"},{"simbolo":"M m","romanizacion":"em","significado":"suena \"m\"","ejemplo":"mother (madre)"}],"examen":[{"pregunta":"¿Cómo se llama la letra \"A\" en inglés?","opciones":["ei","a","ai","e"],"correcta":0,"explicacion":"La A se nombra \"ei\"."},{"pregunta":"¿Cómo se llama la letra \"E\"?","opciones":["i","e","ei","ai"],"correcta":0,"explicacion":"La E se nombra \"i\"."},{"pregunta":"La letra \"H\" en inglés...","opciones":["se pronuncia como una j suave","es muda como en español","suena \"ch\"","no existe"],"correcta":0,"explicacion":"\"House\" empieza con una h aspirada."}]},{"numero":2,"tipo":"escritura","titulo":"Las letras N-Z","descripcion":"Segunda mitad del alfabeto. Ojo con la \"R\" (la lengua no vibra), la \"W\" (suena \"u\") y la \"Y\" (suena \"i\" o \"y\").","items":[{"simbolo":"N n","romanizacion":"en","significado":"suena \"n\"","ejemplo":"name (nombre)"},{"simbolo":"O o","romanizacion":"ou","significado":"nombre \"ou\"; suena /o/ abierta en \"hot\"","ejemplo":"orange (naranja)"},{"simbolo":"P p","romanizacion":"pi","significado":"suena \"p\" con un poco de aire","ejemplo":"pen (bolígrafo)"},{"simbolo":"Q q","romanizacion":"kiu","significado":"casi siempre va con \"u\": \"kw\"","ejemplo":"queen (reina)"},{"simbolo":"R r","romanizacion":"ar","significado":"la lengua no vibra: suena suave","ejemplo":"red (rojo)"},{"simbolo":"S s","romanizacion":"es","significado":"suena \"s\"","ejemplo":"sun (sol)"},{"simbolo":"T t","romanizacion":"ti","significado":"suena \"t\" con aire","ejemplo":"table (mesa)"},{"simbolo":"U u","romanizacion":"iu","significado":"nombre \"iu\"; suena /a/ en \"cup\"","ejemplo":"umbrella (paraguas)"},{"simbolo":"V v","romanizacion":"vi","significado":"los dientes tocan el labio, como una f sonora","ejemplo":"very (muy)"},{"simbolo":"W w","romanizacion":"dabliu","significado":"suena como \"u\": \"water\" es \"uóter\"","ejemplo":"water (agua)"},{"simbolo":"X x","romanizacion":"eks","significado":"suena \"ks\"","ejemplo":"box (caja)"},{"simbolo":"Y y","romanizacion":"uai","significado":"suena \"y\" al inicio y \"i\" al final","ejemplo":"yes (sí)"},{"simbolo":"Z z","romanizacion":"zed / zi","significado":"suena como un zumbido \"zzz\"","ejemplo":"zoo (zoológico)"}],"examen":[{"pregunta":"¿Cómo suena la \"W\" en \"water\"?","opciones":["u","b","gu","v"],"correcta":0,"explicacion":"\"Water\" se dice \"uóter\"."},{"pregunta":"¿Cómo se llama la letra \"Y\"?","opciones":["uai","i griega","ye","ai"],"correcta":0,"explicacion":"La Y se nombra \"uai\"."},{"pregunta":"La \"R\" inglesa...","opciones":["no vibra, es suave","vibra como la rr española","es muda","suena \"l\""],"correcta":0,"explicacion":"La lengua no toca el paladar."}]},{"numero":3,"tipo":"escritura","titulo":"Sonidos que no existen en español","descripcion":"Combinaciones de letras con sonidos propios del inglés. Escucha, repite y fíjate en la posición de la lengua.","items":[{"simbolo":"th (this)","romanizacion":"d suave con la lengua entre los dientes","significado":"\"th\" sonoro: this, the, mother","ejemplo":"this (esto)"},{"simbolo":"th (think)","romanizacion":"z española (Madrid)","significado":"\"th\" sordo: think, thank you, three","ejemplo":"think (pensar)"},{"simbolo":"sh","romanizacion":"sh (como pedir silencio)","significado":"ship, she, fish","ejemplo":"she (ella)"},{"simbolo":"ch","romanizacion":"ch española","significado":"chair, cheese, teacher","ejemplo":"chair (silla)"},{"simbolo":"ee","romanizacion":"i larga","significado":"see, green, tree","ejemplo":"green (verde)"},{"simbolo":"oo","romanizacion":"u larga","significado":"food, moon, school","ejemplo":"school (escuela)"},{"simbolo":"-e final muda","romanizacion":"la e no suena y alarga la vocal anterior","significado":"name, like, time","ejemplo":"name (nombre)"},{"simbolo":"ng","romanizacion":"n nasal, sin decir la g","significado":"sing, morning, thing","ejemplo":"morning (mañana)"},{"simbolo":"a (cat)","romanizacion":"a con la boca muy abierta, entre a y e","significado":"cat, hat, man","ejemplo":"cat (gato)"},{"simbolo":"i (sit)","romanizacion":"i corta y relajada","significado":"sit, big, fish","ejemplo":"big (grande)"}],"examen":[{"pregunta":"¿Cómo suena \"th\" en \"thank you\"?","opciones":["como la z de Madrid","como t","como d fuerte","como s"],"correcta":0,"explicacion":"\"Th\" sordo, lengua entre los dientes."},{"pregunta":"La \"e\" final de \"name\"...","opciones":["no suena","suena \"e\"","suena \"i\"","suena \"a\""],"correcta":0,"explicacion":"Es muda y hace que la \"a\" se diga \"ei\"."},{"pregunta":"\"ee\" en \"green\" suena...","opciones":["i larga","e larga","ei","ie"],"correcta":0,"explicacion":"\"Green\" se dice \"grin\"."}]},{"numero":4,"tipo":"vocabulario","titulo":"Números del 0 al 10","descripcion":"Cuenta con los dedos. Estos diez números son la base de todos los demás.","items":[{"simbolo":"zero","romanizacion":"","significado":"cero","ejemplo":"zero, one, two"},{"simbolo":"one","romanizacion":"","significado":"uno","ejemplo":"one dog"},{"simbolo":"two","romanizacion":"","significado":"dos","ejemplo":"two cats"},{"simbolo":"three","romanizacion":"","significado":"tres","ejemplo":"three apples"},{"simbolo":"four","romanizacion":"","significado":"cuatro","ejemplo":"four books"},{"simbolo":"five","romanizacion":"","significado":"cinco","ejemplo":"five fingers"},{"simbolo":"six","romanizacion":"","significado":"seis","ejemplo":"six eggs"},{"simbolo":"seven","romanizacion":"","significado":"siete","ejemplo":"seven days"},{"simbolo":"eight","romanizacion":"","significado":"ocho","ejemplo":"eight hours"},{"simbolo":"nine","romanizacion":"","significado":"nueve","ejemplo":"nine people"},{"simbolo":"ten","romanizacion":"","significado":"diez","ejemplo":"ten dollars"}],"examen":[{"pregunta":"¿Cómo se dice \"cinco\"?","opciones":["five","four","fifteen","fine"],"correcta":0,"explicacion":"Five es cinco."},{"pregunta":"\"Eight\" es...","opciones":["8","3","18","80"],"correcta":0,"explicacion":"Eight es ocho."},{"pregunta":"¿Qué número viene después de \"six\"?","opciones":["seven","five","eight","sixty"],"correcta":0,"explicacion":"Six, seven, eight."}]},{"numero":5,"tipo":"vocabulario","titulo":"Colores","descripcion":"Los colores básicos para describir lo que ves.","items":[{"simbolo":"red","romanizacion":"","significado":"rojo","ejemplo":"a red apple"},{"