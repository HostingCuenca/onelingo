emplo":"a glass of water"},{"simbolo":"house","romanizacion":"","significado":"casa","ejemplo":"my house"},{"simbolo":"friend","romanizacion":"","significado":"amigo","ejemplo":"my friend"},{"simbolo":"good","romanizacion":"","significado":"bueno","ejemplo":"good morning"},{"simbolo":"big","romanizacion":"","significado":"grande","ejemplo":"a big dog"},{"simbolo":"small","romanizacion":"","significado":"pequeño","ejemplo":"a small cat"}],"examen":[{"pregunta":"¿Cómo se dice \"gracias\"?","opciones":["thank you","please","sorry","hello"],"correcta":0,"explicacion":"Thank you es gracias."},{"pregunta":"\"Water\" es...","opciones":["agua","casa","amigo","perro"],"correcta":0,"explicacion":"Water es agua."},{"pregunta":"¿Cómo se dice \"pequeño\"?","opciones":["small","big","good","bye"],"correcta":0,"explicacion":"Small es pequeño; big es grande."}]},{"numero":7,"tipo":"vocabulario","titulo":"Familia, animales y comida","descripcion":"Vocabulario esencial en tres grupos que aparecen en todas las conversaciones.","items":[{"simbolo":"mother","romanizacion":"","significado":"madre","ejemplo":"my mother"},{"simbolo":"father","romanizacion":"","significado":"padre","ejemplo":"my father"},{"simbolo":"brother","romanizacion":"","significado":"hermano","ejemplo":"my brother"},{"simbolo":"sister","romanizacion":"","significado":"hermana","ejemplo":"my sister"},{"simbolo":"baby","romanizacion":"","significado":"bebé","ejemplo":"a baby"},{"simbolo":"dog","romanizacion":"","significado":"perro","ejemplo":"a big dog"},{"simbolo":"cat","romanizacion":"","significado":"gato","ejemplo":"a black cat"},{"simbolo":"bird","romanizacion":"","significado":"pájaro","ejemplo":"a small bird"},{"simbolo":"fish","romanizacion":"","significado":"pez, pescado","ejemplo":"a fish"},{"simbolo":"bread","romanizacion":"","significado":"pan","ejemplo":"bread and butter"},{"simbolo":"apple","romanizacion":"","significado":"manzana","ejemplo":"a red apple"},{"simbolo":"milk","romanizacion":"","significado