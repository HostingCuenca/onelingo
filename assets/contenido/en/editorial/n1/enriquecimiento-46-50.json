    "en.n1.class-46": {
      "explicacion": {
        "titulo": "Negativas: don't y doesn't",
        "texto": "En español basta con poner «no» delante del verbo. En inglés hace falta un auxiliar: don't con I, you, we y they (I don't eat meat) y doesn't con he, she e it (He doesn't drive a car). Después de don't o doesn't el verbo va en forma base, sin -s: la -s ya está en doesn't. Like funciona al revés que «gustar»: «a ella no le gusta el café» es She doesn't like coffee."
      },
      "patron": {
        "texto": "Sujeto + don't/doesn't + verbo base:",
        "formula": [
          {
            "texto": "She",
            "nota": "una persona → doesn't"
          },
          {
            "texto": "doesn't",
            "nota": "no (con he, she, it)"
          },
          {
            "texto": "drink",
            "nota": "verbo base, sin -s"
          },
          {
            "texto": "milk.",
            "nota": "qué no bebe"
          }
        ]
      },
      "tabla": {
        "columnas": [
          "Sujeto",
          "Negativa",
          "Ejemplo"
        ],
        "filas": [
          [
            {
              "texto": "I / you / we / they"
            },
            {
              "texto": "don't + verbo"
            },
            {
              "texto": "We don't eat meat."
            }
          ],
          [
            {
              "texto": "he / she / it"
            },
            {
              "texto": "doesn't + verbo"
            },
            {
              "texto": "He doesn't drive a car."
            }
          ]
        ]
      },
