      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-5"
    },
    {
      "id": "en.n4.class-15.t02",
      "en": "If I were you, I would apply again next year.",
      "es": "Yo, en tu lugar, me presentaría otra vez el año que viene.",
      "explanationEs": "If I were you, I would + verbo base: consejo amable.",
      "segments": [
        "If I were you, I",
        "would apply again next year."
      ],
      "audioText": "If I were you, I would apply again next year.",
      "audioMode": "tts",
