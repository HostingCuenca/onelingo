  "teaching": [
    {
      "id": "en.n4.class-15.t01",
      "en": "I'm sorry to hear that. It is not your fault.",
      "es": "Siento oír eso. No es tu culpa.",
      "explanationEs": "Primero reconoce el sentimiento y quita la culpa.",
