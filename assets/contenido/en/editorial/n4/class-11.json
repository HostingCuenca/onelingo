  "teaching": [
    {
      "id": "en.n4.class-11.t01",
      "en": "I wish I lived closer to the school.",
      "es": "Ojalá viviera más cerca de la escuela.",
      "explanationEs": "Wish + pasado simple habla del presente: ahora vives lejos.",
      "segments": [
        "I wish I lived",
        "closer to the school."
      ],
      "audioText": "I wish I lived closer to the school.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    },
    {
      "id": "en.n4.class-11.t02",
      "en": "If only we could afford a bigger house.",
      "es": "Ojalá pudiéramos permitirnos una casa más grande.",
      "explanationEs": "If only = wish, pero más emotivo; could expresa lo que hoy no es posible.",
      "segments": [
        "If only we could",
        "afford a bigger house."
      ],
      "audioText": "If only we could afford a bigger house.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    },
    {
      "id": "en.n4.class-11.t03",
      "en": "I wish I had left earlier yesterday.",
      "es": "Ojalá me hubiera ido antes ayer.",
      "explanationEs": "Wish + past perfect (had + participio) es un arrepentimiento del pasado.",
      "segments": [
        "I wish I had",
        "left earlier yesterday."
      ],
      "audioText": "I wish I had left earlier yesterday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    },
    {
      "id": "en.n4.class-11.t04",
      "en": "If only I had taken that chance!",
      "es": "¡Ojalá hubiera aprovechado esa oportunidad!",
      "explanationEs": "If only + past perfect: arrepentimiento fuerte por algo que no hiciste.",
      "segments": [
        "If only I had",
        "taken that chance!"
      ],
      "audioText": "If only I had taken that chance!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    },
    {
      "id": "en.n4.class-11.t05",
      "en": "I wish I were taller.",
      "es": "Ojalá fuera más alto.",
      "explanationEs": "Con wish se usa were con todas las personas: I were, she were.",
      "segments": [
        "I wish I",
        "were taller."
      ],
      "audioText": "I wish I were taller.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    },
    {
      "id": "en.n4.class-11.t06",
      "en": "My biggest regret is not calling my grandmother more often.",
      "es": "Mi mayor arrepentimiento es no haber llamado más a mi abuela.",
      "explanationEs": "Regret (sustantivo) nombra lo que lamentas; wish + had + participio lo expresa.",
      "segments": [
        "My biggest regret is not",
        "calling my grandmother more often."
      ],
      "audioText": "My biggest regret is not calling my grandmother more often.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-1"
    }
