  "teaching": [
    {
      "id": "en.n4.class-49.t01",
      "en": "My cousin Rosa is generous: she shares her lunch with everyone, and her generosity makes us smile.",
      "es": "Mi prima Rosa es generosa: comparte su almuerzo con todos y su generosidad nos hace sonreír.",
      "explanationEs": "Generous → generosity. Un adjetivo de carácter + un hecho que lo demuestra.",
      "segments": [
        "My cousin Rosa is generous: she shares her lunch",
        "with everyone, and her generosity makes us smile."
      ],
      "audioText": "My cousin Rosa is generous: she shares her lunch with everyone, and her generosity makes us smile.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-4"
    },
    {
      "id": "en.n4.class-49.t02",
      "en": "Leo is brave; his bravery helped him speak in front of the class.",
      "es": "Leo es valiente; su valentía le ayudó a hablar delante de la clase.",
      "explanationEs": "Brave → bravery: del adjetivo al sustantivo cambia el final.",
      "segments": [
        "Leo is brave; his bravery helped him",
        "speak in front of the class."
      ],
      "audioText": "Leo is brave; his bravery helped him speak in front of the class.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-4"
    },
    {
      "id": "en.n4.class-49.t03",
      "en": "Mia is shy at first, but her shyness disappears when she knows you.",
      "es": "Mia es tímida al principio, pero su timidez desaparece cuando te conoce.",
      "explanationEs": "Shy → shyness con -ness. Her/his + sustantivo.",
      "segments": [
        "Mia is shy at first, but her",
        "shyness disappears when she knows you."
      ],
      "audioText": "Mia is shy at first, but her shyness disappears when she knows you.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-4"
    },
    {
      "id": "en.n4.class-49.t04",
      "en": "Tom is an honest student, and his honesty is the reason why we trust him.",
      "es": "Tom es un estudiante honrado y su honestidad es el motivo por el que confiamos en él.",
      "explanationEs": "Honest → honesty: el sustantivo termina en -y.",
      "segments": [
        "Tom is an honest student, and his honesty",
        "is the reason why we trust him."
      ],
      "audioText": "Tom is an honest student, and his honesty is the reason why we trust him.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-4"
    },
    {
      "id": "en.n4.class-49.t05",
      "en": "Sara is cheerful and never selfish; for example, she always gives her seat to others.",
      "es": "Sara es alegre y nunca egoísta; por ejemplo, siempre cede su asiento a los demás.",
      "explanationEs": "For example introduce el hecho que demuestra el carácter.",
