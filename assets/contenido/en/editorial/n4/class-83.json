  "teaching": [
    {
      "id": "en.n4.class-83.t01",
      "en": "The date is a fact: the council has confirmed it.",
      "es": "La fecha es un hecho: el consejo la ha confirmado.",
      "explanationEs": "Fact = hecho. Se apoya en una confirmación de una fuente fiable.",
      "segments": [
        "The date is a fact:",
        "the council has confirmed it."
      ],
      "audioText": "The date is a fact: the council has confirmed it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-3"
    },
    {
      "id": "en.n4.class-83.t02",
      "en": "The company claims that the mistake was small, but the workers disagree.",
      "es": "La empresa afirma que el error fue pequeño, pero los trabajadores no están de acuerdo.",
      "explanationEs": "Claims presenta la versión de una parte. Quien informa no la da por cierta.",
      "segments": [
        "The company claims that the mistake",
        "was small, but the workers disagree."
      ],
      "audioText": "The company claims that the mistake was small, but the workers disagree.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-3"
    },
    {
      "id": "en.n4.class-83.t03",
      "en": "The club denies the story, and there is no evidence yet.",
      "es": "El club niega la historia y todavía no hay pruebas.",
      "explanationEs": "Denies = niega. Evidence es incontable: no lleva -s ni a.",
      "segments": [
        "The club denies the story, and",
        "there is no evidence yet."
      ],
      "audioText": "The club denies the story, and there is no evidence yet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-3"
    },
    {
      "id": "en.n4.class-83.t04",
      "en": "Allegedly, the shop owner knew about the problem for weeks.",
      "es": "Supuestamente, el dueño de la tienda sabía del problema desde hacía semanas.",
      "explanationEs": "Allegedly = supuestamente: alguien lo afirma, pero sin pruebas todavía.",
      "segments": [
        "Allegedly, the shop owner knew",
        "about the problem for weeks."
      ],
      "audioText": "Allegedly, the shop owner knew about the problem for weeks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-3"
    },
    {
      "id": "en.n4.class-83.t05",
      "en": "There are two versions of the accident, and the facts are still unclear.",
      "es": "Hay dos versiones del accidente y los hechos siguen sin estar claros.",
      "explanationEs": "Unclear = poco claro. Con dos versiones opuestas, ninguna es un hecho todavía.",
      "segments": [
        "There are two versions of the accident,",
        "and the facts are still unclear."
      ],
      "audioText": "There are two versions of the accident, and the facts are still unclear.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-3"
    }
  ],
