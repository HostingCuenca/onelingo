    {
      "id": "en.n4.class-21.t01",
      "en": "The baker makes the dough at five o'clock.",
      "es": "El panadero prepara la masa a las cinco en punto.",
      "explanationEs": "Voz activa: el sujeto es quien hace la acción (the baker).",
      "segments": [
        "The baker makes the",
        "dough at five o'clock."
      ],
      "audioText": "The baker makes the dough at five o'clock.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-1"
    },
    {
      "id": "en.n4.class-21.t02",
      "en": "The dough is made at five o'clock.",
      "es": "La masa se prepara a las cinco en punto.",
      "explanationEs": "Voz pasiva: is made (be + participio). Lo importante es la masa, no quién la prepara.",
      "segments": [
        "The dough is made",
        "at five o'clock."
      ],
      "audioText": "The dough is made at five o'clock.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-1"
    },
    {
      "id": "en.n4.class-21.t03",
      "en": "The loaves are baked in a big oven.",
      "es": "Las hogazas se hornean en un horno grande.",
      "explanationEs": "Loaves es plural, así que la pasiva lleva are + participio.",
      "segments": [
        "The loaves are baked",
        "in a big oven."
      ],
      "audioText": "The loaves are baked in a big oven.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-1"
    },
    {
      "id": "en.n4.class-21.t04",
      "en": "Fresh bread is sold to customers every morning.",
      "es": "El pan fresco se vende a los clientes cada mañana.",
      "explanationEs": "El español dice «se vende»; el inglés pone el pan como sujeto y usa is sold.",
      "segments": [
        "Fresh bread is sold",
        "to customers every morning."
      ],
      "audioText": "Fresh bread is sold to customers every morning.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-1"
    },
    {
      "id": "en.n4.class-21.t05",
      "en": "The flour is kept in a dry place.",
      "es": "La harina se guarda en un lugar seco.",
      "explanationEs": "Se nombra lo que se guarda; nadie dice quién lo guarda porque no importa.",
      "segments": [
        "The flour is kept",
        "in a dry place."
      ],
      "audioText": "The flour is kept in a dry place.",
      "audioMode": "tts",
      "languageCode": "en",
