  "teaching": [
    {
      "id": "en.n4.class-07.t01",
      "en": "Every summer, we would visit my grandparents at the lake.",
      "es": "Cada verano visitábamos a mis abuelos en el lago.",
      "explanationEs": "Would + verbo base: una acción repetida; antes se ha dicho la época (every summer).",
      "segments": [
        "Every summer, we would visit",
        "my grandparents at the lake."
      ],
      "audioText": "Every summer, we would visit my grandparents at the lake.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-2"
    },
    {
      "id": "en.n4.class-07.t02",
      "en": "We used to swim in the lake every morning.",
      "es": "Nadábamos en el lago todas las mañanas.",
      "explanationEs": "Used to también vale para acciones repetidas.",
      "segments": [
        "We used to swim in",
        "the lake every morning."
      ],
      "audioText": "We used to swim in the lake every morning.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-2"
    },
    {
      "id": "en.n4.class-07.t03",
      "en": "My grandfather used to have a small boat.",
      "es": "Mi abuelo tenía un barco pequeño.",
      "explanationEs": "Have es un estado: aquí solo used to, nunca would.",
      "segments": [
        "My grandfather used to",
        "have a small boat."
      ],
      "audioText": "My grandfather used to have a small boat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-2"
    },
    {
      "id": "en.n4.class-07.t04",
      "en": "After dinner, he would tell us a story, and we would listen.",
      "es": "Después de cenar, nos contaba una historia y nosotros escuchábamos.",
      "explanationEs": "Would + tell / would + listen: dos acciones que se repetían cada noche.",
      "segments": [
        "After dinner, he would tell us",
        "a story, and we would listen."
      ],
      "audioText": "After dinner, he would tell us a story, and we would listen.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-2"
    },
    {
      "id": "en.n4.class-07.t05",
      "en": "I used to be afraid of the water, but my grandfather helped me.",
      "es": "Yo tenía miedo del agua, pero mi abuelo me ayudó.",
      "explanationEs": "Be es un estado: used to be, no would be.",
      "segments": [
        "I used to be afraid of the",
        "water, but my grandfather helped me."
      ],
      "audioText": "I used to be afraid of the water, but my grandfather helped me.",
      "audioMode": "tts",
