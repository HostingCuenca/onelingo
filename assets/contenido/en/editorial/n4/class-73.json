      "languageCode": "en",
      "patternId": "n4-environment-results-3"
    },
    {
      "id": "en.n4.class-73.t03",
      "en": "The solution is simple: the council will clean the drains.",
      "es": "La solución es sencilla: el ayuntamiento limpiará los desagües.",
