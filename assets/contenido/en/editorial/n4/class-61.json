  "teaching": [
    {
      "id": "en.n4.class-61.t01",
      "en": "We stop to rest because we are tired.",
      "es": "Nos paramos para descansar porque estamos cansados.",
      "explanationEs": "Stop + to + verbo: paramos con un propósito (descansar).",
      "segments": [
        "We stop to rest",
        "because we are tired."
      ],
      "audioText": "We stop to rest because we are tired.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-1"
    },
    {
      "id": "en.n4.class-61.t02",
      "en": "Mia wants to stop eating late; it is a bad habit and it is bad for her sleep.",
      "es": "Mia quiere dejar de comer tarde; es un mal hábito y es malo para su sueño.",
      "explanationEs": "Stop + gerundio: dejar de hacer algo. Lo que termina es eating.",
      "segments": [
        "Mia wants to stop eating late; it is a",
        "bad habit and it is bad for her sleep."
      ],
      "audioText": "Mia wants to stop eating late; it is a bad habit and it is bad for her sleep.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-1"
    },
    {
      "id": "en.n4.class-61.t03",
      "en": "Remember to drink water today.",
      "es": "Acuérdate de beber agua hoy.",
      "explanationEs": "Remember + to + verbo: una tarea pendiente, todavía sin hacer.",
      "segments": [
        "Remember to drink",
        "water today."
      ],
      "audioText": "Remember to drink water today.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-1"
    },
    {
      "id": "en.n4.class-61.t04",
      "en": "I remember drinking a lot of water on that hot day.",
      "es": "Recuerdo haber bebido mucha agua ese día de calor.",
      "explanationEs": "Remember + gerundio: recordar algo que ya ocurrió.",
      "segments": [
        "I remember drinking a lot of",
        "water on that hot day."
      ],
      "audioText": "I remember drinking a lot of water on that hot day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-1"
    },
    {
      "id": "en.n4.class-61.t05",
      "en": "I try to sleep early, but I am often tired.",
      "es": "Intento dormir temprano, pero a menudo estoy cansado.",
      "explanationEs": "Try + to + verbo: hacer un esfuerzo; puede que no se consiga.",
      "segments": [
        "I try to sleep early,",
        "but I am often tired."
      ],
      "audioText": "I try to sleep early, but I am often tired.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-1"
    },
    {
      "id": "en.n4.class-61.t06",
      "en": "Try drinking warm water before bed; it may help your sleep.",
      "es": "Prueba a beber agua caliente antes de acostarte; puede ayudar a tu sueño.",
      "explanationEs": "Try + gerundio: probar algo como experimento para ver qué pasa.",
      "segments": [
