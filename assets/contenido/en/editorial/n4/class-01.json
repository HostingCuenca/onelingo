    {
      "id": "en.n4.class-01.t01",
      "en": "When we arrived at the station, the train had already left.",
      "es": "Cuando llegamos a la estación, el tren ya se había ido.",
      "explanationEs": "Had + participio (left) es lo que pasó primero; arrived ocurrió después.",
      "segments": [
        "When we arrived at the station,",
        "the train had already left."
      ],
      "audioText": "When we arrived at the station, the train had already left.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-1"
    },
    {
      "id": "en.n4.class-01.t02",
      "en": "Grandma told an anecdote about her wedding: she had lost her ring the night before.",
      "es": "La abuela contó una anécdota de su boda: había perdido el anillo la noche anterior.",
      "explanationEs": "Told va en pasado simple; had lost marca lo que ya había ocurrido antes de la boda.",
      "segments": [
        "Grandma told an anecdote about her wedding: she",
        "had lost her ring the night before."
      ],
      "audioText": "Grandma told an anecdote about her wedding: she had lost her ring the night before.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-1"
    },
    {
      "id": "en.n4.class-01.t03",
      "en": "The last guest had left before Grandpa found the ring under the table.",
      "es": "El último invitado se había ido antes de que el abuelo encontrara el anillo debajo de la mesa.",
      "explanationEs": "Had left pasó antes que found: el orden de los hechos no es el orden de la frase.",
      "segments": [
        "The last guest had left before Grandpa",
        "found the ring under the table."
      ],
      "audioText": "The last guest had left before Grandpa found the ring under the table.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-1"
    },
    {
      "id": "en.n4.class-01.t04",
      "en": "It was a big surprise because nobody had told Ana about the party.",
      "es": "Fue una gran sorpresa porque nadie le había dicho a Ana lo de la fiesta.",
      "explanationEs": "Nobody had told = nadie había dicho: explica la causa de la sorpresa.",
      "segments": [
        "It was a big surprise because nobody",
        "had told Ana about the party."
      ],
      "audioText": "It was a big surprise because nobody had told Ana about the party.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-1"
    },
    {
      "id": "en.n4.class-01.t05",
      "en": "Earlier that day, it had rained, so the garden was wet.",
      "es": "Más temprano ese día había llovido, así que el jardín estaba mojado.",
      "explanationEs": "Había llovido antes del momento del que hablas; was wet describe ese momento.",
      "segments": [
        "Earlier that day, it had rained,",
        "so the garden was wet."
      ],
      "audioText": "Earlier that day, it had rained, so the garden was wet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-1"
    }
