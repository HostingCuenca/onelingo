    {
      "id": "en.n4.class-43.t01",
      "en": "I do yoga on Monday and play tennis on Friday.",
      "es": "Hago yoga el lunes y juego al tenis el viernes.",
      "explanationEs": "Play para juegos con pelota; do para actividades individuales como yoga.",
      "segments": [
        "I do yoga on Monday",
        "and play tennis on Friday."
      ],
      "audioText": "I do yoga on Monday and play tennis on Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-3"
    },
    {
      "id": "en.n4.class-43.t02",
      "en": "We go swimming every weekend.",
      "es": "Vamos a nadar todos los fines de semana.",
      "explanationEs": "Go + verbo con -ing para actividades como swimming, running o skating.",
      "segments": [
        "We go swimming",
        "every weekend."
      ],
      "audioText": "We go swimming every weekend.",
