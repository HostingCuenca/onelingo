  "teaching": [
    {
      "id": "en.n4.class-88.t01",
      "en": "The receptionist recommends arriving before six.",
      "es": "El recepcionista recomienda llegar antes de las seis.",
      "explanationEs": "Recommend + -ing: recomendar hacer algo. Es una recomendación, no una orden.",
      "segments": [
        "The receptionist recommends",
        "arriving before six."
      ],
      "audioText": "The receptionist recommends arriving before six.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-3"
    },
    {
      "id": "en.n4.class-88.t02",
      "en": "Other travellers say you must pay a deposit at the hostel.",
      "es": "Otros viajeros dicen que debes pagar un depósito en el albergue.",
      "explanationEs": "Travellers = viajeros. Deposit = dinero que se deja como garantía.",
      "segments": [
        "Other travellers say you must pay",
        "a deposit at the hostel."
      ],
      "audioText": "Other travellers say you must pay a deposit at the hostel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-3"
    },
    {
      "id": "en.n4.class-88.t03",
      "en": "A deposit is compulsory, but breakfast is optional.",
      "es": "El depósito es obligatorio, pero el desayuno es opcional.",
      "explanationEs": "Compulsory = obligatorio; optional = puedes elegir. Son opuestos.",
      "segments": [
        "A deposit is compulsory,",
        "but breakfast is optional."
      ],
      "audioText": "A deposit is compulsory, but breakfast is optional.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-3"
    },
    {
      "id": "en.n4.class-88.t04",
      "en": "Guests are allowed to cook in the kitchen, but they are supposed to clean it.",
      "es": "Los huéspedes pueden cocinar en la cocina, pero se supone que deben limpiarla.",
      "explanationEs": "Allowed to = permiso; supposed to = lo que se espera de ti.",
      "segments": [
        "Guests are allowed to cook in the kitchen,",
        "but they are supposed to clean it."
      ],
      "audioText": "Guests are allowed to cook in the kitchen, but they are supposed to clean it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-3"
    },
    {
      "id": "en.n4.class-88.t05",
      "en": "At reception you had better ask about the night bus; the last one leaves early.",
      "es": "En recepción más te vale preguntar por el autobús nocturno; el último sale temprano.",
      "explanationEs": "Reception = recepción. Had better = consejo fuerte, sin ser obligación.",
      "segments": [
        "At reception you had better ask about the",
        "night bus; the last one leaves early."
      ],
      "audioText": "At reception you had better ask about the night bus; the last one leaves early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-3"
    }
  ],
