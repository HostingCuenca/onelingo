  "teaching": [
    {
      "id": "en.n4.class-03.t01",
      "en": "The traffic was terrible because there had been an accident on the bridge.",
      "es": "El tráfico era terrible porque había habido un accidente en el puente.",
      "explanationEs": "Because introduce la causa; had been = había habido, algo anterior al problema.",
      "segments": [
        "The traffic was terrible because there had",
        "been an accident on the bridge."
      ],
      "audioText": "The traffic was terrible because there had been an accident on the bridge.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    },
    {
      "id": "en.n4.class-03.t02",
      "en": "The delay lasted an hour because the road had been closed.",
      "es": "El retraso duró una hora porque habían cerrado la carretera.",
      "explanationEs": "Had been closed: la carretera ya estaba cerrada antes del retraso.",
      "segments": [
        "The delay lasted an hour because",
        "the road had been closed."
      ],
      "audioText": "The delay lasted an hour because the road had been closed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    },
    {
      "id": "en.n4.class-03.t03",
      "en": "Leo's message said that he had missed the first bus, so he was late.",
      "es": "El mensaje de Leo decía que había perdido el primer autobús, así que llegó tarde.",
      "explanationEs": "So anuncia la consecuencia; had missed es lo que pasó antes.",
      "segments": [
        "Leo's message said that he had missed",
        "the first bus, so he was late."
      ],
      "audioText": "Leo's message said that he had missed the first bus, so he was late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    },
    {
      "id": "en.n4.class-03.t04",
      "en": "Sara was stuck at the station because her train had been cancelled.",
      "es": "Sara estaba atascada en la estación porque habían cancelado su tren.",
      "explanationEs": "Was stuck describe el problema; had been cancelled, su causa anterior.",
      "segments": [
        "Sara was stuck at the station",
        "because her train had been cancelled."
      ],
      "audioText": "Sara was stuck at the station because her train had been cancelled.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    },
    {
      "id": "en.n4.class-03.t05",
      "en": "The reason was simple: nobody had checked the time.",
      "es": "El motivo era simple: nadie había mirado la hora.",
      "explanationEs": "The reason introduce la explicación; nobody had checked = nadie había comprobado.",
      "segments": [
        "The reason was simple: nobody",
        "had checked the time."
      ],
      "audioText": "The reason was simple: nobody had checked the time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    },
    {
      "id": "en.n4.class-03.t06",
      "en": "Mia took a taxi because her train had already left.",
      "es": "Mia tomó un taxi porque su tren ya se había ido.",
      "explanationEs": "Took es la consecuencia (después); had already left, el antecedente.",
      "segments": [
        "Mia took a taxi because",
        "her train had already left."
      ],
      "audioText": "Mia took a taxi because her train had already left.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-3"
    }
