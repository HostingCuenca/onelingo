    },
    {
      "id": "en.n4.class-77.t02",
      "en": "The guest doesn't eat meat, does he?",
      "es": "El invitado no come carne, ¿verdad?",
      "explanationEs": "Frase negativa + tag afirmativo: doesn't → does he.",
