  "teaching": [
    {
      "id": "en.n4.class-50.t01",
      "en": "I am writing a reference for Mia, who wants to be a volunteer at the animal club.",
      "es": "Escribo una referencia para Mia, que quiere ser voluntaria en el club de animales.",
      "explanationEs": "Write a reference = escribir una carta de recomendación. Volunteer = voluntario.",
      "segments": [
        "I am writing a reference for Mia, who wants",
        "to be a volunteer at the animal club."
      ],
      "audioText": "I am writing a reference for Mia, who wants to be a volunteer at the animal club.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-5"
    },
    {
      "id": "en.n4.class-50.t02",
      "en": "Mia is responsible: she always finishes her work, and she takes responsibility when something goes wrong.",
      "es": "Mia es responsable: siempre termina su trabajo y asume la responsabilidad cuando algo sale mal.",
      "explanationEs": "Responsible → responsibility. Take responsibility = asumir la responsabilidad.",
      "segments": [
        "Mia is responsible: she always finishes her work,",
        "and she takes responsibility when something goes wrong."
      ],
      "audioText": "Mia is responsible: she always finishes her work, and she takes responsibility when something goes wrong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-5"
    },
    {
      "id": "en.n4.class-50.t03",
      "en": "She is enthusiastic about every task, and her enthusiasm helps the whole group.",
      "es": "Es entusiasta con cada tarea y su entusiasmo ayuda a todo el grupo.",
      "explanationEs": "Enthusiastic about + sustantivo. Enthusiastic → enthusiasm.",
      "segments": [
        "She is enthusiastic about every task, and",
        "her enthusiasm helps the whole group."
      ],
      "audioText": "She is enthusiastic about every task, and her enthusiasm helps the whole group.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-5"
    },
    {
      "id": "en.n4.class-50.t04",
      "en": "She is good at teamwork, and she always gives support to new members.",
      "es": "Es buena en el trabajo en equipo y siempre da apoyo a los miembros nuevos.",
      "explanationEs": "Give support = dar apoyo. Good at + sustantivo.",
      "segments": [
        "She is good at teamwork, and she",
        "always gives support to new members."
      ],
      "audioText": "She is good at teamwork, and she always gives support to new members.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-5"
    },
    {
      "id": "en.n4.class-50.t05",
      "en": "For these reasons, I recommend Mia as a volunteer; I am sure she will be a great help.",
      "es": "Por estas razones, recomiendo a Mia como voluntaria; estoy segura de que será una gran ayuda.",
      "explanationEs": "Recommend + persona + as + función: así se cierra la carta.",
      "segments": [
        "For these reasons, I recommend Mia as a volunteer;",
        "I am sure she will be a great help."
      ],
      "audioText": "For these reasons, I recommend Mia as a volunteer; I am sure she will be a great help.",
