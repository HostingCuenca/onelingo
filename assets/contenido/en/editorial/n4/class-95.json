  "teaching": [
    {
      "id": "en.n4.class-95.t01",
      "en": "Good morning. I am going to present my story to the audience.",
      "es": "Buenos días. Voy a presentar mi historia al público.",
      "explanationEs": "Be going to anuncia lo que vas a hacer al abrir la presentación.",
      "segments": [
        "Good morning. I am going to",
        "present my story to the audience."
      ],
      "audioText": "Good morning. I am going to present my story to the audience.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-5"
    },
    {
      "id": "en.n4.class-95.t02",
      "en": "Someone asks a question, and I give a short answer with a reason.",
      "es": "Alguien hace una pregunta y doy una respuesta corta con una razón.",
      "explanationEs": "Respuesta corta + razón: así contestas al público.",
      "segments": [
        "Someone asks a question, and I give",
        "a short answer with a reason."
      ],
      "audioText": "Someone asks a question, and I give a short answer with a reason.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-5"
    },
    {
      "id": "en.n4.class-95.t03",
      "en": "She made a decision: she kept the camera because her grandfather had used it every summer.",
      "es": "Tomó una decisión: guardó la cámara porque su abuelo la había usado cada verano.",
      "explanationEs": "Because da la razón de una decisión; had used es un antecedente.",
      "segments": [
        "She made a decision: she kept the camera",
        "because her grandfather had used it every summer."
      ],
      "audioText": "She made a decision: she kept the camera because her grandfather had used it every summer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-5"
    },
    {
      "id": "en.n4.class-95.t04",
      "en": "The reason is simple: she decided to keep the camera.",
      "es": "La razón es simple: decidió guardar la cámara.",
      "explanationEs": "Decide + to + verbo base (no «for keep»).",
      "segments": [
        "The reason is simple: she",
        "decided to keep the camera."
      ],
      "audioText": "The reason is simple: she decided to keep the camera.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-5"
    },
    {
      "id": "en.n4.class-95.t05",
      "en": "I finish with a tag: it was a big surprise, wasn't it?",
      "es": "Termino con una coletilla: fue una gran sorpresa, ¿verdad?",
      "explanationEs": "Frase afirmativa + coletilla negativa del mismo verbo.",
      "segments": [
        "I finish with a tag: it",
        "was a big surprise, wasn't it?"
      ],
      "audioText": "I finish with a tag: it was a big surprise, wasn't it?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-5"
    },
    {
      "id": "en.n4.class-95.t06",
      "en": "The audience can agree: yes, it was.",
      "es": "El público puede estar de acuerdo: sí, lo fue.",
      "explanationEs": "La respuesta repite el verbo de la coletilla: yes, it was.",
      "segments": [
        "The audience can agree:",
        "yes, it was."
      ],
      "audioText": "The audience can agree: yes, it was.",
      "audioMode": "tts",
