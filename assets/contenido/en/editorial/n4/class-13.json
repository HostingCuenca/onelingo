  "teaching": [
    {
      "id": "en.n4.class-13.t01",
      "en": "If it is sunny tomorrow, we will have a picnic.",
      "es": "Si mañana hace sol, haremos un picnic.",
      "explanationEs": "Condición real: todavía es posible. If + presente, will.",
      "segments": [
        "If it is sunny tomorrow,",
        "we will have a picnic."
      ],
      "audioText": "If it is sunny tomorrow, we will have a picnic.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-3"
    },
    {
      "id": "en.n4.class-13.t02",
      "en": "If I won the lottery, I would buy a small house by the sea.",
      "es": "Si ganara la lotería, compraría una casita junto al mar.",
      "explanationEs": "Condición irreal en el presente: if + pasado, would. No gano la lotería.",
      "segments": [
        "If I won the lottery, I would",
        "buy a small house by the sea."
      ],
      "audioText": "If I won the lottery, I would buy a small house by the sea.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-3"
    },
    {
      "id": "en.n4.class-13.t03",
      "en": "If I had an umbrella, I would not get wet.",
      "es": "Si tuviera un paraguas, no me mojaría.",
      "explanationEs": "Irreal en el presente: hoy no tengo paraguas.",
      "segments": [
        "If I had an umbrella,",
        "I would not get wet."
      ],
      "audioText": "If I had an umbrella, I would not get wet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-3"
    },
    {
      "id": "en.n4.class-13.t04",
      "en": "If it had rained on Saturday, we would have cancelled the picnic.",
      "es": "Si hubiera llovido el sábado, habríamos cancelado el picnic.",
      "explanationEs": "Imposible en el pasado: no llovió. If + had + participio, would have + participio.",
      "segments": [
        "If it had rained on Saturday,",
        "we would have cancelled the picnic."
      ],
      "audioText": "If it had rained on Saturday, we would have cancelled the picnic.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-3"
    },
    {
      "id": "en.n4.class-13.t05",
      "en": "Winning the lottery is an unreal dream, but tomorrow's picnic is a real plan.",
      "es": "Ganar la lotería es un sueño irreal, pero el picnic de mañana es un plan real.",
      "explanationEs": "Real = puede cumplirse; unreal = solo se imagina.",
      "segments": [
        "Winning the lottery is an unreal dream,",
        "but tomorrow's picnic is a real plan."
      ],
      "audioText": "Winning the lottery is an unreal dream, but tomorrow's picnic is a real plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-3"
    }
  ],
