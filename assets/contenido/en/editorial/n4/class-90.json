  "teaching": [
    {
      "id": "en.n4.class-90.t01",
      "en": "I suggest going to the beach for the weekend.",
      "es": "Sugiero ir a la playa el fin de semana.",
      "explanationEs": "Suggest + -ing: proponer. No se dice suggest to go.",
      "segments": [
        "I suggest going to the",
        "beach for the weekend."
      ],
      "audioText": "I suggest going to the beach for the weekend.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    },
    {
      "id": "en.n4.class-90.t02",
      "en": "I would rather go to the mountains, because the beach is crowded.",
      "es": "Preferiría ir a las montañas, porque la playa está llena de gente.",
      "explanationEs": "Would rather + verbo base: tu preferencia, con su motivo.",
      "segments": [
        "I would rather go to the",
        "mountains, because the beach is crowded."
      ],
      "audioText": "I would rather go to the mountains, because the beach is crowded.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    },
    {
      "id": "en.n4.class-90.t03",
      "en": "We had better book the hostel now; the budget is small.",
      "es": "Más nos vale reservar el albergue ya; el presupuesto es pequeño.",
      "explanationEs": "Budget = presupuesto. Had better + verbo base: consejo práctico.",
      "segments": [
        "We had better book the hostel",
        "now; the budget is small."
      ],
      "audioText": "We had better book the hostel now; the budget is small.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    },
    {
      "id": "en.n4.class-90.t04",
      "en": "We are supposed to share the cost, so we can split the bill.",
      "es": "Se supone que compartimos el gasto, así que podemos dividir la cuenta.",
      "explanationEs": "Split = dividir. Sirve para repartir un gasto entre varias personas.",
      "segments": [
        "We are supposed to share the cost,",
        "so we can split the bill."
      ],
      "audioText": "We are supposed to share the cost, so we can split the bill.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    },
    {
      "id": "en.n4.class-90.t05",
      "en": "How about a deal? We go to the mountains, and you choose the hostel.",
      "es": "¿Y si hacemos un trato? Vamos a las montañas y tú eliges el albergue.",
      "explanationEs": "Deal = trato. How about a deal? abre una negociación.",
      "segments": [
        "How about a deal? We go to",
        "the mountains, and you choose the hostel."
      ],
      "audioText": "How about a deal? We go to the mountains, and you choose the hostel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    },
    {
      "id": "en.n4.class-90.t06",
      "en": "Agreed! That is the plan.",
      "es": "¡De acuerdo! Ese es el plan.",
      "explanationEs": "Agreed cierra el acuerdo. Después se puede repetir el plan.",
      "segments": [
        "Agreed! That is",
        "the plan."
      ],
      "audioText": "Agreed! That is the plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-trip-planning-advice-5"
    }
  ],
