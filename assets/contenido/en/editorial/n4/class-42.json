      "patternId": "n4-sport-and-leisure-words-2"
    },
    {
      "id": "en.n4.class-42.t02",
      "en": "Mia is good at skating, but she is afraid of climbing.",
      "es": "Mia es buena patinando, pero tiene miedo de escalar.",
