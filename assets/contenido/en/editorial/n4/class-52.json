  "teaching": [
    {
      "id": "en.n4.class-52.t01",
      "en": "How about making a poster for the picnic?",
      "es": "¿Qué tal si hacemos un cartel para el picnic?",
      "explanationEs": "How about + verbo en -ing: sugerencia en forma de pregunta.",
      "segments": [
        "How about making a",
        "poster for the picnic?"
      ],
      "audioText": "How about making a poster for the picnic?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    },
    {
      "id": "en.n4.class-52.t02",
      "en": "Why don't we have the picnic on Sunday?",
      "es": "¿Por qué no hacemos el picnic el domingo?",
      "explanationEs": "Why don't we + verbo base: otra forma de sugerir algo al grupo.",
      "segments": [
        "Why don't we have",
        "the picnic on Sunday?"
      ],
      "audioText": "Why don't we have the picnic on Sunday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    },
    {
      "id": "en.n4.class-52.t03",
      "en": "Let's make a poster before Friday.",
      "es": "Hagamos un cartel antes del viernes.",
      "explanationEs": "Let's + verbo base: propones hacer algo juntos.",
      "segments": [
        "Let's make a",
        "poster before Friday."
      ],
      "audioText": "Let's make a poster before Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    },
    {
      "id": "en.n4.class-52.t04",
      "en": "I agree with you. That is a good idea.",
      "es": "Estoy de acuerdo contigo. Es una buena idea.",
      "explanationEs": "I agree (sin be) acepta la idea; that is a good idea la valora.",
      "segments": [
        "I agree with you. That",
        "is a good idea."
      ],
      "audioText": "I agree with you. That is a good idea.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    },
    {
      "id": "en.n4.class-52.t05",
      "en": "I see your point, but I am not sure about Sunday.",
      "es": "Entiendo lo que dices, pero no estoy seguro del domingo.",
      "explanationEs": "I see your point, but… reconoce la idea antes de dudar: así discrepas con cortesía.",
      "segments": [
        "I see your point, but I",
        "am not sure about Sunday."
      ],
      "audioText": "I see your point, but I am not sure about Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    },
    {
      "id": "en.n4.class-52.t06",
      "en": "It is too hot on Sunday. How about Saturday instead?",
      "es": "El domingo hace demasiado calor. ¿Qué tal el sábado en su lugar?",
      "explanationEs": "Instead presenta la alternativa que ofreces en lugar de la primera idea.",
      "segments": [
        "It is too hot on",
        "Sunday. How about Saturday instead?"
      ],
      "audioText": "It is too hot on Sunday. How about Saturday instead?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-2"
    }
  ],
