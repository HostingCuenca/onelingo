  "teaching": [
    {
      "id": "en.n4.class-06.t01",
      "en": "When I was a child, I used to live in a small village.",
      "es": "Cuando era niño, vivía en un pueblo pequeño.",
      "explanationEs": "Used to + verbo base: un estado del pasado que ya no es verdad.",
      "segments": [
        "When I was a child, I used",
        "to live in a small village."
      ],
      "audioText": "When I was a child, I used to live in a small village.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-1"
    },
    {
      "id": "en.n4.class-06.t02",
      "en": "Now I live in a big city, and I no longer see the river every day.",
      "es": "Ahora vivo en una ciudad grande y ya no veo el río todos los días.",
      "explanationEs": "Now marca el presente; no longer = ya no, contrasta con used to.",
      "segments": [
        "Now I live in a big city, and",
        "I no longer see the river every day."
      ],
      "audioText": "Now I live in a big city, and I no longer see the river every day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-1"
    },
    {
      "id": "en.n4.class-06.t03",
      "en": "We used to play games in the street every afternoon.",
      "es": "Jugábamos en la calle todas las tardes.",
      "explanationEs": "Used to también expresa un hábito: algo que se repetía y ya no ocurre.",
      "segments": [
        "We used to play games",
        "in the street every afternoon."
      ],
      "audioText": "We used to play games in the street every afternoon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-1"
    },
    {
      "id": "en.n4.class-06.t04",
      "en": "Leo used to be shy, but now he loves talking to people.",
      "es": "Leo era tímido, pero ahora le encanta hablar con la gente.",
      "explanationEs": "Used to be + adjetivo: cómo era alguien antes; but now marca el cambio.",
      "segments": [
        "Leo used to be shy, but",
        "now he loves talking to people."
      ],
      "audioText": "Leo used to be shy, but now he loves talking to people.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-1"
    },
    {
      "id": "en.n4.class-06.t05",
      "en": "Our childhood was simple: we did not use to have phones.",
      "es": "Nuestra infancia era sencilla: no teníamos teléfonos.",
      "explanationEs": "En negativa se dice did not use to (sin d): did ya marca el pasado.",
      "segments": [
        "Our childhood was simple: we did",
        "not use to have phones."
      ],
      "audioText": "Our childhood was simple: we did not use to have phones.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-1"
    },
    {
      "id": "en.n4.class-06.t06",
      "en": "Mia did not use to like fish, but now she eats it every week.",
      "es": "A Mia no le gustaba el pescado, pero ahora lo come cada semana.",
      "explanationEs": "Did not use to + verbo base: un gusto del pasado que cambió; now marca el presente.",
      "segments": [
        "Mia did not use to like fish,",
        "but now she eats it every week."
