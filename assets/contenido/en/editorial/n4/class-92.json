  "teaching": [
    {
      "id": "en.n4.class-92.t01",
      "en": "Before the storm arrived, Leo had closed all the windows.",
      "es": "Antes de que llegara la tormenta, Leo había cerrado todas las ventanas.",
      "explanationEs": "Had + participio: una acción anterior a otro hecho pasado.",
      "segments": [
        "Before the storm arrived, Leo",
        "had closed all the windows."
      ],
      "audioText": "Before the storm arrived, Leo had closed all the windows.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-2"
    },
    {
      "id": "en.n4.class-92.t02",
      "en": "It was a family habit: we used to sing in the car.",
      "es": "Era una costumbre familiar: solíamos cantar en el coche.",
      "explanationEs": "Used to + verbo base: una costumbre pasada que ya no existe.",
      "segments": [
        "It was a family habit: we",
        "used to sing in the car."
      ],
      "audioText": "It was a family habit: we used to sing in the car.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-2"
    },
    {
      "id": "en.n4.class-92.t03",
      "en": "Mia feels a small regret: if she had taken her umbrella, she would have stayed dry.",
      "es": "Mia siente un pequeño arrepentimiento: si hubiera llevado su paraguas, se habría mantenido seca.",
      "explanationEs": "Tercer condicional: if + had + participio, would have + participio.",
      "segments": [
        "Mia feels a small regret: if she had",
        "taken her umbrella, she would have stayed dry."
      ],
      "audioText": "Mia feels a small regret: if she had taken her umbrella, she would have stayed dry.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-2"
    },
    {
      "id": "en.n4.class-92.t04",
      "en": "The neighbour who found the key gave it back to Leo.",
      "es": "El vecino que encontró la llave se la devolvió a Leo.",
      "explanationEs": "Who da información sobre una persona (which, sobre una cosa).",
      "segments": [
        "The neighbour who found the key",
        "gave it back to Leo."
      ],
      "audioText": "The neighbour who found the key gave it back to Leo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-2"
    },
    {
      "id": "en.n4.class-92.t05",
      "en": "Mia told us that she had forgotten her umbrella.",
      "es": "Mia nos dijo que había olvidado su paraguas.",
      "explanationEs": "Told + persona + that: el verbo retrocede un paso (forgot → had forgotten).",
      "segments": [
        "Mia told us that she",
        "had forgotten her umbrella."
      ],
      "audioText": "Mia told us that she had forgotten her umbrella.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-2"
    }
  ],
