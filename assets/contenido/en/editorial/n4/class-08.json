    {
      "id": "en.n4.class-08.t01",
      "en": "We would always eat together on Sundays.",
      "es": "Siempre comíamos juntos los domingos.",
      "explanationEs": "Would + always: un hábito que se repetía.",
      "segments": [
        "We would always eat",
        "together on Sundays."
      ],
      "audioText": "We would always eat together on Sundays.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-3"
    },
    {
      "id": "en.n4.class-08.t02",
      "en": "I used to write in my diary every night.",
      "es": "Yo solía escribir en mi diario cada noche.",
      "explanationEs": "Used to + every night: otro hábito del pasado.",
      "segments": [
        "I used to write in",
        "my diary every night."
      ],
      "audioText": "I used to write in my diary every night.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-3"
    },
    {
      "id": "en.n4.class-08.t03",
      "en": "Usually, my father picked me up from school.",
      "es": "Normalmente, mi padre me recogía del colegio.",
      "explanationEs": "Usually + pasado simple también puede expresar un hábito.",
      "segments": [
        "Usually, my father picked",
        "me up from school."
      ],
      "audioText": "Usually, my father picked me up from school.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-3"
    },
    {
      "id": "en.n4.class-08.t04",
      "en": "While I was walking to school, it started to rain.",
      "es": "Mientras caminaba al colegio, empezó a llover.",
      "explanationEs": "While + was walking: la escena en progreso; started es el hecho que ocurre dentro.",
      "segments": [
        "While I was walking to",
        "school, it started to rain."
      ],
      "audioText": "While I was walking to school, it started to rain.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-3"
    },
    {
      "id": "en.n4.class-08.t05",
      "en": "Suddenly, a big dog ran in front of me.",
      "es": "De repente, un perro grande corrió delante de mí.",
      "explanationEs": "Suddenly + pasado simple: un hecho puntual, ocurrió una sola vez.",
      "segments": [
        "Suddenly, a big dog ran",
        "in front of me."
      ],
      "audioText": "Suddenly, a big dog ran in front of me.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-memories-past-habits-3"
    },
    {
      "id": "en.n4.class-08.t06",
      "en": "One day, I found an old photo in my diary, and it was a happy memory.",
      "es": "Un día encontré una foto vieja en mi diario y era un recuerdo feliz.",
      "explanationEs": "One day + pasado simple: un hecho que ocurrió una vez.",
      "segments": [
