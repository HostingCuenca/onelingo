  "teaching": [
    {
      "id": "en.n4.class-96.t01",
      "en": "This case is about an exchange trip to Canada.",
      "es": "Este caso trata de un viaje de intercambio a Canadá.",
      "explanationEs": "Case = la situación real que analizas.",
      "segments": [
        "This case is about an",
        "exchange trip to Canada."
      ],
      "audioText": "This case is about an exchange trip to Canada.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    },
    {
      "id": "en.n4.class-96.t02",
      "en": "A fact can be checked: Mia's suitcase did not arrive.",
      "es": "Un hecho se puede comprobar: la maleta de Mia no llegó.",
      "explanationEs": "Hecho: algo que se puede verificar, sin opinión.",
      "segments": [
        "A fact can be checked:",
        "Mia's suitcase did not arrive."
      ],
      "audioText": "A fact can be checked: Mia's suitcase did not arrive.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    },
    {
      "id": "en.n4.class-96.t03",
      "en": "The host family must have waited at the wrong gate, because nobody met Mia.",
      "es": "La familia anfitriona debió de esperar en la puerta equivocada, porque nadie recibió a Mia.",
      "explanationEs": "Must have + participio: deducción casi segura sobre el pasado, con una razón.",
      "segments": [
        "The host family must have waited at",
        "the wrong gate, because nobody met Mia."
      ],
      "audioText": "The host family must have waited at the wrong gate, because nobody met Mia.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    },
    {
      "id": "en.n4.class-96.t04",
      "en": "The evidence is the message: it gave the wrong gate, so the conclusion is easy.",
      "es": "La prueba es el mensaje: daba la puerta equivocada, así que la conclusión es fácil.",
      "explanationEs": "Evidence respalda la conclusión que sacas.",
      "segments": [
        "The evidence is the message: it gave the",
        "wrong gate, so the conclusion is easy."
      ],
      "audioText": "The evidence is the message: it gave the wrong gate, so the conclusion is easy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    },
    {
      "id": "en.n4.class-96.t05",
      "en": "In my opinion, the trip was great, although the first day was difficult.",
      "es": "En mi opinión, el viaje fue genial, aunque el primer día fue difícil.",
      "explanationEs": "In my opinion marca lo que piensa alguien; no se puede comprobar.",
      "segments": [
        "In my opinion, the trip was great,",
        "although the first day was difficult."
      ],
      "audioText": "In my opinion, the trip was great, although the first day was difficult.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    },
    {
      "id": "en.n4.class-96.t06",
      "en": "The evidence shows that Mia can't have lost the message: it is still on her phone.",
      "es": "La prueba muestra que Mia no puede haber perdido el mensaje: sigue en su teléfono.",
      "explanationEs": "Can't have + participio: deducción casi segura de que algo no pasó.",
      "segments": [
        "The evidence shows that Mia can't have lost",
        "the message: it is still on her phone."
      ],
      "audioText": "The evidence shows that Mia can't have lost the message: it is still on her phone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-1"
    }
