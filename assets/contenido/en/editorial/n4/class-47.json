  "teaching": [
    {
      "id": "en.n4.class-47.t01",
      "en": "Sara is very helpful; she helps everyone at the club.",
      "es": "Sara es muy servicial; ayuda a todos en el club.",
      "explanationEs": "Help + -ful = lleno de ayuda: servicial.",
      "segments": [
        "Sara is very helpful; she",
        "helps everyone at the club."
      ],
      "audioText": "Sara is very helpful; she helps everyone at the club.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    },
    {
      "id": "en.n4.class-47.t02",
      "en": "The lost dog looked helpless and sad.",
      "es": "El perro perdido parecía indefenso y triste.",
      "explanationEs": "Help + -less = sin ayuda: indefenso.",
      "segments": [
        "The lost dog looked",
        "helpless and sad."
      ],
      "audioText": "The lost dog looked helpless and sad.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    },
    {
      "id": "en.n4.class-47.t03",
      "en": "Her sadness disappeared when her friends arrived.",
      "es": "Su tristeza desapareció cuando llegaron sus amigos.",
      "explanationEs": "Sad + -ness = sustantivo: sadness.",
      "segments": [
        "Her sadness disappeared when",
        "her friends arrived."
      ],
      "audioText": "Her sadness disappeared when her friends arrived.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    },
    {
      "id": "en.n4.class-47.t04",
      "en": "Tom is reliable, but his cousin is unreliable and often forgets.",
      "es": "Tom es fiable, pero su primo es poco fiable y a menudo olvida cosas.",
      "explanationEs": "Un- + reliable = lo contrario. Reliable = rely + -able: «en quien se puede confiar».",
      "segments": [
        "Tom is reliable, but his cousin",
        "is unreliable and often forgets."
      ],
      "audioText": "Tom is reliable, but his cousin is unreliable and often forgets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    },
    {
      "id": "en.n4.class-47.t05",
      "en": "It is impolite to arrive late, but polite people always say sorry.",
      "es": "Es descortés llegar tarde, pero las personas educadas siempre piden perdón.",
      "explanationEs": "Im- + polite = lo contrario; im- va antes de p.",
      "segments": [
        "It is impolite to arrive late,",
        "but polite people always say sorry."
      ],
      "audioText": "It is impolite to arrive late, but polite people always say sorry.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    },
    {
      "id": "en.n4.class-47.t06",
      "en": "Mia has a lot of creativity; she is creative with paper and colours.",
      "es": "Mia tiene mucha creatividad; es creativa con el papel y los colores.",
      "explanationEs": "Creative (adjetivo) → creativity (sustantivo con -ity).",
      "segments": [
        "Mia has a lot of creativity; she",
        "is creative with paper and colours."
      ],
      "audioText": "Mia has a lot of creativity; she is creative with paper and colours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-2"
    }
