  "teaching": [
    {
      "id": "en.n4.class-23.t01",
      "en": "First, the straw is cut and dried in the sun.",
      "es": "Primero, la paja se corta y se seca al sol.",
      "explanationEs": "First abre la secuencia; dos participios (cut, dried) comparten un solo is.",
      "segments": [
        "First, the straw is cut",
        "and dried in the sun."
      ],
      "audioText": "First, the straw is cut and dried in the sun.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    },
    {
      "id": "en.n4.class-23.t02",
      "en": "Then the straw is woven by an artisan.",
      "es": "Luego la paja la teje un artesano.",
      "explanationEs": "By + artesano aporta un dato útil: quién sabe hacer este paso.",
      "segments": [
        "Then the straw is",
        "woven by an artisan."
      ],
      "audioText": "Then the straw is woven by an artisan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    },
    {
      "id": "en.n4.class-23.t03",
      "en": "After that, the hat is shaped on a wooden form and pressed with a hot iron.",
      "es": "Después, al sombrero se le da forma en una horma de madera y se plancha con una plancha caliente.",
      "explanationEs": "After that marca el paso siguiente; las dos pasivas ocurren en ese orden.",
      "segments": [
        "After that, the hat is shaped on a",
        "wooden form and pressed with a hot iron."
      ],
      "audioText": "After that, the hat is shaped on a wooden form and pressed with a hot iron.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    },
    {
      "id": "en.n4.class-23.t04",
      "en": "Before the hat is sold, it is checked twice.",
      "es": "Antes de venderse, el sombrero se revisa dos veces.",
      "explanationEs": "Con before, lo que se nombra primero ocurre después: se revisa y luego se vende.",
      "segments": [
        "Before the hat is sold,",
        "it is checked twice."
      ],
      "audioText": "Before the hat is sold, it is checked twice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    },
    {
      "id": "en.n4.class-23.t05",
      "en": "Finally, the hat is wrapped and sold at the market.",
      "es": "Por último, el sombrero se envuelve y se vende en el mercado.",
      "explanationEs": "Finally cierra el proceso: es el último paso.",
      "segments": [
        "Finally, the hat is wrapped",
        "and sold at the market."
      ],
      "audioText": "Finally, the hat is wrapped and sold at the market.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    },
    {
      "id": "en.n4.class-23.t06",
      "en": "Each step is done carefully by hand.",
      "es": "Cada paso se hace con cuidado y a mano.",
      "explanationEs": "By hand dice cómo se hace, no quién; por eso no es un agente.",
      "segments": [
        "Each step is done",
        "carefully by hand."
      ],
      "audioText": "Each step is done carefully by hand.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-3"
    }
  ],
