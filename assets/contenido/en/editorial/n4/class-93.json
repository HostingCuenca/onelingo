  "teaching": [
    {
      "id": "en.n4.class-93.t01",
      "en": "Each speaker tells a different version of the story with his or her own voice.",
      "es": "Cada hablante cuenta una versión distinta de la historia con su propia voz.",
      "explanationEs": "Each + singular: cada hablante aporta su propia versión.",
      "segments": [
        "Each speaker tells a different version of the",
        "story with his or her own voice."
      ],
      "audioText": "Each speaker tells a different version of the story with his or her own voice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-3"
    },
    {
      "id": "en.n4.class-93.t02",
      "en": "Mia says that she closed the gate before dinner.",
      "es": "Mia dice que ella cerró el portón antes de la cena.",
      "explanationEs": "Says that + oración: lo que cuenta Mia. Su «I» pasa a she.",
      "segments": [
        "Mia says that she closed",
        "the gate before dinner."
      ],
      "audioText": "Mia says that she closed the gate before dinner.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-3"
    },
    {
      "id": "en.n4.class-93.t03",
      "en": "Leo can't remember the time, but he saw one detail: the gate was open.",
      "es": "Leo no recuerda la hora, pero vio un detalle: el portón estaba abierto.",
      "explanationEs": "Un detalle concreto sirve para comparar versiones.",
      "segments": [
        "Leo can't remember the time, but he",
        "saw one detail: the gate was open."
      ],
      "audioText": "Leo can't remember the time, but he saw one detail: the gate was open.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-3"
    },
    {
      "id": "en.n4.class-93.t04",
      "en": "I agree with Leo: I saw Rex in the street at six.",
      "es": "Estoy de acuerdo con Leo: vi a Rex en la calle a las seis.",
      "explanationEs": "I = quien habla. Agree no lleva am: «estoy de acuerdo» es I agree.",
      "segments": [
        "I agree with Leo: I saw",
        "Rex in the street at six."
      ],
      "audioText": "I agree with Leo: I saw Rex in the street at six.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-3"
    },
    {
      "id": "en.n4.class-93.t05",
      "en": "Mia does not agree with Sara about the time.",
      "es": "Mia no está de acuerdo con Sara sobre la hora.",
      "explanationEs": "Agree with + persona: dos hablantes pueden contradecirse.",
      "segments": [
        "Mia does not agree with",
        "Sara about the time."
      ],
      "audioText": "Mia does not agree with Sara about the time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-3"
    }
  ],
