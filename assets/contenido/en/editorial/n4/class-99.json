  "teaching": [
    {
      "id": "en.n4.class-99.t01",
      "en": "Dear Ms Lopez, I am writing to explain a problem with our exchange trip.",
      "es": "Estimada Sra. López, le escribo para explicar un problema con nuestro viaje de intercambio.",
      "explanationEs": "Saludo formal + I am writing to + verbo: así se abre el mensaje.",
      "segments": [
        "Dear Ms Lopez, I am writing to",
        "explain a problem with our exchange trip."
      ],
      "audioText": "Dear Ms Lopez, I am writing to explain a problem with our exchange trip.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-4"
    },
    {
      "id": "en.n4.class-99.t02",
      "en": "When we arrived, the host family had not received our message.",
      "es": "Cuando llegamos, la familia anfitriona no había recibido nuestro mensaje.",
      "explanationEs": "Narración: pasado simple y had + participio para lo anterior.",
      "segments": [
        "When we arrived, the host family",
        "had not received our message."
      ],
      "audioText": "When we arrived, the host family had not received our message.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-4"
    },
    {
      "id": "en.n4.class-99.t03",
      "en": "If the school had called earlier, we would have found a solution.",
      "es": "Si el colegio hubiera llamado antes, habríamos encontrado una solución.",
      "explanationEs": "If + had + participio, would have + participio: cómo se habría evitado el problema.",
      "segments": [
        "If the school had called earlier,",
        "we would have found a solution."
      ],
      "audioText": "If the school had called earlier, we would have found a solution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-4"
    },
    {
      "id": "en.n4.class-99.t04",
      "en": "Could you please replace the lost ticket?",
      "es": "¿Podría reemplazar el billete perdido, por favor?",
      "explanationEs": "Could you please + verbo: petición educada.",
      "segments": [
        "Could you please replace",
        "the lost ticket?"
      ],
      "audioText": "Could you please replace the lost ticket?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-4"
    },
    {
      "id": "en.n4.class-99.t05",
      "en": "I would appreciate it if you could arrange a refund.",
      "es": "Le agradecería que pudiera organizar un reembolso.",
      "explanationEs": "I would appreciate it if you could + verbo: muy formal.",
      "segments": [
        "I would appreciate it if",
        "you could arrange a refund."
      ],
      "audioText": "I would appreciate it if you could arrange a refund.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-4"
    },
    {
      "id": "en.n4.class-99.t06",
      "en": "Thank you for your time. Sincerely, Mia.",
      "es": "Gracias por su tiempo. Atentamente, Mia.",
