  "teaching": [
    {
      "id": "en.n4.class-81.t01",
      "en": "The mayor announced that the new bridge will open on Monday.",
      "es": "El alcalde anunció que el nuevo puente abrirá el lunes.",
      "explanationEs": "Announced + una fuente oficial: es un hecho confirmado, sin marca de cautela.",
      "segments": [
        "The mayor announced that the new",
        "bridge will open on Monday."
      ],
      "audioText": "The mayor announced that the new bridge will open on Monday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    },
    {
      "id": "en.n4.class-81.t02",
      "en": "Apparently, the old market will close in June.",
      "es": "Al parecer, el mercado viejo cerrará en junio.",
      "explanationEs": "Apparently = al parecer. Va al inicio, con coma: la noticia no está comprobada.",
      "segments": [
        "Apparently, the old market",
        "will close in June."
      ],
      "audioText": "Apparently, the old market will close in June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    },
    {
      "id": "en.n4.class-81.t03",
      "en": "Reportedly, the football coach is staying in a hotel near the station.",
      "es": "Según se informa, el entrenador de fútbol se aloja en un hotel cerca de la estación.",
      "explanationEs": "Reportedly: alguien lo ha contado, pero no hay confirmación oficial.",
      "segments": [
        "Reportedly, the football coach is staying",
        "in a hotel near the station."
      ],
      "audioText": "Reportedly, the football coach is staying in a hotel near the station.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    },
    {
      "id": "en.n4.class-81.t04",
      "en": "It seems that the festival is cancelled because of the storm.",
      "es": "Parece que el festival está cancelado por la tormenta.",
      "explanationEs": "It seems that + oración completa: parece que. Quien habla no lo asegura.",
      "segments": [
        "It seems that the festival is",
        "cancelled because of the storm."
      ],
      "audioText": "It seems that the festival is cancelled because of the storm.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    },
    {
      "id": "en.n4.class-81.t05",
      "en": "The team may play tonight, but the coach has not confirmed it.",
      "es": "Puede que el equipo juegue esta noche, pero el entrenador no lo ha confirmado.",
      "explanationEs": "May + verbo base expresa posibilidad. Confirmed indica justo lo que falta.",
      "segments": [
        "The team may play tonight, but",
        "the coach has not confirmed it."
      ],
      "audioText": "The team may play tonight, but the coach has not confirmed it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    },
    {
      "id": "en.n4.class-81.t06",
      "en": "A rumour is not official news: the police have not said anything.",
      "es": "Un rumor no es una noticia oficial: la policía no ha dicho nada.",
      "explanationEs": "Rumour = rumor. Circula sin que ninguna fuente oficial lo confirme.",
      "segments": [
        "A rumour is not official news:",
        "the police have not said anything."
      ],
      "audioText": "A rumour is not official news: the police have not said anything.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-1"
    }
