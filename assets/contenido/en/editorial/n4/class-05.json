  "teaching": [
    {
      "id": "en.n4.class-05.t01",
      "en": "There was a misunderstanding: I thought you had forgotten the plan.",
      "es": "Hubo un malentendido: pensé que habías olvidado el plan.",
      "explanationEs": "Thought + had + participio: lo que creías que ya había pasado.",
      "segments": [
        "There was a misunderstanding: I thought",
        "you had forgotten the plan."
      ],
      "audioText": "There was a misunderstanding: I thought you had forgotten the plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-5"
    },
    {
      "id": "en.n4.class-05.t02",
      "en": "I apologise: I had not read your message before the meeting.",
      "es": "Me disculpo: no había leído tu mensaje antes de la reunión.",
      "explanationEs": "Had not + participio: algo que todavía no había pasado.",
      "segments": [
        "I apologise: I had not read",
        "your message before the meeting."
      ],
      "audioText": "I apologise: I had not read your message before the meeting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-5"
    },
    {
      "id": "en.n4.class-05.t03",
      "en": "I had not forgotten the plan; my phone had stopped working.",
      "es": "No había olvidado el plan; mi teléfono había dejado de funcionar.",
      "explanationEs": "Had + participio explica la verdadera causa del malentendido.",
      "segments": [
        "I had not forgotten the plan;",
        "my phone had stopped working."
      ],
      "audioText": "I had not forgotten the plan; my phone had stopped working.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-5"
    },
    {
      "id": "en.n4.class-05.t04",
      "en": "I suggest we meet on Saturday instead.",
      "es": "Propongo que quedemos el sábado en su lugar.",
      "explanationEs": "Suggest + sujeto + verbo base: sin to ni -ing; instead = en su lugar.",
      "segments": [
        "I suggest we meet",
        "on Saturday instead."
      ],
      "audioText": "I suggest we meet on Saturday instead.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-5"
    },
    {
      "id": "en.n4.class-05.t05",
      "en": "Sara thought I had cancelled the plan, but I had only moved it to Sunday.",
      "es": "Sara pensó que yo había cancelado el plan, pero solo lo había pasado al domingo.",
      "explanationEs": "Dos past perfect seguidos: lo que ella creía y lo que realmente había pasado.",
      "segments": [
        "Sara thought I had cancelled the plan, but",
        "I had only moved it to Sunday."
      ],
      "audioText": "Sara thought I had cancelled the plan, but I had only moved it to Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-5"
    }
