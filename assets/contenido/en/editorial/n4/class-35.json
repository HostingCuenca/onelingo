      ],
      "audioText": "I listened to the voice message in our group chat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-5"
    },
    {
      "id": "en.n4.class-35.t02",
      "en": "Mia says that the match is on Sunday.",
      "es": "Mia dice que el partido es el domingo.",
      "explanationEs": "Con says, en presente, no hay retroceso: el dato sigue siendo válido.",
      "segments": [
        "Mia says that the",
        "match is on Sunday."
      ],
      "audioText": "Mia says that the match is on Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-5"
    },
    {
      "id": "en.n4.class-35.t03",
      "en": "She also asks if you can bring a ball.",
      "es": "También pregunta si puedes llevar un balón.",
      "explanationEs": "Con asks + if, la pregunta sigue pendiente: can no retrocede.",
      "segments": [
