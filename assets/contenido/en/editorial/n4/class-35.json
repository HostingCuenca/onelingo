    {
      "id": "en.n4.class-35.t01",
      "en": "I listened to the voice message in our group chat.",
      "es": "Escuché el mensaje de voz de nuestro chat de grupo.",
      "explanationEs": "Empieza diciendo de qué mensaje hablas y dónde lo oíste.",
