      "patternId": "n4-trip-planning-advice-2"
    },
    {
      "id": "en.n4.class-87.t02",
      "en": "I would rather stay in a hostel than in a hotel.",
      "es": "Preferiría alojarme en un albergue que en un hotel.",
      "explanationEs": "Would rather + verbo base: preferencia. Se compara con than.",
