  "teaching": [
    {
      "id": "en.n4.class-76.t01",
      "en": "Both festivals have a big parade.",
      "es": "Los dos festivales tienen un gran desfile.",
      "explanationEs": "Both + sustantivo plural + verbo plural: «los dos».",
      "segments": [
        "Both festivals have",
        "a big parade."
      ],
      "audioText": "Both festivals have a big parade.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    },
    {
      "id": "en.n4.class-76.t02",
      "en": "Neither festival is expensive.",
      "es": "Ninguno de los dos festivales es caro.",
      "explanationEs": "Neither ya es negativo: el verbo va en afirmativo (is, no isn't).",
      "segments": [
        "Neither festival",
        "is expensive."
      ],
      "audioText": "Neither festival is expensive.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    },
    {
      "id": "en.n4.class-76.t03",
      "en": "You can wear either costume to the party.",
      "es": "Puedes llevar cualquiera de los dos disfraces a la fiesta.",
      "explanationEs": "Either + sustantivo singular: uno u otro, a elegir.",
      "segments": [
        "You can wear either",
        "costume to the party."
      ],
      "audioText": "You can wear either costume to the party.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    },
    {
      "id": "en.n4.class-76.t04",
      "en": "You can see the parade on either Saturday or Sunday.",
      "es": "Puedes ver el desfile el sábado o el domingo, como prefieras.",
      "explanationEs": "Either… or… presenta dos opciones posibles.",
      "segments": [
        "You can see the parade",
        "on either Saturday or Sunday."
      ],
      "audioText": "You can see the parade on either Saturday or Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    },
    {
      "id": "en.n4.class-76.t05",
      "en": "I love this tradition. — So do I.",
      "es": "Me encanta esta tradición. — A mí también.",
      "explanationEs": "So + auxiliar + I: «yo también» tras una frase afirmativa; do repite el auxiliar de love.",
      "segments": [
        "I love this tradition.",
        "— So do I."
      ],
      "audioText": "I love this tradition. — So do I.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    },
    {
      "id": "en.n4.class-76.t06",
      "en": "I don't celebrate it. — Neither do I.",
      "es": "Yo no lo celebro. — Yo tampoco.",
      "explanationEs": "Neither + auxiliar + I: «yo tampoco» tras una frase negativa.",
      "segments": [
        "I don't celebrate it.",
        "— Neither do I."
      ],
      "audioText": "I don't celebrate it. — Neither do I.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-culture-and-traditions-1"
    }
