  "teaching": [
    {
      "id": "en.n4.class-31.t01",
      "en": "Mia asked me where I lived.",
      "es": "Mia me preguntó dónde vivía.",
      "explanationEs": "Con where, la pregunta conserva la palabra interrogativa y sigue sujeto + verbo: sin did.",
      "segments": [
        "Mia asked me",
        "where I lived."
      ],
      "audioText": "Mia asked me where I lived.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-1"
    },
    {
      "id": "en.n4.class-31.t02",
      "en": "Tom asked if I was hungry.",
      "es": "Tom preguntó si yo tenía hambre.",
      "explanationEs": "Una pregunta de sí o no se transmite con if; el verbo va después del sujeto.",
      "segments": [
        "Tom asked if",
        "I was hungry."
      ],
      "audioText": "Tom asked if I was hungry.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-1"
    },
    {
      "id": "en.n4.class-31.t03",
      "en": "Sara wondered whether the bus was late.",
      "es": "Sara se preguntó si el autobús llegaba tarde.",
      "explanationEs": "Whether también significa «si»; es frecuente con wondered.",
      "segments": [
        "Sara wondered whether the",
        "bus was late."
      ],
      "audioText": "Sara wondered whether the bus was late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-1"
    },
    {
      "id": "en.n4.class-31.t04",
      "en": "Leo asked what time the film started.",
      "es": "Leo preguntó a qué hora empezaba la película.",
      "explanationEs": "What time se mantiene; después viene sujeto + verbo, sin did.",
      "segments": [
        "Leo asked what time",
        "the film started."
      ],
      "audioText": "Leo asked what time the film started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-1"
    },
    {
      "id": "en.n4.class-31.t05",
      "en": "Ana asked if the library was open.",
      "es": "Ana preguntó si la biblioteca estaba abierta.",
      "explanationEs": "Is pasa a was: el tiempo retrocede al contar la pregunta.",
      "segments": [
        "Ana asked if the",
        "library was open."
      ],
      "audioText": "Ana asked if the library was open.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-1"
    }
  ],
