  "teaching": [
    {
      "id": "en.n4.class-91.t01",
      "en": "The song tells the story of a girl and her grandfather.",
      "es": "La canción cuenta la historia de una niña y su abuelo.",
      "explanationEs": "Personajes: ¿quién aparece? Aquí, a girl y her grandfather.",
      "segments": [
        "The song tells the story of",
        "a girl and her grandfather."
      ],
      "audioText": "The song tells the story of a girl and her grandfather.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-1"
    },
    {
      "id": "en.n4.class-91.t02",
      "en": "In the first verse, the girl was never lonely because her grandfather sang every evening.",
      "es": "En la primera estrofa, la niña nunca se sentía sola porque su abuelo cantaba cada tarde.",
      "explanationEs": "Sentimiento (was never lonely) + razón (because…).",
      "segments": [
        "In the first verse, the girl was never",
        "lonely because her grandfather sang every evening."
      ],
      "audioText": "In the first verse, the girl was never lonely because her grandfather sang every evening.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-1"
    },
    {
      "id": "en.n4.class-91.t03",
      "en": "The chorus repeats the main feeling: the girl misses the river.",
      "es": "El estribillo repite el sentimiento principal: la niña echa de menos el río.",
      "explanationEs": "El estribillo suele repetir la idea central de la canción.",
      "segments": [
        "The chorus repeats the main feeling:",
        "the girl misses the river."
      ],
      "audioText": "The chorus repeats the main feeling: the girl misses the river.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-1"
    },
    {
      "id": "en.n4.class-91.t04",
      "en": "The girl is the main character. She likes to sing by the river, and it is part of her memory.",
      "es": "La niña es el personaje principal. Le gusta cantar junto al río, y este es parte de su recuerdo.",
      "explanationEs": "Main character = personaje principal; memory = recuerdo.",
      "segments": [
        "The girl is the main character. She likes to sing",
        "by the river, and it is part of her memory."
      ],
      "audioText": "The girl is the main character. She likes to sing by the river, and it is part of her memory.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-1"
    },
    {
      "id": "en.n4.class-91.t05",
      "en": "Finally, she found his old letter and felt proud.",
      "es": "Por último, encontró su vieja carta y se sintió orgullosa.",
      "explanationEs": "Finally marca el último hecho; felt proud, el sentimiento final.",
      "segments": [
        "Finally, she found his old",
        "letter and felt proud."
      ],
      "audioText": "Finally, she found his old letter and felt proud.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-story-project-1"
    }
  ],
