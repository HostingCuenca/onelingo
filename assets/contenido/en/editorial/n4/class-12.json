  "teaching": [
    {
      "id": "en.n4.class-12.t01",
      "en": "If I had known about the concert, I would have bought a ticket.",
      "es": "Si hubiera sabido lo del concierto, habría comprado una entrada.",
      "explanationEs": "If + had + participio (known) en la condición; would have + participio (bought) en el resultado.",
      "segments": [
        "If I had known about the concert,",
        "I would have bought a ticket."
      ],
      "audioText": "If I had known about the concert, I would have bought a ticket.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-2"
    },
    {
      "id": "en.n4.class-12.t02",
      "en": "If she had studied harder, she would have passed the exam.",
      "es": "Si hubiera estudiado más, habría aprobado el examen.",
      "explanationEs": "Ambas partes miran al pasado: no estudió y no aprobó.",
      "segments": [
        "If she had studied harder, she",
        "would have passed the exam."
      ],
      "audioText": "If she had studied harder, she would have passed the exam.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-2"
    },
    {
      "id": "en.n4.class-12.t03",
      "en": "We would not have been late if we had taken the early bus.",
      "es": "No habríamos llegado tarde si hubiéramos tomado el autobús temprano.",
      "explanationEs": "Si el resultado va primero, no se pone coma. Negativa: would not have.",
      "segments": [
        "We would not have been late if",
        "we had taken the early bus."
      ],
      "audioText": "We would not have been late if we had taken the early bus.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-2"
    },
    {
      "id": "en.n4.class-12.t04",
      "en": "What would you have done if you had lost your passport?",
      "es": "¿Qué habrías hecho si hubieras perdido tu pasaporte?",
      "explanationEs": "En preguntas: What would you have + participio…?",
      "segments": [
        "What would you have done if",
        "you had lost your passport?"
      ],
      "audioText": "What would you have done if you had lost your passport?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-2"
    },
    {
      "id": "en.n4.class-12.t05",
      "en": "If they had not forgotten the map, they would have arrived earlier.",
      "es": "Si no hubieran olvidado el mapa, habrían llegado antes.",
      "explanationEs": "La condición negativa lleva had not + participio.",
      "segments": [
        "If they had not forgotten the",
        "map, they would have arrived earlier."
      ],
      "audioText": "If they had not forgotten the map, they would have arrived earlier.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-regrets-and-wishes-2"
    }
  ],
