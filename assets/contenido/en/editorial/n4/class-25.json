  "teaching": [
    {
      "id": "en.n4.class-25.t01",
      "en": "This local product is made by hand from straw.",
      "es": "Este producto local se hace a mano con paja.",
      "explanationEs": "Is made by hand explica el proceso; by hand dice cómo, no quién.",
      "segments": [
        "This local product is made",
        "by hand from straw."
      ],
      "audioText": "This local product is made by hand from straw.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-5"
    },
    {
      "id": "en.n4.class-25.t02",
      "en": "The history of this product is long: it has been made here for a hundred years.",
      "es": "La historia de este producto es larga: se hace aquí desde hace cien años.",
      "explanationEs": "Has been made + for: algo que empezó en el pasado y sigue hoy.",
      "segments": [
        "The history of this product is long: it",
        "has been made here for a hundred years."
      ],
      "audioText": "The history of this product is long: it has been made here for a hundred years.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-5"
    },
    {
      "id": "en.n4.class-25.t03",
      "en": "A visitor can see how each hat is woven and pressed.",
      "es": "Un visitante puede ver cómo se teje y se plancha cada sombrero.",
      "explanationEs": "After how, la pasiva sigue el orden normal: each hat is woven.",
      "segments": [
        "A visitor can see how each",
        "hat is woven and pressed."
      ],
      "audioText": "A visitor can see how each hat is woven and pressed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-5"
    },
    {
      "id": "en.n4.class-25.t04",
      "en": "It is sold at the local market on Saturdays.",
      "es": "Se vende en el mercado local los sábados.",
      "explanationEs": "Dónde se compra: is sold at + lugar. Local va antes del nombre.",
      "segments": [
        "It is sold at the",
        "local market on Saturdays."
      ],
      "audioText": "It is sold at the local market on Saturdays.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-5"
    },
    {
      "id": "en.n4.class-25.t05",
      "en": "My advice is to buy it from an artisan, and it must be kept dry.",
      "es": "Mi consejo es comprarlo a un artesano, y debe mantenerse seco.",
      "explanationEs": "Must be kept es un modal pasivo: expresa una obligación.",
      "segments": [
        "My advice is to buy it from an",
        "artisan, and it must be kept dry."
      ],
      "audioText": "My advice is to buy it from an artisan, and it must be kept dry.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-how-things-are-made-5"
    },
    {
      "id": "en.n4.class-25.t06",
      "en": "I recommend it as a souvenir because it is made by hand.",
      "es": "Lo recomiendo como recuerdo porque está hecho a mano.",
      "explanationEs": "I recommend + motivo con because; el motivo usa pasiva.",
      "segments": [
