  "teaching": [
    {
      "id": "en.n4.class-60.t01",
      "en": "I bought this camera last week, and here is my receipt.",
      "es": "Compré esta cámara la semana pasada y aquí está mi recibo.",
      "explanationEs": "Receipt: el papel que prueba la compra; se muestra al explicar el fallo.",
      "segments": [
        "I bought this camera last week,",
        "and here is my receipt."
      ],
      "audioText": "I bought this camera last week, and here is my receipt.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    },
    {
      "id": "en.n4.class-60.t02",
      "en": "It is still under warranty, so we can replace it for free.",
      "es": "Todavía está en garantía, así que podemos sustituirla gratis.",
      "explanationEs": "Under warranty (en inglés se usa under): la garantía cubre el arreglo o el cambio.",
      "segments": [
        "It is still under warranty, so",
        "we can replace it for free."
      ],
      "audioText": "It is still under warranty, so we can replace it for free.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    },
    {
      "id": "en.n4.class-60.t03",
      "en": "Would you like to return it or have it repaired?",
      "es": "¿Quiere devolverla o que la reparen?",
      "explanationEs": "Return es devolver; have it repaired es el servicio de reparación.",
      "segments": [
        "Would you like to return",
        "it or have it repaired?"
      ],
      "audioText": "Would you like to return it or have it repaired?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    },
    {
      "id": "en.n4.class-60.t04",
      "en": "The other option is to have it repaired for free.",
      "es": "La otra opción es repararla gratis.",
      "explanationEs": "The other option is to + verbo: así se negocia una alternativa.",
      "segments": [
        "The other option is to",
        "have it repaired for free."
      ],
      "audioText": "The other option is to have it repaired for free.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    },
    {
      "id": "en.n4.class-60.t05",
      "en": "Let me check with my manager.",
      "es": "Déjeme consultarlo con mi gerente.",
      "explanationEs": "El vendedor usa manager cuando necesita una decisión superior.",
      "segments": [
        "Let me check",
        "with my manager."
      ],
      "audioText": "Let me check with my manager.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    },
    {
      "id": "en.n4.class-60.t06",
      "en": "So, to confirm, we will send you a new one on Friday.",
      "es": "Entonces, para confirmar, le enviaremos una nueva el viernes.",
      "explanationEs": "To confirm repite lo acordado antes de terminar.",
      "segments": [
        "So, to confirm, we will send",
        "you a new one on Friday."
      ],
      "audioText": "So, to confirm, we will send you a new one on Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-shops-and-repairs-5"
    }
