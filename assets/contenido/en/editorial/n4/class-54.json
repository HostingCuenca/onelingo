  "teaching": [
    {
      "id": "en.n4.class-54.t01",
      "en": "Eight members attended the meeting on 12 May.",
      "es": "Ocho miembros asistieron a la reunión del 12 de mayo.",
      "explanationEs": "Attended + reunión (sin to): la primera parte del acta dice quién estuvo.",
      "segments": [
        "Eight members attended the",
        "meeting on 12 May."
      ],
      "audioText": "Eight members attended the meeting on 12 May.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-4"
    },
    {
      "id": "en.n4.class-54.t02",
      "en": "First, we discussed the plan for the school fair.",
      "es": "Primero, hablamos del plan para la feria de la escuela.",
      "explanationEs": "First + pasado (discussed): el conector abre la secuencia de lo que pasó.",
      "segments": [
        "First, we discussed the plan",
        "for the school fair."
      ],
      "audioText": "First, we discussed the plan for the school fair.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-4"
    },
    {
      "id": "en.n4.class-54.t03",
      "en": "Then we decided to hold the fair on 20 June.",
      "es": "Luego decidimos celebrar la feria el 20 de junio.",
      "explanationEs": "Then / after that + decided to: las decisiones se cuentan en pasado.",
      "segments": [
        "Then we decided to hold",
        "the fair on 20 June."
      ],
      "audioText": "Then we decided to hold the fair on 20 June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-4"
    },
    {
      "id": "en.n4.class-54.t04",
      "en": "Finally, Sara will send the posters by 5 June.",
      "es": "Por último, Sara enviará los carteles antes del 5 de junio.",
      "explanationEs": "Las tareas futuras llevan will + verbo base y by + fecha.",
      "segments": [
        "Finally, Sara will send the",
        "posters by 5 June."
      ],
      "audioText": "Finally, Sara will send the posters by 5 June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-4"
    },
    {
      "id": "en.n4.class-54.t05",
      "en": "The agenda for the next meeting has three points.",
      "es": "El orden del día de la próxima reunión tiene tres puntos.",
      "explanationEs": "Agenda: la lista de temas; el acta cierra con la próxima reunión.",
      "segments": [
        "The agenda for the next",
        "meeting has three points."
      ],
      "audioText": "The agenda for the next meeting has three points.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-team-meetings-4"
    },
    {
      "id": "en.n4.class-54.t06",
      "en": "These minutes are a short written record of the meeting.",
      "es": "Esta acta es un registro escrito breve de la reunión.",
      "explanationEs": "Minutes significa acta y siempre va en plural.",
      "segments": [
        "These minutes are a short",
        "written record of the meeting."
      ],
      "audioText": "These minutes are a short written record of the meeting.",
