    },
    {
      "id": "en.n4.class-86.t02",
      "en": "You must show your passport at the airport.",
      "es": "Debes mostrar tu pasaporte en el aeropuerto.",
      "explanationEs": "Must + verbo base: una obligación. El viajero no puede elegir.",
