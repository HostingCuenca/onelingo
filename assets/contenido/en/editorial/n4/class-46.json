  "teaching": [
    {
      "id": "en.n4.class-46.t01",
      "en": "Mia looks unhappy today, but yesterday she was very happy.",
      "es": "Mia parece infeliz hoy, pero ayer estaba muy feliz.",
      "explanationEs": "Un- + happy = lo contrario: unhappy es «infeliz».",
      "segments": [
        "Mia looks unhappy today, but",
        "yesterday she was very happy."
      ],
      "audioText": "Mia looks unhappy today, but yesterday she was very happy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-1"
    },
    {
      "id": "en.n4.class-46.t02",
      "en": "Thank you for your kindness; you are a very kind person.",
      "es": "Gracias por tu amabilidad; eres una persona muy amable.",
      "explanationEs": "El sufijo -ness convierte un adjetivo en sustantivo: kind → kindness.",
      "segments": [
        "Thank you for your kindness; you",
        "are a very kind person."
      ],
      "audioText": "Thank you for your kindness; you are a very kind person.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-1"
    },
    {
      "id": "en.n4.class-46.t03",
      "en": "Be careful with the glass, and take care of your little brother.",
      "es": "Ten cuidado con el vaso y cuida a tu hermano pequeño.",
      "explanationEs": "Care + -ful = careful: «lleno de cuidado», es decir, cuidadoso.",
      "segments": [
        "Be careful with the glass, and",
        "take care of your little brother."
      ],
      "audioText": "Be careful with the glass, and take care of your little brother.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-1"
    },
    {
      "id": "en.n4.class-46.t04",
      "en": "It is dishonest to copy a friend's homework, because honest students do their own work.",
      "es": "Es deshonesto copiar la tarea de un amigo, porque los alumnos honrados hacen su propio trabajo.",
      "explanationEs": "Dis- + honest = lo contrario: dishonest es «deshonesto».",
      "segments": [
        "It is dishonest to copy a friend's homework,",
        "because honest students do their own work."
      ],
      "audioText": "It is dishonest to copy a friend's homework, because honest students do their own work.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-1"
    },
    {
      "id": "en.n4.class-46.t05",
      "en": "Tom is impatient, but his sister is patient and waits for everyone.",
      "es": "Tom es impaciente, pero su hermana es paciente y espera a todos.",
      "explanationEs": "Im- aparece antes de p: im + patient. El prefijo cambia el significado.",
      "segments": [
        "Tom is impatient, but his sister",
        "is patient and waits for everyone."
      ],
      "audioText": "Tom is impatient, but his sister is patient and waits for everyone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-character-and-word-families-1"
    }
  ],
