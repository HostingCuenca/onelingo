    },
    {
      "id": "en.n4.class-97.t02",
      "en": "The suitcase was sent to the wrong airport by mistake.",
      "es": "La maleta fue enviada al aeropuerto equivocado por error.",
      "explanationEs": "Pasiva: was/were + participio, cuando importa lo ocurrido y no quién lo hizo.",
