  "teaching": [
    {
      "id": "en.n4.class-63.t01",
      "en": "The expert gives advice: stop looking at the screen for hours.",
      "es": "La experta da un consejo: deja de mirar la pantalla durante horas.",
      "explanationEs": "Stop + gerundio en un consejo: dejar de hacer algo.",
      "segments": [
        "The expert gives advice: stop looking",
        "at the screen for hours."
      ],
      "audioText": "The expert gives advice: stop looking at the screen for hours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-3"
    },
    {
      "id": "en.n4.class-63.t02",
      "en": "Take a break every hour and remember to stretch your back.",
      "es": "Haz una pausa cada hora y acuérdate de estirar la espalda.",
      "explanationEs": "Remember + to + verbo: algo que hay que hacer.",
      "segments": [
        "Take a break every hour and",
        "remember to stretch your back."
      ],
      "audioText": "Take a break every hour and remember to stretch your back.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-3"
    },
    {
      "id": "en.n4.class-63.t03",
      "en": "If you have a headache, try drinking a glass of water first.",
      "es": "Si tienes dolor de cabeza, prueba a beber primero un vaso de agua.",
      "explanationEs": "Try + gerundio: probar algo para ver si ayuda.",
      "segments": [
        "If you have a headache, try",
        "drinking a glass of water first."
      ],
      "audioText": "If you have a headache, try drinking a glass of water first.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-3"
    },
    {
      "id": "en.n4.class-63.t04",
      "en": "Every listener can call the host with a question.",
      "es": "Cada oyente puede llamar al presentador con una pregunta.",
      "explanationEs": "Listener (oyente) es quien escucha el programa; host (presentador) es quien lo dirige.",
      "segments": [
        "Every listener can call the",
        "host with a question."
      ],
      "audioText": "Every listener can call the host with a question.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-3"
    },
    {
      "id": "en.n4.class-63.t05",
      "en": "I regret not taking a break every hour when I was young.",
      "es": "Lamento no haber hecho una pausa cada hora cuando era joven.",
      "explanationEs": "Regret + not + gerundio: lamentar algo que no hiciste.",
      "segments": [
        "I regret not taking a break",
        "every hour when I was young."
      ],
      "audioText": "I regret not taking a break every hour when I was young.",
