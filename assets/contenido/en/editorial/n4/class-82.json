    {
      "id": "en.n4.class-82.t01",
      "en": "According to a witness, the man ran out of the shop.",
      "es": "Según un testigo, el hombre salió corriendo de la tienda.",
      "explanationEs": "According to + fuente, + noticia. La información es de la fuente, no del hablante.",
      "segments": [
        "According to a witness, the man",
        "ran out of the shop."
      ],
      "audioText": "According to a witness, the man ran out of the shop.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-2"
    },
    {
      "id": "en.n4.class-82.t02",
      "en": "According to the police, the fire started in the kitchen.",
      "es": "Según la policía, el incendio empezó en la cocina.",
      "explanationEs": "La fuente puede ser una institución: According to the police.",
      "segments": [
        "According to the police, the",
        "fire started in the kitchen."
      ],
      "audioText": "According to the police, the fire started in the kitchen.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-2"
    },
    {
      "id": "en.n4.class-82.t03",
      "en": "It seems that the driver lost control of the car.",
      "es": "Parece que el conductor perdió el control del coche.",
      "explanationEs": "It seems that + oración completa, con su propio sujeto y verbo.",
      "segments": [
        "It seems that the driver",
        "lost control of the car."
      ],
      "audioText": "It seems that the driver lost control of the car.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-2"
    },
    {
      "id": "en.n4.class-82.t04",
      "en": "The driver appears to be fine, but the doctor has not spoken yet.",
      "es": "El conductor parece estar bien, pero el médico todavía no ha hablado.",
      "explanationEs": "Sujeto + appears to + verbo base: parece + infinitivo.",
      "segments": [
        "The driver appears to be fine, but",
        "the doctor has not spoken yet."
      ],
      "audioText": "The driver appears to be fine, but the doctor has not spoken yet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-2"
    },
    {
      "id": "en.n4.class-82.t05",
      "en": "The storm seems to be moving away from the coast.",
      "es": "La tormenta parece estar alejándose de la costa.",
      "explanationEs": "Seems to + verbo: igual que appears to; se conjuga seems con he, she, it.",
      "segments": [
        "The storm seems to be",
        "moving away from the coast."
      ],
      "audioText": "The storm seems to be moving away from the coast.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-news-and-certainty-2"
    },
    {
