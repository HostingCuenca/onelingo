  "teaching": [
    {
      "id": "en.n4.class-34.t01",
      "en": "Yesterday I heard a conversation between Ana and Leo.",
      "es": "Ayer oí una conversación entre Ana y Leo.",
      "explanationEs": "Abre el relato con el momento y las personas: así el lector sabe de qué hablas.",
      "segments": [
        "Yesterday I heard a conversation",
        "between Ana and Leo."
      ],
      "audioText": "Yesterday I heard a conversation between Ana and Leo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-4"
    },
    {
      "id": "en.n4.class-34.t02",
      "en": "Ana said that she was tired and that she could not come.",
      "es": "Ana dijo que estaba cansada y que no podía venir.",
      "explanationEs": "Said that + retroceso de tiempos: am pasa a was y can't a could not.",
      "segments": [
        "Ana said that she was tired",
        "and that she could not come."
      ],
      "audioText": "Ana said that she was tired and that she could not come.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-4"
    },
    {
      "id": "en.n4.class-34.t03",
      "en": "Leo asked her if she wanted to rest, and she asked him to wait.",
      "es": "Leo le preguntó si quería descansar y ella le pidió que esperara.",
      "explanationEs": "Una misma palabra, asked, sirve para una pregunta (if) y para una petición (to).",
      "segments": [
        "Leo asked her if she wanted to",
        "rest, and she asked him to wait."
      ],
      "audioText": "Leo asked her if she wanted to rest, and she asked him to wait.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-4"
    },
    {
      "id": "en.n4.class-34.t04",
      "en": "He suggested meeting on Saturday, and she promised to answer that night.",
      "es": "Él sugirió vernos el sábado y ella prometió responder esa noche.",
      "explanationEs": "Suggested + -ing y promised + to; tonight pasa a that night.",
      "segments": [
        "He suggested meeting on Saturday, and",
        "she promised to answer that night."
      ],
      "audioText": "He suggested meeting on Saturday, and she promised to answer that night.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-4"
    },
    {
      "id": "en.n4.class-34.t05",
      "en": "Finally, Leo told her not to worry, and they agreed to talk again.",
      "es": "Por último, Leo le dijo que no se preocupara y acordaron hablar otra vez.",
      "explanationEs": "Finally cierra el relato; told + persona + not to + verbo.",
      "segments": [
        "Finally, Leo told her not to worry,",
        "and they agreed to talk again."
      ],
      "audioText": "Finally, Leo told her not to worry, and they agreed to talk again.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-messages-and-gossip-4"
    }
  ],
