  "teaching": [
    {
      "id": "en.n4.class-16.t01",
      "en": "The lights are on, so my neighbour must be at home.",
      "es": "Las luces están encendidas, así que mi vecino debe de estar en casa.",
      "explanationEs": "Must + verbo base: casi seguro, por pistas claras. No significa «deber» aquí.",
      "segments": [
        "The lights are on, so my",
        "neighbour must be at home."
      ],
      "audioText": "The lights are on, so my neighbour must be at home.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-everyday-mysteries-1"
    },
    {
      "id": "en.n4.class-16.t02",
      "en": "That parcel might be for Tom, but I am not sure.",
      "es": "Ese paquete podría ser para Tom, pero no estoy seguro.",
      "explanationEs": "Might + verbo base: es posible, pero no hay seguridad.",
      "segments": [
        "That parcel might be for Tom,",
        "but I am not sure."
      ],
      "audioText": "That parcel might be for Tom, but I am not sure.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-everyday-mysteries-1"
    },
    {
      "id": "en.n4.class-16.t03",
      "en": "It could be a bird on the roof.",
      "es": "Podría ser un pájaro en el tejado.",
      "explanationEs": "Could + verbo base también expresa algo posible.",
      "segments": [
        "It could be a",
        "bird on the roof."
      ],
      "audioText": "It could be a bird on the roof.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-everyday-mysteries-1"
    },
    {
      "id": "en.n4.class-16.t04",
      "en": "She can't be asleep: I can hear her music.",
      "es": "No puede estar dormida: oigo su música.",
      "explanationEs": "Can't + verbo base: casi imposible, porque una pista lo contradice.",
      "segments": [
        "She can't be asleep: I",
        "can hear her music."
      ],
      "audioText": "She can't be asleep: I can hear her music.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-everyday-mysteries-1"
    },
    {
      "id": "en.n4.class-16.t05",
      "en": "The dog is barking, so there must be someone at the door.",
      "es": "El perro está ladrando, así que debe de haber alguien en la puerta.",
      "explanationEs": "Must + verbo base: la conclusión más probable con una pista clara.",
      "segments": [
        "The dog is barking, so there",
        "must be someone at the door."
      ],
      "audioText": "The dog is barking, so there must be someone at the door.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-everyday-mysteries-1"
