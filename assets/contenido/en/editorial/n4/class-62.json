  "teaching": [
    {
      "id": "en.n4.class-62.t01",
      "en": "I forget to drink water when I am busy.",
      "es": "Me olvido de beber agua cuando estoy ocupado.",
      "explanationEs": "Forget + to + verbo: no hacer lo que había que hacer.",
      "segments": [
        "I forget to drink water",
        "when I am busy."
      ],
      "audioText": "I forget to drink water when I am busy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-2"
    },
    {
      "id": "en.n4.class-62.t02",
      "en": "I will never forget running my first race.",
      "es": "Nunca olvidaré haber corrido mi primera carrera.",
      "explanationEs": "Forget + gerundio: olvidar algo ya vivido; casi siempre en negativo (never forget).",
      "segments": [
        "I will never forget",
        "running my first race."
      ],
      "audioText": "I will never forget running my first race.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-2"
    },
    {
      "id": "en.n4.class-62.t03",
      "en": "I regret eating so much cake last night.",
      "es": "Lamento haber comido tanto pastel anoche.",
      "explanationEs": "Regret + gerundio: lamentar algo que ya hiciste.",
      "segments": [
        "I regret eating so",
        "much cake last night."
      ],
      "audioText": "I regret eating so much cake last night.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-2"
    },
    {
      "id": "en.n4.class-62.t04",
      "en": "We regret to tell you that the class is full.",
      "es": "Lamentamos comunicarle que la clase está llena.",
      "explanationEs": "Regret + to + verbo: dar una mala noticia; es un uso formal.",
      "segments": [
        "We regret to tell you",
        "that the class is full."
      ],
      "audioText": "We regret to tell you that the class is full.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-2"
    },
    {
      "id": "en.n4.class-62.t05",
      "en": "Mia felt pain in her knee, but she went on running.",
      "es": "Mia sintió dolor en la rodilla, pero siguió corriendo.",
      "explanationEs": "Go on + gerundio: seguir con la misma acción.",
      "segments": [
        "Mia felt pain in her knee,",
        "but she went on running."
      ],
      "audioText": "Mia felt pain in her knee, but she went on running.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-healthy-habits-2"
    },
    {
      "id": "en.n4.class-62.t06",
      "en": "After the warm-up, Mia went on to do her exercise.",
      "es": "Después del calentamiento, Mia pasó a hacer su ejercicio.",
      "explanationEs": "Go on + to + verbo: pasar a una acción distinta.",
      "segments": [
