  "teaching": [
    {
      "id": "en.n4.class-41.t01",
      "en": "Leo wants to score a goal in every match.",
      "es": "Leo quiere marcar un gol en cada partido.",
      "explanationEs": "Los goles se marcan: score a goal. En inglés no se dice «make a goal».",
      "segments": [
        "Leo wants to score a",
        "goal in every match."
      ],
      "audioText": "Leo wants to score a goal in every match.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-1"
    },
    {
      "id": "en.n4.class-41.t02",
      "en": "Our team can break the record if we win this race.",
      "es": "Nuestro equipo puede batir el récord si ganamos esta carrera.",
      "explanationEs": "Break a record = batir un récord. Win se usa con carreras, partidos y premios.",
      "segments": [
        "Our team can break the record",
        "if we win this race."
      ],
      "audioText": "Our team can break the record if we win this race.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-1"
    },
    {
      "id": "en.n4.class-41.t03",
      "en": "Ana won a gold medal, and Tom won a silver medal.",
      "es": "Ana ganó una medalla de oro y Tom ganó una de plata.",
      "explanationEs": "Win a medal: el verbo de los premios es win, no «gain».",
      "segments": [
        "Ana won a gold medal, and",
        "Tom won a silver medal."
      ],
      "audioText": "Ana won a gold medal, and Tom won a silver medal.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-1"
    },
    {
      "id": "en.n4.class-41.t04",
      "en": "My brother plays for a small team, but they beat the best team in the city.",
      "es": "Mi hermano juega en un equipo pequeño, pero derrotaron al mejor equipo de la ciudad.",
      "explanationEs": "A un rival se le derrota: beat a team. Win va con el partido, no con el rival.",
      "segments": [
        "My brother plays for a small team, but",
        "they beat the best team in the city."
      ],
      "audioText": "My brother plays for a small team, but they beat the best team in the city.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-1"
    },
    {
      "id": "en.n4.class-41.t05",
      "en": "Many people take part in the city race every spring.",
      "es": "Mucha gente participa en la carrera de la ciudad cada primavera.",
      "explanationEs": "Take part in = participar en; la preposición in va siempre al final.",
      "segments": [
        "Many people take part in",
        "the city race every spring."
      ],
      "audioText": "Many people take part in the city race every spring.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-sport-and-leisure-words-1"
    }
  ],
