    {
      "id": "en.n4.class-100.t01",
      "en": "There was a misunderstanding: the host family had not received our message.",
      "es": "Hubo un malentendido: la familia anfitriona no había recibido nuestro mensaje.",
      "explanationEs": "Relato con antecedente: pasado simple + had + participio.",
