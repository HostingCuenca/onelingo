      "patternId": "n4-b1-consolidation-capstone-5"
    },
    {
      "id": "en.n4.class-100.t03",
      "en": "The teacher made a promise: she said that she would call the family.",
      "es": "La profesora hizo una promesa: dijo que llamaría a la familia.",
      "explanationEs": "Discurso indirecto: will pasa a would.",
      "segments": [
        "The teacher made a promise: she said",
        "that she would call the family."
      ],
      "audioText": "The teacher made a promise: she said that she would call the family.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-b1-consolidation-capstone-5"
    },
    {
      "id": "en.n4.class-100.t04",
      "en": "We apologise for the problem; if we had checked the address, we would have avoided it.",
      "es": "Pedimos disculpas por el problema; si hubiéramos comprobado la dirección, lo habríamos evitado.",
      "explanationEs": "Tercer condicional: if + had + participio, would have + participio.",
      "segments": [
