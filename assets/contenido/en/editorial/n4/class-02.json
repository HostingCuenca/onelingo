      ],
      "audioText": "By the time we got to the concert, the band had already started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n4-earlier-events-2"
    },
    {
      "id": "en.n4.class-02.t02",
      "en": "When Ana's phone rang, Leo left the house.",
      "es": "Cuando sonó el teléfono de Ana, Leo salió de casa.",
      "explanationEs": "Dos pasados simples: primero sonó el teléfono y después Leo salió.",
