    {
      "id": "en.n4.class-02.t04",
      "en": "Mia had just finished her homework when her friend arrived.",
      "es": "Mia acababa de terminar la tarea cuando llegó su amiga.",
      "explanationEs": "Had just + participio: algo muy reciente antes de otro momento pasado.",
      "segments": [
        "Mia had just finished her",
        "homework when her friend arrived."
      ],
      "audioText": "Mia had just finished her homework when her friend arrived.",
      "audioMode": "tts",
