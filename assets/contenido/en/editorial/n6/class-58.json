  "teaching": [
    {
      "id": "en.n6.class-58.t01",
      "en": "Leo is responsible for the bus: he will book it by Friday.",
      "es": "Leo es responsable del autobús: lo reservará para el viernes.",
      "explanationEs": "Responsible for = responsable de; by Friday marca el plazo.",
      "segments": [
        "Leo is responsible for the bus:",
        "he will book it by Friday."
      ],
      "audioText": "Leo is responsible for the bus: he will book it by Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-3"
    },
    {
      "id": "en.n6.class-58.t02",
      "en": "Mia will have printed the map by Thursday, so nobody needs to buy one.",
      "es": "Mia habrá impreso el mapa para el jueves, así que nadie necesita comprar uno.",
      "explanationEs": "Will have + participio: terminada antes del plazo.",
      "segments": [
        "Mia will have printed the map by",
        "Thursday, so nobody needs to buy one."
      ],
      "audioText": "Mia will have printed the map by Thursday, so nobody needs to buy one.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-3"
    },
    {
      "id": "en.n6.class-58.t03",
      "en": "This time next week, we will be walking the first route.",
      "es": "A esta hora la semana que viene estaremos caminando la primera ruta.",
      "explanationEs": "This time next week + will be + -ing: acción en curso en ese momento.",
      "segments": [
        "This time next week, we will",
        "be walking the first route."
      ],
      "audioText": "This time next week, we will be walking the first route.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-3"
    },
    {
      "id": "en.n6.class-58.t04",
      "en": "The calendar shows who does what, and the deadline is in the last column.",
      "es": "El calendario muestra quién hace qué, y el plazo está en la última columna.",
      "explanationEs": "Calendar = calendario; deadline = plazo; cada fila tiene quién, qué y cuándo.",
      "segments": [
        "The calendar shows who does what, and",
        "the deadline is in the last column."
      ],
      "audioText": "The calendar shows who does what, and the deadline is in the last column.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-3"
    },
    {
      "id": "en.n6.class-58.t05",
      "en": "We need a permit, and Sara will ask for it by Monday.",
      "es": "Necesitamos un permiso y Sara lo pedirá antes del lunes.",
      "explanationEs": "Permit = permiso; ask for = pedir.",
      "segments": [
        "We need a permit, and Sara",
        "will ask for it by Monday."
      ],
      "audioText": "We need a permit, and Sara will ask for it by Monday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-3"
    },
    {
      "id": "en.n6.class-58.t06",
      "en": "Tom is our guide, and he will have checked the route by Saturday.",
      "es": "Tom es nuestro guía y habrá revisado la ruta para el sábado.",
      "explanationEs": "Guide = guía; will have checked anticipa el resultado antes del sábado.",
      "segments": [
        "Tom is our guide, and he will",
        "have checked the route by Saturday."
      ],
      "audioText": "Tom is our guide, and he will have checked the route by Saturday.",
      "audioMode": "tts",
