    {
      "id": "en.n6.class-27.t01",
      "en": "Having arrived early, we found good seats.",
      "es": "Habiendo llegado temprano, encontramos buenos asientos.",
      "explanationEs": "Dos frases con el mismo sujeto: «We arrived early. We found seats» → Having arrived…, we found…",
      "segments": [
        "Having arrived early, we",
        "found good seats."
      ],
      "audioText": "Having arrived early, we found good seats.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-non-finite-forms-2"
    },
    {
      "id": "en.n6.class-27.t02",
      "en": "Having lost his keys, Leo could not open the door.",
      "es": "Habiendo perdido las llaves, Leo no pudo abrir la puerta.",
      "explanationEs": "Having + lost indica una acción anterior que explica la principal.",
      "segments": [
        "Having lost his keys, Leo",
        "could not open the door."
      ],
      "audioText": "Having lost his keys, Leo could not open the door.",
      "audioMode": "tts",
      "languageCode": "en",
