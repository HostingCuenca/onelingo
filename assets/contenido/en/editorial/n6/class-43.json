  "teaching": [
    {
      "id": "en.n6.class-43.t01",
      "en": "The candidate says that every student needs a voice.",
      "es": "La candidata dice que cada estudiante necesita una voz.",
      "explanationEs": "Idea central: lo que el orador quiere que creamos o hagamos.",
      "segments": [
        "The candidate says that every",
        "student needs a voice."
      ],
      "audioText": "The candidate says that every student needs a voice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    },
    {
      "id": "en.n6.class-43.t02",
      "en": "She repeats \"Your voice, your vote\" so that everyone remembers it.",
      "es": "Repite «Tu voz, tu voto» para que todos lo recuerden.",
      "explanationEs": "Recurso + efecto: la repetición sirve para que el mensaje se quede.",
      "segments": [
        "She repeats \"Your voice, your vote\"",
        "so that everyone remembers it."
      ],
      "audioText": "She repeats \"Your voice, your vote\" so that everyone remembers it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    },
    {
      "id": "en.n6.class-43.t03",
      "en": "Who will speak for your class if not your delegate?",
      "es": "¿Quién hablará por tu clase si no lo hace tu delegado?",
      "explanationEs": "Pregunta retórica: no espera respuesta, hace pensar al público.",
      "segments": [
        "Who will speak for your",
        "class if not your delegate?"
      ],
      "audioText": "Who will speak for your class if not your delegate?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    },
    {
      "id": "en.n6.class-43.t04",
      "en": "She makes a strong claim, but she gives no evidence.",
      "es": "Hace una afirmación fuerte, pero no da pruebas.",
      "explanationEs": "Punto débil frecuente: una afirmación sin pruebas. Evidence no lleva -s.",
      "segments": [
        "She makes a strong claim,",
        "but she gives no evidence."
      ],
      "audioText": "She makes a strong claim, but she gives no evidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    },
    {
      "id": "en.n6.class-43.t05",
      "en": "Her promises sound good, but she has no plan.",
      "es": "Sus promesas suenan bien, pero no tiene un plan.",
      "explanationEs": "Punto débil frecuente: una promesa sin plan para cumplirla.",
      "segments": [
        "Her promises sound good, but",
        "she has no plan."
      ],
      "audioText": "Her promises sound good, but she has no plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    },
    {
      "id": "en.n6.class-43.t06",
      "en": "The weak point of the speech is that she does not say how she will do it.",
      "es": "El punto débil del discurso es que no dice cómo lo hará.",
      "explanationEs": "En una pregunta indirecta no se invierte el orden: how she will do it.",
      "segments": [
        "The weak point of the speech is that she",
        "does not say how she will do it."
      ],
      "audioText": "The weak point of the speech is that she does not say how she will do it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-3"
    }
