  "teaching": [
    {
      "id": "en.n6.class-03.t01",
      "en": "Last Friday I was at the station when I noticed that my ticket was missing.",
      "es": "El viernes pasado estaba en la estación cuando noté que me faltaba el billete.",
      "explanationEs": "Pasado simple y continuo preparan la escena: dónde, cuándo y qué pasaba.",
      "segments": [
        "Last Friday I was at the station when",
        "I noticed that my ticket was missing."
      ],
      "audioText": "Last Friday I was at the station when I noticed that my ticket was missing.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-3"
    },
    {
      "id": "en.n6.class-03.t02",
      "en": "So there I am, on the platform, and my train is arriving.",
      "es": "Y ahí estoy yo, en el andén, y mi tren está llegando.",
      "explanationEs": "«So there I am» avisa del cambio al presente histórico: la escena se vuelve más viva.",
      "segments": [
        "So there I am, on the",
        "platform, and my train is arriving."
      ],
      "audioText": "So there I am, on the platform, and my train is arriving.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-3"
    },
    {
      "id": "en.n6.class-03.t03",
      "en": "I grab my bag, I sprint across the bridge, and the whistle blows!",
      "es": "¡Agarro mi bolso, corro por el puente y suena el silbato!",
      "explanationEs": "Varios verbos en presente simple, uno tras otro: el clímax avanza rápido.",
      "segments": [
        "I grab my bag, I sprint across",
        "the bridge, and the whistle blows!"
      ],
      "audioText": "I grab my bag, I sprint across the bridge, and the whistle blows!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-3"
    },
    {
      "id": "en.n6.class-03.t04",
      "en": "Afterwards, the tension disappeared and we all laughed about it.",
      "es": "Después, la tensión desapareció y todos nos reímos.",
      "explanationEs": "Al terminar el momento intenso, el narrador vuelve al pasado para cerrar.",
      "segments": [
        "Afterwards, the tension disappeared and",
        "we all laughed about it."
      ],
      "audioText": "Afterwards, the tension disappeared and we all laughed about it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-3"
    },
    {
      "id": "en.n6.class-03.t05",
      "en": "Everybody loves this story because it feels so vivid.",
      "es": "A todos les encanta esta historia porque se siente muy vívida.",
      "explanationEs": "El presente histórico no cambia cuándo ocurrió: hace que el oyente lo viva.",
      "segments": [
        "Everybody loves this story because",
        "it feels so vivid."
      ],
      "audioText": "Everybody loves this story because it feels so vivid.",
      "audioMode": "tts",
