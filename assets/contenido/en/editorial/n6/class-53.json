  "teaching": [
    {
      "id": "en.n6.class-53.t01",
      "en": "The coach gives each player a role: Sara defends and Tom passes the ball.",
      "es": "El entrenador da una función a cada jugador: Sara defiende y Tom pasa el balón.",
      "explanationEs": "Role = función; se reparte con I need you to + verbo.",
      "segments": [
        "The coach gives each player a role:",
        "Sara defends and Tom passes the ball."
      ],
      "audioText": "The coach gives each player a role: Sara defends and Tom passes the ball.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    },
    {
      "id": "en.n6.class-53.t02",
      "en": "The coach says, I need you to stay near the goal, Sara.",
      "es": "El entrenador dice: necesito que te quedes cerca de la portería, Sara.",
      "explanationEs": "I need you to + verbo base: así se asigna una tarea.",
      "segments": [
        "The coach says, I need you",
        "to stay near the goal, Sara."
      ],
      "audioText": "The coach says, I need you to stay near the goal, Sara.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    },
    {
      "id": "en.n6.class-53.t03",
      "en": "At half-time, the coach wants to encourage the team: You are doing great!",
      "es": "En el descanso, el entrenador quiere animar al equipo: ¡lo están haciendo genial!",
      "explanationEs": "Encourage = animar; se dice lo que va bien y se pide seguir.",
      "segments": [
        "At half-time, the coach wants to encourage",
        "the team: You are doing great!"
      ],
      "audioText": "At half-time, the coach wants to encourage the team: You are doing great!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    },
    {
      "id": "en.n6.class-53.t04",
      "en": "Her comment was constructive: it named the problem and gave a suggestion.",
      "es": "Su comentario fue constructivo: nombró el problema y dio una sugerencia.",
      "explanationEs": "Constructive = ayuda a mejorar; siempre lleva una suggestion.",
      "segments": [
        "Her comment was constructive: it named",
        "the problem and gave a suggestion."
      ],
      "audioText": "Her comment was constructive: it named the problem and gave a suggestion.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    },
    {
      "id": "en.n6.class-53.t05",
      "en": "Next time, try to pass earlier, and we will improve.",
      "es": "La próxima vez, intenta pasar antes y mejoraremos.",
      "explanationEs": "Next time, try to + verbo base es la sugerencia típica.",
      "segments": [
        "Next time, try to pass",
        "earlier, and we will improve."
      ],
      "audioText": "Next time, try to pass earlier, and we will improve.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    },
    {
      "id": "en.n6.class-53.t06",
      "en": "Praise first, then one suggestion: that is how a good coach talks.",
      "es": "Primero el elogio, luego una sugerencia: así habla un buen entrenador.",
      "explanationEs": "Praise = elogio; el orden elogio + sugerencia suaviza la crítica.",
      "segments": [
        "Praise first, then one suggestion: that",
        "is how a good coach talks."
      ],
      "audioText": "Praise first, then one suggestion: that is how a good coach talks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-3"
    }
  ],
