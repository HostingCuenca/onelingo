    },
    {
      "id": "en.n6.class-48.t03",
      "en": "Many residents wanted to move, and a few did so last year.",
      "es": "Muchos vecinos querían mudarse y unos pocos lo hicieron el año pasado.",
      "explanationEs": "Did so sustituye a un verbo con su complemento: did so = moved.",
      "segments": [
        "Many residents wanted to move, and",
        "a few did so last year."
      ],
      "audioText": "Many residents wanted to move, and a few did so last year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-3"
    },
    {
      "id": "en.n6.class-48.t04",
      "en": "The old houses are cold, but the new ones are warm.",
      "es": "Las casas viejas son frías, pero las nuevas son cálidas.",
      "explanationEs": "Ones sustituye a un nombre plural ya mencionado: the new ones = the new houses.",
      "segments": [
        "The old houses are cold, but",
        "the new ones are warm."
      ],
      "audioText": "The old houses are cold, but the new ones are warm.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-3"
    },
    {
      "id": "en.n6.class-48.t05",
      "en": "The town has no buses or trains. Such a lack of transport makes life hard.",
      "es": "La ciudad no tiene autobuses ni trenes. Semejante falta de transporte hace la vida difícil.",
      "explanationEs": "Such recoge un tipo de situación ya descrita y la valora.",
      "segments": [
        "The town has no buses or trains. Such",
        "a lack of transport makes life hard."
      ],
      "audioText": "The town has no buses or trains. Such a lack of transport makes life hard.",
