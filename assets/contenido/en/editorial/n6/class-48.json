    {
      "id": "en.n6.class-48.t01",
      "en": "The council closed the old bridge. This caused long delays.",
      "es": "El ayuntamiento cerró el viejo puente. Esto causó largos retrasos.",
      "explanationEs": "This remite a toda la acción anterior: cerrar el puente, no solo al puente.",
      "segments": [
        "The council closed the old",
        "bridge. This caused long delays."
      ],
      "audioText": "The council closed the old bridge. This caused long delays.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-3"
    },
    {
      "id": "en.n6.class-48.t02",
      "en": "Norton and Weston are both growing. The former is quiet; the latter is busy.",
      "es": "Norton y Weston están creciendo. La primera es tranquila; la segunda, animada.",
      "explanationEs": "The former es la primera de las dos nombradas (Norton); the latter, la segunda (Weston).",
      "segments": [
        "Norton and Weston are both growing. The",
        "former is quiet; the latter is busy."
      ],
      "audioText": "Norton and Weston are both growing. The former is quiet; the latter is busy.",
      "audioMode": "tts",
      "languageCode": "en",
