  "teaching": [
    {
      "id": "en.n6.class-41.t01",
      "en": "Who will help our readers if the library closes?",
      "es": "¿Quién ayudará a nuestros lectores si la biblioteca cierra?",
      "explanationEs": "Pregunta retórica: no espera respuesta, hace pensar al público. Tras if va el presente (closes), no will.",
      "segments": [
        "Who will help our readers",
        "if the library closes?"
      ],
      "audioText": "Who will help our readers if the library closes?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    },
    {
      "id": "en.n6.class-41.t02",
      "en": "Books, shelves and volunteers: that is all we need.",
      "es": "Libros, estanterías y voluntarios: eso es todo lo que necesitamos.",
      "explanationEs": "Lista de tres: tres elementos seguidos dan ritmo y sensación de algo completo.",
      "segments": [
        "Books, shelves and volunteers: that",
        "is all we need."
      ],
      "audioText": "Books, shelves and volunteers: that is all we need.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    },
    {
      "id": "en.n6.class-41.t03",
      "en": "We will fight for our readers. We will fight for our books. We will fight for our library.",
      "es": "Lucharemos por nuestros lectores. Lucharemos por nuestros libros. Lucharemos por nuestra biblioteca.",
      "explanationEs": "Repetición: la misma estructura al empezar cada frase fija la idea en la memoria.",
      "segments": [
        "We will fight for our readers. We will fight",
        "for our books. We will fight for our library."
      ],
      "audioText": "We will fight for our readers. We will fight for our books. We will fight for our library.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    },
    {
      "id": "en.n6.class-41.t04",
      "en": "The closure saves money today, but it costs us our future.",
      "es": "El cierre ahorra dinero hoy, pero nos cuesta el futuro.",
      "explanationEs": "Contraste: dos ideas opuestas unidas con but; el oyente ve la diferencia.",
      "segments": [
        "The closure saves money today, but",
        "it costs us our future."
      ],
      "audioText": "The closure saves money today, but it costs us our future.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    },
    {
      "id": "en.n6.class-41.t05",
      "en": "A rhetorical question makes the audience think; it does not wait for an answer.",
      "es": "Una pregunta retórica hace pensar al público; no espera una respuesta.",
      "explanationEs": "Así se nombra el efecto: qué recurso es y qué provoca en quien escucha.",
      "segments": [
        "A rhetorical question makes the audience think;",
        "it does not wait for an answer."
      ],
      "audioText": "A rhetorical question makes the audience think; it does not wait for an answer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    },
    {
      "id": "en.n6.class-41.t06",
      "en": "Repetition helps the audience remember the message.",
      "es": "La repetición ayuda al público a recordar el mensaje.",
      "explanationEs": "Otro efecto que conviene saber nombrar: la repetición hace que el mensaje se quede.",
      "segments": [
        "Repetition helps the audience",
        "remember the message."
      ],
      "audioText": "Repetition helps the audience remember the message.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-1"
    }
  ],
