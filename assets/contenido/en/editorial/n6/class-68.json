  "teaching": [
    {
      "id": "en.n6.class-68.t01",
      "en": "The strength of the talk was its clear structure.",
      "es": "El punto fuerte de la charla fue su estructura clara.",
      "explanationEs": "Strength: algo que funciona bien. Se puede decir the strength was… o the best thing was…",
      "segments": [
        "The strength of the talk",
        "was its clear structure."
      ],
      "audioText": "The strength of the talk was its clear structure.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-speaking-to-an-audience-3"
    },
    {
      "id": "en.n6.class-68.t02",
      "en": "The pace was too fast: I could not follow the second point.",
      "es": "El ritmo era demasiado rápido: no pude seguir el segundo punto.",
      "explanationEs": "Pace: la velocidad al hablar. Too fast es demasiado rápido y se justifica con un ejemplo oído.",
      "segments": [
        "The pace was too fast: I",
        "could not follow the second point."
      ],
      "audioText": "The pace was too fast: I could not follow the second point.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-speaking-to-an-audience-3"
    },
    {
      "id": "en.n6.class-68.t03",
      "en": "The volume was good, so everyone at the back could hear.",
      "es": "El volumen era bueno, así que todos al fondo podían oír.",
      "explanationEs": "Volume: lo alto que se habla. Se valora con adjetivo + enough o con too.",
      "segments": [
        "The volume was good, so everyone",
        "at the back could hear."
      ],
      "audioText": "The volume was good, so everyone at the back could hear.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-speaking-to-an-audience-3"
    },
    {
      "id": "en.n6.class-68.t04",
      "en": "She could improve her eye contact: she looked at her notes too much.",
      "es": "Podría mejorar el contacto visual: miró demasiado sus notas.",
      "explanationEs": "Could improve + sustantivo propone una mejora concreta y amable. Eye contact es el contacto visual con el público.",
      "segments": [
        "She could improve her eye contact: she",
        "looked at her notes too much."
      ],
      "audioText": "She could improve her eye contact: she looked at her notes too much.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-speaking-to-an-audience-3"
    },
    {
      "id": "en.n6.class-68.t05",
      "en": "My suggestion is to pause after each point.",
      "es": "Mi sugerencia es hacer una pausa después de cada punto.",
      "explanationEs": "My suggestion is to + verbo base: das una mejora concreta y fácil de aplicar.",
      "segments": [
        "My suggestion is to",
        "pause after each point."
      ],
      "audioText": "My suggestion is to pause after each point.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-speaking-to-an-audience-3"
    }
  ],
