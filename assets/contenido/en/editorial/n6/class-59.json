  "teaching": [
    {
      "id": "en.n6.class-59.t01",
      "en": "The minutes record who attended and what the meeting agreed.",
      "es": "El acta recoge quién asistió y qué acordó la reunión.",
      "explanationEs": "Minutes = acta; se escribe en tercera persona y en pasado.",
      "segments": [
        "The minutes record who attended",
        "and what the meeting agreed."
      ],
      "audioText": "The minutes record who attended and what the meeting agreed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    },
    {
      "id": "en.n6.class-59.t02",
      "en": "We all agree that the cleaning is due to start on 5 June.",
      "es": "Todos estamos de acuerdo en que está previsto que la limpieza empiece el 5 de junio.",
      "explanationEs": "Agree that + oración completa; en el acta pasa a agreed that.",
      "segments": [
        "We all agree that the cleaning is",
        "due to start on 5 June."
      ],
      "audioText": "We all agree that the cleaning is due to start on 5 June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    },
    {
      "id": "en.n6.class-59.t03",
      "en": "Mia will propose a new date, and the agreement is clear: Friday at six.",
      "es": "Mia propondrá una nueva fecha y el acuerdo está claro: el viernes a las seis.",
      "explanationEs": "Propose = proponer; agreement = acuerdo.",
      "segments": [
        "Mia will propose a new date, and",
        "the agreement is clear: Friday at six."
      ],
      "audioText": "Mia will propose a new date, and the agreement is clear: Friday at six.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    },
    {
      "id": "en.n6.class-59.t04",
      "en": "According to the minutes, Tom is to send the invitations by Wednesday.",
      "es": "Según el acta, Tom debe enviar las invitaciones antes del miércoles.",
      "explanationEs": "Be to + verbo base + by: responsable y plazo en un estilo formal.",
      "segments": [
        "According to the minutes, Tom is",
        "to send the invitations by Wednesday."
      ],
      "audioText": "According to the minutes, Tom is to send the invitations by Wednesday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    },
    {
      "id": "en.n6.class-59.t05",
      "en": "In the summary, the chair says who will have done what by the next meeting.",
      "es": "En el resumen, la presidenta dice quién habrá hecho qué para la próxima reunión.",
      "explanationEs": "Summary = resumen; el futuro perfecto marca lo que estará hecho.",
      "segments": [
        "In the summary, the chair says who will",
        "have done what by the next meeting."
      ],
      "audioText": "In the summary, the chair says who will have done what by the next meeting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    },
    {
      "id": "en.n6.class-59.t06",
      "en": "Twelve neighbours will attend, and the vote is set for six o'clock.",
      "es": "Doce vecinos asistirán y la votación está fijada para las seis.",
      "explanationEs": "Attend = asistir; vote = votación; set for = fijado para.",
      "segments": [
        "Twelve neighbours will attend, and the",
        "vote is set for six o'clock."
      ],
      "audioText": "Twelve neighbours will attend, and the vote is set for six o'clock.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-4"
    }
  ],
