  "teaching": [
    {
      "id": "en.n6.class-87.t01",
      "en": "A red notification can trigger the urge to open the app.",
      "es": "Una notificación roja puede desencadenar las ganas de abrir la aplicación.",
      "explanationEs": "Trigger + objeto: una causa inmediata que dispara una reacción. No lleva preposición.",
      "segments": [
        "A red notification can trigger the",
        "urge to open the app."
      ],
      "audioText": "A red notification can trigger the urge to open the app.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-2"
    },
    {
      "id": "en.n6.class-87.t02",
      "en": "Constant rewards bring about a change in our habits.",
      "es": "Las recompensas constantes provocan un cambio en nuestros hábitos.",
      "explanationEs": "Bring about + resultado: la causa es el sujeto y el efecto, un cambio.",
      "segments": [
        "Constant rewards bring about a",
        "change in our habits."
      ],
      "audioText": "Constant rewards bring about a change in our habits.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-2"
    },
    {
      "id": "en.n6.class-87.t03",
      "en": "This feature gives rise to much longer sessions.",
      "es": "Esta función da lugar a sesiones mucho más largas.",
      "explanationEs": "Give rise to es más formal: origina o da lugar a algo nuevo. Lleva to.",
      "segments": [
        "This feature gives rise",
        "to much longer sessions."
      ],
      "audioText": "This feature gives rise to much longer sessions.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-2"
    },
    {
      "id": "en.n6.class-87.t04",
      "en": "Her anxiety stems from comparing herself with other people online.",
      "es": "Su ansiedad proviene de compararse con otras personas en línea.",
      "explanationEs": "Stem from + causa: aquí el sujeto, anxiety, es el efecto.",
      "segments": [
        "Her anxiety stems from comparing",
        "herself with other people online."
      ],
      "audioText": "Her anxiety stems from comparing herself with other people online.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-2"
    },
    {
      "id": "en.n6.class-87.t05",
      "en": "Fear of missing out can give rise to anxiety.",
      "es": "El miedo a perderse algo puede dar lugar a ansiedad.",
      "explanationEs": "Con can, la causa se presenta como posible, no como segura.",
      "segments": [
        "Fear of missing out can",
        "give rise to anxiety."
      ],
      "audioText": "Fear of missing out can give rise to anxiety.",
