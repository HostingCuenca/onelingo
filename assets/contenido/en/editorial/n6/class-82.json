  "teaching": [
    {
      "id": "en.n6.class-82.t01",
      "en": "The more students practise, the higher their scores are.",
      "es": "Cuanto más practican los alumnos, más altas son sus puntuaciones.",
      "explanationEs": "The + comparativo …, the + comparativo: dos cosas que crecen a la vez.",
      "segments": [
        "The more students practise, the",
        "higher their scores are."
      ],
      "audioText": "The more students practise, the higher their scores are.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-2"
    },
    {
      "id": "en.n6.class-82.t02",
      "en": "The less they sleep, the more tired they feel.",
      "es": "Cuanto menos duermen, más cansados se sienten.",
      "explanationEs": "También funciona con less: the less …, the more ….",
      "segments": [
        "The less they sleep, the",
        "more tired they feel."
      ],
      "audioText": "The less they sleep, the more tired they feel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-2"
    },
    {
      "id": "en.n6.class-82.t03",
      "en": "Group A reads twice as long as Group B.",
      "es": "El grupo A lee el doble de tiempo que el grupo B.",
      "explanationEs": "Twice as + adjetivo o adverbio + as indica el doble; twice more no existe.",
      "segments": [
        "Group A reads twice as",
        "long as Group B."
      ],
      "audioText": "Group A reads twice as long as Group B.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-2"
    },
    {
      "id": "en.n6.class-82.t04",
      "en": "Group B is not nearly as active as Group A.",
      "es": "El grupo B no es ni de lejos tan activo como el grupo A.",
      "explanationEs": "Not nearly as … as … significa «mucho menos … que».",
      "segments": [
        "Group B is not nearly",
        "as active as Group A."
      ],
      "audioText": "Group B is not nearly as active as Group A.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-2"
    },
    {
      "id": "en.n6.class-82.t05",
      "en": "Class 3 has by far the highest scores in the school.",
      "es": "La clase 3 tiene con diferencia las puntuaciones más altas del colegio.",
      "explanationEs": "By far + superlativo destaca una gran distancia con el resto.",
      "segments": [
