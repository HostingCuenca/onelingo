  "teaching": [
    {
      "id": "en.n6.class-07.t01",
      "en": "Should you need anything, please contact reception.",
      "es": "Si necesita algo, por favor contacte con recepción.",
      "explanationEs": "Should + sujeto + verbo base, al empezar: un «si» formal y tentativo, sin if.",
      "segments": [
        "Should you need anything,",
        "please contact reception."
      ],
      "audioText": "Should you need anything, please contact reception.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-2"
    },
    {
      "id": "en.n6.class-07.t02",
      "en": "If you should require an extra towel, kindly call us.",
      "es": "Si necesitara una toalla adicional, le rogamos que nos llame.",
      "explanationEs": "If + should hace la condición menos probable y más cortés.",
      "segments": [
        "If you should require an",
        "extra towel, kindly call us."
      ],
      "audioText": "If you should require an extra towel, kindly call us.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-2"
    },
    {
      "id": "en.n6.class-07.t03",
      "en": "If you happen to see my luggage, please tell me.",
      "es": "Si por casualidad ve mi equipaje, avíseme.",
      "explanationEs": "Happen to significa «por casualidad»: la posibilidad es pequeña.",
      "segments": [
        "If you happen to see",
        "my luggage, please tell me."
      ],
      "audioText": "If you happen to see my luggage, please tell me.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-2"
    },
    {
      "id": "en.n6.class-07.t04",
      "en": "Were you to arrive before noon, we would keep your luggage at reception.",
      "es": "Si llegara antes del mediodía, guardaríamos su equipaje en recepción.",
      "explanationEs": "Were + sujeto + to + verbo base es la inversión de if you were to…; va con would.",
      "segments": [
        "Were you to arrive before noon, we",
        "would keep your luggage at reception."
      ],
      "audioText": "Were you to arrive before noon, we would keep your luggage at reception.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-2"
    },
    {
      "id": "en.n6.class-07.t05",
      "en": "Should any guest need help, the staff will come at once.",
      "es": "Si algún huésped necesitara ayuda, el personal acudirá enseguida.",
      "explanationEs": "Tras la inversión con should, el resultado lleva will, can o un imperativo.",
      "segments": [
        "Should any guest need help, the",
        "staff will come at once."
      ],
      "audioText": "Should any guest need help, the staff will come at once.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-2"
    }
  ],
