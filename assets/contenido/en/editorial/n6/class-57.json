  "teaching": [
    {
      "id": "en.n6.class-57.t01",
      "en": "The new library is due to open in March.",
      "es": "Está previsto que la nueva biblioteca abra en marzo.",
      "explanationEs": "Be due to + verbo base: algo esperado según el calendario.",
      "segments": [
        "The new library is due",
        "to open in March."
      ],
      "audioText": "The new library is due to open in March.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    },
    {
      "id": "en.n6.class-57.t02",
      "en": "The council is set to vote on the plan on Friday.",
      "es": "El ayuntamiento tiene previsto votar el plan el viernes.",
      "explanationEs": "Be set to + verbo base: ya está fijado y es casi seguro.",
      "segments": [
        "The council is set to vote",
        "on the plan on Friday."
      ],
      "audioText": "The council is set to vote on the plan on Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    },
    {
      "id": "en.n6.class-57.t03",
      "en": "The mayor is to announce the dates next week.",
      "es": "El alcalde anunciará las fechas la próxima semana.",
      "explanationEs": "Be to + verbo base: plan oficial, típico de noticias y actas.",
      "segments": [
        "The mayor is to announce",
        "the dates next week."
      ],
      "audioText": "The mayor is to announce the dates next week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    },
    {
      "id": "en.n6.class-57.t04",
      "en": "The council is on the point of closing the list, so send your name now.",
      "es": "El ayuntamiento está a punto de cerrar la lista, así que envía tu nombre ahora.",
      "explanationEs": "Be on the point of + -ing: a punto de, muy cerca.",
      "segments": [
        "The council is on the point of closing",
        "the list, so send your name now."
      ],
      "audioText": "The council is on the point of closing the list, so send your name now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    },
    {
      "id": "en.n6.class-57.t05",
      "en": "By Friday, Sara will have written the minutes.",
      "es": "Para el viernes, Sara habrá redactado el acta.",
      "explanationEs": "Repaso: futuro perfecto, acción terminada antes de un plazo.",
      "segments": [
        "By Friday, Sara will",
        "have written the minutes."
      ],
      "audioText": "By Friday, Sara will have written the minutes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    },
    {
      "id": "en.n6.class-57.t06",
      "en": "This time next week, we will be waiting for the council's vote.",
      "es": "A esta hora la semana que viene, estaremos esperando el voto del ayuntamiento.",
      "explanationEs": "Repaso: futuro continuo, acción en curso en un momento futuro.",
      "segments": [
        "This time next week, we will",
        "be waiting for the council's vote."
      ],
      "audioText": "This time next week, we will be waiting for the council's vote.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-2"
    }
