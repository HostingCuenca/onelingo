  "teaching": [
    {
      "id": "en.n6.class-08.t01",
      "en": "If you help me with the boxes, I promise I will bring you some cake.",
      "es": "Si me ayudas con las cajas, te prometo que te traeré pastel.",
      "explanationEs": "If + presente, will: promesa, algo bueno para quien escucha.",
      "segments": [
        "If you help me with the boxes, I",
        "promise I will bring you some cake."
      ],
      "audioText": "If you help me with the boxes, I promise I will bring you some cake.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-3"
    },
    {
      "id": "en.n6.class-08.t02",
      "en": "I warn you: if you leave your bike there, someone will take it.",
      "es": "Te aviso: si dejas tu bici ahí, alguien se la llevará.",
      "explanationEs": "Advertencia: informa de una consecuencia mala que causa otra persona o el azar.",
      "segments": [
        "I warn you: if you leave your",
        "bike there, someone will take it."
      ],
      "audioText": "I warn you: if you leave your bike there, someone will take it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-3"
    },
    {
      "id": "en.n6.class-08.t03",
      "en": "If you keep making noise, I will complain to the landlord.",
      "es": "Si sigues haciendo ruido, me quejaré al casero.",
      "explanationEs": "Amenaza: una consecuencia mala que causa quien habla para presionar.",
      "segments": [
        "If you keep making noise, I",
        "will complain to the landlord."
      ],
      "audioText": "If you keep making noise, I will complain to the landlord.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-3"
    },
    {
      "id": "en.n6.class-08.t04",
      "en": "If I were you, I would talk to him: that is my advice.",
      "es": "Yo que tú hablaría con él: ese es mi consejo.",
      "explanationEs": "Consejo: if I were you + would, sin presión y pensando en el otro.",
      "segments": [
        "If I were you, I would talk",
        "to him: that is my advice."
      ],
      "audioText": "If I were you, I would talk to him: that is my advice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-3"
    },
    {
      "id": "en.n6.class-08.t05",
      "en": "It was not a threat: she said it in a friendly tone.",
      "es": "No era una amenaza: lo dijo en un tono amistoso.",
      "explanationEs": "El tono cambia la intención: las mismas palabras pueden ser un aviso o una amenaza.",
      "segments": [
        "It was not a threat: she",
        "said it in a friendly tone."
      ],
      "audioText": "It was not a threat: she said it in a friendly tone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-3"
    }
