  "teaching": [
    {
      "id": "en.n6.class-06.t01",
      "en": "Supposing the flight is delayed, what will we do?",
      "es": "Suponiendo que el vuelo se retrase, ¿qué haremos?",
      "explanationEs": "Supposing + presente propone una hipótesis para pensar en una posibilidad.",
      "segments": [
        "Supposing the flight is delayed,",
        "what will we do?"
      ],
      "audioText": "Supposing the flight is delayed, what will we do?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-1"
    },
    {
      "id": "en.n6.class-06.t02",
      "en": "Take a spare charger in case the battery dies.",
      "es": "Lleva un cargador de repuesto por si se acaba la batería.",
      "explanationEs": "In case no significa «si»: es una precaución, algo que haces ahora por si pasa algo después.",
      "segments": [
        "Take a spare charger in",
        "case the battery dies."
      ],
      "audioText": "Take a spare charger in case the battery dies.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-1"
    },
    {
      "id": "en.n6.class-06.t03",
      "en": "We will sleep in a tent even if it rains.",
      "es": "Dormiremos en una tienda de campaña aunque llueva.",
      "explanationEs": "Even if es una concesión: la condición no cambia lo que haremos.",
      "segments": [
        "We will sleep in a",
        "tent even if it rains."
      ],
      "audioText": "We will sleep in a tent even if it rains.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-1"
    },
    {
      "id": "en.n6.class-06.t04",
      "en": "What if they cancel our booking?",
      "es": "¿Y si cancelan nuestra reserva?",
      "explanationEs": "What if + presente pregunta por una posibilidad, a menudo con preocupación.",
      "segments": [
        "What if they",
        "cancel our booking?"
      ],
      "audioText": "What if they cancel our booking?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-1"
    },
    {
      "id": "en.n6.class-06.t05",
      "en": "If the company cancels the trip, we get a refund.",
      "es": "Si la empresa cancela el viaje, nos devuelven el dinero.",
      "explanationEs": "If + presente es la condición normal: si pasa A, ocurre B. Compárala con in case.",
      "segments": [
        "If the company cancels the",
        "trip, we get a refund."
      ],
      "audioText": "If the company cancels the trip, we get a refund.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-conditional-nuance-1"
    }
  ],
