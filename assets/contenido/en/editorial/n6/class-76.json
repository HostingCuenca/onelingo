  "teaching": [
    {
      "id": "en.n6.class-76.t01",
      "en": "A headline can frame a story in different ways.",
      "es": "Un titular puede dar un enfoque distinto a una misma noticia.",
      "explanationEs": "Frame: el titular orienta cómo vas a leer la noticia antes de leerla.",
      "segments": [
        "A headline can frame a",
        "story in different ways."
      ],
      "audioText": "A headline can frame a story in different ways.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    },
    {
      "id": "en.n6.class-76.t02",
      "en": "Words like shocking and slashed are loaded: they carry strong feelings.",
      "es": "Palabras como impactante y recortó están cargadas: llevan emociones fuertes.",
      "explanationEs": "Loaded: una palabra que añade emoción o juicio además del hecho.",
      "segments": [
        "Words like shocking and slashed are",
        "loaded: they carry strong feelings."
      ],
      "audioText": "Words like shocking and slashed are loaded: they carry strong feelings.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    },
    {
      "id": "en.n6.class-76.t03",
      "en": "A neutral headline says what happened without strong feelings.",
      "es": "Un titular neutral dice qué pasó sin emociones fuertes.",
      "explanationEs": "Neutral: verbos como closes o announces solo informan.",
      "segments": [
        "A neutral headline says what",
        "happened without strong feelings."
      ],
      "audioText": "A neutral headline says what happened without strong feelings.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    },
    {
      "id": "en.n6.class-76.t04",
      "en": "Some headlines omit the reason for the decision.",
      "es": "Algunos titulares omiten la razón de la decisión.",
      "explanationEs": "Omit: dejar fuera un dato. Lo que falta también orienta al lector.",
      "segments": [
        "Some headlines omit the",
        "reason for the decision."
      ],
      "audioText": "Some headlines omit the reason for the decision.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    },
    {
      "id": "en.n6.class-76.t05",
      "en": "The writer chose to highlight the cost, not the children.",
      "es": "El autor eligió destacar el coste, no a los niños.",
      "explanationEs": "Highlight: poner un dato en primer plano para que pese más.",
      "segments": [
        "The writer chose to highlight",
        "the cost, not the children."
      ],
      "audioText": "The writer chose to highlight the cost, not the children.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    },
    {
      "id": "en.n6.class-76.t06",
      "en": "The tone of the first headline is angry, and the tone of the second is calm.",
      "es": "El tono del primer titular es enfadado y el del segundo es tranquilo.",
      "explanationEs": "Tone: la actitud que transmiten las palabras elegidas.",
      "segments": [
        "The tone of the first headline is angry,",
        "and the tone of the second is calm."
      ],
      "audioText": "The tone of the first headline is angry, and the tone of the second is calm.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-1"
    }
  ],
