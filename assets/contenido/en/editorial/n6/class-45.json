  "teaching": [
    {
      "id": "en.n6.class-45.t01",
      "en": "Our school throws away four hundred plastic bottles every week.",
      "es": "Nuestro colegio tira cuatrocientas botellas de plástico cada semana.",
      "explanationEs": "Un dato concreto da fuerza al mensaje: cifra + qué + periodo. Four hundred no lleva -s.",
      "segments": [
        "Our school throws away four",
        "hundred plastic bottles every week."
      ],
      "audioText": "Our school throws away four hundred plastic bottles every week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-5"
    },
    {
      "id": "en.n6.class-45.t02",
      "en": "Our slogan is short: bring your own bottle.",
      "es": "Nuestro lema es corto: trae tu propia botella.",
      "explanationEs": "Un buen lema es breve, fácil de repetir y empieza con un verbo.",
      "segments": [
        "Our slogan is short:",
        "bring your own bottle."
      ],
      "audioText": "Our slogan is short: bring your own bottle.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-5"
    },
    {
      "id": "en.n6.class-45.t03",
      "en": "Who wants to see the playground full of plastic?",
      "es": "¿Quién quiere ver el patio lleno de plástico?",
      "explanationEs": "Pregunta retórica: engancha al público con una imagen que nadie desea.",
      "segments": [
        "Who wants to see the",
        "playground full of plastic?"
      ],
      "audioText": "Who wants to see the playground full of plastic?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-5"
    },
    {
      "id": "en.n6.class-45.t04",
      "en": "What this campaign needs is your help.",
      "es": "Lo que necesita esta campaña es tu ayuda.",
      "explanationEs": "Cleft con What: destaca la petición principal antes de pedirla.",
      "segments": [
        "What this campaign needs",
        "is your help."
      ],
      "audioText": "What this campaign needs is your help.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-5"
    },
    {
      "id": "en.n6.class-45.t05",
      "en": "I understand your concern, but a good bottle lasts for years.",
      "es": "Entiendo tu preocupación, pero una buena botella dura años.",
      "explanationEs": "Responder a una objeción: reconoce primero (I understand), contrasta con but y da un dato.",
      "segments": [
        "I understand your concern, but a",
        "good bottle lasts for years."
      ],
      "audioText": "I understand your concern, but a good bottle lasts for years.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-5"
    },
    {
      "id": "en.n6.class-45.t06",
      "en": "Your objection is fair, but the numbers are clear.",
      "es": "Tu objeción es razonable, pero las cifras son claras.",
      "explanationEs": "Otra forma de empezar la respuesta: acepta lo justo y vuelve a los datos.",
      "segments": [
