  "teaching": [
    {
      "id": "en.n6.class-32.t01",
      "en": "My neighbour is said to be a famous writer.",
      "es": "Se dice que mi vecino es un escritor famoso.",
      "explanationEs": "Sujeto personal + is said + to + verbo base: lo que se dice ahora. Equivale a It is said that my neighbour is a famous writer.",
      "segments": [
        "My neighbour is said to",
        "be a famous writer."
      ],
      "audioText": "My neighbour is said to be a famous writer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    },
    {
      "id": "en.n6.class-32.t02",
      "en": "The writer is believed to be living in a small town now.",
      "es": "Se cree que el escritor vive ahora en un pueblo pequeño.",
      "explanationEs": "to be + -ing: algo que está en curso en este momento.",
      "segments": [
        "The writer is believed to be",
        "living in a small town now."
      ],
      "audioText": "The writer is believed to be living in a small town now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    },
    {
      "id": "en.n6.class-32.t03",
      "en": "She is thought to have won the lottery last year.",
      "es": "Se piensa que ella ganó la lotería el año pasado.",
      "explanationEs": "to have + participio: lo que se dice ocurrió antes.",
      "segments": [
        "She is thought to have",
        "won the lottery last year."
      ],
      "audioText": "She is thought to have won the lottery last year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    },
    {
      "id": "en.n6.class-32.t04",
      "en": "The writer is known to have retired early.",
      "es": "Se sabe que el escritor se jubiló pronto.",
      "explanationEs": "is known to have: con más certeza que said o thought, pero con la misma forma.",
      "segments": [
        "The writer is known",
        "to have retired early."
      ],
      "audioText": "The writer is known to have retired early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    },
    {
      "id": "en.n6.class-32.t05",
      "en": "The neighbour is expected to move house next month.",
      "es": "Se espera que el vecino se mude de casa el mes que viene.",
      "explanationEs": "is expected to + verbo base: expectativa de futuro.",
      "segments": [
        "The neighbour is expected to",
        "move house next month."
      ],
      "audioText": "The neighbour is expected to move house next month.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    },
    {
      "id": "en.n6.class-32.t06",
      "en": "The mayor is reported to be planning a new park.",
      "es": "Según informan, el alcalde planea un parque nuevo.",
      "explanationEs": "is reported to be + -ing: una noticia sobre algo en curso.",
      "segments": [
        "The mayor is reported to",
        "be planning a new park."
      ],
      "audioText": "The mayor is reported to be planning a new park.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-2"
    }
  ],
