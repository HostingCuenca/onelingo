  "teaching": [
    {
      "id": "en.n6.class-63.t01",
      "en": "Ana's position is clear: she needs the spare room on weekday evenings.",
      "es": "La postura de Ana es clara: necesita la habitación libre por las tardes entre semana.",
      "explanationEs": "Position: lo que alguien quiere conseguir. En el audio suele aparecer con need, want o I'd like.",
      "segments": [
        "Ana's position is clear: she needs",
        "the spare room on weekday evenings."
      ],
      "audioText": "Ana's position is clear: she needs the spare room on weekday evenings.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-3"
    },
    {
      "id": "en.n6.class-63.t02",
      "en": "Leo's limit is Saturday: he will not give it up.",
      "es": "El límite de Leo es el sábado: no va a renunciar a él.",
      "explanationEs": "Limit: lo que no acepta. Se oye con can't, won't o not after…",
      "segments": [
        "Leo's limit is Saturday: he",
        "will not give it up."
      ],
      "audioText": "Leo's limit is Saturday: he will not give it up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-3"
    },
    {
      "id": "en.n6.class-63.t03",
      "en": "Leo insists on keeping Saturday, but he is flexible about Sunday.",
      "es": "Leo insiste en quedarse con el sábado, pero es flexible con el domingo.",
      "explanationEs": "Insists on + -ing marca una postura firme; flexible indica que hay margen para negociar.",
      "segments": [
        "Leo insists on keeping Saturday, but",
        "he is flexible about Sunday."
      ],
      "audioText": "Leo insists on keeping Saturday, but he is flexible about Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-3"
    },
    {
      "id": "en.n6.class-63.t04",
      "en": "In return, Leo accepts a limit: he will stop playing at eight.",
      "es": "A cambio, Leo acepta un límite: dejará de tocar a las ocho.",
      "explanationEs": "In return: lo que uno ofrece a cambio de que el otro ceda.",
      "segments": [
        "In return, Leo accepts a limit:",
        "he will stop playing at eight."
      ],
      "audioText": "In return, Leo accepts a limit: he will stop playing at eight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-3"
    },
    {
      "id": "en.n6.class-63.t05",
      "en": "They reach a compromise: Ana takes the weekdays and Sunday, and Leo keeps Saturday.",
      "es": "Llegan a un compromiso: Ana se queda con los días laborables y el domingo, y Leo conserva el sábado.",
      "explanationEs": "Reach a compromise: llegar a un punto medio que aceptan los dos.",
      "segments": [
        "They reach a compromise: Ana takes the",
        "weekdays and Sunday, and Leo keeps Saturday."
