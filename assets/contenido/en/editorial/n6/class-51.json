  "teaching": [
    {
      "id": "en.n6.class-51.t01",
      "en": "A good leader is level-headed: she stays calm when a plan fails.",
      "es": "Una buena líder es sensata: mantiene la calma cuando un plan falla.",
      "explanationEs": "Level-headed = sereno; se justifica con lo que la persona hace.",
      "segments": [
        "A good leader is level-headed: she",
        "stays calm when a plan fails."
      ],
      "audioText": "A good leader is level-headed: she stays calm when a plan fails.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    },
    {
      "id": "en.n6.class-51.t02",
      "en": "An open-minded leader listens to every idea, even when she disagrees.",
      "es": "Un líder de mente abierta escucha todas las ideas, aunque no esté de acuerdo.",
      "explanationEs": "Open-minded = abierto a ideas distintas de las propias.",
      "segments": [
        "An open-minded leader listens to every",
        "idea, even when she disagrees."
      ],
      "audioText": "An open-minded leader listens to every idea, even when she disagrees.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    },
    {
      "id": "en.n6.class-51.t03",
      "en": "Sara is a reliable leader: she always finishes the tasks she promises.",
      "es": "Sara es una líder de confianza: siempre termina las tareas que promete.",
      "explanationEs": "Reliable = de confianza; se nota en lo que cumple.",
      "segments": [
        "Sara is a reliable leader: she",
        "always finishes the tasks she promises."
      ],
      "audioText": "Sara is a reliable leader: she always finishes the tasks she promises.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    },
    {
      "id": "en.n6.class-51.t04",
      "en": "A decisive leader chooses quickly, but a supportive leader also listens to the team.",
      "es": "Un líder decidido elige rápido, pero un líder que apoya también escucha al equipo.",
      "explanationEs": "Decisive = decide rápido; supportive = anima y ayuda.",
      "segments": [
        "A decisive leader chooses quickly, but a",
        "supportive leader also listens to the team."
      ],
      "audioText": "A decisive leader chooses quickly, but a supportive leader also listens to the team.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    },
    {
      "id": "en.n6.class-51.t05",
      "en": "Our easy-going leader never shouts, so the team feels relaxed.",
      "es": "Nuestro líder tranquilo nunca grita, así que el equipo se siente relajado.",
      "explanationEs": "Easy-going = tranquilo y flexible; el guion une las dos palabras.",
      "segments": [
        "Our easy-going leader never shouts,",
        "so the team feels relaxed."
      ],
      "audioText": "Our easy-going leader never shouts, so the team feels relaxed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    },
    {
      "id": "en.n6.class-51.t06",
      "en": "Patience is a trait that makes people follow a leader.",
      "es": "La paciencia es un rasgo que hace que la gente siga a un líder.",
      "explanationEs": "Trait = rasgo de carácter; follow = seguir a alguien que guía.",
      "segments": [
        "Patience is a trait that",
        "makes people follow a leader."
      ],
      "audioText": "Patience is a trait that makes people follow a leader.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-leading-a-group-1"
    }
  ],
