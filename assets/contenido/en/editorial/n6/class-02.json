  "teaching": [
    {
      "id": "en.n6.class-02.t01",
      "en": "You would interrupt me just when I am telling the best part!",
      "es": "¡Típico de ti: me interrumpes justo cuando cuento lo mejor!",
      "explanationEs": "Would acentuado (se dice con énfasis): critica algo típico de esa persona; no habla del pasado.",
      "segments": [
        "You would interrupt me just when",
        "I am telling the best part!"
      ],
      "audioText": "You would interrupt me just when I am telling the best part!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-2"
    },
    {
      "id": "en.n6.class-02.t02",
      "en": "Sara keeps boasting about her marks, and it gets boring.",
      "es": "Sara no deja de presumir de sus notas, y ya aburre.",
      "explanationEs": "Keep + -ing: repetir algo sin parar; suele sonar a crítica.",
      "segments": [
        "Sara keeps boasting about her",
        "marks, and it gets boring."
      ],
      "audioText": "Sara keeps boasting about her marks, and it gets boring.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-2"
    },
    {
      "id": "en.n6.class-02.t03",
      "en": "When we were little, Grandpa would spoil us with sweets.",
      "es": "Cuando éramos pequeños, el abuelo nos consentía con dulces.",
      "explanationEs": "Would neutro: costumbre del pasado, sin crítica. Se puede cambiar por used to.",
      "segments": [
        "When we were little, Grandpa",
        "would spoil us with sweets."
      ],
      "audioText": "When we were little, Grandpa would spoil us with sweets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-2"
    },
    {
      "id": "en.n6.class-02.t04",
      "en": "Leo took the last slice? He would! That is so typical, and so selfish.",
      "es": "¿Leo tomó el último trozo? ¡Normal en él! Es tan típico y tan egoísta.",
      "explanationEs": "«He would!» reacciona con irritación: confirmas que es propio de él.",
      "segments": [
        "Leo took the last slice? He would!",
        "That is so typical, and so selfish."
      ],
      "audioText": "Leo took the last slice? He would! That is so typical, and so selfish.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-2"
    },
    {
      "id": "en.n6.class-02.t05",
      "en": "We used to gossip after school, but now we study together.",
      "es": "Antes chismorreábamos después de clase, pero ahora estudiamos juntos.",
      "explanationEs": "Used to + verbo base: hábito o estado pasado que ya no existe; aquí no hay crítica.",
      "segments": [
        "We used to gossip after school,",
        "but now we study together."
      ],
      "audioText": "We used to gossip after school, but now we study together.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-2"
    }
