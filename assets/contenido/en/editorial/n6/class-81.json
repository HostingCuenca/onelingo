  "teaching": [
    {
      "id": "en.n6.class-81.t01",
      "en": "The survey shows that the majority of students walk to school.",
      "es": "La encuesta muestra que la mayoría de los alumnos va caminando al colegio.",
      "explanationEs": "The majority of + plural usa el verbo en plural: the majority walk. Significa más de la mitad.",
      "segments": [
        "The survey shows that the majority",
        "of students walk to school."
      ],
      "audioText": "The survey shows that the majority of students walk to school.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-1"
    },
    {
      "id": "en.n6.class-81.t02",
      "en": "About a third of the class chose pizza for lunch.",
      "es": "Alrededor de un tercio de la clase eligió pizza para comer.",
      "explanationEs": "A third es 1/3. About suena a «más o menos»: no se da la cifra exacta.",
      "segments": [
        "About a third of the",
        "class chose pizza for lunch."
      ],
      "audioText": "About a third of the class chose pizza for lunch.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-1"
    },
    {
      "id": "en.n6.class-81.t03",
      "en": "Only a quarter of the students bring lunch from home.",
      "es": "Solo una cuarta parte de los alumnos trae la comida de casa.",
      "explanationEs": "A quarter es 1/4. Only lo presenta como una proporción pequeña.",
      "segments": [
        "Only a quarter of the",
        "students bring lunch from home."
      ],
      "audioText": "Only a quarter of the students bring lunch from home.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-research-and-data-1"
    },
    {
      "id": "en.n6.class-81.t04",
      "en": "Twice as many girls as boys joined the drama club.",
      "es": "El doble de chicas que de chicos se apuntó al club de teatro.",
      "explanationEs": "Twice as many … as … compara dos cantidades: la primera es el doble de la segunda.",
      "segments": [
        "Twice as many girls as",
        "boys joined the drama club."
      ],
      "audioText": "Twice as many girls as boys joined the drama club.",
