  "teaching": [
    {
      "id": "en.n6.class-05.t01",
      "en": "At the family reunion, a relative told us a story about his first job.",
      "es": "En la reunión familiar, un pariente nos contó una historia de su primer trabajo.",
      "explanationEs": "El pasado simple presenta la situación: quién cuenta y cuándo.",
      "segments": [
        "At the family reunion, a relative told",
        "us a story about his first job."
      ],
      "audioText": "At the family reunion, a relative told us a story about his first job.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-5"
    },
    {
      "id": "en.n6.class-05.t02",
      "en": "Earlier that day, he had lost his wallet, so he was already nervous.",
      "es": "Más temprano ese día había perdido la cartera, así que ya estaba nervioso.",
      "explanationEs": "Earlier that day + had + participio: un hecho anterior al momento principal.",
      "segments": [
        "Earlier that day, he had lost his",
        "wallet, so he was already nervous."
      ],
      "audioText": "Earlier that day, he had lost his wallet, so he was already nervous.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-narrative-precision-5"
    },
    {
      "id": "en.n6.class-05.t03",
      "en": "Meanwhile, his wife was waiting outside in the car.",
      "es": "Mientras tanto, su esposa esperaba fuera, en el coche.",
      "explanationEs": "Meanwhile presenta otra acción que ocurría a la vez; se usa el pasado continuo.",
