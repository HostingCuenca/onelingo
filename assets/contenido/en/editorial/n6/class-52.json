      "patternId": "n6-leading-a-group-2"
    },
    {
      "id": "en.n6.class-52.t02",
      "en": "Would you be willing to hand out the leaflets at the door?",
      "es": "¿Estarías dispuesto a repartir los folletos en la puerta?",
