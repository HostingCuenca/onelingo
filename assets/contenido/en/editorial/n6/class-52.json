    },
    {
      "id": "en.n6.class-52.t03",
      "en": "It'd be great if you could finish the task by Friday.",
      "es": "Sería genial que pudieras terminar la tarea para el viernes.",
      "explanationEs": "It'd be great if you could + verbo base; by Friday marca el plazo.",
