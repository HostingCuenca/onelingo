  "teaching": [
    {
      "id": "en.n6.class-96.t01",
      "en": "The writer's thesis is that cities should close their centres to cars.",
      "es": "La tesis de la autora es que las ciudades deberían cerrar sus centros a los coches.",
      "explanationEs": "La tesis es la idea principal que el autor defiende; suele aparecer al inicio o al final.",
      "segments": [
        "The writer's thesis is that cities",
        "should close their centres to cars."
      ],
      "audioText": "The writer's thesis is that cities should close their centres to cars.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    },
    {
      "id": "en.n6.class-96.t02",
      "en": "She supports her thesis with a statistic: air pollution fell by a third.",
      "es": "Apoya su tesis con un dato: la contaminación del aire bajó un tercio.",
      "explanationEs": "Los recursos (datos, ejemplos, citas) sostienen la tesis: pregunta con qué la apoya.",
      "segments": [
        "She supports her thesis with a statistic:",
        "air pollution fell by a third."
      ],
      "audioText": "She supports her thesis with a statistic: air pollution fell by a third.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    },
    {
      "id": "en.n6.class-96.t03",
      "en": "However, critics point out that shops may lose customers.",
      "es": "Sin embargo, los críticos señalan que las tiendas podrían perder clientes.",
      "explanationEs": "However marca contraste; may deja abierta la posibilidad, sin afirmarla.",
      "segments": [
        "However, critics point out that",
        "shops may lose customers."
      ],
      "audioText": "However, critics point out that shops may lose customers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    },
    {
      "id": "en.n6.class-96.t04",
      "en": "This will probably help, but it could also cause new problems.",
      "es": "Esto probablemente ayudará, pero también podría causar nuevos problemas.",
      "explanationEs": "Los matizadores muestran la certeza: will es seguro; probably y could dejan margen.",
      "segments": [
        "This will probably help, but it",
        "could also cause new problems."
      ],
      "audioText": "This will probably help, but it could also cause new problems.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    },
    {
      "id": "en.n6.class-96.t05",
      "en": "In fact, the evidence seems to suggest a clear trend.",
      "es": "De hecho, las pruebas parecen sugerir una tendencia clara.",
      "explanationEs": "In fact refuerza lo dicho; seems to suggest suaviza la afirmación.",
      "segments": [
        "In fact, the evidence seems",
        "to suggest a clear trend."
      ],
      "audioText": "In fact, the evidence seems to suggest a clear trend.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    },
    {
      "id": "en.n6.class-96.t06",
      "en": "Therefore, the writer concludes that the plan is worth trying.",
      "es": "Por lo tanto, la autora concluye que el plan merece la pena.",
      "explanationEs": "Therefore introduce la conclusión, que suele cerrar el texto.",
      "segments": [
        "Therefore, the writer concludes that",
        "the plan is worth trying."
      ],
      "audioText": "Therefore, the writer concludes that the plan is worth trying.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-1"
    }
  ],
