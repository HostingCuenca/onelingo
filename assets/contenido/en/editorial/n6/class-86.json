  "teaching": [
    {
      "id": "en.n6.class-86.t01",
      "en": "Constant notifications lead to a lack of attention.",
      "es": "Las notificaciones constantes llevan a una falta de atención.",
      "explanationEs": "A lead to B: A es la causa y B el efecto. Después de to va un sustantivo.",
      "segments": [
        "Constant notifications lead to",
        "a lack of attention."
      ],
      "audioText": "Constant notifications lead to a lack of attention.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-1"
    },
    {
      "id": "en.n6.class-86.t02",
      "en": "Using a phone in bed can result in poor sleep.",
      "es": "Usar el móvil en la cama puede dar como resultado un mal sueño.",
      "explanationEs": "Result in + efecto. No lo confundas con result from, que señala la causa.",
      "segments": [
        "Using a phone in bed",
        "can result in poor sleep."
      ],
      "audioText": "Using a phone in bed can result in poor sleep.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-technology-and-habits-1"
    },
    {
      "id": "en.n6.class-86.t03",
      "en": "Many sleep problems stem from late screen time.",
      "es": "Muchos problemas de sueño provienen del tiempo de pantalla por la noche.",
      "explanationEs": "Stem from + causa: el sujeto de la frase es el efecto.",
      "segments": [
