  "teaching": [
    {
      "id": "en.n6.class-47.t01",
      "en": "Whether it rains or not, the festival in Norton starts at six.",
      "es": "Tanto si llueve como si no, el festival de Norton empieza a las seis.",
      "explanationEs": "Whether…or not: la condición no cambia el resultado. Se usa con el presente, sin will.",
      "segments": [
        "Whether it rains or not, the",
        "festival in Norton starts at six."
      ],
      "audioText": "Whether it rains or not, the festival in Norton starts at six.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    },
    {
      "id": "en.n6.class-47.t02",
      "en": "Many people in Weston walk rather than drive.",
      "es": "Mucha gente de Weston camina en lugar de conducir.",
      "explanationEs": "Rather than une dos acciones con la misma forma: walk… drive.",
      "segments": [
        "Many people in Weston",
        "walk rather than drive."
      ],
      "audioText": "Many people in Weston walk rather than drive.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    },
    {
      "id": "en.n6.class-47.t03",
      "en": "Norton has a river as well as a big park.",
      "es": "Norton tiene un río además de un gran parque.",
      "explanationEs": "As well as suma un elemento: un río, y también un parque.",
      "segments": [
        "Norton has a river as",
        "well as a big park."
      ],
      "audioText": "Norton has a river as well as a big park.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    },
    {
      "id": "en.n6.class-47.t04",
      "en": "The beach is not in Norton but in Weston.",
      "es": "La playa no está en Norton, sino en Weston.",
      "explanationEs": "Not… but… corrige o contrasta: primero lo que no es y luego lo que sí es.",
      "segments": [
        "The beach is not in",
        "Norton but in Weston."
      ],
      "audioText": "The beach is not in Norton but in Weston.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    },
    {
      "id": "en.n6.class-47.t05",
      "en": "Both cities have museums, but neither city has a zoo.",
      "es": "Ambas ciudades tienen museos, pero ninguna tiene zoológico.",
      "explanationEs": "Both suma las dos; neither niega las dos con un verbo afirmativo (has, no doesn't have).",
      "segments": [
        "Both cities have museums, but",
        "neither city has a zoo."
      ],
      "audioText": "Both cities have museums, but neither city has a zoo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    },
    {
      "id": "en.n6.class-47.t06",
      "en": "You can take either the train or the bus to Weston.",
      "es": "Puedes tomar el tren o el autobús para ir a Weston.",
      "explanationEs": "Either… or… ofrece una opción entre dos: una u otra.",
      "segments": [
        "You can take either the train",
        "or the bus to Weston."
      ],
      "audioText": "You can take either the train or the bus to Weston.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-cohesion-and-linking-2"
    }
  ],
