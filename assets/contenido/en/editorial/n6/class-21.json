    {
      "id": "en.n6.class-21.t01",
      "en": "The decision to close the library surprised the residents.",
      "es": "La decisión de cerrar la biblioteca sorprendió a los vecinos.",
      "explanationEs": "Decide pasa a decision: «the decision to close» equivale a «decidieron cerrar».",
      "segments": [
        "The decision to close the",
        "library surprised the residents."
      ],
      "audioText": "The decision to close the library surprised the residents.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-1"
    },
    {
      "id": "en.n6.class-21.t02",
      "en": "The arrival of the new bus made the journey shorter.",
      "es": "La llegada del autobús nuevo acortó el trayecto.",
      "explanationEs": "Arrive pasa a arrival con -al: la acción de llegar se convierte en una cosa.",
      "segments": [
        "The arrival of the new",
        "bus made the journey shorter."
      ],
      "audioText": "The arrival of the new bus made the journey shorter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-1"
    },
    {
      "id": "en.n6.class-21.t03",
      "en": "The headline says there was an increase in prices.",
      "es": "El titular dice que hubo un aumento de precios.",
      "explanationEs": "Los titulares condensan «los precios aumentaron» en an increase in prices.",
      "segments": [
        "The headline says there was",
        "an increase in prices."
      ],
      "audioText": "The headline says there was an increase in prices.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-1"
    },
    {
      "id": "en.n6.class-21.t04",
      "en": "There was a reduction in noise after the new rule.",
      "es": "Hubo una reducción del ruido después de la nueva norma.",
      "explanationEs": "Reduce pasa a reduction; el sustantivo pide la preposición in.",
      "segments": [
        "There was a reduction in",
        "noise after the new rule."
      ],
      "audioText": "There was a reduction in noise after the new rule.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-1"
    },
    {
      "id": "en.n6.class-21.t05",
      "en": "Safety is the reason for the new rule.",
      "es": "La seguridad es el motivo de la nueva norma.",
      "explanationEs": "El adjetivo safe se convierte en el sustantivo safety.",
      "segments": [
        "Safety is the reason",
        "for the new rule."
      ],
      "audioText": "Safety is the reason for the new rule.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-1"
    },
    {
      "id": "en.n6.class-21.t06",
      "en": "The introduction of the bus lane led to an improvement in the service.",
      "es": "La introducción del carril bus llevó a una mejora del servicio.",
      "explanationEs": "Introduce → introduction e improve → improvement: dos verbos escondidos en una sola frase.",
      "segments": [
