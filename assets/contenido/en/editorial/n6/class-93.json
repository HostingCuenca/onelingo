  "teaching": [
    {
      "id": "en.n6.class-93.t01",
      "en": "The song sounds happy, but the lyrics are actually quite sad.",
      "es": "La canción suena alegre, pero la letra es en realidad bastante triste.",
      "explanationEs": "La música y la letra pueden tener tonos distintos: el mensaje está en las palabras.",
      "segments": [
        "The song sounds happy, but the",
        "lyrics are actually quite sad."
      ],
      "audioText": "The song sounds happy, but the lyrics are actually quite sad.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-3"
    },
    {
      "id": "en.n6.class-93.t02",
      "en": "In the chorus, the singer repeats one line: I wish I had stayed.",
      "es": "En el estribillo, la cantante repite un verso: ojalá me hubiera quedado.",
      "explanationEs": "Wish + had + participio expresa arrepentimiento; el estribillo repite la idea central.",
      "segments": [
        "In the chorus, the singer repeats one",
        "line: I wish I had stayed."
      ],
      "audioText": "In the chorus, the singer repeats one line: I wish I had stayed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-3"
    },
    {
      "id": "en.n6.class-93.t03",
      "en": "The tone is hopeful, but the last verse sounds bitter.",
      "es": "El tono es esperanzado, pero la última estrofa suena amarga.",
      "explanationEs": "Para describir el tono usa adjetivos: hopeful, bitter, lonely. Puede cambiar entre estrofas.",
      "segments": [
        "The tone is hopeful, but",
        "the last verse sounds bitter."
      ],
      "audioText": "The tone is hopeful, but the last verse sounds bitter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-3"
    },
    {
      "id": "en.n6.class-93.t04",
      "en": "The clip is meant to show how lonely a big city can feel.",
      "es": "El videoclip pretende mostrar lo solo que puede sentirse uno en una gran ciudad.",
      "explanationEs": "Be meant to + verbo base expresa la intención del autor.",
      "segments": [
        "The clip is meant to show how",
        "lonely a big city can feel."
      ],
      "audioText": "The clip is meant to show how lonely a big city can feel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-3"
    },
    {
      "id": "en.n6.class-93.t05",
      "en": "I think the message is that we should not wait for a perfect moment.",
      "es": "Creo que el mensaje es que no debemos esperar al momento perfecto.",
      "explanationEs": "Para dar tu reacción, empieza con I think y termina con una razón del texto.",
      "segments": [
        "I think the message is that we",
        "should not wait for a perfect moment."
      ],
      "audioText": "I think the message is that we should not wait for a perfect moment.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-3"
    }
