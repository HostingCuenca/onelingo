  "teaching": [
    {
      "id": "en.n6.class-61.t01",
      "en": "My offer is eighty dollars for the bike.",
      "es": "Mi oferta son ochenta dólares por la bicicleta.",
      "explanationEs": "Offer: alguien propone una cifra o una condición. Con ella empieza la negociación.",
      "segments": [
        "My offer is eighty",
        "dollars for the bike."
      ],
      "audioText": "My offer is eighty dollars for the bike.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-1"
    },
    {
      "id": "en.n6.class-61.t02",
      "en": "That price is too high, so Mia made a counteroffer of sixty dollars.",
      "es": "Ese precio es demasiado alto, así que Mia hizo una contraoferta de sesenta dólares.",
      "explanationEs": "Counteroffer: respondes a una oferta con otra cifra o condición, sin rechazar de plano.",
      "segments": [
        "That price is too high, so Mia",
        "made a counteroffer of sixty dollars."
      ],
      "audioText": "That price is too high, so Mia made a counteroffer of sixty dollars.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-1"
    },
    {
      "id": "en.n6.class-61.t03",
      "en": "I'm afraid I have to refuse, but I could go a little lower.",
      "es": "Me temo que tengo que rechazar, pero podría bajar un poco.",
      "explanationEs": "Refuse + but: rechazas con tacto y dejas una puerta abierta. Lower significa más bajo.",
      "segments": [
        "I'm afraid I have to refuse, but",
        "I could go a little lower."
      ],
      "audioText": "I'm afraid I have to refuse, but I could go a little lower.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-1"
    },
    {
      "id": "en.n6.class-61.t04",
      "en": "Seventy is a reasonable price, so I accept.",
      "es": "Setenta es un precio razonable, así que acepto.",
      "explanationEs": "Accept cierra la negociación. Reasonable describe un precio que se considera justo.",
      "segments": [
        "Seventy is a reasonable",
        "price, so I accept."
      ],
      "audioText": "Seventy is a reasonable price, so I accept.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-1"
    },
    {
      "id": "en.n6.class-61.t05",
      "en": "OK, seventy dollars. It's a deal!",
      "es": "De acuerdo, setenta dólares. ¡Trato hecho!",
      "explanationEs": "It's a deal: el cierre habitual y amistoso. El sujeto it es obligatorio en inglés.",
      "segments": [
        "OK, seventy dollars.",
        "It's a deal!"
      ],
      "audioText": "OK, seventy dollars. It's a deal!",
