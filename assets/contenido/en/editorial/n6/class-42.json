  "teaching": [
    {
      "id": "en.n6.class-42.t01",
      "en": "What worries the students is the noise in the old library.",
      "es": "Lo que preocupa a los estudiantes es el ruido de la vieja biblioteca.",
      "explanationEs": "What + verbo + is + dato: pone el foco en una cosa. Después de is va el dato destacado.",
      "segments": [
        "What worries the students is the",
        "noise in the old library."
      ],
      "audioText": "What worries the students is the noise in the old library.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-2"
    },
    {
      "id": "en.n6.class-42.t02",
      "en": "It was Sara who started the petition.",
      "es": "Fue Sara quien empezó la petición.",
      "explanationEs": "It was + persona + who + verbo: destaca quién lo hizo. Con personas, who.",
      "segments": [
        "It was Sara who",
        "started the petition."
      ],
      "audioText": "It was Sara who started the petition.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-2"
    },
    {
      "id": "en.n6.class-42.t03",
      "en": "All I want is a quiet place to study.",
      "es": "Lo único que quiero es un lugar tranquilo para estudiar.",
      "explanationEs": "All + sujeto + verbo + is: «lo único que». Sin what después de all.",
      "segments": [
        "All I want is a",
        "quiet place to study."
      ],
      "audioText": "All I want is a quiet place to study.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-2"
    },
    {
      "id": "en.n6.class-42.t04",
      "en": "It is the volunteers who make the difference.",
      "es": "Son los voluntarios quienes marcan la diferencia.",
      "explanationEs": "El verbo de who concuerda con el dato destacado: volunteers, plural, por eso make.",
      "segments": [
        "It is the volunteers",
        "who make the difference."
      ],
      "audioText": "It is the volunteers who make the difference.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-2"
    },
    {
      "id": "en.n6.class-42.t05",
      "en": "What we did was write a letter to the mayor.",
      "es": "Lo que hicimos fue escribir una carta al alcalde.",
      "explanationEs": "Después de What we did was va el verbo en forma base: write, no wrote.",
      "segments": [
        "What we did was write",
        "a letter to the mayor."
      ],
      "audioText": "What we did was write a letter to the mayor.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-2"
    }
  ],
