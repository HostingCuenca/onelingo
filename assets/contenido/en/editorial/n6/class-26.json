      "patternId": "n6-non-finite-forms-1"
    },
    {
      "id": "en.n6.class-26.t02",
      "en": "Feeling tired, Mia went to bed early.",
      "es": "Sintiéndose cansada, Mia se acostó temprano.",
      "explanationEs": "Feeling tired = «como se sentía cansada»: el participio puede dar el motivo.",
      "segments": [
