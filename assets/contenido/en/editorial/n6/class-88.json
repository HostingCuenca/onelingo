      "languageCode": "en",
      "patternId": "n6-technology-and-habits-3"
    },
    {
      "id": "en.n6.class-88.t02",
      "en": "One benefit is that students can look up information quickly.",
      "es": "Un beneficio es que los alumnos pueden buscar información rápido.",
      "explanationEs": "One benefit is that … introduce una ventaja; después va una oración completa.",
