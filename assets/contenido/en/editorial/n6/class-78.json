  "teaching": [
    {
      "id": "en.n6.class-78.t01",
      "en": "Each outlet reports that the town market opened on Saturday.",
      "es": "Cada medio informa de que el mercado del pueblo abrió el sábado.",
      "explanationEs": "Outlet: un medio de comunicación (periódico, radio, web).",
      "segments": [
        "Each outlet reports that the",
        "town market opened on Saturday."
      ],
      "audioText": "Each outlet reports that the town market opened on Saturday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    },
    {
      "id": "en.n6.class-78.t02",
      "en": "This version says that two thousand people came, but the other says five thousand.",
      "es": "Esta versión dice que vinieron dos mil personas, pero la otra dice cinco mil.",
      "explanationEs": "Version: cada relato del mismo hecho. One says… the other says… marca la diferencia.",
      "segments": [
        "This version says that two thousand people",
        "came, but the other says five thousand."
      ],
      "audioText": "This version says that two thousand people came, but the other says five thousand.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    },
    {
      "id": "en.n6.class-78.t03",
      "en": "The attendance figures differ because one outlet counted tickets.",
      "es": "Las cifras de asistencia difieren porque un medio contó las entradas.",
      "explanationEs": "Differ about/on: no coinciden. Attendance: cuánta gente asistió.",
      "segments": [
        "The attendance figures differ because",
        "one outlet counted tickets."
      ],
      "audioText": "The attendance figures differ because one outlet counted tickets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    },
    {
      "id": "en.n6.class-78.t04",
      "en": "The mayor's speech is an unverified detail: nobody has a recording.",
      "es": "El discurso del alcalde es un detalle sin comprobar: nadie tiene una grabación.",
      "explanationEs": "Unverified: dato que aparece en una sola versión y no se ha comprobado.",
      "segments": [
        "The mayor's speech is an unverified",
        "detail: nobody has a recording."
      ],
      "audioText": "The mayor's speech is an unverified detail: nobody has a recording.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    },
    {
      "id": "en.n6.class-78.t05",
      "en": "A second source could confirm the number.",
      "es": "Una segunda fuente podría confirmar la cifra.",
      "explanationEs": "Confirm: una fuente independiente comprueba el dato.",
      "segments": [
        "A second source could",
        "confirm the number."
      ],
      "audioText": "A second source could confirm the number.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    },
    {
      "id": "en.n6.class-78.t06",
      "en": "Both outlets say that the market is open every Saturday.",
      "es": "Los dos medios dicen que el mercado abre todos los sábados.",
      "explanationEs": "Both + plural: lo que coincide suele ser lo más fiable.",
      "segments": [
        "Both outlets say that the",
        "market is open every Saturday."
      ],
      "audioText": "Both outlets say that the market is open every Saturday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-3"
    }
  ],
