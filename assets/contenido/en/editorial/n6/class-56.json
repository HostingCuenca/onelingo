      "languageCode": "en",
      "patternId": "n6-group-meetings-and-plans-1"
    },
    {
      "id": "en.n6.class-56.t02",
      "en": "Sorry to interrupt, but the meeting ends at nine.",
      "es": "Perdona que te interrumpa, pero la reunión termina a las nueve.",
      "explanationEs": "Sorry to interrupt, but… = interrumpir con tacto.",
