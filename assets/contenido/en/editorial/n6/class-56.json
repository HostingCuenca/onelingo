    },
    {
      "id": "en.n6.class-56.t04",
      "en": "Thank you, Tom. I'll hand over to Sara, our chair.",
      "es": "Gracias, Tom. Paso la palabra a Sara, nuestra presidenta.",
      "explanationEs": "Hand over to + persona = ceder la palabra.",
      "segments": [
        "Thank you, Tom. I'll hand",
        "over to Sara, our chair."
      ],
      "audioText": "Thank you, Tom. I'll hand over to Sara, our chair.",
