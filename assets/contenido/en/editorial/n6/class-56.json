    },
    {
      "id": "en.n6.class-56.t05",
      "en": "Go ahead, Leo. The floor is yours: over to you.",
      "es": "Adelante, Leo. Tienes la palabra: es tu turno.",
      "explanationEs": "Go ahead y Over to you = ceder el turno a alguien.",
      "segments": [
        "Go ahead, Leo. The floor",
        "is yours: over to you."
      ],
      "audioText": "Go ahead, Leo. The floor is yours: over to you.",
      "audioMode": "tts",
