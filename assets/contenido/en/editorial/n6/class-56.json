    },
    {
      "id": "en.n6.class-56.t03",
      "en": "Let me finish my point, and then you can add your idea.",
      "es": "Déjame terminar mi idea y luego puedes añadir la tuya.",
      "explanationEs": "Let me finish = mantener la palabra; let + persona + verbo base.",
      "segments": [
        "Let me finish my point, and",
        "then you can add your idea."
      ],
      "audioText": "Let me finish my point, and then you can add your idea.",
      "audioMode": "tts",
