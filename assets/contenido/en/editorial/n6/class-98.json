  "teaching": [
    {
      "id": "en.n6.class-98.t01",
      "en": "Mia is in favour of the plan, as long as shops keep some parking.",
      "es": "Mia está a favor del plan, siempre que las tiendas conserven algo de aparcamiento.",
      "explanationEs": "In favour of + nombre expresa apoyo; as long as añade la condición de esa postura.",
      "segments": [
        "Mia is in favour of the plan,",
        "as long as shops keep some parking."
      ],
      "audioText": "Mia is in favour of the plan, as long as shops keep some parking.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-3"
    },
    {
      "id": "en.n6.class-98.t02",
      "en": "I see your point, but I'm not convinced it will make the road safer.",
      "es": "Entiendo tu argumento, pero no estoy convencido de que la calle sea más segura.",
      "explanationEs": "I see your point, but… es un acuerdo parcial: reconoces la idea y mantienes tu duda.",
      "segments": [
        "I see your point, but I'm not",
        "convinced it will make the road safer."
      ],
      "audioText": "I see your point, but I'm not convinced it will make the road safer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-3"
    },
    {
      "id": "en.n6.class-98.t03",
      "en": "Honestly, I'd rather we spent the money on the library.",
      "es": "Sinceramente, preferiría que gastáramos el dinero en la biblioteca.",
      "explanationEs": "I'd rather + sujeto + pasado simple expresa una preferencia sobre lo que otros hacen.",
      "segments": [
        "Honestly, I'd rather we spent",
        "the money on the library."
      ],
      "audioText": "Honestly, I'd rather we spent the money on the library.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-3"
    },
    {
      "id": "en.n6.class-98.t04",
      "en": "Tom objects to the plan because his main concern is the noise.",
      "es": "Tom se opone al plan porque su principal preocupación es el ruido.",
      "explanationEs": "Objects to + nombre expresa oposición; his main concern introduce la razón.",
      "segments": [
