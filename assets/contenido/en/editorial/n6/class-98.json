      "patternId": "n6-b2-consolidation-capstone-3"
    },
    {
      "id": "en.n6.class-98.t05",
      "en": "You've convinced me, so a small lane might work.",
      "es": "Me has convencido, así que un carril pequeño podría funcionar.",
      "explanationEs": "You've convinced me marca que alguien cambia de opinión durante la discusión.",
      "segments": [
        "You've convinced me, so a",
        "small lane might work."
      ],
      "audioText": "You've convinced me, so a small lane might work.",
