  "teaching": [
    {
      "id": "en.n6.class-77.t01",
      "en": "The report does not state the cause of the fire.",
      "es": "El informe no indica la causa del incendio.",
      "explanationEs": "State: declarar con formalidad, como un hecho. Es el más neutral.",
      "segments": [
        "The report does not state",
        "the cause of the fire."
      ],
      "audioText": "The report does not state the cause of the fire.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    },
    {
      "id": "en.n6.class-77.t02",
      "en": "Some drivers claim that the light was green.",
      "es": "Algunos conductores afirman que el semáforo estaba en verde.",
      "explanationEs": "Claim: afirma algo; el periodista se distancia un poco porque no está probado.",
      "segments": [
        "Some drivers claim that",
        "the light was green."
      ],
      "audioText": "Some drivers claim that the light was green.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    },
    {
      "id": "en.n6.class-77.t03",
      "en": "Police allege that the man took the bike.",
      "es": "La policía alega que el hombre se llevó la bicicleta.",
      "explanationEs": "Allege: acusa sin pruebas definitivas. Es formal y típico de la noticia judicial.",
      "segments": [
        "Police allege that the",
        "man took the bike."
      ],
      "audioText": "Police allege that the man took the bike.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    },
    {
      "id": "en.n6.class-77.t04",
      "en": "Both teams insist that they played fairly.",
      "es": "Los dos equipos insisten en que jugaron limpio.",
      "explanationEs": "Insist: lo dice con firmeza, a veces repitiéndolo. Después va that.",
      "segments": [
        "Both teams insist that",
        "they played fairly."
      ],
      "audioText": "Both teams insist that they played fairly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    },
    {
      "id": "en.n6.class-77.t05",
      "en": "The owner had to admit that the price was wrong.",
      "es": "El dueño tuvo que admitir que el precio era incorrecto.",
      "explanationEs": "Admit: reconoce algo negativo o incómodo para él.",
      "segments": [
        "The owner had to admit",
        "that the price was wrong."
      ],
      "audioText": "The owner had to admit that the price was wrong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    },
    {
      "id": "en.n6.class-77.t06",
      "en": "The mayor continues to deny that the park will close.",
      "es": "El alcalde sigue negando que el parque vaya a cerrar.",
      "explanationEs": "Deny + that + oración: rechaza una acusación o un rumor.",
      "segments": [
        "The mayor continues to deny",
        "that the park will close."
      ],
      "audioText": "The mayor continues to deny that the park will close.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-media-literacy-2"
    }
  ],
