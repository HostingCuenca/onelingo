  "teaching": [
    {
      "id": "en.n6.class-24.t01",
      "en": "There have been many complaints about the rubbish in our street.",
      "es": "Ha habido muchas quejas por la basura de nuestra calle.",
      "explanationEs": "La nota informal «people complain» se vuelve formal con el sustantivo complaints.",
      "segments": [
        "There have been many complaints about",
        "the rubbish in our street."
      ],
      "audioText": "There have been many complaints about the rubbish in our street.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-4"
    },
    {
      "id": "en.n6.class-24.t02",
      "en": "The collection of rubbish happens only once a week.",
      "es": "La recogida de la basura ocurre solo una vez a la semana.",
      "explanationEs": "«They collect the rubbish» pasa a the collection of rubbish: el sustantivo es el sujeto.",
      "segments": [
        "The collection of rubbish happens",
        "only once a week."
      ],
      "audioText": "The collection of rubbish happens only once a week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-4"
    },
    {
      "id": "en.n6.class-24.t03",
      "en": "The lack of bins causes a serious problem for every resident.",
      "es": "La falta de contenedores causa un problema serio a cada vecino.",
      "explanationEs": "Lack of + sustantivo funciona como sujeto y causa el problema.",
      "segments": [
        "The lack of bins causes a",
        "serious problem for every resident."
      ],
      "audioText": "The lack of bins causes a serious problem for every resident.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-4"
    },
    {
      "id": "en.n6.class-24.t04",
      "en": "The installation of more bins would bring an improvement.",
      "es": "La instalación de más contenedores traería una mejora.",
      "explanationEs": "«They install bins» pasa a the installation of bins; would expresa una propuesta.",
      "segments": [
        "The installation of more bins",
        "would bring an improvement."
      ],
      "audioText": "The installation of more bins would bring an improvement.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-4"
    },
    {
      "id": "en.n6.class-24.t05",
      "en": "The council's response to the complaints was slow.",
      "es": "La respuesta del ayuntamiento a las quejas fue lenta.",
      "explanationEs": "«The council responded slowly» se condensa en the council's slow response.",
      "segments": [
        "The council's response to",
        "the complaints was slow."
      ],
      "audioText": "The council's response to the complaints was slow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-4"
    },
    {
      "id": "en.n6.class-24.t06",
      "en": "An increase in the number of collections is the best solution.",
      "es": "Un aumento del número de recogidas es la mejor solución.",
      "explanationEs": "An increase in + sustantivo cierra el informe con una propuesta clara.",
      "segments": [
        "An increase in the number of",
        "collections is the best solution."
      ],
      "audioText": "An increase in the number of collections is the best solution.",
