  "teaching": [
    {
      "id": "en.n6.class-12.t01",
      "en": "Hardly had the band started when the power went out.",
      "es": "Apenas había empezado la banda cuando se fue la luz.",
      "explanationEs": "Hardly + had + sujeto + participio, y el conector es when.",
      "segments": [
        "Hardly had the band started",
        "when the power went out."
      ],
      "audioText": "Hardly had the band started when the power went out.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-2"
    },
    {
      "id": "en.n6.class-12.t02",
      "en": "No sooner had we sat down than the waiter brought the menu.",
      "es": "Apenas nos habíamos sentado cuando el camarero trajo la carta.",
      "explanationEs": "No sooner se une con than, no con when.",
      "segments": [
        "No sooner had we sat down",
        "than the waiter brought the menu."
      ],
      "audioText": "No sooner had we sat down than the waiter brought the menu.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-2"
    },
    {
      "id": "en.n6.class-12.t03",
      "en": "Not only was the room clean, but it also had a lovely view.",
      "es": "La habitación no solo estaba limpia, sino que además tenía una vista preciosa.",
      "explanationEs": "Not only abre la frase y el verbo be va antes del sujeto; después viene but … also.",
      "segments": [
        "Not only was the room clean, but",
        "it also had a lovely view."
      ],
      "audioText": "Not only was the room clean, but it also had a lovely view.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-2"
    },
    {
      "id": "en.n6.class-12.t04",
      "en": "Only when the doors opened did we see the stage.",
      "es": "Solo cuando se abrieron las puertas vimos el escenario.",
      "explanationEs": "Only when + cláusula normal; la inversión va en la segunda parte: did we see.",
      "segments": [
        "Only when the doors opened",
        "did we see the stage."
      ],
      "audioText": "Only when the doors opened did we see the stage.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-2"
    }
  ],
