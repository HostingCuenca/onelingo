  "teaching": [
    {
      "id": "en.n6.class-91.t01",
      "en": "The lights are off, so they must have left.",
      "es": "Las luces están apagadas, así que deben de haberse ido.",
      "explanationEs": "Must have + participio deduce algo pasado: no lo viste, pero estás casi seguro.",
      "segments": [
        "The lights are off, so",
        "they must have left."
      ],
      "audioText": "The lights are off, so they must have left.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-1"
    },
    {
      "id": "en.n6.class-91.t02",
      "en": "They should have left earlier, but they stayed to chat.",
      "es": "Deberían haberse ido antes, pero se quedaron charlando.",
      "explanationEs": "Should have + participio critica lo que no se hizo: aquí ocurrió lo contrario de lo correcto.",
      "segments": [
        "They should have left earlier,",
        "but they stayed to chat."
      ],
      "audioText": "They should have left earlier, but they stayed to chat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-1"
    },
    {
      "id": "en.n6.class-91.t03",
      "en": "I wish I had a bigger flat, but I hope to find one soon.",
      "es": "Ojalá tuviera un piso más grande, pero espero encontrar uno pronto.",
      "explanationEs": "Wish + pasado simple es un deseo irreal de hoy. Hope + infinitivo o presente es un deseo posible.",
      "segments": [
        "I wish I had a bigger flat,",
        "but I hope to find one soon."
      ],
      "audioText": "I wish I had a bigger flat, but I hope to find one soon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-1"
    },
    {
      "id": "en.n6.class-91.t04",
      "en": "We used to swim in the lake, and we would race every Sunday.",
      "es": "Antes nadábamos en el lago y hacíamos carreras cada domingo.",
      "explanationEs": "Used to sirve para estados y hábitos pasados; would solo para hábitos repetidos.",
      "segments": [
        "We used to swim in the lake,",
        "and we would race every Sunday."
      ],
      "audioText": "We used to swim in the lake, and we would race every Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-integrated-review-and-storytelling-1"
    },
    {
      "id": "en.n6.class-91.t05",
      "en": "If we had left earlier, we would have caught the train.",
      "es": "Si nos hubiéramos ido antes, habríamos alcanzado el tren.",
      "explanationEs": "If + pasado perfecto y would have + participio hablan del pasado irreal; con if + pasado simple hablarías de hoy.",
      "segments": [
        "If we had left earlier, we",
        "would have caught the train."
      ],
      "audioText": "If we had left earlier, we would have caught the train.",
