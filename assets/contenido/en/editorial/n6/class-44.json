  "teaching": [
    {
      "id": "en.n6.class-44.t01",
      "en": "Who would say no to fresh vegetables grown by our own students?",
      "es": "¿Quién diría que no a verduras frescas cultivadas por nuestros propios estudiantes?",
      "explanationEs": "Gancho: una pregunta retórica al principio atrapa al lector. Nadie responde que no.",
      "segments": [
        "Who would say no to fresh",
        "vegetables grown by our own students?"
      ],
      "audioText": "Who would say no to fresh vegetables grown by our own students?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-4"
    },
    {
      "id": "en.n6.class-44.t02",
      "en": "The garden costs little, but it teaches a lot.",
      "es": "El huerto cuesta poco, pero enseña mucho.",
      "explanationEs": "Contraste: el coste contra el beneficio. Con un nombre incontable (little), nunca few.",
      "segments": [
        "The garden costs little, but",
        "it teaches a lot."
      ],
      "audioText": "The garden costs little, but it teaches a lot.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-4"
    },
    {
      "id": "en.n6.class-44.t03",
      "en": "What makes a garden special is that every student can help.",
      "es": "Lo que hace especial a un huerto es que todos los estudiantes pueden ayudar.",
      "explanationEs": "Cleft con What: después de is va that + una oración, no porque.",
      "segments": [
        "What makes a garden special is",
        "that every student can help."
      ],
      "audioText": "What makes a garden special is that every student can help.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-4"
    },
    {
      "id": "en.n6.class-44.t04",
      "en": "It was the volunteers who built the first beds last spring.",
      "es": "Fueron los voluntarios quienes construyeron los primeros bancales la primavera pasada.",
      "explanationEs": "Cleft con It was: destaca a las personas reales que hicieron algo.",
      "segments": [
        "It was the volunteers who built",
        "the first beds last spring."
      ],
      "audioText": "It was the volunteers who built the first beds last spring.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-4"
    },
    {
      "id": "en.n6.class-44.t05",
      "en": "Plant, learn and share: that is what our garden offers.",
      "es": "Plantar, aprender y compartir: eso es lo que ofrece nuestro huerto.",
      "explanationEs": "Lista de tres: cierra el párrafo con ritmo y deja una idea clara.",
      "segments": [
        "Plant, learn and share: that",
        "is what our garden offers."
      ],
      "audioText": "Plant, learn and share: that is what our garden offers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-persuasive-devices-4"
    },
    {
      "id": "en.n6.class-44.t06",
      "en": "Join us, and you will see the difference.",
      "es": "Únete a nosotros y verás la diferencia.",
      "explanationEs": "Llamada a la acción: una orden amable al final invita a participar.",
      "segments": [
