  "teaching": [
    {
      "id": "en.n6.class-35.t01",
      "en": "According to the historian, the legend of the cave is very old.",
      "es": "Según el historiador, la leyenda de la cueva es muy antigua.",
      "explanationEs": "According to + fuente: atribuyes la información a alguien concreto.",
      "segments": [
        "According to the historian, the legend",
        "of the cave is very old."
      ],
      "audioText": "According to the historian, the legend of the cave is very old.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    },
    {
      "id": "en.n6.class-35.t02",
      "en": "The villagers claimed that they had heard music near the cave.",
      "es": "Los habitantes del pueblo afirmaron que habían oído música cerca de la cueva.",
      "explanationEs": "claimed that: alguien afirma algo sin que esté comprobado; el verbo retrocede (heard → had heard).",
      "segments": [
        "The villagers claimed that they had",
        "heard music near the cave."
      ],
      "audioText": "The villagers claimed that they had heard music near the cave.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    },
    {
      "id": "en.n6.class-35.t03",
      "en": "The cave is said to have been a meeting place.",
      "es": "Se dice que la cueva fue un lugar de reunión.",
      "explanationEs": "Estructura impersonal con sujeto personal: rumor sin fuente.",
      "segments": [
        "The cave is said to",
        "have been a meeting place."
      ],
      "audioText": "The cave is said to have been a meeting place.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    },
    {
      "id": "en.n6.class-35.t04",
      "en": "I asked the historian whether there was any evidence.",
      "es": "Le pregunté al historiador si había alguna prueba.",
      "explanationEs": "Pregunta reportada de sí/no: asked + whether/if + orden afirmativo, sin do.",
      "segments": [
        "I asked the historian whether",
        "there was any evidence."
      ],
      "audioText": "I asked the historian whether there was any evidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    },
    {
      "id": "en.n6.class-35.t05",
      "en": "She asked where the legend had started.",
      "es": "Ella preguntó dónde había empezado la leyenda.",
      "explanationEs": "Con palabra interrogativa: asked where + sujeto + verbo (sin invertir).",
      "segments": [
        "She asked where the",
        "legend had started."
      ],
      "audioText": "She asked where the legend had started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    },
    {
      "id": "en.n6.class-35.t06",
      "en": "The newspaper is the only source of the story.",
      "es": "El periódico es la única fuente de la historia.",
      "explanationEs": "Nombrar la source deja claro de dónde sale la información.",
      "segments": [
        "The newspaper is the only",
        "source of the story."
      ],
      "audioText": "The newspaper is the only source of the story.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-5"
    }
  ],
