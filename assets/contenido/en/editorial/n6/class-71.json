  "teaching": [
    {
      "id": "en.n6.class-71.t01",
      "en": "My claim is that teenagers need more sleep.",
      "es": "Mi afirmación es que los adolescentes necesitan dormir más.",
      "explanationEs": "Claim: lo que alguien dice que es verdad. Todavía hay que probarlo.",
      "segments": [
        "My claim is that",
        "teenagers need more sleep."
      ],
      "audioText": "My claim is that teenagers need more sleep.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    },
    {
      "id": "en.n6.class-71.t02",
      "en": "The reason is that their bodies are still growing.",
      "es": "La razón es que su cuerpo todavía está creciendo.",
      "explanationEs": "Reason: responde a «¿por qué?». Se introduce con because o the reason is that.",
      "segments": [
        "The reason is that their",
        "bodies are still growing."
      ],
      "audioText": "The reason is that their bodies are still growing.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    },
    {
      "id": "en.n6.class-71.t03",
      "en": "According to a survey, most teenagers sleep less than seven hours.",
      "es": "Según una encuesta, la mayoría de los adolescentes duermen menos de siete horas.",
      "explanationEs": "La prueba es un dato que otra persona puede comprobar. La fuente se cita con according to.",
      "segments": [
        "According to a survey, most teenagers",
        "sleep less than seven hours."
      ],
      "audioText": "According to a survey, most teenagers sleep less than seven hours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    },
    {
      "id": "en.n6.class-71.t04",
      "en": "There is a lot of evidence, so this argument is strong.",
      "es": "Hay muchas pruebas, así que este argumento es sólido.",
      "explanationEs": "Evidence es incontable: a lot of evidence, nunca evidences.",
      "segments": [
        "There is a lot of evidence,",
        "so this argument is strong."
      ],
      "audioText": "There is a lot of evidence, so this argument is strong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    },
    {
      "id": "en.n6.class-71.t05",
      "en": "Without evidence, an argument is weak.",
      "es": "Sin pruebas, un argumento es débil.",
      "explanationEs": "Sin evidence, una afirmación se queda en opinión.",
      "segments": [
        "Without evidence, an",
        "argument is weak."
      ],
      "audioText": "Without evidence, an argument is weak.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    },
    {
      "id": "en.n6.class-71.t06",
      "en": "Students who sleep more often get better grades.",
      "es": "Los estudiantes que duermen más suelen sacar mejores notas.",
      "explanationEs": "Un dato concreto de un estudio es un buen tipo de evidence.",
      "segments": [
        "Students who sleep more",
        "often get better grades."
      ],
      "audioText": "Students who sleep more often get better grades.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-critical-thinking-1"
    }
  ],
