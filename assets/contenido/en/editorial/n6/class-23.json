  "teaching": [
    {
      "id": "en.n6.class-23.t01",
      "en": "The introduction of a ban on cars in the centre led to a fall in pollution.",
      "es": "La introducción de una prohibición de coches en el centro llevó a una caída de la contaminación.",
      "explanationEs": "Desempaquetada: el ayuntamiento prohibió los coches y la contaminación bajó.",
      "segments": [
        "The introduction of a ban on cars in",
        "the centre led to a fall in pollution."
      ],
      "audioText": "The introduction of a ban on cars in the centre led to a fall in pollution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-3"
    },
    {
      "id": "en.n6.class-23.t02",
      "en": "The construction of a new bike lane took six months.",
      "es": "La construcción de un carril bici nuevo tardó seis meses.",
      "explanationEs": "Desempaquetada: alguien construyó el carril y tardaron seis meses.",
      "segments": [
        "The construction of a new",
        "bike lane took six months."
      ],
      "audioText": "The construction of a new bike lane took six months.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-3"
    },
    {
      "id": "en.n6.class-23.t03",
      "en": "The closure of the bridge caused a delay for every cyclist.",
      "es": "El cierre del puente causó un retraso a cada ciclista.",
      "explanationEs": "Desempaquetada: cerraron el puente y por eso los ciclistas llegaron tarde.",
      "segments": [
        "The closure of the bridge caused",
        "a delay for every cyclist."
      ],
      "audioText": "The closure of the bridge caused a delay for every cyclist.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-3"
    },
    {
      "id": "en.n6.class-23.t04",
      "en": "Every cyclist welcomed the opening of the new path.",
      "es": "Cada ciclista celebró la apertura del nuevo camino.",
      "explanationEs": "La frase no dice quién abrió el camino: el sustantivo opening oculta al autor.",
      "segments": [
        "Every cyclist welcomed the opening",
        "of the new path."
      ],
      "audioText": "Every cyclist welcomed the opening of the new path.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-3"
    },
    {
      "id": "en.n6.class-23.t05",
      "en": "A fall in pollution was the result of the ban.",
      "es": "Una caída de la contaminación fue el resultado de la prohibición.",
      "explanationEs": "Result of une la causa (the ban) con el efecto (a fall in pollution).",
      "segments": [
        "A fall in pollution was",
        "the result of the ban."
      ],
      "audioText": "A fall in pollution was the result of the ban.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-noun-phrases-3"
    }
  ],
