  "teaching": [
    {
      "id": "en.n6.class-13.t01",
      "en": "So exhausted was Leo that he fell asleep on the bus.",
      "es": "Leo estaba tan agotado que se durmió en el autobús.",
      "explanationEs": "So + adjetivo + be + sujeto + that: el verbo be va antes de Leo.",
      "segments": [
        "So exhausted was Leo that he",
        "fell asleep on the bus."
      ],
      "audioText": "So exhausted was Leo that he fell asleep on the bus.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-3"
    },
    {
      "id": "en.n6.class-13.t02",
      "en": "Such was the noise that nobody could hear the speaker.",
      "es": "Tal era el ruido que nadie podía oír al orador.",
      "explanationEs": "Such + be + sustantivo + that: se usa such porque hay un sustantivo (the noise).",
      "segments": [
        "Such was the noise that",
        "nobody could hear the speaker."
      ],
      "audioText": "Such was the noise that nobody could hear the speaker.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-3"
    },
    {
      "id": "en.n6.class-13.t03",
      "en": "So large was the crowd that the police closed the street.",
      "es": "Tan grande era la multitud que la policía cerró la calle.",
      "explanationEs": "La versión normal sería: The crowd was so large that…",
      "segments": [
        "So large was the crowd that",
        "the police closed the street."
      ],
      "audioText": "So large was the crowd that the police closed the street.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-3"
    },
    {
      "id": "en.n6.class-13.t04",
      "en": "Such was the relief on her face that everybody laughed.",
      "es": "Tal era el alivio en su cara que todos se rieron.",
      "explanationEs": "Such was the relief that… resume una emoción fuerte y su consecuencia.",
      "segments": [
        "Such was the relief on",
        "her face that everybody laughed."
      ],
      "audioText": "Such was the relief on her face that everybody laughed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-3"
    },
    {
      "id": "en.n6.class-13.t05",
      "en": "So quietly did the cat walk in that nobody noticed it.",
      "es": "El gato entró tan silenciosamente que nadie lo notó.",
      "explanationEs": "Con un adverbio, so + adverbio + did + sujeto + verbo base.",
      "segments": [
        "So quietly did the cat walk",
        "in that nobody noticed it."
      ],
      "audioText": "So quietly did the cat walk in that nobody noticed it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-emphatic-inversion-3"
    }
