  "teaching": [
    {
      "id": "en.n6.class-33.t01",
      "en": "The mayor admitted that the bridge was late.",
      "es": "El alcalde admitió que el puente iba con retraso.",
      "explanationEs": "admitted + that + oración: reconoce algo incómodo. El verbo retrocede un tiempo (is → was).",
      "segments": [
        "The mayor admitted that",
        "the bridge was late."
      ],
      "audioText": "The mayor admitted that the bridge was late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-3"
    },
    {
      "id": "en.n6.class-33.t02",
      "en": "The coach denied changing the team.",
      "es": "El entrenador negó haber cambiado al equipo.",
      "explanationEs": "denied + -ing: niega haber hecho algo. También vale denied that + oración.",
      "segments": [
        "The coach denied",
        "changing the team."
      ],
      "audioText": "The coach denied changing the team.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-3"
    },
    {
      "id": "en.n6.class-33.t03",
      "en": "The neighbour insisted on paying for the repairs.",
      "es": "El vecino insistió en pagar las reparaciones.",
      "explanationEs": "insisted on + -ing (o insisted that + oración): repite algo con fuerza.",
      "segments": [
        "The neighbour insisted on",
        "paying for the repairs."
      ],
      "audioText": "The neighbour insisted on paying for the repairs.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-3"
    },
    {
      "id": "en.n6.class-33.t04",
      "en": "The guide warned us not to swim in the river.",
      "es": "El guía nos advirtió de que no nos bañáramos en el río.",
      "explanationEs": "warned + persona + (not) to + verbo: avisa de un peligro.",
      "segments": [
        "The guide warned us not",
        "to swim in the river."
      ],
      "audioText": "The guide warned us not to swim in the river.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-3"
    },
    {
      "id": "en.n6.class-33.t05",
      "en": "The waiter suggested trying the soup.",
      "es": "El camarero sugirió probar la sopa.",
      "explanationEs": "suggested + -ing (o suggested that + oración): propone sin imponer.",
      "segments": [
        "The waiter suggested",
        "trying the soup."
      ],
      "audioText": "The waiter suggested trying the soup.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-reporting-and-impersonal-3"
    }
  ],
