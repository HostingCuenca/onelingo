      "languageCode": "en",
      "patternId": "n6-b2-consolidation-capstone-2"
    },
    {
      "id": "en.n6.class-97.t04",
      "en": "I would be grateful if you could send me your draft by Friday.",
      "es": "Te agradecería que me enviaras tu borrador antes del viernes.",
      "explanationEs": "En un registro formal se pide con I would be grateful if you could…, no con una orden directa.",
