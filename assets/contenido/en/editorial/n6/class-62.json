  "teaching": [
    {
      "id": "en.n6.class-62.t01",
      "en": "We can book the hotel provided that the price includes breakfast.",
      "es": "Podemos reservar el hotel siempre que el precio incluya el desayuno.",
      "explanationEs": "Provided that + presente simple pone una condición. Después no se usa will.",
      "segments": [
        "We can book the hotel provided",
        "that the price includes breakfast."
      ],
      "audioText": "We can book the hotel provided that the price includes breakfast.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-2"
    },
    {
      "id": "en.n6.class-62.t02",
      "en": "I will pay half on condition that you buy the train tickets.",
      "es": "Pagaré la mitad a condición de que tú compres los billetes de tren.",
      "explanationEs": "On condition that: condición firme y más formal; se exige algo a cambio.",
      "segments": [
        "I will pay half on condition",
        "that you buy the train tickets."
      ],
      "audioText": "I will pay half on condition that you buy the train tickets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-2"
    },
    {
      "id": "en.n6.class-62.t03",
      "en": "You can choose the hotel as long as it fits our budget.",
      "es": "Puedes elegir el hotel siempre que se ajuste a nuestro presupuesto.",
      "explanationEs": "As long as + presente simple: la condición más natural en conversación.",
      "segments": [
        "You can choose the hotel as",
        "long as it fits our budget."
      ],
      "audioText": "You can choose the hotel as long as it fits our budget.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-2"
    },
    {
      "id": "en.n6.class-62.t04",
      "en": "Although the hostel is far from the beach, it is cheap.",
      "es": "Aunque el hostal está lejos de la playa, es barato.",
      "explanationEs": "Although + oración reconoce un inconveniente (concesión). No se usa con but.",
      "segments": [
        "Although the hostel is far from",
        "the beach, it is cheap."
      ],
      "audioText": "Although the hostel is far from the beach, it is cheap.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-2"
    },
    {
      "id": "en.n6.class-62.t05",
      "en": "The train is expensive. Even so, we can afford it.",
      "es": "El tren es caro. Aun así, podemos permitírnoslo.",
      "explanationEs": "Even so une dos frases: la segunda sigue adelante pese a la primera. Lleva coma.",
      "segments": [
        "The train is expensive. Even",
        "so, we can afford it."
      ],
      "audioText": "The train is expensive. Even so, we can afford it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n6-negotiating-and-compromise-2"
    }
  ],
