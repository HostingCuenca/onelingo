  "teaching": [
    {
      "id": "en.n5.class-77.t01",
      "en": "The roads were icy; nevertheless, the bus arrived on time.",
      "es": "Las calles tenían hielo; aun así, el autobús llegó a la hora.",
      "explanationEs": "Nevertheless presenta un contraste que sorprende. Va tras punto y coma y lleva coma detrás.",
      "segments": [
        "The roads were icy; nevertheless,",
        "the bus arrived on time."
      ],
      "audioText": "The roads were icy; nevertheless, the bus arrived on time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    },
    {
      "id": "en.n5.class-77.t02",
      "en": "Fuel prices rose; consequently, bus tickets became more expensive.",
      "es": "El precio del combustible subió; por consiguiente, los billetes de autobús se encarecieron.",
      "explanationEs": "Consequently marca el resultado del hecho anterior.",
      "segments": [
        "Fuel prices rose; consequently, bus",
        "tickets became more expensive."
      ],
      "audioText": "Fuel prices rose; consequently, bus tickets became more expensive.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    },
    {
      "id": "en.n5.class-77.t03",
      "en": "Some students like early classes, whereas others prefer a later start.",
      "es": "A algunos estudiantes les gustan las clases tempranas, mientras que otros prefieren empezar más tarde.",
      "explanationEs": "Whereas contrasta dos cosas dentro de una misma frase.",
      "segments": [
        "Some students like early classes, whereas",
        "others prefer a later start."
      ],
      "audioText": "Some students like early classes, whereas others prefer a later start.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    },
    {
      "id": "en.n5.class-77.t04",
      "en": "The plan is cheap; moreover, it is fast.",
      "es": "El plan es barato; además, es rápido.",
      "explanationEs": "Moreover añade un argumento más, y a menudo más fuerte.",
      "segments": [
        "The plan is cheap;",
        "moreover, it is fast."
      ],
      "audioText": "The plan is cheap; moreover, it is fast.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    },
    {
      "id": "en.n5.class-77.t05",
      "en": "The later start is, arguably, the biggest change of the year.",
      "es": "El horario más tardío es, podría decirse, el mayor cambio del año.",
      "explanationEs": "Arguably suaviza una afirmación fuerte: se puede defender, pero no es un hecho.",
      "segments": [
        "The later start is, arguably, the",
        "biggest change of the year."
      ],
      "audioText": "The later start is, arguably, the biggest change of the year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    },
    {
      "id": "en.n5.class-77.t06",
      "en": "It would seem that teenagers tend to sleep late, so they need more rest.",
      "es": "Parece ser que los adolescentes suelen dormir tarde, así que necesitan más descanso.",
      "explanationEs": "It would seem that… y tend to + verbo base matizan: no dicen «siempre».",
      "segments": [
        "It would seem that teenagers tend to",
        "sleep late, so they need more rest."
      ],
      "audioText": "It would seem that teenagers tend to sleep late, so they need more rest.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-2"
    }
