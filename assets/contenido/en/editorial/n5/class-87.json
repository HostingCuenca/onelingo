  "teaching": [
    {
      "id": "en.n5.class-87.t01",
      "en": "I'll remind Leo to bring the gloves.",
      "es": "Le recordaré a Leo que traiga los guantes.",
      "explanationEs": "Remind + persona + to + verbo base: recordar a alguien que haga algo.",
      "segments": [
        "I'll remind Leo to",
        "bring the gloves."
      ],
      "audioText": "I'll remind Leo to bring the gloves.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-2"
    },
    {
      "id": "en.n5.class-87.t02",
      "en": "Sara will encourage the new volunteers to sign up.",
      "es": "Sara animará a los nuevos voluntarios a apuntarse.",
      "explanationEs": "Encourage + persona + to: animar a alguien a hacer algo.",
      "segments": [
        "Sara will encourage the new",
        "volunteers to sign up."
      ],
      "audioText": "Sara will encourage the new volunteers to sign up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-2"
    },
    {
      "id": "en.n5.class-87.t03",
      "en": "Please tell Carlos to come on time and ask Mia to bring the paint.",
      "es": "Por favor, dile a Carlos que venga a tiempo y pídele a Mia que traiga la pintura.",
      "explanationEs": "Tell es más directo y ask más cortés; los dos llevan persona + to + verbo base.",
      "segments": [
        "Please tell Carlos to come on time",
        "and ask Mia to bring the paint."
      ],
      "audioText": "Please tell Carlos to come on time and ask Mia to bring the paint.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-2"
    },
    {
      "id": "en.n5.class-87.t04",
      "en": "I suggest painting the stall, and I recommend buying the paint today.",
      "es": "Sugiero pintar el puesto y recomiendo comprar la pintura hoy.",
      "explanationEs": "Suggest y recommend van con -ing, sin persona ni to.",
      "segments": [
        "I suggest painting the stall, and",
        "I recommend buying the paint today."
      ],
      "audioText": "I suggest painting the stall, and I recommend buying the paint today.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-2"
    },
    {
      "id": "en.n5.class-87.t05",
      "en": "Don't just tell people what to do: encourage them to share ideas.",
      "es": "No te limites a decir a la gente qué hacer: anímala a compartir ideas.",
      "explanationEs": "Un buen líder no solo ordena: anima a la gente a participar.",
      "segments": [
        "Don't just tell people what to",
        "do: encourage them to share ideas."
      ],
      "audioText": "Don't just tell people what to do: encourage them to share ideas.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-2"
    }
