  "teaching": [
    {
      "id": "en.n5.class-35.t01",
      "en": "I am calling to make a complaint about a repair.",
      "es": "Llamo para hacer una reclamación sobre una reparación.",
      "explanationEs": "Make a complaint = presentar una queja. Es una apertura educada y directa.",
      "segments": [
        "I am calling to make",
        "a complaint about a repair."
      ],
      "audioText": "I am calling to make a complaint about a repair.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    },
    {
      "id": "en.n5.class-35.t02",
      "en": "I had my laptop repaired on Monday, but it still does not work properly.",
      "es": "Hice reparar mi portátil el lunes, pero todavía no funciona bien.",
      "explanationEs": "Had + objeto + participio dice lo encargado; but still + presente dice que el problema sigue.",
      "segments": [
        "I had my laptop repaired on Monday,",
        "but it still does not work properly."
      ],
      "audioText": "I had my laptop repaired on Monday, but it still does not work properly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    },
    {
      "id": "en.n5.class-35.t03",
      "en": "The screen was scratched when I got it back.",
      "es": "La pantalla estaba rayada cuando me la devolvieron.",
      "explanationEs": "Got it back = me lo devolvieron. Scratched describe el defecto.",
      "segments": [
        "The screen was scratched when",
        "I got it back."
      ],
      "audioText": "The screen was scratched when I got it back.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    },
    {
      "id": "en.n5.class-35.t04",
      "en": "The part is faulty, so I would like a refund or a free repair.",
      "es": "La pieza es defectuosa, así que quisiera un reembolso o una reparación gratis.",
      "explanationEs": "I would like… es la forma cortés de pedir una solución.",
      "segments": [
        "The part is faulty, so I would",
        "like a refund or a free repair."
      ],
      "audioText": "The part is faulty, so I would like a refund or a free repair.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    },
    {
      "id": "en.n5.class-35.t05",
      "en": "We apologise, and we promise to have it ready by Thursday.",
      "es": "Pedimos disculpas y prometemos tenerlo listo para el jueves.",
      "explanationEs": "Promise to + verbo base. La tienda confirma el nuevo plazo con by.",
      "segments": [
        "We apologise, and we promise to",
        "have it ready by Thursday."
      ],
      "audioText": "We apologise, and we promise to have it ready by Thursday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    },
    {
      "id": "en.n5.class-35.t06",
      "en": "Can you have it repaired again by Friday?",
      "es": "¿Pueden hacer que lo reparen otra vez para el viernes, a más tardar?",
      "explanationEs": "Again = otra vez. Can you have it + participio pide que se repita el trabajo.",
      "segments": [
        "Can you have it",
        "repaired again by Friday?"
      ],
      "audioText": "Can you have it repaired again by Friday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-5"
    }
