  "teaching": [
    {
      "id": "en.n5.class-72.t01",
      "en": "Lack of sleep leads to stress at school.",
      "es": "La falta de sueño provoca estrés en la escuela.",
      "explanationEs": "La causa es el sujeto; tras leads to va el efecto, un sustantivo.",
      "segments": [
        "Lack of sleep leads",
        "to stress at school."
      ],
      "audioText": "Lack of sleep leads to stress at school.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    },
    {
      "id": "en.n5.class-72.t02",
      "en": "A bad diet can result in health problems.",
      "es": "Una mala dieta puede tener como resultado problemas de salud.",
      "explanationEs": "Result in + efecto: va seguido de un sustantivo, no de una oración con verbo.",
      "segments": [
        "A bad diet can",
        "result in health problems."
      ],
      "audioText": "A bad diet can result in health problems.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    },
    {
      "id": "en.n5.class-72.t03",
      "en": "Many students feel tired due to screens at night.",
      "es": "Muchos estudiantes se sienten cansados debido a las pantallas por la noche.",
      "explanationEs": "Due to + causa: el efecto va primero y la causa después.",
      "segments": [
        "Many students feel tired due",
        "to screens at night."
      ],
      "audioText": "Many students feel tired due to screens at night.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    },
    {
      "id": "en.n5.class-72.t04",
      "en": "As a result of the heat, sales of coats dropped sharply.",
      "es": "Como resultado del calor, las ventas de abrigos cayeron bruscamente.",
      "explanationEs": "As a result of + sustantivo abre la frase; sharply indica un cambio grande y rápido.",
      "segments": [
        "As a result of the heat,",
        "sales of coats dropped sharply."
      ],
      "audioText": "As a result of the heat, sales of coats dropped sharply.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    },
    {
      "id": "en.n5.class-72.t05",
      "en": "Sleep hours rose steadily, so there was a drop in tired students.",
      "es": "Las horas de sueño subieron de forma constante, así que hubo una caída de estudiantes cansados.",
      "explanationEs": "Steadily: poco a poco y sin parar. A drop es una caída.",
      "segments": [
        "Sleep hours rose steadily, so there",
        "was a drop in tired students."
      ],
      "audioText": "Sleep hours rose steadily, so there was a drop in tired students.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    },
    {
      "id": "en.n5.class-72.t06",
      "en": "The temperature rose slightly last year, but a small rise can matter.",
      "es": "La temperatura subió ligeramente el año pasado, pero una pequeña subida puede importar.",
      "explanationEs": "Slightly indica un cambio pequeño. Rise puede ser verbo o sustantivo.",
      "segments": [
        "The temperature rose slightly last year,",
        "but a small rise can matter."
      ],
      "audioText": "The temperature rose slightly last year, but a small rise can matter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-2"
    }
  ],
