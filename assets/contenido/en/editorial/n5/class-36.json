  "teaching": [
    {
      "id": "en.n5.class-36.t01",
      "en": "Although the old town is crowded, it is my favourite place.",
      "es": "Aunque el casco antiguo está abarrotado, es mi lugar favorito.",
      "explanationEs": "Although + sujeto + verbo: presenta un dato que contrasta con lo que sigue.",
      "segments": [
        "Although the old town is crowded,",
        "it is my favourite place."
      ],
      "audioText": "Although the old town is crowded, it is my favourite place.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    },
    {
      "id": "en.n5.class-36.t02",
      "en": "The centre is noisy, whereas the park is quiet.",
      "es": "El centro es ruidoso, mientras que el parque es tranquilo.",
      "explanationEs": "Whereas contrasta dos cosas distintas. No expresa sorpresa, sino comparación.",
      "segments": [
        "The centre is noisy, whereas",
        "the park is quiet."
      ],
      "audioText": "The centre is noisy, whereas the park is quiet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    },
    {
      "id": "en.n5.class-36.t03",
      "en": "Despite the heavy traffic, we arrived on time.",
      "es": "A pesar del tráfico denso, llegamos a tiempo.",
      "explanationEs": "Despite + sustantivo: el tráfico. No lleva sujeto + verbo.",
      "segments": [
        "Despite the heavy traffic,",
        "we arrived on time."
      ],
      "audioText": "Despite the heavy traffic, we arrived on time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    },
    {
      "id": "en.n5.class-36.t04",
      "en": "In spite of being expensive, the hotel is always full.",
      "es": "A pesar de ser caro, el hotel siempre está lleno.",
      "explanationEs": "In spite of + -ing: equivale a despite y tiene el mismo uso.",
      "segments": [
        "In spite of being expensive,",
        "the hotel is always full."
      ],
      "audioText": "In spite of being expensive, the hotel is always full.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    },
    {
      "id": "en.n5.class-36.t05",
      "en": "Despite the fact that the street is narrow, buses use it.",
      "es": "A pesar de que la calle es estrecha, los autobuses la usan.",
      "explanationEs": "Despite the fact that + sujeto + verbo: cuando quieres una cláusula completa.",
      "segments": [
        "Despite the fact that the street",
        "is narrow, buses use it."
      ],
      "audioText": "Despite the fact that the street is narrow, buses use it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    },
    {
      "id": "en.n5.class-36.t06",
      "en": "The square is famous, although few tourists visit it.",
      "es": "La plaza es famosa, aunque pocos turistas la visitan.",
      "explanationEs": "Although también puede ir en medio de la frase, con coma delante.",
      "segments": [
        "The square is famous, although",
        "few tourists visit it."
      ],
      "audioText": "The square is famous, although few tourists visit it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-connecting-ideas-1"
    }
