  "teaching": [
    {
      "id": "en.n5.class-74.t01",
      "en": "The aim of the experiment was to find out whether plants grow faster in light.",
      "es": "El objetivo del experimento era averiguar si las plantas crecen más rápido con luz.",
      "explanationEs": "The aim of the experiment was to + verbo: así se expresa el propósito.",
      "segments": [
        "The aim of the experiment was to find",
        "out whether plants grow faster in light."
      ],
      "audioText": "The aim of the experiment was to find out whether plants grow faster in light.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    },
    {
      "id": "en.n5.class-74.t02",
      "en": "Twenty seeds were divided into two groups.",
      "es": "Veinte semillas se dividieron en dos grupos.",
      "explanationEs": "Voz pasiva: were + participio. Importa qué se hizo, no quién lo hizo.",
      "segments": [
        "Twenty seeds were divided",
        "into two groups."
      ],
      "audioText": "Twenty seeds were divided into two groups.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    },
    {
      "id": "en.n5.class-74.t03",
      "en": "One group was placed near the window; the other was kept in a dark cupboard.",
      "es": "Un grupo se colocó junto a la ventana; el otro se mantuvo en un armario oscuro.",
      "explanationEs": "Un grupo es singular: was + participio (placed, kept).",
      "segments": [
        "One group was placed near the window; the",
        "other was kept in a dark cupboard."
      ],
      "audioText": "One group was placed near the window; the other was kept in a dark cupboard.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    },
    {
      "id": "en.n5.class-74.t04",
      "en": "The height of each plant was measured and recorded every three days.",
      "es": "La altura de cada planta se midió y se anotó cada tres días.",
      "explanationEs": "Dos participios con un solo was: measured and recorded.",
      "segments": [
        "The height of each plant was",
        "measured and recorded every three days."
      ],
      "audioText": "The height of each plant was measured and recorded every three days.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    },
    {
      "id": "en.n5.class-74.t05",
      "en": "The results were clear: the plants in the light grew taller.",
      "es": "Los resultados fueron claros: las plantas con luz crecieron más.",
      "explanationEs": "Results es plural, por eso were. Taller compara alturas.",
      "segments": [
        "The results were clear: the plants",
        "in the light grew taller."
      ],
      "audioText": "The results were clear: the plants in the light grew taller.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    },
    {
      "id": "en.n5.class-74.t06",
      "en": "It can be concluded that light helps plants grow.",
      "es": "Se puede concluir que la luz ayuda a las plantas a crecer.",
      "explanationEs": "It can be concluded that… abre la conclusión y evita decir «yo creo».",
      "segments": [
        "It can be concluded that",
        "light helps plants grow."
      ],
      "audioText": "It can be concluded that light helps plants grow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-4"
    }
