  "teaching": [
    {
      "id": "en.n5.class-43.t01",
      "en": "Mia and Sara hit it off at once, and their friendship is now very strong.",
      "es": "Mia y Sara congeniaron enseguida y su amistad es ahora muy fuerte.",
      "explanationEs": "Hit it off = llevarse bien desde el primer momento.",
      "segments": [
        "Mia and Sara hit it off at once,",
        "and their friendship is now very strong."
      ],
      "audioText": "Mia and Sara hit it off at once, and their friendship is now very strong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-3"
    },
    {
      "id": "en.n5.class-43.t02",
      "en": "Good friends sometimes fall out, but they apologise and forgive each other.",
      "es": "Los buenos amigos a veces se pelean, pero se piden perdón y se perdonan.",
      "explanationEs": "Fall out = pelearse; el verbo cambia (fell out) pero el modismo no.",
      "segments": [
        "Good friends sometimes fall out, but",
        "they apologise and forgive each other."
      ],
      "audioText": "Good friends sometimes fall out, but they apologise and forgive each other.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-3"
    },
    {
      "id": "en.n5.class-43.t03",
      "en": "Ana and Leo get on like a house on fire, and they never have an argument.",
      "es": "Ana y Leo se llevan de maravilla y nunca discuten.",
      "explanationEs": "Get on like a house on fire = llevarse fenomenal.",
      "segments": [
        "Ana and Leo get on like a house",
        "on fire, and they never have an argument."
      ],
      "audioText": "Ana and Leo get on like a house on fire, and they never have an argument.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-3"
    },
    {
      "id": "en.n5.class-43.t04",
      "en": "Without messages, even a good friendship can drift apart and lose touch.",
      "es": "Sin mensajes, incluso una buena amistad puede distanciarse y perder el contacto.",
      "explanationEs": "Drift apart: alejarse poco a poco, sin pelea; lose touch: dejar de hablarse.",
      "segments": [
        "Without messages, even a good friendship",
        "can drift apart and lose touch."
      ],
      "audioText": "Without messages, even a good friendship can drift apart and lose touch.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-3"
    },
    {
      "id": "en.n5.class-43.t05",
      "en": "After every argument, Tom and Carlos make up within an hour.",
      "es": "Después de cada discusión, Tom y Carlos hacen las paces en una hora.",
      "explanationEs": "Make up = hacer las paces, no «hacer la paz».",
      "segments": [
        "After every argument, Tom and Carlos",
        "make up within an hour."
      ],
      "audioText": "After every argument, Tom and Carlos make up within an hour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-3"
    }
  ],
