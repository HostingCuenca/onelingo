  "teaching": [
    {
      "id": "en.n5.class-41.t01",
      "en": "Is Mia coming tonight? I think so, but she might be late.",
      "es": "¿Viene Mia esta noche? Creo que sí, pero puede que llegue tarde.",
      "explanationEs": "So sustituye a toda la idea «Mia is coming»: no hace falta repetirla.",
      "segments": [
        "Is Mia coming tonight? I think",
        "so, but she might be late."
      ],
      "audioText": "Is Mia coming tonight? I think so, but she might be late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    },
    {
      "id": "en.n5.class-41.t02",
      "en": "Will it rain at the match? I hope not, because we have no umbrellas.",
      "es": "¿Lloverá en el partido? Espero que no, porque no tenemos paraguas.",
      "explanationEs": "Hope not = «espero que no». Con hope, el no se dice not.",
      "segments": [
        "Will it rain at the match? I",
        "hope not, because we have no umbrellas."
      ],
      "audioText": "Will it rain at the match? I hope not, because we have no umbrellas.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    },
    {
      "id": "en.n5.class-41.t03",
      "en": "Can you lend me your charger? I'm afraid not. It's at home.",
      "es": "¿Me prestas tu cargador? Me temo que no. Está en casa.",
      "explanationEs": "I'm afraid not: un «no» educado, que lamenta la respuesta.",
      "segments": [
        "Can you lend me your charger?",
        "I'm afraid not. It's at home."
      ],
      "audioText": "Can you lend me your charger? I'm afraid not. It's at home.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    },
    {
      "id": "en.n5.class-41.t04",
      "en": "Did Leo get the job? I suppose so. He looked very happy.",
      "es": "¿Consiguió Leo el trabajo? Supongo que sí. Se le veía muy contento.",
      "explanationEs": "Suppose y guess funcionan como think: I suppose so, I guess so.",
      "segments": [
        "Did Leo get the job? I",
        "suppose so. He looked very happy."
      ],
      "audioText": "Did Leo get the job? I suppose so. He looked very happy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    },
    {
      "id": "en.n5.class-41.t05",
      "en": "Is the test hard? I guess so, but it will probably be fine.",
      "es": "¿Es difícil el examen? Supongo que sí, pero probablemente irá bien.",
      "explanationEs": "Guess so = «supongo que sí»; probably añade una posibilidad.",
      "segments": [
        "Is the test hard? I guess so,",
        "but it will probably be fine."
      ],
      "audioText": "Is the test hard? I guess so, but it will probably be fine.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    },
    {
      "id": "en.n5.class-41.t06",
      "en": "I can't sleep. Neither can I, so let's chat.",
      "es": "No puedo dormir. Yo tampoco, así que charlemos.",
      "explanationEs": "Repaso: Neither + auxiliar + sujeto = «yo tampoco».",
      "segments": [
        "I can't sleep. Neither can",
        "I, so let's chat."
      ],
      "audioText": "I can't sleep. Neither can I, so let's chat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-1"
    }
  ],
