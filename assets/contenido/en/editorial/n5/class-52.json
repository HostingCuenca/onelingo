      "languageCode": "en",
      "patternId": "n5-right-and-wrong-2"
    },
    {
      "id": "en.n5.class-52.t02",
      "en": "If only the neighbours would stop the annoying noise!",
      "es": "¡Ojalá los vecinos pararan ese ruido tan molesto!",
      "explanationEs": "If only + would dice lo mismo que wish, pero con más emoción.",
      "segments": [
        "If only the neighbours would",
        "stop the annoying noise!"
      ],
      "audioText": "If only the neighbours would stop the annoying noise!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-2"
    },
    {
      "id": "en.n5.class-52.t03",
      "en": "I wish I had studied more for the exam.",
      "es": "Ojalá hubiera estudiado más para el examen.",
      "explanationEs": "Wish + had + participio: lamentas algo que ya pasó.",
      "segments": [
        "I wish I had studied",
        "more for the exam."
      ],
      "audioText": "I wish I had studied more for the exam.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-2"
    },
    {
      "id": "en.n5.class-52.t04",
      "en": "You should have studied for the exam; it was important.",
      "es": "Deberías haber estudiado para el examen; era importante.",
      "explanationEs": "Should have + participio: crítica por algo que no se hizo.",
      "segments": [
        "You should have studied for",
