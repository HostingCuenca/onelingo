      ],
      "audioText": "You should have studied for the exam; it was important.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-2"
    },
    {
      "id": "en.n5.class-52.t05",
      "en": "I regret shouting at her; I shouldn't have done that.",
      "es": "Me arrepiento de haberle gritado; no debería haberlo hecho.",
      "explanationEs": "Shouldn't have + participio: lamentas algo que sí hiciste.",
      "segments": [
