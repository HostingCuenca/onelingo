  "teaching": [
    {
      "id": "en.n5.class-76.t01",
      "en": "It is a fact that the council closed the road on 3 March.",
      "es": "Es un hecho que el ayuntamiento cerró la calle el 3 de marzo.",
      "explanationEs": "Un hecho se puede comprobar con una fecha, una cifra o un suceso.",
      "segments": [
        "It is a fact that the council",
        "closed the road on 3 March."
      ],
      "audioText": "It is a fact that the council closed the road on 3 March.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-1"
    },
    {
      "id": "en.n5.class-76.t02",
      "en": "In my opinion, the new rules are terrible.",
      "es": "En mi opinión, las nuevas reglas son terribles.",
      "explanationEs": "Una opinión es un juicio personal; palabras como terrible, best o should la delatan.",
      "segments": [
        "In my opinion, the",
        "new rules are terrible."
      ],
      "audioText": "In my opinion, the new rules are terrible.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-1"
    },
    {
      "id": "en.n5.class-76.t03",
      "en": "The spokesperson claims that traffic fell by 20 percent.",
      "es": "El portavoz afirma que el tráfico bajó un 20 por ciento.",
      "explanationEs": "Claim: lo dice alguien, pero la noticia no lo ha comprobado. El periodista toma distancia.",
      "segments": [
        "The spokesperson claims that traffic",
        "fell by 20 percent."
      ],
      "audioText": "The spokesperson claims that traffic fell by 20 percent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-1"
    },
    {
      "id": "en.n5.class-76.t04",
      "en": "Critics argue that the plan will cost too much.",
      "es": "Los críticos defienden que el plan costará demasiado.",
      "explanationEs": "Argue: defender una idea con razones. Suele introducir una opinión.",
      "segments": [
        "Critics argue that the plan",
        "will cost too much."
      ],
      "audioText": "Critics argue that the plan will cost too much.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-1"
    },
    {
      "id": "en.n5.class-76.t05",
      "en": "The mayor said there is no proof yet, but residents point out that the bus is late every day.",
      "es": "El alcalde dijo que aún no hay pruebas, pero los vecinos señalan que el autobús llega tarde cada día.",
      "explanationEs": "Point out: señalar algo que cualquiera puede ver o comprobar.",
      "segments": [
        "The mayor said there is no proof yet, but residents",
        "point out that the bus is late every day."
      ],
      "audioText": "The mayor said there is no proof yet, but residents point out that the bus is late every day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-1"
    },
    {
      "id": "en.n5.class-76.t06",
      "en": "According to a statement from the council, 300 residents voted; you can check the number.",
      "es": "Según una declaración del ayuntamiento, votaron 300 vecinos; puedes comprobar la cifra.",
      "explanationEs": "According to + fuente atribuye la información sin decir que sea cierta.",
      "segments": [
        "According to a statement from the council, 300",
        "residents voted; you can check the number."
      ],
      "audioText": "According to a statement from the council, 300 residents voted; you can check the number.",
