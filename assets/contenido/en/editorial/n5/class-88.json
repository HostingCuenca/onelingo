  "teaching": [
    {
      "id": "en.n5.class-88.t01",
      "en": "In my pitch, I'll explain the idea, the customers, the costs and the profit.",
      "es": "En mi propuesta explicaré la idea, los clientes, los costes y el beneficio.",
      "explanationEs": "Una propuesta breve responde a cuatro preguntas: idea, público, coste y beneficio.",
      "segments": [
        "In my pitch, I'll explain the idea,",
        "the customers, the costs and the profit."
      ],
      "audioText": "In my pitch, I'll explain the idea, the customers, the costs and the profit.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-3"
    },
    {
      "id": "en.n5.class-88.t02",
      "en": "Our target is students, because they finish school at three and want a cheap snack.",
      "es": "Nuestro público objetivo son los estudiantes, porque salen del colegio a las tres y quieren un tentempié barato.",
      "explanationEs": "Target nombra al público al que va dirigido el negocio.",
      "segments": [
        "Our target is students, because they finish school",
        "at three and want a cheap snack."
      ],
      "audioText": "Our target is students, because they finish school at three and want a cheap snack.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-3"
    },
    {
      "id": "en.n5.class-88.t03",
      "en": "The ingredients cost £40 per day, and we expect to sell 60 sandwiches.",
      "es": "Los ingredientes cuestan 40 libras al día y esperamos vender 60 bocadillos.",
      "explanationEs": "Per day = por día; expect to + verbo: lo que se espera que ocurra.",
      "segments": [
        "The ingredients cost £40 per day, and",
        "we expect to sell 60 sandwiches."
      ],
      "audioText": "The ingredients cost £40 per day, and we expect to sell 60 sandwiches.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-3"
    },
    {
      "id": "en.n5.class-88.t04",
      "en": "At £2 each, the sales will cover the costs and leave a profit of at least £70 per day.",
      "es": "A 2 libras cada uno, las ventas cubrirán los costes y dejarán un beneficio de al menos 70 libras al día.",
      "explanationEs": "Cover the costs = pagar los gastos; profit es lo que queda; at least = como mínimo.",
      "segments": [
        "At £2 each, the sales will cover the costs and",
        "leave a profit of at least £70 per day."
      ],
      "audioText": "At £2 each, the sales will cover the costs and leave a profit of at least £70 per day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-3"
    },
    {
      "id": "en.n5.class-88.t05",
      "en": "The stall is worth it only if it sells more than 20 sandwiches per day.",
      "es": "El puesto solo vale la pena si vende más de 20 bocadillos al día.",
      "explanationEs": "Worth it indica que algo compensa el esfuerzo y el dinero.",
      "segments": [
        "The stall is worth it only if it",
        "sells more than 20 sandwiches per day."
      ],
      "audioText": "The stall is worth it only if it sells more than 20 sandwiches per day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-3"
