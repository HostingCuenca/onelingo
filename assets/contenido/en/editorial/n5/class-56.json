    {
      "id": "en.n5.class-56.t01",
      "en": "Tom admitted that he had broken the window.",
      "es": "Tom reconoció que había roto la ventana.",
      "explanationEs": "Admitted: reconoce algo que hizo («Fui yo»). El tiempo retrocede un paso: had broken.",
      "segments": [
        "Tom admitted that he",
        "had broken the window."
      ],
      "audioText": "Tom admitted that he had broken the window.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-1"
    },
    {
      "id": "en.n5.class-56.t02",
      "en": "Mia denied that she had taken the last cake.",
      "es": "Mia negó haber tomado el último pastel.",
      "explanationEs": "Denied: niega algo («Yo no fui»).",
      "segments": [
        "Mia denied that she had",
        "taken the last cake."
      ],
      "audioText": "Mia denied that she had taken the last cake.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-1"
    },
    {
      "id": "en.n5.class-56.t03",
      "en": "Ana insisted that she was telling the truth.",
      "es": "Ana insistió en que decía la verdad.",
      "explanationEs": "Insisted: repite con firmeza lo que dice («¡Es verdad, te lo aseguro!»).",
      "segments": [
        "Ana insisted that she",
        "was telling the truth."
      ],
      "audioText": "Ana insisted that she was telling the truth.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-1"
    },
    {
      "id": "en.n5.class-56.t04",
      "en": "The teacher urged us to hurry because the bus was leaving.",
      "es": "La profesora nos instó a darnos prisa porque el autobús se iba.",
      "explanationEs": "Urged + persona + to + verbo: pide con insistencia que alguien actúe.",
      "segments": [
        "The teacher urged us to hurry",
        "because the bus was leaving."
      ],
      "audioText": "The teacher urged us to hurry because the bus was leaving.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-1"
    },
    {
      "id": "en.n5.class-56.t05",
      "en": "Leo wondered if the shop was still open.",
      "es": "Leo se preguntaba si la tienda seguía abierta.",
      "explanationEs": "Wondered + if: una pregunta que te haces a ti mismo; sin inversión ni signo de pregunta.",
      "segments": [
        "Leo wondered if the",
        "shop was still open."
      ],
      "audioText": "Leo wondered if the shop was still open.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-1"
    },
    {
      "id": "en.n5.class-56.t06",
      "en": "My sister warned me that the road was dangerous.",
      "es": "Mi hermana me advirtió que la carretera era peligrosa.",
      "explanationEs": "Warned + persona + that: avisa de un peligro.",
      "segments": [
