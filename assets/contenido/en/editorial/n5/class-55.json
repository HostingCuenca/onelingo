  "teaching": [
    {
      "id": "en.n5.class-55.t01",
      "en": "It's time we had a vote on how to spend the money.",
      "es": "Ya es hora de que hagamos una votación sobre cómo gastar el dinero.",
      "explanationEs": "It's time + we + pasado (had): urge a decidir ahora.",
      "segments": [
        "It's time we had a vote",
        "on how to spend the money."
      ],
      "audioText": "It's time we had a vote on how to spend the money.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    },
    {
      "id": "en.n5.class-55.t02",
      "en": "In my opinion, it is fair to share the money, because both ideas are good.",
      "es": "En mi opinión, es justo repartir el dinero, porque las dos ideas son buenas.",
      "explanationEs": "Postura + because + razón: así expones tu propuesta.",
      "segments": [
        "In my opinion, it is fair to share",
        "the money, because both ideas are good."
      ],
      "audioText": "In my opinion, it is fair to share the money, because both ideas are good.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    },
    {
      "id": "en.n5.class-55.t03",
      "en": "I see your point, but I'd rather we bought books first.",
      "es": "Entiendo tu argumento, pero preferiría que compráramos libros primero.",
      "explanationEs": "I see your point, but… reconoce lo que dice el otro antes de responder.",
      "segments": [
        "I see your point, but I'd",
        "rather we bought books first."
      ],
      "audioText": "I see your point, but I'd rather we bought books first.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    },
    {
      "id": "en.n5.class-55.t04",
      "en": "If we agree to share the money, each group gets half.",
      "es": "Si aceptamos repartir el dinero, cada grupo recibe la mitad.",
      "explanationEs": "If + presente + presente: lo que pasará con la propuesta.",
      "segments": [
        "If we agree to share the",
        "money, each group gets half."
      ],
      "audioText": "If we agree to share the money, each group gets half.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    },
    {
      "id": "en.n5.class-55.t05",
      "en": "I wish the council had asked the students before it decided.",
      "es": "Ojalá el consejo hubiera preguntado a los estudiantes antes de decidir.",
      "explanationEs": "Wish + had + participio: lamentas una decisión que ya se tomó.",
      "segments": [
        "I wish the council had asked",
        "the students before it decided."
      ],
      "audioText": "I wish the council had asked the students before it decided.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    },
    {
      "id": "en.n5.class-55.t06",
      "en": "Let's compromise: books this year and sports equipment next year.",
      "es": "Lleguemos a un acuerdo: libros este año y material deportivo el próximo.",
      "explanationEs": "Un compromise es un acuerdo en el que cada parte cede algo.",
      "segments": [
        "Let's compromise: books this year",
        "and sports equipment next year."
      ],
      "audioText": "Let's compromise: books this year and sports equipment next year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-right-and-wrong-5"
    }
  ],
