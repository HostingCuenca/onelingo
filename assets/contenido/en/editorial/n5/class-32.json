      "patternId": "n5-have-it-done-2"
    },
    {
      "id": "en.n5.class-32.t05",
      "en": "My parents let me choose the colour of my room.",
      "es": "Mis padres me dejan elegir el color de mi cuarto.",
      "explanationEs": "Let + persona + verbo base: permitir. Let no cambia en pasado.",
