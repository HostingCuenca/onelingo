  "teaching": [
    {
      "id": "en.n5.class-26.t01",
      "en": "I remember being told that the last bus leaves at nine.",
      "es": "Recuerdo que me dijeron que el último autobús sale a las nueve.",
      "explanationEs": "Remember + being + participio: alguien hizo la acción a mi persona (pasiva).",
      "segments": [
        "I remember being told that the",
        "last bus leaves at nine."
      ],
      "audioText": "I remember being told that the last bus leaves at nine.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    },
    {
      "id": "en.n5.class-26.t02",
      "en": "I can't deny having forgotten the tickets.",
      "es": "No puedo negar haber olvidado las entradas.",
      "explanationEs": "Deny + having + participio: negar algo que yo hice antes.",
      "segments": [
        "I can't deny having",
        "forgotten the tickets."
      ],
      "audioText": "I can't deny having forgotten the tickets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    },
    {
      "id": "en.n5.class-26.t03",
      "en": "We avoid being charged extra by booking early.",
      "es": "Evitamos que nos cobren de más reservando con tiempo.",
      "explanationEs": "Avoid + being + participio: evitar que otros nos hagan algo.",
      "segments": [
        "We avoid being charged",
        "extra by booking early."
      ],
      "audioText": "We avoid being charged extra by booking early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    },
    {
      "id": "en.n5.class-26.t04",
      "en": "I don't regret having travelled alone.",
      "es": "No lamento haber viajado sola.",
      "explanationEs": "Regret + having + participio: lamentar una acción propia ya realizada.",
      "segments": [
        "I don't regret",
        "having travelled alone."
      ],
      "audioText": "I don't regret having travelled alone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    },
    {
      "id": "en.n5.class-26.t05",
      "en": "I really appreciate being invited to stay in your flat.",
      "es": "Agradezco mucho que me invitaras a quedarme en tu piso.",
      "explanationEs": "Appreciate + being + participio: agradecer lo que alguien hizo por mí.",
      "segments": [
        "I really appreciate being invited",
        "to stay in your flat."
      ],
      "audioText": "I really appreciate being invited to stay in your flat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    },
    {
      "id": "en.n5.class-26.t06",
      "en": "She had to admit having missed the train, but she did not say why.",
      "es": "Tuvo que admitir haber perdido el tren, pero no dijo por qué.",
      "explanationEs": "Admit + having + participio: reconocer algo que yo hice antes.",
      "segments": [
        "She had to admit having missed the",
        "train, but she did not say why."
      ],
      "audioText": "She had to admit having missed the train, but she did not say why.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-1"
    }
  ],
