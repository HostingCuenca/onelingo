      "patternId": "n5-friends-banter-4"
    },
    {
      "id": "en.n5.class-44.t05",
      "en": "I've got loads of news, so let's catch up this weekend, mate.",
      "es": "Tengo montones de novedades, así que pongámonos al día este fin de semana, amigo.",
      "explanationEs": "Loads of = «montones de»; catch up = ponerse al día.",
      "segments": [
