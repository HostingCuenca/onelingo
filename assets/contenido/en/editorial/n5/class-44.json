  "teaching": [
    {
      "id": "en.n5.class-44.t01",
      "en": "Hi Mia! I haven't heard from you for ages, so I thought I'd write.",
      "es": "¡Hola, Mia! Hace siglos que no sé de ti, así que pensé en escribirte.",
      "explanationEs": "For ages = «durante mucho tiempo»; informal y muy frecuente.",
