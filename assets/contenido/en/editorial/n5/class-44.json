      "languageCode": "en",
      "patternId": "n5-friends-banter-4"
    },
    {
      "id": "en.n5.class-44.t03",
      "en": "It's so good to hear from you! I really miss our chats.",
      "es": "¡Qué bien saber de ti! Echo mucho de menos nuestras charlas.",
      "explanationEs": "So + adjetivo: «qué bien». Miss = echar de menos.",
      "segments": [
        "It's so good to hear from",
        "you! I really miss our chats."
      ],
      "audioText": "It's so good to hear from you! I really miss our chats.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-4"
    },
    {
      "id": "en.n5.class-44.t04",
      "en": "It was such a lovely surprise to get your message yesterday!",
      "es": "¡Fue una sorpresa tan bonita recibir tu mensaje ayer!",
      "explanationEs": "Such + a + adjetivo + sustantivo.",
      "segments": [
        "It was such a lovely surprise",
        "to get your message yesterday!"
      ],
      "audioText": "It was such a lovely surprise to get your message yesterday!",
