  "teaching": [
    {
      "id": "en.n5.class-45.t01",
      "en": "Hi, I'm Leo, a friend of the host. Let me introduce my sister.",
      "es": "Hola, soy Leo, amigo del anfitrión. Te presento a mi hermana.",
      "explanationEs": "Introduce + persona: así se presenta a alguien.",
      "segments": [
        "Hi, I'm Leo, a friend of the",
        "host. Let me introduce my sister."
      ],
      "audioText": "Hi, I'm Leo, a friend of the host. Let me introduce my sister.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-5"
    },
    {
      "id": "en.n5.class-45.t02",
      "en": "Do you know many people here? Not really. Actually, I only know the host.",
      "es": "¿Conoces a mucha gente aquí? La verdad es que no. En realidad, solo conozco al anfitrión.",
      "explanationEs": "Actually añade información que corrige o matiza: «en realidad».",
      "segments": [
        "Do you know many people here? Not",
        "really. Actually, I only know the host."
      ],
      "audioText": "Do you know many people here? Not really. Actually, I only know the host.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-5"
    },
    {
      "id": "en.n5.class-45.t03",
      "en": "Small talk is easy: ask a question, give a short answer and add a comment.",
      "es": "La charla informal es fácil: haz una pregunta, da una respuesta corta y añade un comentario.",
      "explanationEs": "Pregunta + respuesta corta + comentario mantiene viva la charla.",
      "segments": [
        "Small talk is easy: ask a question, give",
        "a short answer and add a comment."
      ],
      "audioText": "Small talk is easy: ask a question, give a short answer and add a comment.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-5"
    },
    {
      "id": "en.n5.class-45.t04",
      "en": "Speaking of music, our host is the DJ tonight. Fancy a dance?",
      "es": "Hablando de música, nuestro anfitrión es el DJ esta noche. ¿Te apetece bailar?",
      "explanationEs": "Speaking of + tema introduce un tema relacionado; Fancy a dance? es una elipsis.",
      "segments": [
        "Speaking of music, our host is",
        "the DJ tonight. Fancy a dance?"
      ],
      "audioText": "Speaking of music, our host is the DJ tonight. Fancy a dance?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-5"
    },
    {
      "id": "en.n5.class-45.t05",
      "en": "By the way, she's such a funny guest! We hit it off at once.",
      "es": "Por cierto, ¡es una invitada tan divertida! Congeniamos enseguida.",
      "explanationEs": "By the way cambia de tema; such a funny guest: such + a + adjetivo + sustantivo.",
      "segments": [
        "By the way, she's such a funny",
        "guest! We hit it off at once."
      ],
      "audioText": "By the way, she's such a funny guest! We hit it off at once.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-friends-banter-5"
    },
    {
      "id": "en.n5.class-45.t06",
      "en": "It was such a nice evening. Keep in touch!",
      "es": "Fue una tarde tan agradable. ¡Mantengamos el contacto!",
      "explanationEs": "Keep in touch! es la despedida típica.",
      "segments": [
        "It was such a nice",
        "evening. Keep in touch!"
      ],
      "audioText": "It was such a nice evening. Keep in touch!",
      "audioMode": "tts",
