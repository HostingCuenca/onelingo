  "teaching": [
    {
      "id": "en.n5.class-66.t01",
      "en": "The exam was a piece of cake, so I finished in twenty minutes.",
      "es": "El examen fue pan comido, así que terminé en veinte minutos.",
      "explanationEs": "A piece of cake no habla de pasteles: significa algo muy fácil.",
      "segments": [
        "The exam was a piece of cake,",
        "so I finished in twenty minutes."
      ],
      "audioText": "The exam was a piece of cake, so I finished in twenty minutes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    },
    {
      "id": "en.n5.class-66.t02",
      "en": "I feel under the weather, so I will miss the party.",
      "es": "Me siento mal, así que me perderé la fiesta.",
      "explanationEs": "Under the weather es sentirse un poco enfermo; nada que ver con el clima.",
      "segments": [
        "I feel under the weather, so",
        "I will miss the party."
      ],
      "audioText": "I feel under the weather, so I will miss the party.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    },
    {
      "id": "en.n5.class-66.t03",
      "en": "A small joke can break the ice when two people meet at a party.",
      "es": "Un pequeño chiste puede romper el hielo cuando dos personas se conocen en una fiesta.",
      "explanationEs": "Break the ice es una expresión transparente: el hielo es la tensión del primer encuentro.",
      "segments": [
        "A small joke can break the ice",
        "when two people meet at a party."
      ],
      "audioText": "A small joke can break the ice when two people meet at a party.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    },
    {
      "id": "en.n5.class-66.t04",
      "en": "I have an exam on Friday, so I must hit the books tonight.",
      "es": "Tengo un examen el viernes, así que esta noche debo ponerme a estudiar.",
      "explanationEs": "Hit the books es estudiar con ganas; books va siempre en plural.",
      "segments": [
        "I have an exam on Friday, so",
        "I must hit the books tonight."
      ],
      "audioText": "I have an exam on Friday, so I must hit the books tonight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    },
    {
      "id": "en.n5.class-66.t05",
      "en": "We see our cousins once in a blue moon, so this party is special.",
      "es": "Vemos a nuestros primos muy de vez en cuando, así que esta fiesta es especial.",
      "explanationEs": "Once in a blue moon quiere decir casi nunca, muy rara vez.",
      "segments": [
        "We see our cousins once in a",
        "blue moon, so this party is special."
      ],
      "audioText": "We see our cousins once in a blue moon, so this party is special.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    },
    {
      "id": "en.n5.class-66.t06",
      "en": "Please do not spill the beans: the party is a secret.",
      "es": "Por favor, no sueltes el secreto: la fiesta es una sorpresa.",
      "explanationEs": "Spill the beans es una expresión opaca: no se adivina, hay que aprenderla.",
      "segments": [
        "Please do not spill the beans:",
        "the party is a secret."
      ],
      "audioText": "Please do not spill the beans: the party is a secret.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-1"
    }
