  "teaching": [
    {
      "id": "en.n5.class-34.t01",
      "en": "For the makeover, we will paint the walls ourselves.",
      "es": "Para la reforma, pintaremos las paredes nosotros mismos.",
      "explanationEs": "Ourselves/myself indica que lo haces tú: verbo activo, sin have + participio.",
      "segments": [
        "For the makeover, we will",
        "paint the walls ourselves."
      ],
      "audioText": "For the makeover, we will paint the walls ourselves.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    },
    {
      "id": "en.n5.class-34.t02",
      "en": "We will have the shelves installed by a carpenter.",
      "es": "Encargaremos a un carpintero que instale los estantes.",
      "explanationEs": "Have + objeto + participio: el trabajo lo hace otra persona. By dice quién.",
      "segments": [
        "We will have the shelves",
        "installed by a carpenter."
      ],
      "audioText": "We will have the shelves installed by a carpenter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    },
    {
      "id": "en.n5.class-34.t03",
      "en": "The ceiling is too high, so we are getting it painted.",
      "es": "El techo es demasiado alto, así que lo vamos a hacer pintar.",
      "explanationEs": "Get + objeto + participio es la forma informal de encargar.",
      "segments": [
        "The ceiling is too high, so",
        "we are getting it painted."
      ],
      "audioText": "The ceiling is too high, so we are getting it painted.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    },
    {
      "id": "en.n5.class-34.t04",
      "en": "Our budget is small, so I will do the easy jobs myself.",
      "es": "Nuestro presupuesto es pequeño, así que haré yo mismo los trabajos fáciles.",
      "explanationEs": "Budget = presupuesto. Hacerlo tú mismo ahorra dinero.",
      "segments": [
        "Our budget is small, so I",
        "will do the easy jobs myself."
      ],
      "audioText": "Our budget is small, so I will do the easy jobs myself.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    },
    {
      "id": "en.n5.class-34.t05",
      "en": "The first rule: Dad lets us choose the colour, but he makes us tidy up.",
      "es": "La primera regla: papá nos deja elegir el color, pero nos hace ordenar.",
      "explanationEs": "Let permite y make obliga. Los dos llevan verbo base.",
      "segments": [
        "The first rule: Dad lets us choose the",
        "colour, but he makes us tidy up."
      ],
      "audioText": "The first rule: Dad lets us choose the colour, but he makes us tidy up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    },
    {
      "id": "en.n5.class-34.t06",
      "en": "The second rule is no noise after ten, so we cannot install anything late.",
      "es": "La segunda regla es no hacer ruido después de las diez, así que no podemos instalar nada tarde.",
      "explanationEs": "Noise es ruido, sin plural. Rule = norma de la casa.",
      "segments": [
        "The second rule is no noise after",
        "ten, so we cannot install anything late."
      ],
      "audioText": "The second rule is no noise after ten, so we cannot install anything late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-4"
    }
  ],
