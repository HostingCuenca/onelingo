  "teaching": [
    {
      "id": "en.n5.class-12.t01",
      "en": "We had been queuing for two hours when the doors finally opened.",
      "es": "Llevábamos dos horas haciendo cola cuando por fin se abrieron las puertas.",
      "explanationEs": "Had been + -ing + for: la actividad duró dos horas hasta ese momento.",
      "segments": [
        "We had been queuing for two",
        "hours when the doors finally opened."
      ],
      "audioText": "We had been queuing for two hours when the doors finally opened.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-before-that-moment-2"
    },
    {
      "id": "en.n5.class-12.t02",
      "en": "Leo hadn't been sleeping well, so he was grumpy all day.",
      "es": "Leo no había estado durmiendo bien, así que estuvo de mal humor todo el día.",
      "explanationEs": "Negativa: hadn't been + -ing; explica el mal humor.",
      "segments": [
        "Leo hadn't been sleeping well, so",
        "he was grumpy all day."
      ],
      "audioText": "Leo hadn't been sleeping well, so he was grumpy all day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-before-that-moment-2"
    },
    {
      "id": "en.n5.class-12.t03",
      "en": "By noon Mia had finished two pages, so she took a short break.",
      "es": "Para el mediodía Mia había terminado dos páginas, así que hizo un breve descanso.",
      "explanationEs": "Had finished + cantidad: interesa el resultado (dos páginas), no el tiempo.",
      "segments": [
        "By noon Mia had finished two pages,",
        "so she took a short break."
      ],
      "audioText": "By noon Mia had finished two pages, so she took a short break.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-before-that-moment-2"
    },
    {
      "id": "en.n5.class-12.t04",
      "en": "How long had you been queuing before the doors opened?",
      "es": "¿Cuánto tiempo llevabas haciendo cola antes de que abrieran las puertas?",
      "explanationEs": "Pregunta de duración: How long + had + sujeto + been + -ing.",
      "segments": [
        "How long had you been",
        "queuing before the doors opened?"
      ],
      "audioText": "How long had you been queuing before the doors opened?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-before-that-moment-2"
    },
    {
      "id": "en.n5.class-12.t05",
      "en": "Sara had written four pages, but she had only been writing for an hour.",
      "es": "Sara había escrito cuatro páginas, pero solo llevaba una hora escribiendo.",
      "explanationEs": "Had written cuenta el resultado (four pages); had been writing mide el tiempo.",
      "segments": [
        "Sara had written four pages, but she",
        "had only been writing for an hour."
      ],
      "audioText": "Sara had written four pages, but she had only been writing for an hour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-before-that-moment-2"
    }
