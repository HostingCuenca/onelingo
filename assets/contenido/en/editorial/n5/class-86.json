  "teaching": [
    {
      "id": "en.n5.class-86.t01",
      "en": "Carlos is in charge of the tools, so he checks them every Saturday.",
      "es": "Carlos es el encargado de las herramientas, así que las revisa cada sábado.",
      "explanationEs": "Be in charge of + cosa: tiene el mando y la tarea.",
      "segments": [
        "Carlos is in charge of the tools,",
        "so he checks them every Saturday."
      ],
      "audioText": "Carlos is in charge of the tools, so he checks them every Saturday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-leading-projects-1"
    },
    {
      "id": "en.n5.class-86.t02",
      "en": "Sara is responsible for the schedule, so she decides who works when.",
      "es": "Sara es responsable del horario, así que decide quién trabaja y cuándo.",
      "explanationEs": "Be responsible for + cosa: responde de que salga bien.",
