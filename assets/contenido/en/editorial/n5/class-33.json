  "teaching": [
    {
      "id": "en.n5.class-33.t01",
      "en": "Mia has an appointment to have her hair cut and dyed on Thursday.",
      "es": "Mia tiene cita para cortarse y teñirse el pelo el jueves.",
      "explanationEs": "Appointment es una cita para un servicio. Have her hair cut and dyed: dos participios, dos trabajos.",
      "segments": [
        "Mia has an appointment to have her",
        "hair cut and dyed on Thursday."
      ],
      "audioText": "Mia has an appointment to have her hair cut and dyed on Thursday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    },
    {
      "id": "en.n5.class-33.t02",
      "en": "The garage can have the brakes checked by Friday.",
      "es": "El taller puede hacer revisar los frenos para el viernes, a más tardar.",
      "explanationEs": "By + día marca el plazo: a más tardar ese día.",
      "segments": [
        "The garage can have the",
        "brakes checked by Friday."
      ],
      "audioText": "The garage can have the brakes checked by Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    },
    {
      "id": "en.n5.class-33.t03",
      "en": "The deadline is Friday, but only if the parts arrive on Wednesday.",
      "es": "El plazo es el viernes, pero solo si las piezas llegan el miércoles.",
      "explanationEs": "Only if introduce la condición: sin ella, el plazo no vale.",
      "segments": [
        "The deadline is Friday, but only",
        "if the parts arrive on Wednesday."
      ],
      "audioText": "The deadline is Friday, but only if the parts arrive on Wednesday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    },
    {
      "id": "en.n5.class-33.t04",
      "en": "Tom is having his phone screen replaced and it will be ready by six.",
      "es": "Tom está haciendo cambiar la pantalla de su móvil y estará lista antes de las seis.",
      "explanationEs": "Ready by + hora dice cuándo se puede recoger.",
      "segments": [
        "Tom is having his phone screen replaced",
        "and it will be ready by six."
      ],
      "audioText": "Tom is having his phone screen replaced and it will be ready by six.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    },
    {
      "id": "en.n5.class-33.t05",
      "en": "You must pay a deposit before they start.",
      "es": "Debes pagar un anticipo antes de que empiecen.",
      "explanationEs": "Must marca lo que el cliente está obligado a hacer.",
      "segments": [
        "You must pay a",
        "deposit before they start."
      ],
      "audioText": "You must pay a deposit before they start.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    },
    {
      "id": "en.n5.class-33.t06",
      "en": "The salon has one condition: clients must arrive ten minutes early.",
      "es": "La peluquería pone una condición: los clientes deben llegar diez minutos antes.",
      "explanationEs": "Condition = condición. Después de los dos puntos viene lo que hay que cumplir.",
      "segments": [
        "The salon has one condition: clients",
        "must arrive ten minutes early."
      ],
      "audioText": "The salon has one condition: clients must arrive ten minutes early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-have-it-done-3"
    }
