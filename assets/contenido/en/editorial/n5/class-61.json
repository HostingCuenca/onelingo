      "patternId": "n5-everyday-phrasal-1"
    },
    {
      "id": "en.n5.class-61.t04",
      "en": "Passengers must check in two hours before the flight.",
      "es": "Los pasajeros deben registrarse dos horas antes del vuelo.",
      "explanationEs": "Check in es presentarte en el mostrador o en línea para confirmar tu viaje.",
      "segments": [
        "Passengers must check in two",
        "hours before the flight."
      ],
      "audioText": "Passengers must check in two hours before the flight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-1"
    },
    {
      "id": "en.n5.class-61.t05",
      "en": "If the app stays open all day, we will run out of battery.",
      "es": "Si la aplicación se queda abierta todo el día, nos quedaremos sin batería.",
      "explanationEs": "Run out of + algo: ese algo se acaba. Va seguido de of.",
      "segments": [
        "If the app stays open all day,",
        "we will run out of battery."
      ],
      "audioText": "If the app stays open all day, we will run out of battery.",
      "audioMode": "tts",
