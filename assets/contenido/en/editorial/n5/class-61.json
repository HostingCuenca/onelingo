    {
      "id": "en.n5.class-61.t01",
      "en": "The coach asked the team to warm up before the tournament.",
      "es": "El entrenador pidió al equipo que calentara antes del torneo.",
      "explanationEs": "Warm up aquí es calentar el cuerpo antes de hacer deporte.",
      "segments": [
        "The coach asked the team to",
        "warm up before the tournament."
      ],
      "audioText": "The coach asked the team to warm up before the tournament.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-1"
    },
    {
      "id": "en.n5.class-61.t02",
      "en": "Our coach told us never to give up, even in the last minute.",
      "es": "Nuestro entrenador nos dijo que nunca nos rindiéramos, ni siquiera en el último minuto.",
      "explanationEs": "Give up significa rendirse: no tiene nada que ver con «dar» ni con «arriba».",
      "segments": [
        "Our coach told us never to give",
        "up, even in the last minute."
      ],
      "audioText": "Our coach told us never to give up, even in the last minute.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-1"
    },
    {
      "id": "en.n5.class-61.t03",
      "en": "I cannot log in to the app because I forgot my password.",
      "es": "No puedo iniciar sesión en la aplicación porque olvidé mi contraseña.",
      "explanationEs": "Log in es entrar en una cuenta con usuario y contraseña.",
      "segments": [
        "I cannot log in to the",
        "app because I forgot my password."
      ],
      "audioText": "I cannot log in to the app because I forgot my password.",
      "audioMode": "tts",
