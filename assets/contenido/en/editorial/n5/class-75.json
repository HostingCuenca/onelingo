  "teaching": [
    {
      "id": "en.n5.class-75.t01",
      "en": "Let me explain the finding in simple words.",
      "es": "Déjame explicarte el hallazgo con palabras sencillas.",
      "explanationEs": "Explain + el hallazgo; simple words anuncia que vas a simplificar.",
      "segments": [
        "Let me explain the",
        "finding in simple words."
      ],
      "audioText": "Let me explain the finding in simple words.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    },
    {
      "id": "en.n5.class-75.t02",
      "en": "In other words, there is a pattern: students who sleep more tend to get better marks.",
      "es": "Es decir, hay un patrón: los estudiantes que duermen más suelen sacar mejores notas.",
      "explanationEs": "In other words reformula con palabras más simples. Pattern = lo que se repite en los datos.",
      "segments": [
        "In other words, there is a pattern: students",
        "who sleep more tend to get better marks."
      ],
      "audioText": "In other words, there is a pattern: students who sleep more tend to get better marks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    },
    {
      "id": "en.n5.class-75.t03",
      "en": "That does not mean that sleep causes good marks; it may be a coincidence.",
      "es": "Eso no significa que dormir cause buenas notas; puede ser una coincidencia.",
      "explanationEs": "That does not mean that… frena una conclusión demasiado fuerte. Coincidence = dos cosas que coinciden sin relación.",
      "segments": [
        "That does not mean that sleep causes",
        "good marks; it may be a coincidence."
      ],
      "audioText": "That does not mean that sleep causes good marks; it may be a coincidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    },
    {
      "id": "en.n5.class-75.t04",
      "en": "More sleep does not necessarily lead to better marks.",
      "es": "Dormir más no lleva necesariamente a mejores notas.",
      "explanationEs": "Not necessarily matiza: puede pasar, pero no siempre ni por esa razón.",
      "segments": [
        "More sleep does not necessarily",
        "lead to better marks."
      ],
      "audioText": "More sleep does not necessarily lead to better marks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    },
    {
      "id": "en.n5.class-75.t05",
      "en": "For example, umbrella sales and rain both rise in autumn, but umbrellas do not cause rain.",
      "es": "Por ejemplo, las ventas de paraguas y la lluvia suben ambas en otoño, pero los paraguas no causan la lluvia.",
      "explanationEs": "For example abre un caso que aclara la idea. Both = los dos.",
      "segments": [
        "For example, umbrella sales and rain both rise",
        "in autumn, but umbrellas do not cause rain."
      ],
      "audioText": "For example, umbrella sales and rain both rise in autumn, but umbrellas do not cause rain.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    },
    {
      "id": "en.n5.class-75.t06",
      "en": "I am not sure yet, so the next study must test it.",
      "es": "Todavía no estoy seguro, así que el próximo estudio debe comprobarlo.",
      "explanationEs": "Decir que todavía no estás seguro también es explicar con precisión.",
      "segments": [
        "I am not sure yet, so",
        "the next study must test it."
      ],
      "audioText": "I am not sure yet, so the next study must test it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-5"
    }
  ],
