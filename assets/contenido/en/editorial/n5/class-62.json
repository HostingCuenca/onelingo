  "teaching": [
    {
      "id": "en.n5.class-62.t01",
      "en": "She picked her suitcase up and walked to the gate.",
      "es": "Recogió su maleta y caminó hacia la puerta.",
      "explanationEs": "Separable: con un sustantivo, el objeto puede ir en medio (picked her suitcase up) o después (picked up her suitcase).",
      "segments": [
        "She picked her suitcase up",
        "and walked to the gate."
      ],
      "audioText": "She picked her suitcase up and walked to the gate.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-2"
    },
    {
      "id": "en.n5.class-62.t02",
      "en": "The suitcase was heavy, so she picked it up carefully.",
      "es": "La maleta pesaba mucho, así que la recogió con cuidado.",
      "explanationEs": "Con un pronombre (it, them, me) el objeto va siempre en medio: picked it up.",
      "segments": [
        "The suitcase was heavy, so",
        "she picked it up carefully."
      ],
      "audioText": "The suitcase was heavy, so she picked it up carefully.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-2"
    },
    {
      "id": "en.n5.class-62.t03",
      "en": "Please turn off the light before you leave.",
      "es": "Por favor, apaga la luz antes de salir.",
      "explanationEs": "Turn off es separable: también puedes decir turn the light off o turn it off.",
      "segments": [
        "Please turn off the",
        "light before you leave."
      ],
      "audioText": "Please turn off the light before you leave.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-2"
    },
    {
      "id": "en.n5.class-62.t04",
      "en": "Our neighbour looks after the dog when we travel.",
      "es": "Nuestro vecino cuida al perro cuando viajamos.",
      "explanationEs": "Inseparable: el objeto va siempre después y nada se mete en medio: looks after it.",
      "segments": [
        "Our neighbour looks after the",
        "dog when we travel."
      ],
      "audioText": "Our neighbour looks after the dog when we travel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-2"
    },
    {
      "id": "en.n5.class-62.t05",
      "en": "I am looking forward to the holiday.",
      "es": "Tengo muchas ganas de que lleguen las vacaciones.",
      "explanationEs": "Tres partes: el objeto va después de todo el verbo, incluido to: looking forward to it.",
      "segments": [
        "I am looking forward",
        "to the holiday."
      ],
      "audioText": "I am looking forward to the holiday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-everyday-phrasal-2"
    },
    {
      "id": "en.n5.class-62.t06",
      "en": "Leo came up with a great idea for the trip.",
      "es": "A Leo se le ocurrió una gran idea para el viaje.",
      "explanationEs": "Come up with también tiene tres partes: el objeto va al final.",
      "segments": [
