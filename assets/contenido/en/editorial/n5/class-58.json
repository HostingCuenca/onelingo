  "teaching": [
    {
      "id": "en.n5.class-58.t01",
      "en": "Tom said he was tired then.",
      "es": "Tom dijo que estaba cansado en ese momento.",
      "explanationEs": "Now → then: el «ahora» de la cita original pasa a «entonces»; am → was.",
      "segments": [
        "Tom said he",
        "was tired then."
      ],
      "audioText": "Tom said he was tired then.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    },
    {
      "id": "en.n5.class-58.t02",
      "en": "Ana said she had been there the day before.",
      "es": "Ana dijo que había estado allí el día anterior.",
      "explanationEs": "Here → there y yesterday → the day before; el tiempo retrocede un paso (was → had been).",
      "segments": [
        "Ana said she had been",
        "there the day before."
      ],
      "audioText": "Ana said she had been there the day before.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    },
    {
      "id": "en.n5.class-58.t03",
      "en": "The original was «I might come», but the report says she promised to come, so that version is distorted.",
      "es": "El original era «quizá venga», pero el reporte dice que prometió venir, así que esa versión está distorsionada.",
      "explanationEs": "Una versión distorsionada cambia la fuerza de lo dicho: might no es promised.",
      "segments": [
        "The original was «I might come», but the report says",
        "she promised to come, so that version is distorted."
      ],
      "audioText": "The original was «I might come», but the report says she promised to come, so that version is distorted.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    },
    {
      "id": "en.n5.class-58.t04",
      "en": "She said «a few people», but the report says «hundreds», so it is exaggerated.",
      "es": "Ella dijo «unas pocas personas», pero el reporte dice «cientos», así que está exagerado.",
      "explanationEs": "Exaggerated: hace algo más grande de lo que fue.",
      "segments": [
        "She said «a few people», but the",
        "report says «hundreds», so it is exaggerated."
      ],
      "audioText": "She said «a few people», but the report says «hundreds», so it is exaggerated.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    },
    {
      "id": "en.n5.class-58.t05",
      "en": "An accurate report keeps every detail: who said it, what they said and when.",
      "es": "Un reporte exacto conserva cada detalle: quién lo dijo, qué dijo y cuándo.",
      "explanationEs": "Accurate + detail: no se omite ni se añade información.",
      "segments": [
        "An accurate report keeps every detail: who",
        "said it, what they said and when."
      ],
      "audioText": "An accurate report keeps every detail: who said it, what they said and when.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    },
    {
      "id": "en.n5.class-58.t06",
      "en": "In a faithful version, «I may be late» becomes He said he might be late.",
      "es": "En una versión fiel, «puede que llegue tarde» se convierte en Dijo que quizá llegaría tarde.",
      "explanationEs": "May → might: el grado de posibilidad se mantiene al retroceder.",
      "segments": [
        "In a faithful version, «I may be late»",
        "becomes He said he might be late."
      ],
      "audioText": "In a faithful version, «I may be late» becomes He said he might be late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-what-they-said-3"
    }
  ],
