  "id": "en.n5.class-58",
  "title": {
    "en": "Original or retold?",
    "es": "¿Versión original o versión contada?"
  },
  "objectives": {
    "es": [
      "Comparar una conversación con su versión reportada y detectar distorsiones de tiempo, persona o sentido."
    ]
  },
