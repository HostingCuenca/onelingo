  "teaching": [
    {
      "id": "en.n5.class-27.t01",
      "en": "She seems to have lost her passport somewhere in the station.",
      "es": "Parece haber perdido su pasaporte en algún lugar de la estación.",
      "explanationEs": "To have + participio: algo que ya pasó antes de «seems».",
      "segments": [
        "She seems to have lost her",
        "passport somewhere in the station."
      ],
      "audioText": "She seems to have lost her passport somewhere in the station.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    },
    {
      "id": "en.n5.class-27.t02",
      "en": "I hope to be invited to the wedding in Rome.",
      "es": "Espero que me inviten a la boda en Roma.",
      "explanationEs": "To be + participio: el sujeto recibe la acción (pasiva).",
      "segments": [
        "I hope to be invited",
        "to the wedding in Rome."
      ],
      "audioText": "I hope to be invited to the wedding in Rome.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    },
    {
      "id": "en.n5.class-27.t03",
      "en": "Don't pretend to have forgotten the tickets!",
      "es": "¡No finjas haber olvidado las entradas!",
      "explanationEs": "Pretend to have + participio: fingir algo que ya ocurrió.",
      "segments": [
        "Don't pretend to have",
        "forgotten the tickets!"
      ],
      "audioText": "Don't pretend to have forgotten the tickets!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    },
    {
      "id": "en.n5.class-27.t04",
      "en": "I'm glad to have met you on this trip.",
      "es": "Me alegro de haberte conocido en este viaje.",
      "explanationEs": "Glad to have + participio: alegrarse de algo ya hecho.",
      "segments": [
        "I'm glad to have met",
        "you on this trip."
      ],
      "audioText": "I'm glad to have met you on this trip.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    },
    {
      "id": "en.n5.class-27.t05",
      "en": "After having missed the last bus, we walked to the hostel.",
      "es": "Después de perder el último autobús, fuimos andando al albergue.",
      "explanationEs": "After + having + participio: tras una preposición se usa -ing.",
      "segments": [
        "After having missed the last bus,",
        "we walked to the hostel."
      ],
      "audioText": "After having missed the last bus, we walked to the hostel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    },
    {
      "id": "en.n5.class-27.t06",
      "en": "Mia was glad to be chosen for the trip.",
      "es": "Mia se alegró de que la eligieran para el viaje.",
      "explanationEs": "To be + participio con adjetivos: glad to be chosen.",
      "segments": [
        "Mia was glad to be",
        "chosen for the trip."
      ],
      "audioText": "Mia was glad to be chosen for the trip.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-journeys-verb-patterns-2"
    }
  ],
