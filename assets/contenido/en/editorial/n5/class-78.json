  "teaching": [
    {
      "id": "en.n5.class-78.t01",
      "en": "The two versions report the same event, but each one has a different focus.",
      "es": "Las dos versiones cuentan el mismo hecho, pero cada una tiene un enfoque distinto.",
      "explanationEs": "Focus = lo que una versión pone en primer plano.",
      "segments": [
        "The two versions report the same event,",
        "but each one has a different focus."
      ],
      "audioText": "The two versions report the same event, but each one has a different focus.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    },
    {
      "id": "en.n5.class-78.t02",
      "en": "Version A says the council takes away the park, whereas version B says it closes the park on Sundays.",
      "es": "La versión A dice que el ayuntamiento quita el parque, mientras que la B dice que lo cierra los domingos.",
      "explanationEs": "Dos versiones del mismo hecho: takes away suena más duro que closes.",
      "segments": [
        "Version A says the council takes away the park, whereas",
        "version B says it closes the park on Sundays."
      ],
      "audioText": "Version A says the council takes away the park, whereas version B says it closes the park on Sundays.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    },
    {
      "id": "en.n5.class-78.t03",
      "en": "Loaded words, like «takes away», carry an opinion in a news story.",
      "es": "Las palabras cargadas, como «takes away», llevan una opinión en una noticia.",
      "explanationEs": "Loaded: lleva una emoción o un juicio escondido.",
      "segments": [
        "Loaded words, like «takes away», carry",
        "an opinion in a news story."
      ],
      "audioText": "Loaded words, like «takes away», carry an opinion in a news story.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    },
    {
      "id": "en.n5.class-78.t04",
      "en": "A neutral headline only states the facts: who, what and when.",
      "es": "Un titular neutral solo da los hechos: quién, qué y cuándo.",
      "explanationEs": "Neutral = sin opinión. Busca verbos como closes o says.",
      "segments": [
        "A neutral headline only states the",
        "facts: who, what and when."
      ],
      "audioText": "A neutral headline only states the facts: who, what and when.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    },
    {
      "id": "en.n5.class-78.t05",
      "en": "One version will emphasise the anger of the families; the other will mention the new grass.",
      "es": "Una versión destacará el enfado de las familias; la otra mencionará la hierba nueva.",
      "explanationEs": "Emphasise = poner el acento; mention = nombrar sin insistir.",
      "segments": [
        "One version will emphasise the anger of the",
        "families; the other will mention the new grass."
      ],
      "audioText": "One version will emphasise the anger of the families; the other will mention the new grass.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    },
    {
      "id": "en.n5.class-78.t06",
      "en": "The tone of a text shows how the writer feels about the event.",
      "es": "El tono de un texto muestra lo que siente el autor sobre el hecho.",
      "explanationEs": "Tone: angry, calm o neutral.",
      "segments": [
        "The tone of a text shows how",
        "the writer feels about the event."
      ],
      "audioText": "The tone of a text shows how the writer feels about the event.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-3"
    }
  ],
