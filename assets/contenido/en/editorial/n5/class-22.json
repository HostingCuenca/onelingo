    {
      "id": "en.n5.class-22.t01",
      "en": "Our neighbour must have been sleeping, because he did not hear the noise.",
      "es": "Nuestro vecino debía de estar durmiendo, porque no oyó el ruido.",
      "explanationEs": "Must have been + -ing: casi seguro de una acción que estaba en curso.",
      "segments": [
        "Our neighbour must have been sleeping, because",
        "he did not hear the noise."
      ],
      "audioText": "Our neighbour must have been sleeping, because he did not hear the noise.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-speculation-and-chances-2"
    },
    {
      "id": "en.n5.class-22.t02",
      "en": "A guest might have been using the kitchen, because the light was on.",
      "es": "Puede que un invitado estuviera usando la cocina, porque la luz estaba encendida.",
      "explanationEs": "Might have been + -ing: posible, sin certeza.",
      "segments": [
