  "id": "en.n5.class-73",
  "title": {
    "en": "Reading a study summary",
    "es": "Leer el resumen de un estudio"
  },
  "objectives": {
    "es": [
      "Leer el resumen de un estudio y localizar la pregunta, el método, el resultado y la limitación, sin confundir lo que el estudio sugiere con lo que demuestra."
    ]
  },
