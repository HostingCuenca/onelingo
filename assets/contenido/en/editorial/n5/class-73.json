  "teaching": [
    {
      "id": "en.n5.class-73.t01",
      "en": "The researchers asked whether teenagers who eat breakfast feel better.",
      "es": "Los investigadores preguntaron si los adolescentes que desayunan se sienten mejor.",
      "explanationEs": "Whether = «si» en una pregunta indirecta; el orden es sujeto + verbo, sin do ni did.",
      "segments": [
        "The researchers asked whether teenagers",
        "who eat breakfast feel better."
      ],
      "audioText": "The researchers asked whether teenagers who eat breakfast feel better.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-3"
    },
    {
      "id": "en.n5.class-73.t02",
      "en": "They surveyed 200 participants for six weeks.",
      "es": "Encuestaron a 200 participantes durante seis semanas.",
      "explanationEs": "El método dice a quién se estudió, cómo y cuánto tiempo.",
      "segments": [
        "They surveyed 200 participants",
        "for six weeks."
      ],
      "audioText": "They surveyed 200 participants for six weeks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-3"
    },
    {
      "id": "en.n5.class-73.t03",
      "en": "The main finding is that students who ate breakfast scored higher.",
      "es": "El hallazgo principal es que los estudiantes que desayunaron sacaron más puntos.",
      "explanationEs": "Finding = lo que encontraron: el resultado principal.",
      "segments": [
        "The main finding is that students",
        "who ate breakfast scored higher."
      ],
      "audioText": "The main finding is that students who ate breakfast scored higher.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-3"
    },
    {
      "id": "en.n5.class-73.t04",
      "en": "The results suggest a link, but they do not prove the cause.",
      "es": "Los resultados sugieren un vínculo, pero no demuestran la causa.",
      "explanationEs": "Suggest indica una pista; prove sería una prueba definitiva. Un estudio pequeño casi siempre solo sugiere.",
      "segments": [
        "The results suggest a link, but",
        "they do not prove the cause."
      ],
      "audioText": "The results suggest a link, but they do not prove the cause.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-3"
    },
    {
      "id": "en.n5.class-73.t05",
      "en": "However, the sample was small, and this limitation matters: the study lasted only six weeks.",
      "es": "Sin embargo, la muestra era pequeña, y esta limitación importa: el estudio duró solo seis semanas.",
      "explanationEs": "However + coma abre la limitación. Sample es el grupo estudiado; only marca que es poco.",
      "segments": [
        "However, the sample was small, and this limitation",
        "matters: the study lasted only six weeks."
      ],
      "audioText": "However, the sample was small, and this limitation matters: the study lasted only six weeks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-3"
    }
  ],
