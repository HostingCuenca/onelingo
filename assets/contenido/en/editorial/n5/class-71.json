  "teaching": [
    {
      "id": "en.n5.class-71.t01",
      "en": "The scientist will analyse the data tomorrow.",
      "es": "La científica analizará los datos mañana.",
      "explanationEs": "Analyse es un verbo (la acción) y va después de will.",
      "segments": [
        "The scientist will analyse",
        "the data tomorrow."
      ],
      "audioText": "The scientist will analyse the data tomorrow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    },
    {
      "id": "en.n5.class-71.t02",
      "en": "Her analysis shows that the plant needs more light.",
      "es": "Su análisis muestra que la planta necesita más luz.",
      "explanationEs": "Analysis es un sustantivo (-sis): nombra una cosa y va después de her.",
      "segments": [
        "Her analysis shows that the",
        "plant needs more light."
      ],
      "audioText": "Her analysis shows that the plant needs more light.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    },
    {
      "id": "en.n5.class-71.t03",
      "en": "She has an analytical mind and checks every number.",
      "es": "Tiene una mente analítica y revisa cada número.",
      "explanationEs": "Analytical es un adjetivo (-al): describe el sustantivo mind.",
      "segments": [
        "She has an analytical mind",
        "and checks every number."
      ],
      "audioText": "She has an analytical mind and checks every number.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    },
    {
      "id": "en.n5.class-71.t04",
      "en": "The team worked scientifically and wrote down every observation.",
      "es": "El equipo trabajó científicamente y anotó cada observación.",
      "explanationEs": "Scientifically es un adverbio (-ly): dice cómo trabajó. Observation es un sustantivo (-tion).",
      "segments": [
        "The team worked scientifically and",
        "wrote down every observation."
      ],
      "audioText": "The team worked scientifically and wrote down every observation.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    },
    {
      "id": "en.n5.class-71.t05",
      "en": "Good scientists observe first; then they make a prediction.",
      "es": "Los buenos científicos primero observan; después hacen una predicción.",
      "explanationEs": "Observe es un verbo; prediction es un sustantivo. La raíz se repite con otra terminación.",
      "segments": [
        "Good scientists observe first; then",
        "they make a prediction."
      ],
      "audioText": "Good scientists observe first; then they make a prediction.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    },
    {
      "id": "en.n5.class-71.t06",
      "en": "Every measurement in a scientific report must be correct.",
      "es": "Cada medición de un informe científico debe ser correcta.",
      "explanationEs": "Measurement es un sustantivo (-ment); scientific es un adjetivo (-ific) y va antes de report.",
      "segments": [
        "Every measurement in a scientific",
        "report must be correct."
      ],
      "audioText": "Every measurement in a scientific report must be correct.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-how-science-works-1"
    }
  ],
