  "teaching": [
    {
      "id": "en.n5.class-80.t01",
      "en": "I would say the coverage was fairly balanced.",
      "es": "Yo diría que la cobertura fue bastante equilibrada.",
      "explanationEs": "I would say suaviza tu opinión; fairly modera el adjetivo.",
      "segments": [
        "I would say the",
        "coverage was fairly balanced."
      ],
      "audioText": "I would say the coverage was fairly balanced.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-5"
    },
    {
      "id": "en.n5.class-80.t02",
      "en": "It was rather one-sided, because it used only one source.",
      "es": "Fue más bien unilateral, porque usó solo una fuente.",
      "explanationEs": "Rather = más bien: matiza sin exagerar. Después de because va la evidencia.",
      "segments": [
        "It was rather one-sided, because",
        "it used only one source."
      ],
      "audioText": "It was rather one-sided, because it used only one source.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-5"
    },
    {
      "id": "en.n5.class-80.t03",
      "en": "You have a point: that criticism is valid.",
      "es": "Tienes razón: esa crítica es válida.",
      "explanationEs": "You have a point concede un argumento. No se dice «you have reason».",
      "segments": [
        "You have a point:",
        "that criticism is valid."
      ],
      "audioText": "You have a point: that criticism is valid.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-5"
    },
    {
      "id": "en.n5.class-80.t04",
      "en": "That said, to some extent the report was biased: the headline was loaded.",
      "es": "Dicho esto, hasta cierto punto el reportaje fue parcial: el titular estaba cargado.",
      "explanationEs": "That said vuelve al argumento contrario; to some extent modera la crítica.",
      "segments": [
        "That said, to some extent the report",
        "was biased: the headline was loaded."
      ],
      "audioText": "That said, to some extent the report was biased: the headline was loaded.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-5"
    },
    {
      "id": "en.n5.class-80.t05",
      "en": "On balance, the coverage was fair, because it gave both sides.",
      "es": "En conjunto, la cobertura fue justa, porque dio los dos lados.",
      "explanationEs": "On balance abre la conclusión final, tras pesar los argumentos.",
      "segments": [
        "On balance, the coverage was fair,",
        "because it gave both sides."
      ],
      "audioText": "On balance, the coverage was fair, because it gave both sides.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-reading-the-media-5"
    }
  ],
