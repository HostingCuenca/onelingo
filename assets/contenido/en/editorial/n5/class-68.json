  "teaching": [
    {
      "id": "en.n5.class-68.t01",
      "en": "The spring festival is a tradition that began more than a hundred years ago.",
      "es": "El festival de primavera es una tradición que empezó hace más de cien años.",
      "explanationEs": "El origen se cuenta en pasado simple (began); la tradición sigue hoy.",
      "segments": [
        "The spring festival is a tradition that",
        "began more than a hundred years ago."
      ],
      "audioText": "The spring festival is a tradition that began more than a hundred years ago.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    },
    {
      "id": "en.n5.class-68.t02",
      "en": "Everyone in the village is happy to take part in the festival.",
      "es": "Todos en el pueblo están felices de participar en el festival.",
      "explanationEs": "Take part in: la preposición es in, aunque en español digamos «participar de».",
      "segments": [
        "Everyone in the village is happy",
        "to take part in the festival."
      ],
      "audioText": "Everyone in the village is happy to take part in the festival.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    },
    {
      "id": "en.n5.class-68.t03",
      "en": "It is a custom to dress up as animals and walk through the streets.",
      "es": "Es una costumbre disfrazarse de animales y caminar por las calles.",
      "explanationEs": "Dress up es disfrazarse; as animals dice de qué.",
      "segments": [
        "It is a custom to dress up",
        "as animals and walk through the streets."
      ],
      "audioText": "It is a custom to dress up as animals and walk through the streets.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    },
    {
      "id": "en.n5.class-68.t04",
      "en": "Families pass down the recipes from grandmother to mother, and that is a tradition.",
      "es": "Las familias transmiten las recetas de abuela a madre, y eso es una tradición.",
      "explanationEs": "Pass down es transmitir de una generación a otra.",
      "segments": [
        "Families pass down the recipes from grandmother",
        "to mother, and that is a tradition."
      ],
      "audioText": "Families pass down the recipes from grandmother to mother, and that is a tradition.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    },
    {
      "id": "en.n5.class-68.t05",
      "en": "It is a custom, too: guests are supposed to bring a small gift.",
      "es": "También es una costumbre: se supone que los invitados llevan un pequeño regalo.",
      "explanationEs": "Be supposed to + verbo base expresa lo que se espera socialmente.",
      "segments": [
        "It is a custom, too: guests are",
        "supposed to bring a small gift."
      ],
      "audioText": "It is a custom, too: guests are supposed to bring a small gift.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    },
    {
      "id": "en.n5.class-68.t06",
      "en": "At the festival there is an unwritten rule: do not arrive late.",
      "es": "En el festival hay una norma no escrita: no llegar tarde.",
      "explanationEs": "Una unwritten rule nadie la escribe, pero todos la conocen.",
      "segments": [
        "At the festival there is an",
        "unwritten rule: do not arrive late."
      ],
      "audioText": "At the festival there is an unwritten rule: do not arrive late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-3"
    }
