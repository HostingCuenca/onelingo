  "teaching": [
    {
      "id": "en.n5.class-67.t01",
      "en": "We are all in the same boat: nobody has a ticket for the concert.",
      "es": "Todos estamos en la misma situación: nadie tiene entrada para el concierto.",
      "explanationEs": "Be in the same boat: el verbo be cambia (are, were), el resto no.",
      "segments": [
        "We are all in the same boat:",
        "nobody has a ticket for the concert."
      ],
      "audioText": "We are all in the same boat: nobody has a ticket for the concert.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-2"
    },
    {
      "id": "en.n5.class-67.t02",
      "en": "I cannot help you today; I have a lot on my plate with this project.",
      "es": "Hoy no puedo ayudarte; tengo mucho por hacer con este proyecto.",
      "explanationEs": "El posesivo cambia (my, her, our) pero la preposición siempre es on.",
      "segments": [
        "I cannot help you today; I have a",
        "lot on my plate with this project."
      ],
      "audioText": "I cannot help you today; I have a lot on my plate with this project.",
