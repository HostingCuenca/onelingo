    },
    {
      "id": "en.n5.class-67.t03",
      "en": "This ticket cost an arm and a leg, but I will buy it.",
      "es": "Esta entrada costó un ojo de la cara, pero la voy a comprar.",
      "explanationEs": "Cost es irregular: presente y pasado son iguales, así que el tiempo se ve por el contexto.",
      "segments": [
        "This ticket cost an arm and a",
        "leg, but I will buy it."
      ],
      "audioText": "This ticket cost an arm and a leg, but I will buy it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-sayings-and-traditions-2"
    },
    {
      "id": "en.n5.class-67.t04",
      "en": "I have explained the project; now the ball is in your court.",
      "es": "Ya he explicado el proyecto; ahora te toca a ti.",
      "explanationEs": "The ball is in your court: la expresión no cambia, solo el posesivo según de quién sea el turno (his court, her court).",
      "segments": [
        "I have explained the project; now",
        "the ball is in your court."
      ],
      "audioText": "I have explained the project; now the ball is in your court.",
