    {
      "id": "en.n5.class-07.t01",
      "en": "Sara is an exchange student, and she is used to her new school now.",
      "es": "Sara es estudiante de intercambio y ya está acostumbrada a su nuevo colegio.",
      "explanationEs": "Be used to: estado de «ya estoy acostumbrado»; be cambia de tiempo.",
      "segments": [
        "Sara is an exchange student, and she",
        "is used to her new school now."
      ],
      "audioText": "Sara is an exchange student, and she is used to her new school now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-getting-used-to-2"
    },
    {
      "id": "en.n5.class-07.t02",
      "en": "At first, she wasn't used to the British accent, but she got used to it in a month.",
      "es": "Al principio no estaba acostumbrada al acento británico, pero se acostumbró en un mes.",
      "explanationEs": "Wasn't used to = no era normal; got used to = el proceso terminó.",
      "segments": [
        "At first, she wasn't used to the British accent,",
        "but she got used to it in a month."
      ],
      "audioText": "At first, she wasn't used to the British accent, but she got used to it in a month.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-getting-used-to-2"
    },
    {
      "id": "en.n5.class-07.t03",
      "en": "She is getting used to spicy food, but she still misses her mother's cooking.",
      "es": "Se está acostumbrando a la comida picante, pero todavía echa de menos la cocina de su madre.",
      "explanationEs": "Is getting used to = el proceso sigue abierto hoy.",
      "segments": [
        "She is getting used to spicy food,",
        "but she still misses her mother's cooking."
      ],
      "audioText": "She is getting used to spicy food, but she still misses her mother's cooking.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-getting-used-to-2"
    },
    {
      "id": "en.n5.class-07.t04",
      "en": "She will get used to the long timetable soon.",
      "es": "Se acostumbrará pronto al horario tan largo.",
      "explanationEs": "Will get used to = un proceso futuro; used to no cambia.",
      "segments": [
        "She will get used to",
        "the long timetable soon."
      ],
      "audioText": "She will get used to the long timetable soon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n5-getting-used-to-2"
    },
    {
      "id": "en.n5.class-07.t05",
      "en": "She felt homesick at first, but she got used to living far from home.",
      "es": "Al principio sentía morriña, pero se acostumbró a vivir lejos de casa.",
      "explanationEs": "Get used to + -ing: detrás va un verbo con -ing, como con be used to.",
      "segments": [
        "She felt homesick at first, but she",
        "got used to living far from home."
      ],
