  "teaching": [
    {
      "id": "en.n10.class-22.t01",
      "en": "Much as I admire the plan, I think the fee is too high.",
      "es": "Por mucho que admire el plan, creo que la cuota es demasiado alta.",
      "explanationEs": "Much as + sujeto + verbo equivale a «por mucho que»; el verbo va en presente normal, sin subjuntivo.",
      "segments": [
        "Much as I admire the plan, I",
        "think the fee is too high."
      ],
      "audioText": "Much as I admire the plan, I think the fee is too high.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    },
    {
      "id": "en.n10.class-22.t02",
      "en": "However tempting the offer is, we cannot accept it this year.",
      "es": "Por muy tentadora que sea la oferta, no podemos aceptarla este año.",
      "explanationEs": "However + adjetivo + sujeto + verbo: el adjetivo va pegado a However y el sujeto antes del verbo.",
      "segments": [
        "However tempting the offer is, we",
        "cannot accept it this year."
      ],
      "audioText": "However tempting the offer is, we cannot accept it this year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    },
    {
      "id": "en.n10.class-22.t03",
      "en": "Strict though the rules seem, they protect every neighbour.",
      "es": "Aunque las normas parezcan estrictas, protegen a todos los vecinos.",
      "explanationEs": "Adjetivo + though/as + sujeto + verbo: el adjetivo pasa al principio.",
      "segments": [
        "Strict though the rules seem,",
        "they protect every neighbour."
      ],
      "audioText": "Strict though the rules seem, they protect every neighbour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    },
    {
      "id": "en.n10.class-22.t04",
      "en": "Clever as the idea is, it has one serious flaw.",
      "es": "Por ingeniosa que sea la idea, tiene un defecto grave.",
      "explanationEs": "Con as, el adjetivo también va delante, y la segunda parte no lleva but.",
      "segments": [
        "Clever as the idea is,",
        "it has one serious flaw."
      ],
      "audioText": "Clever as the idea is, it has one serious flaw.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    },
    {
      "id": "en.n10.class-22.t05",
      "en": "However much effort we put in, the timetable will not change.",
      "es": "Por mucho esfuerzo que pongamos, el horario no cambiará.",
      "explanationEs": "However much + nombre + sujeto + verbo: «por mucho… que».",
      "segments": [
        "However much effort we put in,",
        "the timetable will not change."
      ],
      "audioText": "However much effort we put in, the timetable will not change.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    },
    {
      "id": "en.n10.class-22.t06",
      "en": "Tempting as the trip was, Mia said no because of the fee.",
      "es": "Aunque el viaje era tentador, Mia dijo que no por la cuota.",
      "explanationEs": "La estructura también funciona en pasado: adjetivo + as + sujeto + was.",
      "segments": [
        "Tempting as the trip was, Mia",
        "said no because of the fee."
      ],
      "audioText": "Tempting as the trip was, Mia said no because of the fee.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-complex-debate-2"
    }
  ],
