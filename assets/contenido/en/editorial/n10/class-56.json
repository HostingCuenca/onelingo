    },
    {
      "id": "en.n10.class-56.t02",
      "en": "If I may, I would like to take the floor for a moment.",
      "es": "Si me permite, me gustaría tomar la palabra un momento.",
      "explanationEs": "Take the floor = tomar la palabra; If I may es una petición cortés de turno.",
