    },
    {
      "id": "en.n10.class-56.t04",
      "en": "As I was saying, the panel cannot ignore the cost.",
      "es": "Como iba diciendo, la mesa no puede ignorar el coste.",
      "explanationEs": "As I was saying retoma lo que decías y mantiene tu turno.",
