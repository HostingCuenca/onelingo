      "patternId": "n10-panel-discussion-1"
    },
    {
      "id": "en.n10.class-56.t03",
      "en": "Sorry to interrupt, but could I ask a quick question?",
      "es": "Perdona que interrumpa, pero ¿puedo hacer una pregunta rápida?",
      "explanationEs": "Sorry to interrupt es una interrupción cortés: se disculpa y pide permiso.",
