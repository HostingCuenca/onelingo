  "teaching": [
    {
      "id": "en.n10.class-07.t01",
      "en": "Down the hill ran the dog.",
      "es": "Colina abajo corrió el perro.",
      "explanationEs": "Anteposición: lugar + verbo + sujeto. El sujeto es un nombre (the dog).",
      "segments": [
        "Down the hill",
        "ran the dog."
      ],
      "audioText": "Down the hill ran the dog.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    },
    {
      "id": "en.n10.class-07.t02",
      "en": "On the table lay a single letter.",
      "es": "Sobre la mesa había una sola carta.",
      "explanationEs": "Con verbos como lay, stood o hung la inversión es natural: lugar + verbo + sujeto.",
      "segments": [
        "On the table lay",
        "a single letter."
      ],
      "audioText": "On the table lay a single letter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    },
    {
      "id": "en.n10.class-07.t03",
      "en": "Down the hill it ran, barking at the wind.",
      "es": "Colina abajo corrió, ladrando al viento.",
      "explanationEs": "Si el sujeto es un pronombre no hay inversión: lugar + pronombre + verbo.",
      "segments": [
        "Down the hill it ran,",
        "barking at the wind."
      ],
      "audioText": "Down the hill it ran, barking at the wind.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    },
    {
      "id": "en.n10.class-07.t04",
      "en": "Never had she seen such a silent street.",
      "es": "Nunca había visto una calle tan silenciosa.",
      "explanationEs": "Never al inicio pide inversión: never + auxiliar + sujeto (had she).",
      "segments": [
        "Never had she seen",
        "such a silent street."
      ],
      "audioText": "Never had she seen such a silent street.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    },
    {
      "id": "en.n10.class-07.t05",
      "en": "Silence. Then footsteps. Slowly, the door opened.",
      "es": "Silencio. Luego, pasos. Despacio, la puerta se abrió.",
      "explanationEs": "Los fragmentos sin verbo crean tensión; úsalos pocas veces y con intención.",
      "segments": [
        "Silence. Then footsteps. Slowly,",
        "the door opened."
      ],
      "audioText": "Silence. Then footsteps. Slowly, the door opened.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    },
    {
      "id": "en.n10.class-07.t06",
      "en": "She walked for hours through the empty streets, past closed shops and dark windows, until the cold reached her bones. Then she stopped.",
      "es": "Caminó durante horas por las calles vacías, junto a tiendas cerradas y ventanas oscuras, hasta que el frío le llegó a los huesos. Entonces se detuvo.",
      "explanationEs": "Una frase larga que fluye y una corta que golpea crean ritmo.",
      "segments": [
        "She walked for hours through the empty streets, past closed shops and",
        "dark windows, until the cold reached her bones. Then she stopped."
      ],
      "audioText": "She walked for hours through the empty streets, past closed shops and dark windows, until the cold reached her bones. Then she stopped.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-2"
    }
  ],
