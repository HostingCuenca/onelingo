  "teaching": [
    {
      "id": "en.n10.class-66.t01",
      "en": "That's a tricky question; let me think for a second.",
      "es": "Es una pregunta complicada; déjame pensar un segundo.",
      "explanationEs": "Registro neutro: valoras la pregunta y ganas unos segundos.",
      "segments": [
        "That's a tricky question; let",
        "me think for a second."
      ],
      "audioText": "That's a tricky question; let me think for a second.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    },
    {
      "id": "en.n10.class-66.t02",
      "en": "Offhand, I would say about twenty, but I can check.",
      "es": "Así, de improviso, diría que unos veinte, pero puedo comprobarlo.",
      "explanationEs": "Offhand avisa de que das un dato aproximado, sin haberlo comprobado.",
      "segments": [
        "Offhand, I would say about",
        "twenty, but I can check."
      ],
      "audioText": "Offhand, I would say about twenty, but I can check.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    },
    {
      "id": "en.n10.class-66.t03",
      "en": "Off the top of my head, I can't remember the exact date, honestly.",
      "es": "De memoria, no recuerdo la fecha exacta, sinceramente.",
      "explanationEs": "Off the top of my head introduce un dato de memoria; honestly suaviza una duda.",
      "segments": [
        "Off the top of my head, I",
        "can't remember the exact date, honestly."
      ],
      "audioText": "Off the top of my head, I can't remember the exact date, honestly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    },
    {
      "id": "en.n10.class-66.t04",
      "en": "Hang on, let me gather my thoughts.",
      "es": "Espera, déjame ordenar mis ideas.",
      "explanationEs": "Registro informal: hang on entre amigos o compañeros, antes de empezar a hablar.",
      "segments": [
        "Hang on, let me",
        "gather my thoughts."
      ],
      "audioText": "Hang on, let me gather my thoughts.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    },
    {
      "id": "en.n10.class-66.t05",
      "en": "That is an interesting point; allow me a moment to consider it.",
      "es": "Es un punto interesante; permítame un momento para considerarlo.",
      "explanationEs": "Registro formal: adecuado en entrevistas, reuniones o presentaciones.",
      "segments": [
        "That is an interesting point; allow",
        "me a moment to consider it."
      ],
      "audioText": "That is an interesting point; allow me a moment to consider it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    },
    {
      "id": "en.n10.class-66.t06",
      "en": "After a short pause, she said, “Well, it depends.”",
      "es": "Tras una breve pausa, dijo: «Bueno, depende».",
      "explanationEs": "Una pausa corta con Well… también gana tiempo y suena más natural que un largo silencio.",
      "segments": [
        "After a short pause, she",
        "said, “Well, it depends.”"
      ],
      "audioText": "After a short pause, she said, “Well, it depends.”",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-spontaneous-speaking-1"
    }
