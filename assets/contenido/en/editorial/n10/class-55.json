  "teaching": [
    {
      "id": "en.n10.class-55.t01",
      "en": "Growing vegetables is my passion, and today I will tell you why.",
      "es": "Cultivar verduras es mi pasión, y hoy te diré por qué.",
      "explanationEs": "Abrir con tu pasión es un gancho personal: muestra por qué hablas de este tema.",
      "segments": [
        "Growing vegetables is my passion, and",
        "today I will tell you why."
      ],
      "audioText": "Growing vegetables is my passion, and today I will tell you why.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-5"
    },
    {
      "id": "en.n10.class-55.t02",
      "en": "Even a beginner can harvest a salad in six weeks.",
      "es": "Hasta un principiante puede cosechar una ensalada en seis semanas.",
      "explanationEs": "Un dato concreto hace creíble la idea; beginner = principiante, harvest = cosechar.",
      "segments": [
        "Even a beginner can harvest",
        "a salad in six weeks."
      ],
      "audioText": "Even a beginner can harvest a salad in six weeks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-5"
    },
    {
      "id": "en.n10.class-55.t03",
      "en": "Rehearse out loud and check your timing: five minutes go fast.",
      "es": "Ensaya en voz alta y controla el tiempo: cinco minutos pasan rápido.",
      "explanationEs": "Rehearse es ensayar; timing, el control del tiempo durante la charla.",
      "segments": [
        "Rehearse out loud and check your",
        "timing: five minutes go fast."
      ],
      "audioText": "Rehearse out loud and check your timing: five minutes go fast.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-5"
    },
    {
      "id": "en.n10.class-55.t04",
      "en": "Seldom have I felt as proud as on the day of my first harvest.",
      "es": "Rara vez me he sentido tan orgulloso como el día de mi primera cosecha.",
      "explanationEs": "Una inversión (seldom have I) da énfasis a un momento clave de la charla.",
      "segments": [
        "Seldom have I felt as proud as",
        "on the day of my first harvest."
      ],
      "audioText": "Seldom have I felt as proud as on the day of my first harvest.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-5"
    },
    {
      "id": "en.n10.class-55.t05",
      "en": "My takeaway is simple: plant one seed and see what happens.",
      "es": "Mi idea final es sencilla: planta una semilla y mira qué pasa.",
      "explanationEs": "El takeaway es lo que quieres que el público recuerde al salir.",
      "segments": [
        "My takeaway is simple: plant one",
        "seed and see what happens."
      ],
      "audioText": "My takeaway is simple: plant one seed and see what happens.",
