  "teaching": [
    {
      "id": "en.n10.class-53.t01",
      "en": "Many good talks follow one structure: a problem, then a solution.",
      "es": "Muchas buenas charlas siguen una estructura: un problema y luego una solución.",
      "explanationEs": "Structure es la estructura; problem y solution son las dos piezas centrales.",
      "segments": [
        "Many good talks follow one structure:",
        "a problem, then a solution."
      ],
      "audioText": "Many good talks follow one structure: a problem, then a solution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-3"
    },
    {
      "id": "en.n10.class-53.t02",
      "en": "The speaker described a problem: we waste a lot of food in our city.",
      "es": "La oradora describió un problema: desperdiciamos mucha comida en nuestra ciudad.",
      "explanationEs": "El problema suele ir al principio y debe ser concreto; waste = desperdiciar.",
      "segments": [
        "The speaker described a problem: we waste",
        "a lot of food in our city."
      ],
      "audioText": "The speaker described a problem: we waste a lot of food in our city.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-3"
    },
    {
      "id": "en.n10.class-53.t03",
      "en": "Her solution was simple: share the extra food with your neighbours.",
      "es": "Su solución era sencilla: compartir la comida que sobra con los vecinos.",
      "explanationEs": "La solución llega tras el problema y suele ser breve y fácil de recordar.",
      "segments": [
        "Her solution was simple: share the",
        "extra food with your neighbours."
      ],
      "audioText": "Her solution was simple: share the extra food with your neighbours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-3"
    },
    {
      "id": "en.n10.class-53.t04",
      "en": "The rule of three makes a list memorable: fast, cheap and green.",
      "es": "La regla de tres hace memorable una lista: rápido, barato y ecológico.",
      "explanationEs": "Tres elementos de forma parecida suenan completos y se recuerdan mejor.",
      "segments": [
        "The rule of three makes a",
        "list memorable: fast, cheap and green."
      ],
      "audioText": "The rule of three makes a list memorable: fast, cheap and green.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-3"
    },
    {
      "id": "en.n10.class-53.t05",
      "en": "In the closing, she returned to her first story: a callback that brought the talk full circle.",
      "es": "En el cierre, volvió a su primera historia: un callback, una referencia al inicio que cerró el círculo de la charla.",
      "explanationEs": "Callback es retomar algo del inicio; full circle = «cerrar el círculo».",
      "segments": [
        "In the closing, she returned to her first story:",
        "a callback that brought the talk full circle."
      ],
      "audioText": "In the closing, she returned to her first story: a callback that brought the talk full circle.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-3"
    }
  ],
