  "teaching": [
    {
      "id": "en.n10.class-03.t01",
      "en": "\"Would you like to come to the wedding?\" \"I'd love to. Thanks for the invitation.\"",
      "es": "«¿Te gustaría venir a la boda?» «Me encantaría. Gracias por la invitación.»",
      "explanationEs": "I'd love to omite el verbo que ya se dijo (come): solo queda to.",
      "segments": [
        "\"Would you like to come to the wedding?\"",
        "\"I'd love to. Thanks for the invitation.\""
      ],
      "audioText": "\"Would you like to come to the wedding?\" \"I'd love to. Thanks for the invitation.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    },
    {
      "id": "en.n10.class-03.t02",
      "en": "\"I'm exhausted.\" \"So am I.\"",
      "es": "«Estoy agotado.» «Yo también.»",
      "explanationEs": "So + auxiliar + sujeto = yo también. El auxiliar es el de la frase original: am.",
      "segments": [
        "\"I'm exhausted.\" \"So",
        "am I.\""
      ],
      "audioText": "\"I'm exhausted.\" \"So am I.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    },
    {
      "id": "en.n10.class-03.t03",
      "en": "\"I didn't sleep well.\" \"Neither did I.\"",
      "es": "«No dormí bien.» «Yo tampoco.»",
      "explanationEs": "Neither + auxiliar + sujeto = yo tampoco; el verbo se omite y el auxiliar copia didn't.",
      "segments": [
        "\"I didn't sleep well.\"",
        "\"Neither did I.\""
      ],
      "audioText": "\"I didn't sleep well.\" \"Neither did I.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    },
    {
      "id": "en.n10.class-03.t04",
      "en": "\"Will the tickets be cheap?\" \"I hope so.\"",
      "es": "«¿Serán baratas las entradas?» «Espero que sí.»",
      "explanationEs": "So sustituye a toda la oración (the tickets will be cheap). En negativo: I hope not.",
      "segments": [
        "\"Will the tickets be",
        "cheap?\" \"I hope so.\""
      ],
      "audioText": "\"Will the tickets be cheap?\" \"I hope so.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    },
    {
      "id": "en.n10.class-03.t05",
      "en": "\"Is the restaurant still open?\" \"I'm afraid not.\"",
      "es": "«¿Sigue abierto el restaurante?» «Me temo que no.»",
      "explanationEs": "I'm afraid not da una mala noticia con educación y sustituye a «it isn't open».",
      "segments": [
        "\"Is the restaurant still",
        "open?\" \"I'm afraid not.\""
      ],
      "audioText": "\"Is the restaurant still open?\" \"I'm afraid not.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    },
    {
      "id": "en.n10.class-03.t06",
      "en": "\"Shall we walk home?\" \"I'd rather not. It's late.\"",
      "es": "«¿Volvemos andando?» «Prefiero que no. Es tarde.»",
      "explanationEs": "I'd rather not omite el verbo de la propuesta (walk home).",
      "segments": [
        "\"Shall we walk home?\" \"I'd",
        "rather not. It's late.\""
      ],
      "audioText": "\"Shall we walk home?\" \"I'd rather not. It's late.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-3"
    }
  ],
