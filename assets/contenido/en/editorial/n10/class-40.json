  "teaching": [
    {
      "id": "en.n10.class-40.t01",
      "en": "Thank you for coming. I will begin my pitch with the timeline.",
      "es": "Gracias por venir. Empezaré mi presentación con el calendario.",
      "explanationEs": "Una buena apertura saluda y dice qué vas a mostrar; pitch es la presentación breve de un proyecto.",
      "segments": [
        "Thank you for coming. I will",
        "begin my pitch with the timeline."
      ],
      "audioText": "Thank you for coming. I will begin my pitch with the timeline.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    },
    {
      "id": "en.n10.class-40.t02",
      "en": "Our forecast is fifty repairs a month by the end of the year.",
      "es": "Nuestra previsión es de cincuenta reparaciones al mes a finales de año.",
      "explanationEs": "Forecast es una previsión con cifras; se apoya en un plazo con by.",
      "segments": [
        "Our forecast is fifty repairs a month",
        "by the end of the year."
      ],
      "audioText": "Our forecast is fifty repairs a month by the end of the year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    },
    {
      "id": "en.n10.class-40.t03",
      "en": "An investor may raise the objection that cycling drops in winter.",
      "es": "Un inversor puede plantear la objeción de que el ciclismo baja en invierno.",
      "explanationEs": "Objection es un reparo que alguien pone a tu plan; raise an objection = plantearlo.",
      "segments": [
        "An investor may raise the objection",
        "that cycling drops in winter."
      ],
      "audioText": "An investor may raise the objection that cycling drops in winter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    },
    {
      "id": "en.n10.class-40.t04",
      "en": "I understand that concern, but let me reassure you: we have a contingency plan.",
      "es": "Entiendo esa preocupación, pero permítame tranquilizarle: tenemos un plan de contingencia.",
      "explanationEs": "Reconoce la preocupación antes de responder; reassure es transitivo, sin preposición.",
      "segments": [
        "I understand that concern, but let me",
        "reassure you: we have a contingency plan."
      ],
      "audioText": "I understand that concern, but let me reassure you: we have a contingency plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    },
    {
      "id": "en.n10.class-40.t05",
      "en": "Should demand fall, we will use our reserve, so we think the plan is realistic.",
      "es": "Si la demanda bajara, usaremos nuestra reserva, así que creemos que el plan es realista.",
      "explanationEs": "Realistic muestra que lo prometido se puede cumplir; la contingencia lo respalda.",
      "segments": [
        "Should demand fall, we will use our reserve,",
        "so we think the plan is realistic."
      ],
      "audioText": "Should demand fall, we will use our reserve, so we think the plan is realistic.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    },
    {
      "id": "en.n10.class-40.t06",
      "en": "I would like to address your objection briefly.",
      "es": "Me gustaría responder brevemente a su objeción.",
      "explanationEs": "Address significa abordar un reparo de manera directa; I would like to es cortés y formal.",
      "segments": [
        "I would like to",
        "address your objection briefly."
      ],
      "audioText": "I would like to address your objection briefly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-5"
    }
