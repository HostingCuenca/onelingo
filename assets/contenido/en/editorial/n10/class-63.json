  "teaching": [
    {
      "id": "en.n10.class-63.t01",
      "en": "We somehow managed to finish everything, and it went really well.",
      "es": "De algún modo logramos terminarlo todo y salió muy bien.",
      "explanationEs": "Respuesta vaga: somehow y «went really well» no dicen qué pasó ni con qué resultado.",
      "segments": [
        "We somehow managed to finish everything,",
        "and it went really well."
      ],
      "audioText": "We somehow managed to finish everything, and it went really well.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-3"
    },
    {
      "id": "en.n10.class-63.t02",
      "en": "I cut the waiting time from ten days to three by creating a checklist.",
      "es": "Reduje el tiempo de espera de diez días a tres creando una lista de verificación.",
      "explanationEs": "Respuesta concreta: una acción clara (a checklist) y dos cifras (from… to…).",
      "segments": [
        "I cut the waiting time from ten",
        "days to three by creating a checklist."
      ],
      "audioText": "I cut the waiting time from ten days to three by creating a checklist.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-3"
    },
    {
      "id": "en.n10.class-63.t03",
      "en": "As a result, complaints fell by forty per cent in two months.",
      "es": "Como resultado, las quejas bajaron un cuarenta por ciento en dos meses.",
      "explanationEs": "El resultado medible cierra la respuesta; con cifras se usa by (fell by).",
      "segments": [
        "As a result, complaints fell by",
        "forty per cent in two months."
      ],
      "audioText": "As a result, complaints fell by forty per cent in two months.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-3"
    },
    {
      "id": "en.n10.class-63.t04",
      "en": "Could you be more specific? I would like a concrete example.",
      "es": "¿Podrías ser más concreto? Me gustaría un ejemplo real.",
      "explanationEs": "El entrevistador detecta una respuesta vaga y pide un ejemplo.",
      "segments": [
        "Could you be more specific? I",
        "would like a concrete example."
      ],
      "audioText": "Could you be more specific? I would like a concrete example.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-3"
    },
    {
      "id": "en.n10.class-63.t05",
      "en": "The impact was measurable: sign-ups rose by a fifth.",
      "es": "El impacto fue medible: las inscripciones subieron una quinta parte.",
      "explanationEs": "Impacto medible es un resultado que se puede contar con figures o porcentajes.",
      "segments": [
        "The impact was measurable: sign-ups",
        "rose by a fifth."
      ],
      "audioText": "The impact was measurable: sign-ups rose by a fifth.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-3"
    }
  ],
