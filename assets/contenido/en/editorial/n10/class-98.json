  "title": {
    "en": "Judge a model performance",
    "es": "Valorar una actuación modelo"
  },
  "objectives": {
    "es": [
      "Valorar una actuación oral modelo con una rúbrica de cuatro criterios: estructura, precisión, tacto y evidencia."
