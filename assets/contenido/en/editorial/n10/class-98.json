  "teaching": [
    {
      "id": "en.n10.class-98.t01",
      "en": "A rubric lists the criteria we use to assess a performance.",
      "es": "Una rúbrica enumera los criterios que usamos para valorar una actuación.",
      "explanationEs": "Valorar con criterios evita las impresiones vagas del tipo «me gustó».",
      "segments": [
        "A rubric lists the criteria we",
        "use to assess a performance."
      ],
      "audioText": "A rubric lists the criteria we use to assess a performance.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    },
    {
      "id": "en.n10.class-98.t02",
      "en": "The first criterion is structure: a clear opening, two reasons and a closing.",
      "es": "El primer criterio es la estructura: una apertura clara, dos razones y un cierre.",
      "explanationEs": "Se comprueba con las señales de orden: first, second, finally, to sum up.",
      "segments": [
        "The first criterion is structure: a clear",
        "opening, two reasons and a closing."
      ],
      "audioText": "The first criterion is structure: a clear opening, two reasons and a closing.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    },
    {
      "id": "en.n10.class-98.t03",
      "en": "The second criterion is accuracy: the verbs, connectors and word order must be correct.",
      "es": "El segundo criterio es la precisión: los verbos, los conectores y el orden de las palabras deben ser correctos.",
      "explanationEs": "Es la capa que repasaste en la clase de edición de precisión.",
      "segments": [
        "The second criterion is accuracy: the verbs,",
        "connectors and word order must be correct."
      ],
      "audioText": "The second criterion is accuracy: the verbs, connectors and word order must be correct.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    },
    {
      "id": "en.n10.class-98.t04",
      "en": "The third is tact: a good speaker concedes a point and softens a request.",
      "es": "El tercero es el tacto: quien habla bien concede un punto y suaviza una petición.",
      "explanationEs": "Much as…, I was wondering whether… y should it fail son señales de tacto.",
      "segments": [
        "The third is tact: a good speaker",
        "concedes a point and softens a request."
      ],
      "audioText": "The third is tact: a good speaker concedes a point and softens a request.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    },
    {
      "id": "en.n10.class-98.t05",
      "en": "The fourth criterion is evidence: a strong speaker supports each reason with data.",
      "es": "El cuarto criterio es la evidencia: quien habla con fuerza apoya cada razón con datos.",
      "explanationEs": "Una encuesta, una cifra o un ejemplo concreto valen más que «mucha gente lo piensa».",
      "segments": [
        "The fourth criterion is evidence: a strong",
        "speaker supports each reason with data."
      ],
      "audioText": "The fourth criterion is evidence: a strong speaker supports each reason with data.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    },
    {
      "id": "en.n10.class-98.t06",
      "en": "A strength is something the speaker does well; a weakness is something to improve.",
      "es": "Una fortaleza es algo que la persona hace bien; una debilidad es algo que debe mejorar.",
      "explanationEs": "Una buena valoración nombra ambas y cita la frase que lo demuestra.",
      "segments": [
        "A strength is something the speaker does",
        "well; a weakness is something to improve."
      ],
      "audioText": "A strength is something the speaker does well; a weakness is something to improve.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-c1-mastery-capstone-3"
    }
  ],
