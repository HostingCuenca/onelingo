  "teaching": [
    {
      "id": "en.n10.class-62.t01",
      "en": "Could you tell me what led you to choose this approach?",
      "es": "¿Podrías decirme qué te llevó a elegir este enfoque?",
      "explanationEs": "Could you tell me + what + verbo afirmativo: what es el sujeto y no hace falta did.",
      "segments": [
        "Could you tell me what led",
        "you to choose this approach?"
      ],
      "audioText": "Could you tell me what led you to choose this approach?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    },
    {
      "id": "en.n10.class-62.t02",
      "en": "I would like to know why you chose this approach.",
      "es": "Me gustaría saber por qué elegiste este enfoque.",
      "explanationEs": "Pregunta indirecta: why + sujeto + verbo afirmativo (you chose), sin did.",
      "segments": [
        "I would like to know",
        "why you chose this approach."
      ],
      "audioText": "I would like to know why you chose this approach.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    },
    {
      "id": "en.n10.class-62.t03",
      "en": "To what extent did the outcome match your plan?",
      "es": "¿Hasta qué punto coincidió el resultado con tu plan?",
      "explanationEs": "To what extent abre una pregunta directa: sí lleva inversión (did the outcome match).",
      "segments": [
        "To what extent did the",
        "outcome match your plan?"
      ],
      "audioText": "To what extent did the outcome match your plan?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    },
    {
      "id": "en.n10.class-62.t04",
      "en": "I am curious whether you measured the outcome.",
      "es": "Tengo curiosidad por saber si mediste el resultado.",
      "explanationEs": "I am curious whether…: el sí/no se convierte en whether + orden afirmativo.",
      "segments": [
        "I am curious whether",
        "you measured the outcome."
      ],
      "audioText": "I am curious whether you measured the outcome.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    },
    {
      "id": "en.n10.class-62.t05",
      "en": "What precisely do you mean by a successful project?",
      "es": "¿Qué quieres decir exactamente con un proyecto exitoso?",
      "explanationEs": "What precisely…? pide que concretes una expresión vaga.",
      "segments": [
        "What precisely do you mean",
        "by a successful project?"
      ],
      "audioText": "What precisely do you mean by a successful project?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    },
    {
      "id": "en.n10.class-62.t06",
      "en": "Could you explain how that insight changed your approach?",
      "es": "¿Podrías explicar cómo esa idea cambió tu enfoque?",
      "explanationEs": "Could you explain how + sujeto + verbo: pregunta indirecta con how.",
      "segments": [
        "Could you explain how that",
        "insight changed your approach?"
      ],
      "audioText": "Could you explain how that insight changed your approach?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-interviews-2"
    }
