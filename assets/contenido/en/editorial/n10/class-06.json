    {
      "id": "en.n10.class-06.t01",
      "en": "Her hands began to tremble as she opened the letter.",
      "es": "Las manos le empezaron a temblar al abrir la carta.",
      "explanationEs": "Muestra el nervio con una reacción del cuerpo, sin decir «she was nervous».",
      "segments": [
        "Her hands began to tremble",
        "as she opened the letter."
      ],
      "audioText": "Her hands began to tremble as she opened the letter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-1"
    },
    {
      "id": "en.n10.class-06.t02",
      "en": "He slammed the door so hard that the glasses on the shelf rattled.",
      "es": "Dio un portazo tan fuerte que los vasos de la estantería tintinearon.",
      "explanationEs": "La acción y el sonido muestran la rabia sin nombrarla.",
      "segments": [
        "He slammed the door so hard that",
        "the glasses on the shelf rattled."
      ],
      "audioText": "He slammed the door so hard that the glasses on the shelf rattled.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-1"
    },
    {
      "id": "en.n10.class-06.t03",
      "en": "The smell of burnt milk filled the kitchen, and nobody said a word.",
      "es": "El olor a leche quemada llenó la cocina y nadie dijo una palabra.",
      "explanationEs": "Un detalle del olfato y el silencio muestran la tensión.",
      "segments": [
        "The smell of burnt milk filled the",
        "kitchen, and nobody said a word."
      ],
      "audioText": "The smell of burnt milk filled the kitchen, and nobody said a word.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-1"
    },
    {
      "id": "en.n10.class-06.t04",
      "en": "When we were kids, we would sit on the wall every evening and count the cars.",
      "es": "De pequeños, nos sentábamos en el muro cada tarde y contábamos los coches.",
      "explanationEs": "Would + verbo describe una acción que se repetía en el pasado.",
      "segments": [
        "When we were kids, we would sit on",
        "the wall every evening and count the cars."
      ],
      "audioText": "When we were kids, we would sit on the wall every evening and count the cars.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-1"
    },
    {
      "id": "en.n10.class-06.t05",
      "en": "The old house used to smell of pine and wet wool.",
      "es": "La casa vieja solía oler a pino y a lana mojada.",
      "explanationEs": "Used to sirve para estados y hábitos del pasado; para estados no se usa would.",
      "segments": [
        "The old house used to smell",
        "of pine and wet wool."
      ],
      "audioText": "The old house used to smell of pine and wet wool.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-storytelling-1"
    },
    {
      "id": "en.n10.class-06.t06",
      "en": "She bit her nails and checked the clock every minute.",
      "es": "Se mordía las uñas y miraba el reloj cada minuto.",
      "explanationEs": "Dos acciones concretas muestran la ansiedad; contar sería «she was anxious».",
      "segments": [
