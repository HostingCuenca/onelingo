  "teaching": [
    {
      "id": "en.n10.class-01.t01",
      "en": "\"I've joined a choir.\" \"Have you? Since when?\"",
      "es": "«Me he apuntado a un coro.» «¿Ah, sí? ¿Desde cuándo?»",
      "explanationEs": "Have you? repite el auxiliar de I've: es un eco que muestra interés, no pide un dato.",
      "segments": [
        "\"I've joined a choir.\"",
        "\"Have you? Since when?\""
      ],
      "audioText": "\"I've joined a choir.\" \"Have you? Since when?\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    },
    {
      "id": "en.n10.class-01.t02",
      "en": "\"She got the promotion.\" \"Did she? Good for her!\"",
      "es": "«Consiguió el ascenso.» «¿Sí? ¡Me alegro por ella!»",
      "explanationEs": "Got es pasado simple, así que el eco usa did. Después del eco se añade un comentario.",
      "segments": [
        "\"She got the promotion.\" \"Did",
        "she? Good for her!\""
      ],
      "audioText": "\"She got the promotion.\" \"Did she? Good for her!\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    },
    {
      "id": "en.n10.class-01.t03",
      "en": "\"You've met my colleague, haven't you?\" \"I have, yes. She seems nice.\"",
      "es": "«Ya conoces a mi colega, ¿verdad?» «Sí, la conozco. Parece simpática.»",
      "explanationEs": "La tag haven't you? pide confirmar algo que el hablante ya cree; el eco Have you? reacciona a una noticia.",
      "segments": [
        "\"You've met my colleague, haven't you?\"",
        "\"I have, yes. She seems nice.\""
      ],
      "audioText": "\"You've met my colleague, haven't you?\" \"I have, yes. She seems nice.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    },
    {
      "id": "en.n10.class-01.t04",
      "en": "\"Honestly, I found the film too long.\" \"Fair enough. I got a bit bored too.\"",
      "es": "«Sinceramente, la película se me hizo larga.» «Vale, te entiendo. A mí también me aburrió un poco.»",
      "explanationEs": "Fair enough acepta la opinión del otro sin discutirla.",
      "segments": [
        "\"Honestly, I found the film too long.\" \"Fair",
        "enough. I got a bit bored too.\""
      ],
      "audioText": "\"Honestly, I found the film too long.\" \"Fair enough. I got a bit bored too.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    },
    {
      "id": "en.n10.class-01.t05",
      "en": "\"I'm running a marathon in May.\" \"No way! Since when do you run?\"",
      "es": "«Voy a correr un maratón en mayo.» «¡No puede ser! ¿Desde cuándo corres?»",
      "explanationEs": "No way! expresa incredulidad o admiración; el contexto decide cuál.",
      "segments": [
        "\"I'm running a marathon in May.\" \"No",
        "way! Since when do you run?\""
      ],
      "audioText": "\"I'm running a marathon in May.\" \"No way! Since when do you run?\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    },
    {
      "id": "en.n10.class-01.t06",
      "en": "\"Guess what? I've got a job offer in Lisbon.\" \"Have you? That's brilliant!\"",
      "es": "«¿A que no sabes qué? Me han hecho una oferta de trabajo en Lisboa.» «¿Ah, sí? ¡Qué bien!»",
      "explanationEs": "Guess what? abre un tema con una noticia; el eco Have you? reacciona a ella.",
      "segments": [
        "\"Guess what? I've got a job offer",
        "in Lisbon.\" \"Have you? That's brilliant!\""
      ],
      "audioText": "\"Guess what? I've got a job offer in Lisbon.\" \"Have you? That's brilliant!\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-1"
    }
  ],
