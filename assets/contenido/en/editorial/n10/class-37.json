  "teaching": [
    {
      "id": "en.n10.class-37.t01",
      "en": "The scope of the first phase is limited to one neighbourhood.",
      "es": "El alcance de la primera fase se limita a un barrio.",
      "explanationEs": "Scope es hasta dónde llega un proyecto; suele ir con limited to.",
      "segments": [
        "The scope of the first phase",
        "is limited to one neighbourhood."
      ],
      "audioText": "The scope of the first phase is limited to one neighbourhood.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    },
    {
      "id": "en.n10.class-37.t02",
      "en": "Sara holds a twenty per cent stake in the workshop.",
      "es": "Sara tiene una participación del veinte por ciento en el taller.",
      "explanationEs": "Stake es la parte de un negocio que posee alguien (no confundir con steak, «filete»).",
      "segments": [
        "Sara holds a twenty per",
        "cent stake in the workshop."
      ],
      "audioText": "Sara holds a twenty per cent stake in the workshop.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    },
    {
      "id": "en.n10.class-37.t03",
      "en": "We can leverage Leo's contacts to reach new customers.",
      "es": "Podemos aprovechar los contactos de Leo para llegar a nuevos clientes.",
      "explanationEs": "Como verbo, leverage es transitivo: sacar partido de algo que ya tienes, sin preposición.",
      "segments": [
        "We can leverage Leo's contacts",
        "to reach new customers."
      ],
      "audioText": "We can leverage Leo's contacts to reach new customers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    },
    {
      "id": "en.n10.class-37.t04",
      "en": "The margin on each repair is about forty per cent, and overheads are low.",
      "es": "El margen de cada reparación es de un cuarenta por ciento y los gastos fijos son bajos.",
      "explanationEs": "Margin es la diferencia entre precio y coste; overheads son los gastos fijos (alquiler, electricidad), que siempre van en plural.",
      "segments": [
        "The margin on each repair is about",
        "forty per cent, and overheads are low."
      ],
      "audioText": "The margin on each repair is about forty per cent, and overheads are low.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    },
    {
      "id": "en.n10.class-37.t05",
      "en": "We will scale up once the workshop is profitable.",
      "es": "Ampliaremos el negocio cuando el taller sea rentable.",
      "explanationEs": "Scale up es ampliar el negocio o su capacidad; lo ideal es crecer sin que los costes suban en la misma proporción.",
      "segments": [
        "We will scale up once",
        "the workshop is profitable."
      ],
      "audioText": "We will scale up once the workshop is profitable.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    },
    {
      "id": "en.n10.class-37.t06",
      "en": "There is a niche for fast repairs near the station, so the idea is viable.",
      "es": "Hay un nicho para reparaciones rápidas cerca de la estación, así que la idea es viable.",
      "explanationEs": "Niche es un hueco pequeño y concreto del mercado; viable significa que funciona en la práctica.",
      "segments": [
        "There is a niche for fast repairs near",
        "the station, so the idea is viable."
      ],
      "audioText": "There is a niche for fast repairs near the station, so the idea is viable.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-2"
    }
  ],
