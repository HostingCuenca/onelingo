  "teaching": [
    {
      "id": "en.n10.class-88.t01",
      "en": "Well, it is a bit pricey, so I will think about it.",
      "es": "Bueno, es un poco caro, así que lo pensaré.",
      "explanationEs": "Dice «es caro», pero lo que quiere decir es «probablemente no lo compraré».",
      "segments": [
        "Well, it is a bit pricey,",
        "so I will think about it."
      ],
      "audioText": "Well, it is a bit pricey, so I will think about it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-3"
    },
    {
      "id": "en.n10.class-88.t02",
      "en": "I suppose it could work.",
      "es": "Supongo que podría funcionar.",
      "explanationEs": "I suppose suena a aceptar sin ganas: el hablante no está convencido.",
      "segments": [
        "I suppose it",
        "could work."
      ],
      "audioText": "I suppose it could work.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-3"
    },
    {
      "id": "en.n10.class-88.t03",
      "en": "I can hardly say it was my favourite.",
      "es": "No puedo decir que fuera mi favorito.",
      "explanationEs": "Hardly suaviza una crítica: en realidad significa «no me gustó».",
      "segments": [
        "I can hardly say",
        "it was my favourite."
      ],
      "audioText": "I can hardly say it was my favourite.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-3"
    },
    {
      "id": "en.n10.class-88.t04",
      "en": "To be honest, I have not had time to read it.",
      "es": "Sinceramente, no he tenido tiempo de leerlo.",
      "explanationEs": "To be honest introduce algo incómodo: probablemente no lo ha leído.",
      "segments": [
        "To be honest, I have not",
        "had time to read it."
      ],
      "audioText": "To be honest, I have not had time to read it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-3"
    },
    {
      "id": "en.n10.class-88.t05",
      "en": "That is not exactly what I asked for, but we will see.",
      "es": "Eso no es exactamente lo que pedí, pero ya veremos.",
      "explanationEs": "Not exactly equivale a «no»; we will see muestra dudas, no una promesa.",
      "segments": [
