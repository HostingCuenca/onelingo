  "teaching": [
    {
      "id": "en.n10.class-17.t01",
      "en": "People in my town tend to be punctual, but of course there are exceptions.",
      "es": "La gente de mi ciudad suele ser puntual, pero, claro, hay excepciones.",
      "explanationEs": "Tend to + verbo base expresa una tendencia, no una regla sin excepciones.",
      "segments": [
        "People in my town tend to be",
        "punctual, but of course there are exceptions."
      ],
      "audioText": "People in my town tend to be punctual, but of course there are exceptions.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-2"
    },
    {
      "id": "en.n10.class-17.t02",
      "en": "By and large, my neighbours are reserved at first, but they become very friendly.",
      "es": "En general, mis vecinos son reservados al principio, pero luego se vuelven muy amables.",
      "explanationEs": "By and large abre la frase y matiza: «en general».",
      "segments": [
        "By and large, my neighbours are reserved",
        "at first, but they become very friendly."
      ],
      "audioText": "By and large, my neighbours are reserved at first, but they become very friendly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-2"
    },
    {
      "id": "en.n10.class-17.t03",
      "en": "It is not unusual for a typical family here to eat lunch at two.",
      "es": "No es raro que una familia típica de aquí coma a las dos.",
      "explanationEs": "It is not unusual for + sujeto + to + verbo: «no es raro que».",
      "segments": [
        "It is not unusual for a typical",
        "family here to eat lunch at two."
      ],
      "audioText": "It is not unusual for a typical family here to eat lunch at two.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-2"
    },
    {
      "id": "en.n10.class-17.t04",
      "en": "As a rule, shops close early on Sundays, but it is only a generalisation.",
      "es": "Por norma general, las tiendas cierran pronto los domingos, pero es solo una generalización.",
      "explanationEs": "As a rule significa «por norma general» y admite excepciones.",
      "segments": [
        "As a rule, shops close early on",
        "Sundays, but it is only a generalisation."
      ],
      "audioText": "As a rule, shops close early on Sundays, but it is only a generalisation.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-2"
    },
    {
      "id": "en.n10.class-17.t05",
      "en": "To say that all people here are rude is an absolute claim, and it is unfair.",
      "es": "Decir que toda la gente de aquí es maleducada es una afirmación absoluta, y es injusto.",
      "explanationEs": "Todos, siempre y nunca son absolutos: casi nunca son justos.",
      "segments": [
        "To say that all people here are rude",
        "is an absolute claim, and it is unfair."
      ],
      "audioText": "To say that all people here are rude is an absolute claim, and it is unfair.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-2"
    }
  ],
