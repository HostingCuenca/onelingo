  "teaching": [
    {
      "id": "en.n10.class-42.t01",
      "en": "The recurring motif of water in the novel suggests change.",
      "es": "El motivo recurrente del agua en la novela sugiere cambio.",
      "explanationEs": "Un motif es una imagen o idea que se repite a lo largo de la obra.",
      "segments": [
        "The recurring motif of water",
        "in the novel suggests change."
      ],
      "audioText": "The recurring motif of water in the novel suggests change.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    },
    {
      "id": "en.n10.class-42.t02",
      "en": "The broken clock is a symbol of time that has been lost.",
      "es": "El reloj roto es un símbolo del tiempo que se ha perdido.",
      "explanationEs": "Un symbol es una cosa concreta que representa una idea.",
      "segments": [
        "The broken clock is a symbol",
        "of time that has been lost."
      ],
      "audioText": "The broken clock is a symbol of time that has been lost.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    },
    {
      "id": "en.n10.class-42.t03",
      "en": "The storm in chapter two is foreshadowing: it warns us that something bad will happen.",
      "es": "La tormenta del capítulo dos es un presagio: nos avisa de que ocurrirá algo malo.",
      "explanationEs": "Foreshadowing anticipa lo que vendrá sin decirlo abiertamente.",
      "segments": [
        "The storm in chapter two is foreshadowing: it",
        "warns us that something bad will happen."
      ],
      "audioText": "The storm in chapter two is foreshadowing: it warns us that something bad will happen.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    },
    {
      "id": "en.n10.class-42.t04",
      "en": "The main theme is the cost of ambition.",
      "es": "El tema principal es el precio de la ambición.",
      "explanationEs": "El theme es la idea general que sostiene toda la obra.",
      "segments": [
        "The main theme is",
        "the cost of ambition."
      ],
      "audioText": "The main theme is the cost of ambition.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    },
    {
      "id": "en.n10.class-42.t05",
      "en": "The writer's cold, grey imagery makes the town feel lonely.",
      "es": "Las imágenes frías y grises del autor hacen que el pueblo parezca solitario.",
      "explanationEs": "Imagery son las imágenes sensoriales que crean una atmósfera.",
      "segments": [
        "The writer's cold, grey imagery",
        "makes the town feel lonely."
      ],
      "audioText": "The writer's cold, grey imagery makes the town feel lonely.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    },
    {
      "id": "en.n10.class-42.t06",
      "en": "The final chapter will resonate with anyone who has left home.",
      "es": "El último capítulo calará en cualquiera que haya dejado su casa.",
      "explanationEs": "Resonate with + persona: la obra le llega y le dice algo.",
      "segments": [
        "The final chapter will resonate with",
        "anyone who has left home."
      ],
      "audioText": "The final chapter will resonate with anyone who has left home.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-2"
    }
  ],
