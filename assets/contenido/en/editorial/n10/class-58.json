  "teaching": [
    {
      "id": "en.n10.class-58.t01",
      "en": "Tom stressed that free buses would help poor families most.",
      "es": "Tom subrayó que los autobuses gratuitos ayudarían sobre todo a las familias pobres.",
      "explanationEs": "Stress that… = recalcar: destaca una idea como la más importante.",
      "segments": [
        "Tom stressed that free buses",
        "would help poor families most."
      ],
      "audioText": "Tom stressed that free buses would help poor families most.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-panel-discussion-3"
    },
    {
      "id": "en.n10.class-58.t02",
      "en": "Sara doubted that the city could afford them.",
      "es": "Sara dudó de que la ciudad pudiera permitírselos.",
      "explanationEs": "Doubt that… = dudar de que; muestra escepticismo y el verbo retrocede (can → could).",
      "segments": [
        "Sara doubted that the",
        "city could afford them."
      ],
      "audioText": "Sara doubted that the city could afford them.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-panel-discussion-3"
    },
    {
      "id": "en.n10.class-58.t03",
      "en": "Leo conceded that the plan had some risks.",
      "es": "Leo reconoció que el plan tenía algunos riesgos.",
      "explanationEs": "Concede that… = conceder: aceptas algo a regañadientes.",
      "segments": [
        "Leo conceded that the",
        "plan had some risks."
      ],
      "audioText": "Leo conceded that the plan had some risks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-panel-discussion-3"
    },
    {
      "id": "en.n10.class-58.t04",
      "en": "Mia insisted that we must start this year.",
      "es": "Mia insistió en que debemos empezar este año.",
      "explanationEs": "Insist that + oración mantiene la postura con firmeza; con un verbo en -ing se dice insist on.",
      "segments": [
        "Mia insisted that we",
        "must start this year."
      ],
      "audioText": "Mia insisted that we must start this year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-panel-discussion-3"
    },
    {
      "id": "en.n10.class-58.t05",
      "en": "Carlos warned that costs could rise quickly.",
      "es": "Carlos advirtió que los costes podían subir rápidamente.",
      "explanationEs": "Warn that… avisa de un riesgo; can pasa a could al resumir.",
      "segments": [
        "Carlos warned that costs",
        "could rise quickly."
      ],
      "audioText": "Carlos warned that costs could rise quickly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-panel-discussion-3"
    },
    {
      "id": "en.n10.class-58.t06",
      "en": "Ana suggested that we test the idea in one district.",
      "es": "Ana sugirió que probáramos la idea en un distrito.",
