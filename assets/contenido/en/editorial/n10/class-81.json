  "teaching": [
    {
      "id": "en.n10.class-81.t01",
      "en": "The survey was conducted in March among four hundred adults in three cities.",
      "es": "La encuesta se realizó en marzo entre cuatrocientos adultos de tres ciudades.",
      "explanationEs": "El pasivo en pasado (was conducted) cuenta qué se hizo sin decir quién lo hizo.",
      "segments": [
        "The survey was conducted in March among",
        "four hundred adults in three cities."
      ],
      "audioText": "The survey was conducted in March among four hundred adults in three cities.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-1"
    },
    {
      "id": "en.n10.class-81.t02",
      "en": "The participants were selected at random from a list of local residents.",
      "es": "Los participantes se seleccionaron al azar de una lista de vecinos de la zona.",
      "explanationEs": "Sujeto plural + were + participio: así se explica cómo se formó la muestra.",
      "segments": [
        "The participants were selected at random",
        "from a list of local residents."
      ],
      "audioText": "The participants were selected at random from a list of local residents.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-1"
    },
    {
      "id": "en.n10.class-81.t03",
      "en": "Participants were asked to complete a short questionnaire online.",
      "es": "Se pidió a los participantes que completaran un breve cuestionario en línea.",
      "explanationEs": "Were asked to + verbo describe las instrucciones que recibió la muestra.",
      "segments": [
        "Participants were asked to complete",
        "a short questionnaire online."
      ],
      "audioText": "Participants were asked to complete a short questionnaire online.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-1"
    },
    {
      "id": "en.n10.class-81.t04",
      "en": "A sample of two hundred students was interviewed about their sleep.",
      "es": "Se entrevistó a una muestra de doscientos estudiantes sobre su sueño.",
      "explanationEs": "Con a sample of + plural, el verbo concuerda con sample (singular): was interviewed.",
      "segments": [
        "A sample of two hundred students",
        "was interviewed about their sleep."
      ],
      "audioText": "A sample of two hundred students was interviewed about their sleep.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-1"
    },
    {
      "id": "en.n10.class-81.t05",
      "en": "All the answers were recorded and compared with last year's results.",
      "es": "Todas las respuestas se registraron y se compararon con los resultados del año pasado.",
      "explanationEs": "Dos pasivos unidos: el segundo were se puede omitir (were recorded and compared).",
      "segments": [
        "All the answers were recorded and",
        "compared with last year's results."
      ],
      "audioText": "All the answers were recorded and compared with last year's results.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-1"
    }
  ],
