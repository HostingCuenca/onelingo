  "teaching": [
    {
      "id": "en.n10.class-26.t01",
      "en": "It's easily done; I nearly sent the message to the wrong person myself.",
      "es": "Es fácil que pase; yo casi envío el mensaje a la persona equivocada.",
      "explanationEs": "It's easily done quita peso al error del otro: le dice que le podría pasar a cualquiera.",
      "segments": [
        "It's easily done; I nearly sent the",
        "message to the wrong person myself."
      ],
      "audioText": "It's easily done; I nearly sent the message to the wrong person myself.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    },
    {
      "id": "en.n10.class-26.t02",
      "en": "I may not have been clear, and that is not your fault; I take the blame.",
      "es": "Puede que yo no fuera claro, y no es culpa tuya; asumo la culpa.",
      "explanationEs": "Asumir parte del problema (I may not have been clear) deja al otro una salida digna.",
      "segments": [
        "I may not have been clear, and that",
        "is not your fault; I take the blame."
      ],
      "audioText": "I may not have been clear, and that is not your fault; I take the blame.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    },
    {
      "id": "en.n10.class-26.t03",
      "en": "No harm done; the meeting can start ten minutes late.",
      "es": "No ha pasado nada; la reunión puede empezar diez minutos tarde.",
      "explanationEs": "No harm done dice que el error no tuvo consecuencias; cierra el tema sin reproches.",
      "segments": [
        "No harm done; the meeting",
        "can start ten minutes late."
      ],
      "audioText": "No harm done; the meeting can start ten minutes late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    },
    {
      "id": "en.n10.class-26.t04",
      "en": "I'm sure you didn't mean it that way, but it felt awkward for Leo.",
      "es": "Seguro que no querías decirlo así, pero a Leo le resultó incómodo.",
      "explanationEs": "Suponer buena intención (I'm sure you didn't mean it) permite avisar sin acusar.",
      "segments": [
        "I'm sure you didn't mean it that",
        "way, but it felt awkward for Leo."
      ],
      "audioText": "I'm sure you didn't mean it that way, but it felt awkward for Leo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    },
    {
      "id": "en.n10.class-26.t05",
      "en": "I wish I had warned you earlier; the blame is mine, not yours.",
      "es": "Ojalá te hubiera avisado antes; la culpa es mía, no tuya.",
      "explanationEs": "Para un lamento sobre el pasado se usa wish + had + participio.",
      "segments": [
        "I wish I had warned you earlier;",
        "the blame is mine, not yours."
      ],
      "audioText": "I wish I had warned you earlier; the blame is mine, not yours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    },
    {
      "id": "en.n10.class-26.t06",
      "en": "If only I had been clearer, the conversation would not have been so awkward.",
      "es": "Ojalá hubiera sido más claro; la conversación no habría sido tan incómoda.",
      "explanationEs": "If only + had + participio es un lamento más intenso que wish; no suena a reproche hacia el otro.",
      "segments": [
        "If only I had been clearer, the",
        "conversation would not have been so awkward."
      ],
      "audioText": "If only I had been clearer, the conversation would not have been so awkward.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-1"
    }
  ],
