  "id": "en.n10.class-28",
  "title": {
    "en": "Read a diplomatic statement",
    "es": "Leer un comunicado diplomático"
  },
  "objectives": {
    "es": [
      "Leer un comunicado entre dos asociaciones y traducir sus frases diplomáticas a lenguaje directo, repasando las preguntas reportadas."
