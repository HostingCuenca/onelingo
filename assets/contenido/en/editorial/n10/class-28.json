  "teaching": [
    {
      "id": "en.n10.class-28.t01",
      "en": "We note with concern that the garden has not been cleaned.",
      "es": "Observamos con preocupación que el jardín no se ha limpiado.",
      "explanationEs": "We note with concern no es neutral: significa «estamos molestos y queremos que se arregle».",
      "segments": [
        "We note with concern that the",
        "garden has not been cleaned."
      ],
      "audioText": "We note with concern that the garden has not been cleaned.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    },
    {
      "id": "en.n10.class-28.t02",
      "en": "Our association held frank discussions about the rent.",
      "es": "Nuestra asociación mantuvo conversaciones francas sobre el alquiler.",
      "explanationEs": "Frank discussions suele esconder un desacuerdo fuerte que se dijo con claridad.",
      "segments": [
        "Our association held frank",
        "discussions about the rent."
      ],
      "audioText": "Our association held frank discussions about the rent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    },
    {
      "id": "en.n10.class-28.t03",
      "en": "We regret that the meeting ended early.",
      "es": "Lamentamos que la reunión terminara pronto.",
      "explanationEs": "We regret expresa pesar y, sin decirlo, sugiere que alguien tuvo la responsabilidad.",
      "segments": [
        "We regret that the",
        "meeting ended early."
      ],
      "audioText": "We regret that the meeting ended early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    },
    {
      "id": "en.n10.class-28.t04",
      "en": "We remain committed to finding a solution.",
      "es": "Seguimos comprometidos con encontrar una solución.",
      "explanationEs": "Remain committed to dice que quieren seguir hablando, pero aún no hay acuerdo.",
      "segments": [
        "We remain committed to",
        "finding a solution."
      ],
      "audioText": "We remain committed to finding a solution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    },
    {
      "id": "en.n10.class-28.t05",
      "en": "The committee asked whether the association would reconsider its decision.",
      "es": "El comité preguntó si la asociación reconsideraría su decisión.",
      "explanationEs": "Pregunta reportada: whether + sujeto + verbo, sin invertir el orden y con would por el paso al pasado.",
      "segments": [
        "The committee asked whether the",
        "association would reconsider its decision."
      ],
      "audioText": "The committee asked whether the association would reconsider its decision.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    },
    {
      "id": "en.n10.class-28.t06",
      "en": "This statement does not mean that the talks have ended.",
      "es": "Este comunicado no significa que las conversaciones hayan terminado.",
      "explanationEs": "El comunicado es un texto oficial; lo importante es leer qué dice entre líneas.",
      "segments": [
        "This statement does not mean",
        "that the talks have ended."
      ],
      "audioText": "This statement does not mean that the talks have ended.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-diplomacy-3"
    }
  ],
