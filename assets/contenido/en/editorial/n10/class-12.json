    },
    {
      "id": "en.n10.class-12.t03",
      "en": "I wanted to be a tailor, but the job did not suit me.",
      "es": "Quería ser sastre, pero el trabajo no me quedaba bien.",
      "explanationEs": "Suit = quedar bien una prenda y convenir un trabajo.",
      "segments": [
        "I wanted to be a tailor, but",
        "the job did not suit me."
