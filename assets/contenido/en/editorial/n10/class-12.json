      "languageCode": "en",
      "patternId": "n10-humor-and-irony-2"
    },
    {
      "id": "en.n10.class-12.t02",
      "en": "The farmer won an award because he was outstanding in his field.",
      "es": "El granjero ganó un premio porque era sobresaliente en su campo.",
      "explanationEs": "Outstanding = excelente y «de pie fuera»; field = campo de cultivo y ámbito profesional.",
      "segments": [
        "The farmer won an award because",
        "he was outstanding in his field."
