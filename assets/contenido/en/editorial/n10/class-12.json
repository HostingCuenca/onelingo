    },
    {
      "id": "en.n10.class-12.t04",
      "en": "I am on a seafood diet: I see food and I eat it.",
      "es": "Estoy a dieta de marisco: veo comida y me la como.",
      "explanationEs": "Homófonos: seafood suena como see food.",
      "segments": [
        "I am on a seafood diet: I",
