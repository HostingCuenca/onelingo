    {
      "id": "en.n10.class-12.t01",
      "en": "I used to be a banker, but I lost interest.",
      "es": "Antes era banquero, pero perdí el interés.",
      "explanationEs": "Interest = interés bancario y ganas: una palabra, dos sentidos.",
      "segments": [
        "I used to be a",
        "banker, but I lost interest."
      ],
      "audioText": "I used to be a banker, but I lost interest.",
