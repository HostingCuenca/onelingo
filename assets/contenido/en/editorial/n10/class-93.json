  "teaching": [
    {
      "id": "en.n10.class-93.t01",
      "en": "In song lyrics, a metaphor says one thing and means another.",
      "es": "En las letras de canciones, una metáfora dice una cosa y significa otra.",
      "explanationEs": "Lo literal es lo que dicen las palabras; lo figurado es lo que quieren decir.",
      "segments": [
        "In song lyrics, a metaphor says",
        "one thing and means another."
      ],
      "audioText": "In song lyrics, a metaphor says one thing and means another.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    },
    {
      "id": "en.n10.class-93.t02",
      "en": "If you read that verse as a literal door, you miss the point.",
      "es": "Si lees ese verso como una puerta literal, no captas lo que quiere decir.",
      "explanationEs": "Una imagen rara o imposible suele ser la pista de que hay que leerla en sentido figurado.",
      "segments": [
        "If you read that verse as a",
        "literal door, you miss the point."
      ],
      "audioText": "If you read that verse as a literal door, you miss the point.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    },
    {
      "id": "en.n10.class-93.t03",
      "en": "When a singer says 'I kept a light on', the lyrics imply that someone is still waiting.",
      "es": "Cuando la cantante dice «dejé una luz encendida», la letra da a entender que alguien sigue esperando.",
      "explanationEs": "Imply: la letra sugiere algo que nunca dice con todas las letras.",
      "segments": [
        "When a singer says 'I kept a light on',",
        "the lyrics imply that someone is still waiting."
      ],
      "audioText": "When a singer says 'I kept a light on', the lyrics imply that someone is still waiting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    },
    {
      "id": "en.n10.class-93.t04",
      "en": "A quiet echo can be a hint that someone has left.",
      "es": "Un eco suave puede ser un indicio de que alguien se ha ido.",
      "explanationEs": "Un sonido o un espacio vacío insinúan una ausencia sin nombrarla.",
      "segments": [
        "A quiet echo can be a",
        "hint that someone has left."
      ],
      "audioText": "A quiet echo can be a hint that someone has left.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    },
    {
      "id": "en.n10.class-93.t05",
      "en": "The tone of the verse is gentle: the singer does not blame anyone.",
      "es": "El tono de la estrofa es suave: la cantante no culpa a nadie.",
      "explanationEs": "El tono (suave, irónico, resignado) se deduce de las palabras elegidas y de lo que se calla.",
      "segments": [
        "The tone of the verse is gentle:",
        "the singer does not blame anyone."
      ],
      "audioText": "The tone of the verse is gentle: the singer does not blame anyone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    },
    {
      "id": "en.n10.class-93.t06",
      "en": "What the words say is literal; what they imply is the hidden meaning.",
      "es": "Lo que dicen las palabras es literal; lo que implican es el sentido oculto.",
      "explanationEs": "Interpretar es pasar del significado literal al oculto apoyándote en palabras concretas.",
      "segments": [
        "What the words say is literal; what",
        "they imply is the hidden meaning."
      ],
      "audioText": "What the words say is literal; what they imply is the hidden meaning.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-3"
    }
  ],
