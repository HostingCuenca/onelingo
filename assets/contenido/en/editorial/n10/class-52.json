  "teaching": [
    {
      "id": "en.n10.class-52.t01",
      "en": "First, I will explain the problem; moreover, I will show you a solution.",
      "es": "Primero explicaré el problema; además, te mostraré una solución.",
      "explanationEs": "Moreover añade un punto más y avisa de que todavía viene algo.",
      "segments": [
        "First, I will explain the problem; moreover,",
        "I will show you a solution."
      ],
      "audioText": "First, I will explain the problem; moreover, I will show you a solution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-2"
    },
    {
      "id": "en.n10.class-52.t02",
      "en": "Having said that, let me briefly turn to the risks.",
      "es": "Dicho esto, déjame pasar brevemente a los riesgos.",
      "explanationEs": "Having said that reconoce lo anterior y cambia de punto con un matiz.",
      "segments": [
        "Having said that, let me",
        "briefly turn to the risks."
      ],
      "audioText": "Having said that, let me briefly turn to the risks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-2"
    },
    {
      "id": "en.n10.class-52.t03",
      "en": "Before moving on, let me recap what we have learnt so far.",
      "es": "Antes de pasar al siguiente punto, déjame recapitular lo que hemos aprendido hasta ahora.",
      "explanationEs": "Moving on abre el punto siguiente; recap repasa lo dicho antes.",
      "segments": [
        "Before moving on, let me recap",
        "what we have learnt so far."
      ],
      "audioText": "Before moving on, let me recap what we have learnt so far.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-2"
    },
    {
      "id": "en.n10.class-52.t04",
      "en": "To sum up, we can conclude that small habits change big results.",
      "es": "En resumen, podemos concluir que los pequeños hábitos cambian grandes resultados.",
      "explanationEs": "To sum up anuncia el cierre; conclude introduce la idea final.",
      "segments": [
        "To sum up, we can conclude",
        "that small habits change big results."
      ],
      "audioText": "To sum up, we can conclude that small habits change big results.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-2"
    },
    {
      "id": "en.n10.class-52.t05",
      "en": "She asked a rhetorical question and waited: who has never been nervous?",
      "es": "Hizo una pregunta retórica y esperó: ¿quién no ha estado nunca nervioso?",
      "explanationEs": "La pregunta retórica no espera respuesta; hace pensar al público.",
      "segments": [
        "She asked a rhetorical question and",
        "waited: who has never been nervous?"
      ],
      "audioText": "She asked a rhetorical question and waited: who has never been nervous?",
      "audioMode": "tts",
