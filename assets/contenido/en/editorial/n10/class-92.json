  "teaching": [
    {
      "id": "en.n10.class-92.t01",
      "en": "Flag the error first, then repair only the words that are wrong.",
      "es": "Marca primero el error y después repara solo las palabras que fallan.",
      "explanationEs": "Corregir lo mínimo conserva tu voz y te enseña qué regla falló.",
      "segments": [
        "Flag the error first, then repair",
        "only the words that are wrong."
      ],
      "audioText": "Flag the error first, then repair only the words that are wrong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    },
    {
      "id": "en.n10.class-92.t02",
      "en": "A consistent tense keeps the story clear: When I arrived, the meeting had already started.",
      "es": "Un tiempo verbal coherente aclara el relato: Cuando llegué, la reunión ya había empezado.",
      "explanationEs": "Si dos hechos pasados se suceden, el anterior lleva had + participio.",
      "segments": [
        "A consistent tense keeps the story clear: When",
        "I arrived, the meeting had already started."
      ],
      "audioText": "A consistent tense keeps the story clear: When I arrived, the meeting had already started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    },
    {
      "id": "en.n10.class-92.t03",
      "en": "However precise the wording, the message can still sound rude.",
      "es": "Por precisa que sea la redacción, el mensaje puede seguir sonando grosero.",
      "explanationEs": "However + adjetivo: el adjetivo va pegado a however y luego viene el sujeto, sin inversión.",
      "segments": [
        "However precise the wording, the",
        "message can still sound rude."
      ],
      "audioText": "However precise the wording, the message can still sound rude.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    },
    {
      "id": "en.n10.class-92.t04",
      "en": "Should the contractor fail to deliver, the contingency plan applies.",
      "es": "Si el contratista no cumple, se aplica el plan de contingencia.",
      "explanationEs": "Should + sujeto + verbo base sustituye a if en contingencias formales.",
      "segments": [
        "Should the contractor fail to",
        "deliver, the contingency plan applies."
      ],
      "audioText": "Should the contractor fail to deliver, the contingency plan applies.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    },
    {
      "id": "en.n10.class-92.t05",
      "en": "Academic writers swap verbs for nouns: prices fell becomes the fall in prices.",
      "es": "Quien escribe en registro académico cambia verbos por sustantivos: prices fell pasa a the fall in prices.",
      "explanationEs": "Nominalizar compacta la idea; el sustantivo de cambio lleva in.",
      "segments": [
        "Academic writers swap verbs for nouns: prices",
        "fell becomes the fall in prices."
      ],
      "audioText": "Academic writers swap verbs for nouns: prices fell becomes the fall in prices.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    },
    {
      "id": "en.n10.class-92.t06",
      "en": "I was wondering whether the wording could be softer.",
      "es": "Me preguntaba si la redacción podría ser más suave.",
      "explanationEs": "La pregunta indirecta con I was wondering whether mantiene el orden afirmativo y suaviza la petición.",
      "segments": [
        "I was wondering whether the",
        "wording could be softer."
      ],
      "audioText": "I was wondering whether the wording could be softer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-2"
    }
