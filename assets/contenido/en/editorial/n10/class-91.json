  "teaching": [
    {
      "id": "en.n10.class-91.t01",
      "en": "I diagnose each slip before I rewrite the sentence.",
      "es": "Diagnostico cada desliz antes de reescribir la frase.",
      "explanationEs": "Primero localizas qué tipo de error es; después lo corriges con la regla adecuada, no al azar.",
      "segments": [
        "I diagnose each slip before",
        "I rewrite the sentence."
      ],
      "audioText": "I diagnose each slip before I rewrite the sentence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    },
    {
      "id": "en.n10.class-91.t02",
      "en": "A recurring slip in spoken grammar is forgetting the pronoun: That film, it was brilliant.",
      "es": "Un desliz recurrente en la gramática oral es olvidar el pronombre: That film, it was brilliant.",
      "explanationEs": "La cabeza (That film) se retoma siempre con un pronombre; en español no hace falta y de ahí el fallo.",
      "segments": [
        "A recurring slip in spoken grammar is forgetting",
        "the pronoun: That film, it was brilliant."
      ],
      "audioText": "A recurring slip in spoken grammar is forgetting the pronoun: That film, it was brilliant.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    },
    {
      "id": "en.n10.class-91.t03",
      "en": "In the concession category, much as never takes but: Much as I admire her, I disagree.",
      "es": "En la categoría de la concesión, much as nunca lleva but: Much as I admire her, I disagree.",
      "explanationEs": "Much as ya marca el contraste; añadir but es un calco de «aunque… pero».",
      "segments": [
        "In the concession category, much as never takes",
        "but: Much as I admire her, I disagree."
      ],
      "audioText": "In the concession category, much as never takes but: Much as I admire her, I disagree.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    },
    {
      "id": "en.n10.class-91.t04",
      "en": "To pinpoint a tact slip, ask whether the request sounds like an order.",
      "es": "Para localizar un desliz de tacto, pregúntate si la petición suena a orden.",
      "explanationEs": "Los deslices de tacto suelen ser de forma (would, whether, orden afirmativo), no de vocabulario.",
      "segments": [
        "To pinpoint a tact slip, ask whether",
        "the request sounds like an order."
      ],
      "audioText": "To pinpoint a tact slip, ask whether the request sounds like an order.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    },
    {
      "id": "en.n10.class-91.t05",
      "en": "Academic register prefers a noun: the increase in prices.",
      "es": "El registro académico prefiere un sustantivo: el aumento de los precios.",
      "explanationEs": "Con sustantivos de cambio (increase, drop, growth) se usa in, no of, para lo que cambia.",
      "segments": [
        "Academic register prefers a noun:",
        "the increase in prices."
      ],
      "audioText": "Academic register prefers a noun: the increase in prices.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    },
    {
      "id": "en.n10.class-91.t06",
      "en": "I spot a narrative slip when the order of events is unclear: the film had already started.",
      "es": "Detecto un desliz narrativo cuando el orden de los hechos no está claro: la película ya había empezado.",
      "explanationEs": "Lo que pasó antes de otro hecho pasado lleva had + participio.",
      "segments": [
        "I spot a narrative slip when the order of",
        "events is unclear: the film had already started."
      ],
      "audioText": "I spot a narrative slip when the order of events is unclear: the film had already started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-integrated-creation-1"
    }
  ],
