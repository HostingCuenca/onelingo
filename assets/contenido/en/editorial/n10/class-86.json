  "teaching": [
    {
      "id": "en.n10.class-86.t01",
      "en": "When friends are excited, their voices overlap and nobody finishes a sentence.",
      "es": "Cuando los amigos están emocionados, sus voces se solapan y nadie termina una frase.",
      "explanationEs": "Overlap describe voces que suenan a la vez; tendrás que reconstruir lo que falta.",
      "segments": [
        "When friends are excited, their voices",
        "overlap and nobody finishes a sentence."
      ],
      "audioText": "When friends are excited, their voices overlap and nobody finishes a sentence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-1"
    },
    {
      "id": "en.n10.class-86.t02",
      "en": "Hang on, sorry to interrupt, but I thought we were meeting on Friday.",
      "es": "Espera, perdona que te interrumpa, pero creía que quedábamos el viernes.",
      "explanationEs": "Hang on frena la conversación; sorry to interrupt pide permiso para cortar.",
      "segments": [
        "Hang on, sorry to interrupt, but I",
        "thought we were meeting on Friday."
      ],
      "audioText": "Hang on, sorry to interrupt, but I thought we were meeting on Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-1"
    },
    {
      "id": "en.n10.class-86.t03",
      "en": "We all tend to talk over each other, so I sometimes lose the thread.",
      "es": "Todos tendemos a hablar unos encima de otros, así que a veces pierdo el hilo.",
      "explanationEs": "Lose the thread = perder el hilo; talk over each other = hablar a la vez.",
      "segments": [
        "We all tend to talk over each",
        "other, so I sometimes lose the thread."
      ],
      "audioText": "We all tend to talk over each other, so I sometimes lose the thread.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-1"
    },
    {
      "id": "en.n10.class-86.t04",
      "en": "Sorry, did I cut in? Go ahead, I did not mean to interrupt.",
      "es": "Perdona, ¿me he metido? Adelante, no quería interrumpir.",
      "explanationEs": "Go ahead devuelve el turno a quien fue interrumpido.",
      "segments": [
        "Sorry, did I cut in? Go ahead,",
        "I did not mean to interrupt."
      ],
      "audioText": "Sorry, did I cut in? Go ahead, I did not mean to interrupt.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-1"
    },
    {
      "id": "en.n10.class-86.t05",
      "en": "Anyway, as I was saying, let us switch to the budget.",
      "es": "En fin, como iba diciendo, pasemos al presupuesto.",
      "explanationEs": "As I was saying retoma lo que se dijo antes; switch to cambia de tema.",
      "segments": [
        "Anyway, as I was saying, let",
        "us switch to the budget."
      ],
      "audioText": "Anyway, as I was saying, let us switch to the budget.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-1"
    }
