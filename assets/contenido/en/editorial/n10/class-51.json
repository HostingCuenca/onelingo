  "teaching": [
    {
      "id": "en.n10.class-51.t01",
      "en": "A strong opening grabs the audience with a hook in ten seconds.",
      "es": "Una apertura sólida engancha al público con un gancho en diez segundos.",
      "explanationEs": "Opening es la apertura; hook, el gancho que capta la atención desde el primer momento.",
      "segments": [
        "A strong opening grabs the audience",
        "with a hook in ten seconds."
      ],
      "audioText": "A strong opening grabs the audience with a hook in ten seconds.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    },
    {
      "id": "en.n10.class-51.t02",
      "en": "She began with an anecdote: last year she lost her suitcase in Rome.",
      "es": "Empezó con una anécdota: el año pasado perdió su maleta en Roma.",
      "explanationEs": "Una anécdota es una historia personal breve que crea cercanía con el público.",
      "segments": [
        "She began with an anecdote: last year",
        "she lost her suitcase in Rome."
      ],
      "audioText": "She began with an anecdote: last year she lost her suitcase in Rome.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    },
    {
      "id": "en.n10.class-51.t03",
      "en": "He opened with a statistic: nine out of ten people forget a talk in a week.",
      "es": "Abrió con un dato: nueve de cada diez personas olvidan una charla en una semana.",
      "explanationEs": "Una cifra sorprendente es otro gancho habitual; «nine out of ten» se traduce «nueve de cada diez».",
      "segments": [
        "He opened with a statistic: nine out of",
        "ten people forget a talk in a week."
      ],
      "audioText": "He opened with a statistic: nine out of ten people forget a talk in a week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    },
    {
      "id": "en.n10.class-51.t04",
      "en": "Her promise was simple: by the end, you will know how to open a talk.",
      "es": "Su promesa era sencilla: al final, sabrás cómo abrir una charla.",
      "explanationEs": "La promesa dice qué ganará el público por escuchar; by the end = «al final».",
      "segments": [
        "Her promise was simple: by the end, you",
        "will know how to open a talk."
      ],
      "audioText": "Her promise was simple: by the end, you will know how to open a talk.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    },
    {
      "id": "en.n10.class-51.t05",
      "en": "Let me outline the talk: first the problem, then the solution.",
      "es": "Déjame esbozar la charla: primero el problema, luego la solución.",
      "explanationEs": "Let me outline… anuncia la estructura antes de desarrollarla.",
      "segments": [
        "Let me outline the talk: first",
        "the problem, then the solution."
      ],
      "audioText": "Let me outline the talk: first the problem, then the solution.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    },
    {
      "id": "en.n10.class-51.t06",
      "en": "A signpost tells the audience where the talk is going next.",
      "es": "Una señal de organización le dice al público hacia dónde va la charla.",
      "explanationEs": "Signpost, como un cartel en la carretera, marca el camino: first, next, in a moment.",
      "segments": [
        "A signpost tells the audience where",
        "the talk is going next."
      ],
      "audioText": "A signpost tells the audience where the talk is going next.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-keynote-speaking-1"
    }
  ],
