  "teaching": [
    {
      "id": "en.n10.class-87.t01",
      "en": "Every variety of English has its own words, even though most of the grammar is shared.",
      "es": "Cada variedad del inglés tiene sus propias palabras, aunque casi toda la gramática es común.",
      "explanationEs": "Variety = variedad: no hay un único inglés correcto, hay muchos ingleses.",
      "segments": [
        "Every variety of English has its own words,",
        "even though most of the grammar is shared."
      ],
      "audioText": "Every variety of English has its own words, even though most of the grammar is shared.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-2"
    },
    {
      "id": "en.n10.class-87.t02",
      "en": "Could we prepone tomorrow's meeting to nine o'clock?",
      "es": "¿Podríamos adelantar la reunión de mañana a las nueve?",
      "explanationEs": "India: prepone es lo contrario de postpone; significa pasar algo a una hora más temprana.",
      "segments": [
        "Could we prepone tomorrow's",
        "meeting to nine o'clock?"
      ],
      "audioText": "Could we prepone tomorrow's meeting to nine o'clock?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-2"
    },
    {
      "id": "en.n10.class-87.t03",
      "en": "How far? Flash me when you arrive, and I will come down.",
      "es": "¿Qué tal? Dame un toque cuando llegues y bajo.",
      "explanationEs": "Nigeria: how far? saluda; flash me pide una llamada perdida como aviso.",
      "segments": [
        "How far? Flash me when you",
        "arrive, and I will come down."
      ],
      "audioText": "How far? Flash me when you arrive, and I will come down.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-2"
    },
    {
      "id": "en.n10.class-87.t04",
      "en": "I am grand, thanks; I am just after finishing my exams.",
      "es": "Estoy bien, gracias; acabo de terminar mis exámenes.",
      "explanationEs": "Irlanda: grand = bien; I am after + -ing = acabo de + infinitivo.",
      "segments": [
        "I am grand, thanks; I am",
        "just after finishing my exams."
      ],
      "audioText": "I am grand, thanks; I am just after finishing my exams.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-2"
    },
    {
      "id": "en.n10.class-87.t05",
      "en": "I reckon we will have heaps of time this arvo.",
      "es": "Creo que tendremos un montón de tiempo esta tarde.",
      "explanationEs": "Australia: reckon = creo, heaps of = un montón de, arvo = tarde.",
      "segments": [
        "I reckon we will have",
        "heaps of time this arvo."
      ],
      "audioText": "I reckon we will have heaps of time this arvo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-advanced-listening-2"
    }
  ],
