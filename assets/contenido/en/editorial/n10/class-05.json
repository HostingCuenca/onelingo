  "teaching": [
    {
      "id": "en.n10.class-05.t01",
      "en": "\"My sister, she's making the dessert.\" \"Is she? What's she making?\"",
      "es": "«Mi hermana hace el postre.» «¿Ah, sí? ¿Qué prepara?»",
      "explanationEs": "Combina cabeza (My sister, she's…) y eco (Is she?).",
      "segments": [
        "\"My sister, she's making the dessert.\"",
        "\"Is she? What's she making?\""
      ],
      "audioText": "\"My sister, she's making the dessert.\" \"Is she? What's she making?\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    },
    {
      "id": "en.n10.class-05.t02",
      "en": "\"It's a lovely recipe, this soup.\" \"Is it? I'd love to try a bite.\"",
      "es": "«Es una receta preciosa, esta sopa.» «¿Sí? Me encantaría probar un bocado.»",
      "explanationEs": "Cola (this soup) + eco (Is it?) + elipsis (I'd love to).",
      "segments": [
        "\"It's a lovely recipe, this soup.\" \"Is",
        "it? I'd love to try a bite.\""
      ],
      "audioText": "\"It's a lovely recipe, this soup.\" \"Is it? I'd love to try a bite.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    },
    {
      "id": "en.n10.class-05.t03",
      "en": "\"I can't eat another bite.\" \"Neither can I. Shall we have a coffee?\"",
      "es": "«No puedo comer ni un bocado más.» «Yo tampoco. ¿Tomamos un café?»",
      "explanationEs": "Neither can I copia el auxiliar de can't y se usa tras una frase negativa.",
      "segments": [
        "\"I can't eat another bite.\" \"Neither can",
        "I. Shall we have a coffee?\""
      ],
      "audioText": "\"I can't eat another bite.\" \"Neither can I. Shall we have a coffee?\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    },
    {
      "id": "en.n10.class-05.t04",
      "en": "\"By the way, have you heard the latest gossip?\" \"No. Go on, tell me!\"",
      "es": "«Por cierto, ¿has oído el último cotilleo?» «No. ¡Sigue, cuéntame!»",
      "explanationEs": "By the way abre el tema; Go on invita a seguir.",
      "segments": [
        "\"By the way, have you heard the",
        "latest gossip?\" \"No. Go on, tell me!\""
      ],
      "audioText": "\"By the way, have you heard the latest gossip?\" \"No. Go on, tell me!\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    },
    {
      "id": "en.n10.class-05.t05",
      "en": "\"Anyway, shall we help the host with the dishes?\" \"I'd love to.\"",
      "es": "«En fin, ¿ayudamos a la anfitriona con los platos?» «Me encantaría.»",
      "explanationEs": "Anyway vuelve a lo práctico; I'd love to omite el verbo help.",
      "segments": [
        "\"Anyway, shall we help the host",
        "with the dishes?\" \"I'd love to.\""
      ],
      "audioText": "\"Anyway, shall we help the host with the dishes?\" \"I'd love to.\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    },
    {
      "id": "en.n10.class-05.t06",
      "en": "\"Come to think of it, Tom still owes us a toast.\" \"So he does!\"",
      "es": "«Ahora que lo pienso, Tom todavía nos debe un brindis.» «¡Es verdad!»",
      "explanationEs": "So he does confirma lo que alguien acaba de decir; no significa «él también».",
      "segments": [
        "\"Come to think of it, Tom still",
        "owes us a toast.\" \"So he does!\""
      ],
      "audioText": "\"Come to think of it, Tom still owes us a toast.\" \"So he does!\"",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-native-like-conversation-5"
    }
  ],
