  "teaching": [
    {
      "id": "en.n10.class-82.t01",
      "en": "The vast majority of students, 88 per cent, walk to school.",
      "es": "La gran mayoría de los estudiantes, el 88 por ciento, va andando a la escuela.",
      "explanationEs": "The vast majority equivale a «casi todos»; per cent no lleva -s.",
      "segments": [
        "The vast majority of students, 88",
        "per cent, walk to school."
      ],
      "audioText": "The vast majority of students, 88 per cent, walk to school.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-2"
    },
    {
      "id": "en.n10.class-82.t02",
      "en": "Roughly a third of the students, 34 per cent, travel by bus.",
      "es": "Aproximadamente un tercio de los estudiantes, el 34 por ciento, viaja en autobús.",
      "explanationEs": "Roughly suaviza la cifra: no es exacta, pero se acerca a un tercio.",
      "segments": [
        "Roughly a third of the students,",
        "34 per cent, travel by bus."
      ],
      "audioText": "Roughly a third of the students, 34 per cent, travel by bus.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-2"
    },
    {
      "id": "en.n10.class-82.t03",
      "en": "Only a minority cycle, yet twice as many students cycle as take the train.",
      "es": "Solo una minoría va en bicicleta, pero el doble de estudiantes usa la bici que el tren.",
      "explanationEs": "Twice as many… as compara dos cantidades contables: el doble.",
      "segments": [
        "Only a minority cycle, yet twice as",
        "many students cycle as take the train."
      ],
      "audioText": "Only a minority cycle, yet twice as many students cycle as take the train.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-2"
    },
    {
      "id": "en.n10.class-82.t04",
      "en": "The proportion of students who come by car is barely five per cent.",
      "es": "La proporción de estudiantes que llega en coche es apenas del cinco por ciento.",
      "explanationEs": "Barely señala una cantidad muy pequeña, casi insuficiente.",
      "segments": [
        "The proportion of students who come by",
        "car is barely five per cent."
      ],
      "audioText": "The proportion of students who come by car is barely five per cent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-2"
    },
    {
      "id": "en.n10.class-82.t05",
      "en": "Car use rose slightly, from four to five per cent.",
      "es": "El uso del coche subió ligeramente, del cuatro al cinco por ciento.",
      "explanationEs": "Slightly acompaña cambios pequeños: rose slightly, fell slightly.",
      "segments": [
        "Car use rose slightly, from",
        "four to five per cent."
      ],
      "audioText": "Car use rose slightly, from four to five per cent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-research-discussion-2"
    }
