  "teaching": [
    {
      "id": "en.n10.class-36.t01",
      "en": "Our target customers are students and workers who cycle every day.",
      "es": "Nuestros clientes objetivo son estudiantes y trabajadores que van en bici cada día.",
      "explanationEs": "Sección de mercado: dice quién compra. Target customers = el público al que se dirige el negocio.",
      "segments": [
        "Our target customers are students and",
        "workers who cycle every day."
      ],
      "audioText": "Our target customers are students and workers who cycle every day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-1"
    },
    {
      "id": "en.n10.class-36.t02",
      "en": "Two competitors already repair bikes in the city centre.",
      "es": "Dos competidores ya reparan bicicletas en el centro de la ciudad.",
      "explanationEs": "También es mercado: competitors son los negocios que venden lo mismo en la misma zona.",
      "segments": [
        "Two competitors already repair bikes",
        "in the city centre."
      ],
      "audioText": "Two competitors already repair bikes in the city centre.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-1"
    },
    {
      "id": "en.n10.class-36.t03",
      "en": "We will promote the workshop with posters and a weekly offer.",
      "es": "Promocionaremos el taller con carteles y una oferta semanal.",
      "explanationEs": "Sección de marketing: will + verbo base describe lo que harás para darte a conocer.",
      "segments": [
        "We will promote the workshop with",
        "posters and a weekly offer."
      ],
      "audioText": "We will promote the workshop with posters and a weekly offer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-1"
    },
    {
      "id": "en.n10.class-36.t04",
      "en": "The workshop will open six days a week, with two shifts each day.",
      "es": "El taller abrirá seis días a la semana, con dos turnos cada día.",
      "explanationEs": "Operaciones: horarios, turnos y personal; casi todo va en futuro con will.",
      "segments": [
        "The workshop will open six days a",
        "week, with two shifts each day."
      ],
      "audioText": "The workshop will open six days a week, with two shifts each day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-1"
    },
    {
      "id": "en.n10.class-36.t05",
      "en": "We need a loan of fifteen thousand dollars and expect a profit in the second year.",
      "es": "Necesitamos un préstamo de quince mil dólares y esperamos beneficios en el segundo año.",
      "explanationEs": "Finanzas: cuánto dinero hace falta (loan) y cuándo habrá beneficio (profit); expect marca una previsión.",
      "segments": [
        "We need a loan of fifteen thousand dollars",
        "and expect a profit in the second year."
      ],
      "audioText": "We need a loan of fifteen thousand dollars and expect a profit in the second year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-professional-mastery-1"
    },
    {
      "id": "en.n10.class-36.t06",
      "en": "The main risk is that costs may rise faster than sales.",
      "es": "El principal riesgo es que los costes suban más rápido que las ventas.",
      "explanationEs": "Sección de riesgos: may expresa lo que es posible pero incierto.",
      "segments": [
        "The main risk is that costs",
