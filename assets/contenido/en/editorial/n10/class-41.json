  "teaching": [
    {
      "id": "en.n10.class-41.t01",
      "en": "An unreliable narrator says he was at home, but his muddy boots are a clue.",
      "es": "Un narrador poco fiable dice que estaba en casa, pero sus botas embarradas son una pista.",
      "explanationEs": "Una pista (clue) es un detalle que apunta a la verdad y choca con lo que cuenta el narrador.",
      "segments": [
        "An unreliable narrator says he was at home,",
        "but his muddy boots are a clue."
      ],
      "audioText": "An unreliable narrator says he was at home, but his muddy boots are a clue.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    },
    {
      "id": "en.n10.class-41.t02",
      "en": "His version of the night contradicts the letter on the table.",
      "es": "Su versión de la noche contradice la carta que hay sobre la mesa.",
      "explanationEs": "Contradict: lo que muestra un detalle choca con lo que dice el narrador.",
      "segments": [
        "His version of the night contradicts",
        "the letter on the table."
      ],
      "audioText": "His version of the night contradicts the letter on the table.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    },
    {
      "id": "en.n10.class-41.t03",
      "en": "The narrator claims he never left, but the ticket in his coat must have come from somewhere.",
      "es": "El narrador afirma que nunca salió, pero el billete de su abrigo tiene que haber venido de algún sitio.",
      "explanationEs": "Must have + participio: deducción casi segura sobre el pasado.",
      "segments": [
        "The narrator claims he never left, but the ticket",
        "in his coat must have come from somewhere."
      ],
      "audioText": "The narrator claims he never left, but the ticket in his coat must have come from somewhere.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    },
    {
      "id": "en.n10.class-41.t04",
      "en": "He can't have forgotten the meeting; his calm voice is suspicious.",
      "es": "No puede haberse olvidado de la reunión; su voz tranquila resulta sospechosa.",
      "explanationEs": "Can't have + participio: casi seguro que no ocurrió. Para deducir no se usa mustn't.",
      "segments": [
        "He can't have forgotten the meeting;",
        "his calm voice is suspicious."
      ],
      "audioText": "He can't have forgotten the meeting; his calm voice is suspicious.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    },
    {
      "id": "en.n10.class-41.t05",
      "en": "The narrator might have exaggerated the storm to seem brave.",
      "es": "Puede que el narrador exagerara la tormenta para parecer valiente.",
      "explanationEs": "Might have + participio: posibilidad sin certeza. Exaggerate es contar algo como más grande de lo que fue.",
      "segments": [
        "The narrator might have exaggerated",
        "the storm to seem brave."
      ],
      "audioText": "The narrator might have exaggerated the storm to seem brave.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    },
    {
      "id": "en.n10.class-41.t06",
      "en": "He could have tried to conceal the letter, or he might simply have lost it.",
      "es": "Podría haber intentado ocultar la carta, o quizá simplemente la perdió.",
      "explanationEs": "Could have y might have plantean explicaciones posibles; conceal significa ocultar.",
      "segments": [
        "He could have tried to conceal the letter,",
        "or he might simply have lost it."
      ],
      "audioText": "He could have tried to conceal the letter, or he might simply have lost it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-film-and-literature-1"
    }
  ],
