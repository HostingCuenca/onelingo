  "teaching": [
    {
      "id": "en.n10.class-31.t01",
      "en": "The rapid growth of cities has put pressure on housing.",
      "es": "El rápido crecimiento de las ciudades ha presionado la vivienda.",
      "explanationEs": "«Cities have grown rapidly» se empaqueta: el verbo grow pasa a growth y el adverbio rapidly pasa a adjetivo (rapid).",
      "segments": [
        "The rapid growth of cities",
        "has put pressure on housing."
      ],
      "audioText": "The rapid growth of cities has put pressure on housing.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-academic-mastery-1"
    },
    {
      "id": "en.n10.class-31.t02",
      "en": "The adoption of the new method improved the assessment of student work.",
      "es": "La adopción del nuevo método mejoró la evaluación del trabajo de los estudiantes.",
      "explanationEs": "Dos verbos (adopt, assess) se vuelven sustantivos: en lugar de acciones, son «cosas» de las que se puede hablar.",
      "segments": [
        "The adoption of the new method",
        "improved the assessment of student work."
      ],
      "audioText": "The adoption of the new method improved the assessment of student work.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-academic-mastery-1"
    },
    {
      "id": "en.n10.class-31.t03",
      "en": "Greater awareness of the risk led to a significant reduction in accidents.",
      "es": "Una mayor conciencia del riesgo llevó a una reducción significativa de los accidentes.",
      "explanationEs": "«People became aware and accidents fell» se comprime: aware → awareness, fell → reduction; significant indica el grado.",
      "segments": [
        "Greater awareness of the risk led",
        "to a significant reduction in accidents."
      ],
      "audioText": "Greater awareness of the risk led to a significant reduction in accidents.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-academic-mastery-1"
    },
    {
      "id": "en.n10.class-31.t04",
      "en": "The efficiency of the system depends on regular checks.",
      "es": "La eficiencia del sistema depende de revisiones periódicas.",
      "explanationEs": "El adjetivo efficient pasa a efficiency (-ent → -ency); el grupo nominal entero es el sujeto de depends.",
      "segments": [
        "The efficiency of the system",
        "depends on regular checks."
      ],
      "audioText": "The efficiency of the system depends on regular checks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-academic-mastery-1"
    },
    {
      "id": "en.n10.class-31.t05",
      "en": "Rapid growth is not always good news for a small business.",
      "es": "El crecimiento rápido no siempre es una buena noticia para un pequeño negocio.",
      "explanationEs": "Sin of, growth también funciona como sustantivo pleno: «Rapid growth» es el sujeto de la frase.",
      "segments": [
        "Rapid growth is not always good",
        "news for a small business."
      ],
      "audioText": "Rapid growth is not always good news for a small business.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-academic-mastery-1"
    }
  ],
