  "id": "en.n10.class-31",
  "title": {
    "en": "How academic texts pack ideas",
    "es": "Cómo empaquetan ideas los textos académicos"
  },
  "objectives": {
    "es": [
      "Reconocer cómo un verbo o un adjetivo se convierte en sustantivo (nominalización) para compactar información en un texto académico."
    ]
  },
