  "teaching": [
    {
      "id": "en.n10.class-16.t01",
      "en": "“That might be difficult” is often an indirect refusal, not a real maybe.",
      "es": "«Eso podría ser difícil» suele ser un rechazo indirecto, no un «quizá» real.",
      "explanationEs": "Un suavizador (might, difficult) sin alternativa concreta suele significar «no».",
      "segments": [
        "“That might be difficult” is often an",
        "indirect refusal, not a real maybe."
      ],
      "audioText": "“That might be difficult” is often an indirect refusal, not a real maybe.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-1"
    },
    {
      "id": "en.n10.class-16.t02",
      "en": "When my boss said “I will think about it,” I understood the hint: it was a no.",
      "es": "Cuando mi jefa dijo «Lo pensaré», entendí la indirecta: era un no.",
      "explanationEs": "«I will think about it» sin fecha ni detalles suele ser un rechazo cortés.",
      "segments": [
        "When my boss said “I will think about it,”",
        "I understood the hint: it was a no."
      ],
      "audioText": "When my boss said “I will think about it,” I understood the hint: it was a no.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-1"
    },
    {
      "id": "en.n10.class-16.t03",
      "en": "“With respect, I see it differently” is a tactful way to disagree.",
      "es": "«Con todo respeto, yo lo veo de otra manera» es una forma diplomática de discrepar.",
      "explanationEs": "With respect anuncia un desacuerdo, no una muestra de admiración.",
      "segments": [
        "“With respect, I see it differently”",
        "is a tactful way to disagree."
      ],
      "audioText": "“With respect, I see it differently” is a tactful way to disagree.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-1"
    },
    {
      "id": "en.n10.class-16.t04",
      "en": "“We must have lunch sometime” is often a friendly goodbye, not an invitation.",
      "es": "«Tenemos que comer juntos algún día» suele ser una despedida amable, no una invitación.",
      "explanationEs": "Sin día ni hora no hay plan real.",
      "segments": [
        "“We must have lunch sometime” is often",
        "a friendly goodbye, not an invitation."
      ],
      "audioText": "“We must have lunch sometime” is often a friendly goodbye, not an invitation.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-1"
    },
    {
      "id": "en.n10.class-16.t05",
      "en": "To be honest, a direct “No” can sound rude to many English speakers, so they soften it.",
      "es": "Siendo sincero, un «No» directo puede sonar descortés a muchos angloparlantes, así que lo suavizan.",
      "explanationEs": "Es una tendencia, no una regla: el contexto y el tono mandan.",
      "segments": [
        "To be honest, a direct “No” can sound rude",
        "to many English speakers, so they soften it."
      ],
      "audioText": "To be honest, a direct “No” can sound rude to many English speakers, so they soften it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n10-cultural-nuance-1"
    }
  ],
