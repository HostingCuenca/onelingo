    {
      "id": "en.n3.class-08.t01",
      "en": "A timeline keeps the background, interruption and result in order.",
      "es": "Una línea temporal mantiene en orden el fondo, la interrupción y el resultado.",
      "explanationEs": "El orden evita atribuir una reacción a un hecho posterior.",
      "segments": [
        {
          "en": "A timeline keeps the background,",
          "es": "Una línea temporal mantiene en orden"
        },
        {
          "en": "interruption and result in order.",
          "es": "el fondo, la interrupción y el resultado."
        }
      ],
      "audioText": "A timeline keeps the background, interruption and result in order.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-past-scenes-3"
    },
    {
