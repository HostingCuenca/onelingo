  "teaching": [
    {
      "id": "en.n3.class-92.t01",
      "en": "The problem is that the empty space behind the library has no shade.",
      "es": "El problema es que el espacio vacío detrás de la biblioteca no tiene sombra.",
      "explanationEs": "The problem is that + oración presenta lo que falla ahora.",
      "segments": [
        "The problem is that the empty space",
        "behind the library has no shade."
      ],
      "audioText": "The problem is that the empty space behind the library has no shade.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-community-project-2"
    },
    {
      "id": "en.n3.class-92.t02",
      "en": "For example, families leave after ten minutes because there are no seats.",
      "es": "Por ejemplo, las familias se van a los diez minutos porque no hay asientos.",
      "explanationEs": "For example + dato da la prueba; because da la razón.",
      "segments": [
        "For example, families leave after ten",
        "minutes because there are no seats."
      ],
      "audioText": "For example, families leave after ten minutes because there are no seats.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-community-project-2"
    },
    {
      "id": "en.n3.class-92.t03",
      "en": "So we propose a small garden with benches and trees.",
      "es": "Así que proponemos un pequeño jardín con bancos y árboles.",
      "explanationEs": "So + we propose: la solución responde al problema.",
      "segments": [
        "So we propose a small",
        "garden with benches and trees."
      ],
      "audioText": "So we propose a small garden with benches and trees.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-community-project-2"
    },
    {
      "id": "en.n3.class-92.t04",
      "en": "As a result, more families may stay and read.",
      "es": "Como resultado, más familias pueden quedarse a leer.",
      "explanationEs": "As a result + may: lo esperado, sin prometerlo.",
      "segments": [
        "As a result, more families",
        "may stay and read."
      ],
      "audioText": "As a result, more families may stay and read.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-community-project-2"
    },
    {
      "id": "en.n3.class-92.t05",
      "en": "The proposal has four parts: the problem, the evidence, the solution and the result.",
      "es": "La propuesta tiene cuatro partes: el problema, la prueba, la solución y el resultado.",
      "explanationEs": "Esta es la estructura y siempre va en este orden.",
      "segments": [
        "The proposal has four parts: the problem,",
        "the evidence, the solution and the result."
      ],
      "audioText": "The proposal has four parts: the problem, the evidence, the solution and the result.",
      "audioMode": "tts",
