  "teaching": [
    {
      "id": "en.n3.class-86.t01",
      "en": "A cause explains why a local problem starts.",
      "es": "Una causa explica por qué empieza un problema local.",
      "explanationEs": "Use the documented action, not a guess.",
      "segments": [
        {
          "en": "A cause explains why",
          "es": "Una causa explica por"
        },
        {
          "en": "a local problem starts.",
          "es": "qué empieza un problema local."
        }
      ],
      "audioText": "A cause explains why a local problem starts.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-1"
    },
    {
      "id": "en.n3.class-86.t02",
      "en": "An effect is the recorded result.",
      "es": "Un efecto es el resultado registrado.",
      "explanationEs": "Keep the consequence separate from the cause.",
      "segments": [
        {
          "en": "An effect is",
          "es": "Un efecto es"
        },
        {
          "en": "the recorded result.",
          "es": "el resultado registrado."
        }
      ],
      "audioText": "An effect is the recorded result.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-1"
    },
    {
      "id": "en.n3.class-86.t03",
      "en": "An actor controls or performs the relevant action.",
      "es": "Un actor controla o realiza la acción pertinente.",
      "explanationEs": "Name the group able to change the practice.",
      "segments": [
        {
          "en": "An actor controls or",
          "es": "Un actor controla o"
        },
        {
          "en": "performs the relevant action.",
          "es": "realiza la acción pertinente."
        }
      ],
      "audioText": "An actor controls or performs the relevant action.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-1"
    },
    {
      "id": "en.n3.class-86.t04",
      "en": "One record can link cause, effect and actor.",
      "es": "Un registro puede vincular causa, efecto y actor.",
      "explanationEs": "All three elements must come from the same case.",
      "segments": [
        {
          "en": "One record can link",
          "es": "Un registro puede vincular"
        },
        {
          "en": "cause, effect and actor.",
          "es": "causa, efecto y actor."
        }
      ],
      "audioText": "One record can link cause, effect and actor.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-1"
    },
    {
      "id": "en.n3.class-86.t05",
      "en": "Local evidence limits what we can claim.",
      "es": "La evidencia local limita lo que podemos afirmar.",
      "explanationEs": "Do not invent a wider effect.",
      "segments": [
        {
          "en": "Local evidence limits",
          "es": "La evidencia local limita"
        },
        {
          "en": "what we can claim.",
          "es": "lo que podemos afirmar."
        }
      ],
      "audioText": "Local evidence limits what we can claim.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-1"
    },
    {
      "id": "en.n3.class-86.t06",
      "en": "Drivers idle outside school, the air worsens, and drivers are the actor able to change it.",
      "es": "Conductores dejan motores encendidos, empeora el aire y ellos pueden cambiarlo.",
      "explanationEs": "The model identifies cause, effect and actor.",
      "segments": [
        {
          "en": "Drivers idle outside school, the air worsens, and",
          "es": "Conductores dejan motores encendidos, empeora"
