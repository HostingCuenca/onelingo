  "teaching": [
    {
      "id": "en.n3.class-83.t01",
      "en": "Feedback can name an achievement and a specific problem.",
      "es": "La retroalimentación puede señalar un logro y un problema específico.",
      "explanationEs": "No interpretes todo el comentario como crítica.",
      "segments": [
        "Feedback can name an achievement and ",
        "a specific problem."
      ],
      "audioText": "Feedback can name an achievement and a specific problem.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-3"
    },
    {
      "id": "en.n3.class-83.t02",
      "en": "Your ideas are clear, but you sometimes miss an ending.",
      "es": "Tus ideas son claras, pero a veces omites una terminación.",
      "explanationEs": "Clear ideas es el logro; miss an ending es el problema.",
      "segments": [
        "Your ideas are clear, but ",
        "you sometimes miss an ending."
      ],
      "audioText": "Your ideas are clear, but you sometimes miss an ending.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-3"
    },
    {
      "id": "en.n3.class-83.t03",
      "en": "The next step is to check each verb before you submit your work.",
      "es": "El siguiente paso es comprobar cada verbo antes de entregar tu trabajo.",
      "explanationEs": "Una acción observable dice qué hacer y sobre qué hacerlo.",
      "segments": [
        "The next step is to ",
        "check each verb before you submit your work."
      ],
      "audioText": "The next step is to check each verb before you submit your work.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-3"
    },
    {
      "id": "en.n3.class-83.t04",
      "en": "Practise more is less specific than rewrite three incorrect sentences.",
      "es": "Practica más es menos específico que reescribe tres frases incorrectas.",
      "explanationEs": "Prefiere acciones que puedas comprobar después.",
      "segments": [
        "Practise more is ",
        "less specific than rewrite three incorrect sentences."
      ],
      "audioText": "Practise more is less specific than rewrite three incorrect sentences.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-3"
    },
    {
      "id": "en.n3.class-83.t05",
      "en": "Keep using examples; add one reason after each opinion.",
      "es": "Sigue usando ejemplos; añade una razón después de cada opinión.",
      "explanationEs": "Conserva la fortaleza mientras corriges la dificultad.",
      "segments": [
        "Keep using examples; ",
        "add one reason after each opinion."
      ],
      "audioText": "Keep using examples; add one reason after each opinion.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-3"
    },
    {
      "id": "en.n3.class-83.t06",
      "en": "You used the right words. Two answers lacked reasons. Add a reason to each answer.",
      "es": "Usaste las palabras adecuadas. A dos respuestas les faltaban razones. Añade una razón a cada respuesta.",
      "explanationEs": "Extrae tres columnas: logro, problema y siguiente acción.",
      "segments": [
        "You used the right words. ",
        "Two answers lacked reasons. Add a reason to each answer."
      ],
