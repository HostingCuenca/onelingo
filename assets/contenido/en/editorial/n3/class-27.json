  "teaching": [
    {
      "id": "en.n3.class-27.t01",
      "en": "The condition uses if plus a past form.",
      "es": "La condición usa if más una forma pasada.",
      "explanationEs": "La cláusula if establece la situación imaginaria.",
      "segments": [
        {
          "en": "The condition uses if",
          "es": "La condición usa if"
        },
        {
          "en": "plus a past form.",
          "es": "más una forma pasada."
        }
      ],
      "audioText": "The condition uses if plus a past form.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    },
    {
      "id": "en.n3.class-27.t02",
      "en": "Would introduces the chosen result.",
      "es": "Would introduce el resultado elegido.",
      "explanationEs": "El resultado con would presenta una decisión.",
      "segments": [
        {
          "en": "Would introduces",
          "es": "Would introduce"
        },
        {
          "en": "the chosen result.",
          "es": "el resultado elegido."
        }
      ],
      "audioText": "Would introduces the chosen result.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    },
    {
      "id": "en.n3.class-27.t03",
      "en": "Could introduces a possibility.",
      "es": "Could introduce una posibilidad.",
      "explanationEs": "La opción queda abierta y no se confirma.",
      "segments": [
        {
          "en": "Could introduces",
          "es": "Could introduce"
        },
        {
          "en": "a possibility.",
          "es": "una posibilidad."
        }
      ],
      "audioText": "Could introduces a possibility.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    },
    {
      "id": "en.n3.class-27.t04",
      "en": "A decision uses would; an option can use could.",
      "es": "Una decisión usa would; una opción puede usar could.",
      "explanationEs": "El significado determina el modal.",
      "segments": [
        {
          "en": "A decision uses would;",
          "es": "Una decisión usa would;"
        },
        {
          "en": "an option can use could.",
          "es": "una opción puede usar could."
        }
      ],
      "audioText": "A decision uses would; an option can use could.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    },
    {
      "id": "en.n3.class-27.t05",
      "en": "After each modal, use the base form of the verb.",
      "es": "Después de cada modal, usa la forma base del verbo.",
      "explanationEs": "No añadas to ni una terminación al verbo principal.",
      "segments": [
        {
          "en": "After each modal, use the",
          "es": "Después de cada modal, usa"
        },
        {
          "en": "base form of the verb.",
          "es": "la forma base del verbo."
        }
      ],
      "audioText": "After each modal, use the base form of the verb.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    },
    {
      "id": "en.n3.class-27.t06",
      "en": "Label each result as a decision or possibility before choosing the modal.",
      "es": "Etiqueta cada resultado como decisión o posibilidad antes de elegir el modal.",
      "explanationEs": "La etiqueta hace inequívoca la elección entre would y could.",
      "segments": [
        {
          "en": "Label each result as a decision",
          "es": "Etiqueta cada resultado como decisión o"
        },
        {
          "en": "or possibility before choosing the modal.",
          "es": "posibilidad antes de elegir el modal."
        }
      ],
      "audioText": "Label each result as a decision or possibility before choosing the modal.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-hypothetical-choices-2"
    }
