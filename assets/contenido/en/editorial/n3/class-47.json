    {
      "id": "en.n3.class-47.t01",
      "en": "We say something to report content.",
      "es": "Usamos say para reportar contenido.",
      "explanationEs": "Say no necesita receptor como objeto.",
      "segments": [
        {
          "en": "We say something",
          "es": "Usamos say"
        },
        {
          "en": "to report content.",
          "es": "para reportar contenido."
