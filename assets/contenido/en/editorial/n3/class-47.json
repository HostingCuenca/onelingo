      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    },
    {
      "id": "en.n3.class-47.t02",
      "en": "Lina said the bus was late.",
      "es": "Lina dijo que el bus llegaba tarde.",
      "explanationEs": "Said es el pasado de say.",
      "segments": [
        {
          "en": "Lina said the",
          "es": "Lina dijo que"
        },
        {
          "en": "bus was late.",
          "es": "el bus llegaba tarde."
        }
      ],
      "audioText": "Lina said the bus was late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    },
    {
      "id": "en.n3.class-47.t03",
      "en": "We tell a listener some news.",
      "es": "Le contamos una noticia a un oyente.",
      "explanationEs": "Tell necesita una persona receptora.",
      "segments": [
        {
          "en": "We tell a",
          "es": "Le contamos una"
        },
        {
          "en": "listener some news.",
          "es": "noticia a un oyente."
        }
      ],
      "audioText": "We tell a listener some news.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    },
    {
      "id": "en.n3.class-47.t04",
      "en": "Lina told Omar the bus was late.",
      "es": "Lina le dijo a Omar que el bus llegaba tarde.",
      "explanationEs": "Told es el pasado de tell y precede al receptor.",
      "segments": [
        {
          "en": "Lina told Omar",
          "es": "Lina le dijo a Omar"
        },
        {
          "en": "the bus was late.",
          "es": "que el bus llegaba tarde."
        }
      ],
      "audioText": "Lina told Omar the bus was late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    },
    {
      "id": "en.n3.class-47.t05",
      "en": "The listener follows told directly.",
      "es": "El oyente sigue directamente a told.",
      "explanationEs": "Listener hace visible quién recibe el mensaje.",
      "segments": [
        {
          "en": "The listener",
          "es": "El oyente sigue"
        },
        {
          "en": "follows told directly.",
          "es": "directamente a told."
        }
      ],
      "audioText": "The listener follows told directly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    },
    {
      "id": "en.n3.class-47.t06",
      "en": "Use say or said before content without a receiver; use tell or told before a receiver. Tell and told take that listener as their person object. Say and tell are present; said and told are past.",
      "es": "Usa say o said antes del contenido sin receptor; usa tell o told antes de un receptor. Tell y told toman a ese oyente como objeto personal. Say y tell son presente; said y told son pasado.",
      "explanationEs": "El repaso integrado permite recuperar las seis decisiones por receptor y tiempo verbal.",
      "segments": [
        {
          "en": "Use say or said before content without a receiver; use tell or told before a receiver. Tell and",
          "es": "Usa say o said antes del contenido sin receptor; usa tell o told antes de un receptor. Tell"
        },
        {
          "en": "told take that listener as their person object. Say and tell are present; said and told are past.",
          "es": "y told toman a ese oyente como objeto personal. Say y tell son presente; said y told son pasado."
        }
      ],
      "audioText": "Use say or said before content without a receiver; use tell or told before a receiver. Tell and told take that listener as their person object. Say and tell are present; said and told are past.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-reported-messages-2"
    }
  ],
