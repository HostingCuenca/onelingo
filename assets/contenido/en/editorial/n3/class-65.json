      {
        "id": "en.n3.c65.e04",
        "format": "escribir",
        "prompt": {
          "es": "Negocia 90–120: Ana: informe/datos; Luis: diapositivas; viernes imposible; acuerda lunes."
        },
        "answer": {
          "text": "The report is the priority because the client needs the update first. Ana finished the report and will check the data, while Luis prepares the slides. The data file is the blocker and Friday is impossible for all three tasks. Could you tell me when the data can be ready? We agree that Ana owns the report and data, Luis owns the slides, and Monday is the confirmed deadline. Please confirm this new plan and report any remaining blocker. This agreement keeps the client update, the three assignments and the new deadline visible to both people.",
          "accepted": [
            "The report is the priority because the client needs the update first. Ana finished the report and will check the data, while Luis prepares the slides. The data file is the blocker and Friday is impossible for all three tasks. Could you tell me when the data can be ready? We agree that Ana owns the report and data, Luis owns the slides, and Monday is the confirmed deadline. Please confirm this new plan and report any remaining blocker. This agreement keeps the client update, the three assignments and the new deadline visible to both people.",
            "The client update makes the report urgent, so it comes first. Ana will complete the report and data check; Luis will prepare the slides. The data is still blocked, and the Friday deadline cannot cover the three tasks. Could you tell me when the data will be ready? We confirm Ana for the report and data, Luis for the slides, and Monday for the final summary. Please confirm Monday and tell us about any blocker. The recorded plan keeps every responsibility and the changed deadline clear. The team will use this record to follow progress before Monday."
          ]
        },
        "choices": [],
        "teaches": [],
        "requires": [
          "n3-workplace-collaboration-1",
          "n3-workplace-collaboration-2",
          "n3-workplace-collaboration-3",
          "n3-workplace-collaboration-4",
          "n3-workplace-collaboration-5"
        ],
        "origin": {
          "kind": "editorial",
          "feedback": {
            "es": "El escenario negocia prioridad justificada, reparto de tres tareas y nuevo plazo confirmado."
          },
          "scoring": {
