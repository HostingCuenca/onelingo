    {
      "id": "en.n3.class-18.t01",
      "en": "The workshop moved to Thursday, but Room B2 stayed confirmed.",
      "es": "El taller pasó al jueves, pero la sala B2 siguió confirmada.",
      "explanationEs": "Comparar moved y stayed ayuda a detectar qué dato cambia.",
      "segments": [
        {
          "en": "The workshop moved to Thursday,",
          "es": "El taller pasó al jueves,"
        },
        {
          "en": "but Room B2 stayed confirmed.",
          "es": "pero la sala B2 siguió confirmada."
        }
      ],
      "audioText": "The workshop moved to Thursday, but Room B2 stayed confirmed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-future-coordination-3"
    },
    {
      "id": "en.n3.class-18.t02",
      "en": "The new time is four, while Ana is still the host.",
      "es": "La hora nueva es cuatro, mientras Ana sigue siendo la anfitriona.",
      "explanationEs": "Now y still separan actualización y continuidad.",
      "segments": [
        {
          "en": "The new time is four,",
          "es": "La hora nueva es cuatro,"
        },
        {
          "en": "while Ana is still the host.",
          "es": "mientras Ana sigue siendo la anfitriona."
