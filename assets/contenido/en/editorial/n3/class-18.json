    {
      "id": "en.n3.class-18.t03",
      "en": "Read the old schedule before listening to the update.",
      "es": "Lee el horario antiguo antes de escuchar la actualización.",
      "explanationEs": "La comparación necesita un dato original y un mensaje posterior.",
      "segments": [
        {
          "en": "Read the old schedule",
          "es": "Lee el horario antiguo"
        },
        {
          "en": "before listening to the update.",
          "es": "antes de escuchar la actualización."
