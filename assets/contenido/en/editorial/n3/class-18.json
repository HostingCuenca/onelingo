      "languageCode": "en",
      "patternId": "n3-future-coordination-3"
    },
    {
      "id": "en.n3.class-18.t04",
      "en": "A schedule update can change one detail and preserve another.",
      "es": "Una actualización puede cambiar un dato y conservar otro.",
      "explanationEs": "No todos los datos de una agenda cambian juntos.",
      "segments": [
        {
          "en": "A schedule update can change",
          "es": "Una actualización puede cambiar"
        },
        {
          "en": "one detail and preserve another.",
          "es": "un dato y conservar otro."
        }
      ],
      "audioText": "A schedule update can change one detail and preserve another.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-future-coordination-3"
    },
    {
      "id": "en.n3.class-18.t05",
      "en": "The room remains the same after the time changes.",
