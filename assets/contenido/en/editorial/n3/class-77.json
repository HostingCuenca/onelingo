      "languageCode": "en",
      "patternId": "n3-media-reviews-2"
    },
    {
      "id": "en.n3.class-77.t05",
      "en": "Keep the original logical relation when combining ideas.",
      "es": "Conserva la relación lógica original al combinar ideas.",
