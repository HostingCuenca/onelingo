      "patternId": "n3-media-reviews-2"
    },
    {
      "id": "en.n3.class-77.t04",
      "en": "A balanced review can praise one feature and limit another.",
      "es": "Una reseña equilibrada puede elogiar y limitar.",
      "explanationEs": "Contrast prevents an absolute judgement.",
      "segments": [
        {
          "en": "A balanced review can praise",
          "es": "Una reseña equilibrada"
        },
        {
          "en": "one feature and limit another.",
          "es": "puede elogiar y limitar."
        }
