  "teaching": [
    {
      "id": "en.n3.class-72.t01",
      "en": "According to names the source.",
      "es": "According to nombra la fuente.",
      "explanationEs": "Use it before the attributed information.",
      "segments": [
        {
          "en": "According to",
          "es": "According to"
        },
        {
          "en": "names the source.",
          "es": "nombra la fuente."
        }
      ],
      "audioText": "According to names the source.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    },
    {
      "id": "en.n3.class-72.t02",
      "en": "Reported and said attach a claim to a speaker or text.",
      "es": "Reported y said vinculan una afirmación con una fuente.",
      "explanationEs": "The source stays visible.",
      "segments": [
        {
          "en": "Reported and said attach a",
          "es": "Reported y said vinculan"
        },
        {
          "en": "claim to a speaker or text.",
          "es": "una afirmación con una fuente."
        }
      ],
      "audioText": "Reported and said attach a claim to a speaker or text.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    },
    {
      "id": "en.n3.class-72.t03",
      "en": "An uncertain report can use may or might.",
      "es": "Un informe incierto puede usar may o might.",
      "explanationEs": "Do not change a report into certainty.",
      "segments": [
        {
          "en": "An uncertain report can",
          "es": "Un informe incierto puede"
        },
        {
          "en": "use may or might.",
          "es": "usar may o might."
        }
      ],
      "audioText": "An uncertain report can use may or might.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    },
    {
      "id": "en.n3.class-72.t04",
      "en": "A source can be a paper, radio, notice or person.",
      "es": "Una fuente puede ser un periódico, radio, aviso o persona.",
      "explanationEs": "Name who or what supplies the information.",
      "segments": [
        {
          "en": "A source can be a",
          "es": "Una fuente puede ser un"
        },
        {
          "en": "paper, radio, notice or person.",
          "es": "periódico, radio, aviso o persona."
        }
      ],
      "audioText": "A source can be a paper, radio, notice or person.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    },
    {
      "id": "en.n3.class-72.t05",
      "en": "A reported claim shows whose words we use.",
      "es": "Una afirmación reportada muestra de quién son las palabras.",
      "explanationEs": "Said and reported do not prove the claim.",
      "segments": [
        {
          "en": "A reported claim shows",
          "es": "Una afirmación reportada muestra"
        },
        {
          "en": "whose words we use.",
          "es": "de quién son las palabras."
        }
      ],
      "audioText": "A reported claim shows whose words we use.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    },
    {
      "id": "en.n3.class-72.t06",
      "en": "According to the notice, the paper reported a delay, and the nurse said the clinic was busy.",
      "es": "Según el aviso, el periódico informó un retraso y la enfermera dijo que la clínica estaba llena.",
      "explanationEs": "This model combines named sources, reporting verbs and cautious meaning.",
      "segments": [
        {
          "en": "According to the notice, the paper reported a",
          "es": "Según el aviso, el periódico informó un retraso"
        },
        {
          "en": "delay, and the nurse said the clinic was busy.",
          "es": "y la enfermera dijo que la clínica estaba llena."
        }
      ],
      "audioText": "According to the notice, the paper reported a delay, and the nurse said the clinic was busy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-2"
    }
