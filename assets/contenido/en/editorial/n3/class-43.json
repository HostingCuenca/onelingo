  "teaching": [
    {
      "id": "en.n3.class-43.t01",
      "en": "A service request moves through ordered stages.",
      "es": "Una solicitud de servicio avanza por etapas ordenadas.",
      "explanationEs": "El registro permite reconstruir la secuencia.",
      "segments": [
        {
          "en": "A service request",
          "es": "Una solicitud de servicio"
        },
        {
          "en": "moves through ordered stages.",
          "es": "avanza por etapas ordenadas."
        }
      ],
      "audioText": "A service request moves through ordered stages.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    },
    {
      "id": "en.n3.class-43.t02",
      "en": "Reception records that the request was received.",
      "es": "La recepción registra que la solicitud fue recibida.",
      "explanationEs": "Es la primera etapa.",
      "segments": [
        {
          "en": "Reception records that",
          "es": "La recepción registra que"
        },
        {
          "en": "the request was received.",
          "es": "la solicitud fue recibida."
        }
      ],
      "audioText": "Reception records that the request was received.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    },
    {
      "id": "en.n3.class-43.t03",
      "en": "Review checks the item before repair.",
      "es": "La revisión comprueba el objeto antes de repararlo.",
      "explanationEs": "La reparación depende de la revisión.",
      "segments": [
        {
          "en": "Review checks the",
          "es": "La revisión comprueba el"
        },
        {
          "en": "item before repair.",
          "es": "objeto antes de repararlo."
        }
      ],
      "audioText": "Review checks the item before repair.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    },
    {
      "id": "en.n3.class-43.t04",
      "en": "The current stage tells what is happening now.",
      "es": "El estado actual indica qué ocurre ahora.",
      "explanationEs": "Now, currently y pending ayudan a localizarlo.",
      "segments": [
        {
          "en": "The current stage tells",
          "es": "El estado actual"
        },
        {
          "en": "what is happening now.",
          "es": "indica qué ocurre ahora."
        }
      ],
      "audioText": "The current stage tells what is happening now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    },
    {
      "id": "en.n3.class-43.t05",
      "en": "The closing date tells when confirmation is completed.",
      "es": "La fecha de cierre indica cuándo termina la confirmación.",
      "explanationEs": "No la confundas con la recepción.",
      "segments": [
        {
          "en": "The closing date tells",
          "es": "La fecha de cierre"
        },
        {
          "en": "when confirmation is completed.",
          "es": "indica cuándo termina la confirmación."
        }
      ],
      "audioText": "The closing date tells when confirmation is completed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    },
    {
      "id": "en.n3.class-43.t06",
      "en": "Read one notice, order reception, review, repair and confirmation, then report the current status and closing date. Keep every date attached to its stated stage.",
      "es": "Ordena cuatro etapas y comunica el estado actual y la fecha de cierre.",
      "explanationEs": "La tarea integrada evita inventar etapas o mover fechas entre acciones.",
      "segments": [
        {
          "en": "Read one notice, order reception, review, repair and confirmation, then report the",
          "es": "Ordena cuatro etapas y comunica el"
        },
        {
          "en": "current status and closing date. Keep every date attached to its stated stage.",
          "es": "estado actual y la fecha de cierre."
        }
      ],
      "audioText": "Read one notice, order reception, review, repair and confirmation, then report the current status and closing date. Keep every date attached to its stated stage.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-3"
    }
  ],
