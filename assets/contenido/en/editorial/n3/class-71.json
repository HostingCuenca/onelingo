  "teaching": [
    {
      "id": "en.n3.class-71.t01",
      "en": "A headline is a short title.",
      "es": "Un titular es un título breve.",
      "explanationEs": "A headline names the news in few words.",
      "segments": [
        {
          "en": "A headline is",
          "es": "Un titular es"
        },
        {
          "en": "a short title.",
          "es": "un título breve."
        }
      ],
      "audioText": "A headline is a short title.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-1"
    },
    {
      "id": "en.n3.class-71.t02",
      "en": "A detail is a complete confirmed statement.",
      "es": "Un detalle es una afirmación completa confirmada.",
      "explanationEs": "The detail says exactly what the text confirms.",
      "segments": [
        {
          "en": "A detail is",
          "es": "Un detalle es"
        },
        {
          "en": "a complete confirmed statement.",
          "es": "una afirmación completa confirmada."
        }
      ],
      "audioText": "A detail is a complete confirmed statement.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-1"
    },
    {
      "id": "en.n3.class-71.t03",
      "en": "A report separates title and detail.",
      "es": "Un informe separa título y detalle.",
      "explanationEs": "Read the title first, then check its full lead.",
      "segments": [
        {
          "en": "A report separates",
          "es": "Un informe separa"
        },
        {
          "en": "title and detail.",
          "es": "título y detalle."
        }
      ],
      "audioText": "A report separates title and detail.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-1"
    },
    {
      "id": "en.n3.class-71.t04",
      "en": "A date or number can make a detail exact.",
      "es": "Una fecha o número puede hacer exacto un detalle.",
      "explanationEs": "Specific information is easier to verify.",
      "segments": [
        {
          "en": "A date or number",
          "es": "Una fecha o número"
        },
        {
          "en": "can make a detail exact.",
          "es": "puede hacer exacto un detalle."
        }
      ],
      "audioText": "A date or number can make a detail exact.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-1"
    },
    {
      "id": "en.n3.class-71.t05",
      "en": "Do not turn an opinion into a confirmed detail.",
      "es": "No conviertas una opinión en detalle confirmado.",
      "explanationEs": "Only use information stated by the news text.",
      "segments": [
        {
          "en": "Do not turn an",
          "es": "No conviertas una"
        },
        {
          "en": "opinion into a confirmed detail.",
          "es": "opinión en detalle confirmado."
        }
      ],
      "audioText": "Do not turn an opinion into a confirmed detail.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-1"
    },
    {
