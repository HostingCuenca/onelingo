  "teaching": [
    {
      "id": "en.n3.class-82.t01",
      "en": "A strategy is an action; its purpose is the result you want.",
      "es": "Una estrategia es una acción; su propósito es el resultado que deseas.",
      "explanationEs": "Explica qué haces y para qué lo haces.",
      "segments": [
        "A strategy is an action; ",
        "its purpose is the result you want."
      ],
      "audioText": "A strategy is an action; its purpose is the result you want.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    },
    {
      "id": "en.n3.class-82.t02",
      "en": "I review my notes to remember key ideas.",
      "es": "Repaso mis apuntes para recordar las ideas principales.",
      "explanationEs": "Después de to usa un verbo en forma base.",
      "segments": [
        "I review my notes to ",
        "remember key ideas."
      ],
      "audioText": "I review my notes to remember key ideas.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    },
    {
      "id": "en.n3.class-82.t03",
      "en": "I record my voice so that I can notice mistakes.",
      "es": "Grabo mi voz para poder notar errores.",
      "explanationEs": "So that introduce sujeto y verbo: I can notice.",
      "segments": [
        "I record my voice so that ",
        "I can notice mistakes."
      ],
      "audioText": "I record my voice so that I can notice mistakes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    },
    {
      "id": "en.n3.class-82.t04",
      "en": "I practise with a partner to build confidence.",
      "es": "Practico con un compañero para ganar confianza.",
      "explanationEs": "La acción debe servir al propósito indicado.",
      "segments": [
        "I practise with a partner to ",
        "build confidence."
      ],
      "audioText": "I practise with a partner to build confidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    },
    {
      "id": "en.n3.class-82.t05",
      "en": "I use large cards so that I can read the words easily.",
      "es": "Uso tarjetas grandes para poder leer las palabras fácilmente.",
      "explanationEs": "No pongas un sujeto justo después de to: usa so that.",
      "segments": [
        "I use large cards so that ",
        "I can read the words easily."
      ],
      "audioText": "I use large cards so that I can read the words easily.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    },
    {
      "id": "en.n3.class-82.t06",
      "en": "I test myself to find gaps, and I check the answers so that I can correct them.",
      "es": "Me pongo a prueba para encontrar lagunas y reviso las respuestas para poder corregirlas.",
      "explanationEs": "Ambas estructuras conectan una estrategia con su finalidad.",
      "segments": [
        "I test myself to find gaps, and I check the answers so that ",
        "I can correct them."
      ],
      "audioText": "I test myself to find gaps, and I check the answers so that I can correct them.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-learning-strategies-2"
    }
