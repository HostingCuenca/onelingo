        {
          "en": "According to and",
          "es": "According to y"
        },
        {
          "en": "reported identify the source.",
          "es": "reported identifican la fuente."
        }
      ],
      "audioText": "According to and reported identify the source.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-4"
    },
    {
      "id": "en.n3.class-74.t03",
      "en": "A factual summary includes three important details.",
      "es": "Un resumen factual incluye tres detalles importantes.",
      "explanationEs": "Select the three stated facts.",
      "segments": [
        {
          "en": "A factual summary",
          "es": "Un resumen factual"
        },
        {
          "en": "includes three important details.",
          "es": "incluye tres detalles importantes."
        }
      ],
      "audioText": "A factual summary includes three important details.",
