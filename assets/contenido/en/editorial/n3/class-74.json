      "patternId": "n3-news-sources-4"
    },
    {
      "id": "en.n3.class-74.t05",
      "en": "A time, number or place can preserve exact detail.",
      "es": "Una hora, número o lugar puede conservar un detalle exacto.",
      "explanationEs": "Keep concrete evidence in your words.",
      "segments": [
