  "teaching": [
    {
      "id": "en.n3.class-74.t01",
      "en": "A source card gives the facts you may summarize.",
      "es": "Una ficha de fuente da los hechos que puedes resumir.",
      "explanationEs": "Use only visible information.",
      "segments": [
        {
          "en": "A source card gives",
          "es": "Una ficha de fuente da"
        },
        {
          "en": "the facts you may summarize.",
          "es": "los hechos que puedes resumir."
        }
      ],
      "audioText": "A source card gives the facts you may summarize.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-4"
    },
    {
      "id": "en.n3.class-74.t02",
      "en": "According to and reported identify the source.",
      "es": "According to y reported identifican la fuente.",
      "explanationEs": "Keep attribution in the summary.",
