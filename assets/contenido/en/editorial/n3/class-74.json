      "languageCode": "en",
      "patternId": "n3-news-sources-4"
    },
    {
      "id": "en.n3.class-74.t04",
      "en": "Do not add a cause that the card does not confirm.",
      "es": "No añadas una causa que la ficha no confirma.",
      "explanationEs": "Absence of a reason is meaningful.",
      "segments": [
        {
          "en": "Do not add a cause",
