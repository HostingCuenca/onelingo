  "teaching": [
    {
      "id": "en.n3.class-37.t01",
      "en": "A thing can use which in an essential definition.",
      "es": "Una cosa puede usar which en una definición esencial.",
      "explanationEs": "Which introduce la función del objeto.",
      "segments": [
        {
          "en": "A thing can use",
          "es": "Una cosa puede usar"
        },
        {
          "en": "which in an essential definition.",
          "es": "which en una definición esencial."
        }
      ],
      "audioText": "A thing can use which in an essential definition.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    },
    {
      "id": "en.n3.class-37.t02",
      "en": "An object can also use that.",
      "es": "Un objeto también puede usar that.",
      "explanationEs": "That y which son posibles con cosas en este contexto.",
      "segments": [
        {
          "en": "An object can",
          "es": "Un objeto también"
        },
        {
          "en": "also use that.",
          "es": "puede usar that."
        }
      ],
      "audioText": "An object can also use that.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    },
    {
      "id": "en.n3.class-37.t03",
      "en": "Use that without a comma in these definitions.",
      "es": "Usa that sin coma en estas definiciones.",
      "explanationEs": "La información es necesaria para identificar el antecedente.",
      "segments": [
        {
          "en": "Use that without a",
          "es": "Usa that sin"
        },
        {
          "en": "comma in these definitions.",
          "es": "coma en estas definiciones."
        }
      ],
      "audioText": "Use that without a comma in these definitions.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    },
    {
      "id": "en.n3.class-37.t04",
      "en": "A place uses where before an activity.",
      "es": "Un lugar usa where antes de una actividad.",
      "explanationEs": "Where equivale a in/at which en estas definiciones.",
      "segments": [
        {
          "en": "A place uses",
          "es": "Un lugar usa where"
        },
        {
          "en": "where before an activity.",
          "es": "antes de una actividad."
        }
      ],
      "audioText": "A place uses where before an activity.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    },
    {
      "id": "en.n3.class-37.t05",
      "en": "Which or that must agree with a thing, not a person.",
      "es": "Which o that deben referirse a una cosa, no a una persona.",
      "explanationEs": "Primero identifica el tipo de antecedente.",
      "segments": [
        {
          "en": "Which or that must agree",
          "es": "Which o that deben referirse a"
        },
        {
          "en": "with a thing, not a person.",
          "es": "una cosa, no a una persona."
        }
      ],
      "audioText": "Which or that must agree with a thing, not a person.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    },
    {
      "id": "en.n3.class-37.t06",
      "en": "For six items, label each antecedent as object or place before completing.",
      "es": "En seis ítems, etiqueta cada antecedente como objeto o lugar antes de completar.",
      "explanationEs": "La etiqueta hace inequívoca la selección del relativo.",
      "segments": [
        {
          "en": "For six items, label each antecedent",
          "es": "En seis ítems, etiqueta cada antecedente"
        },
        {
          "en": "as object or place before completing.",
          "es": "como objeto o lugar antes de completar."
        }
      ],
      "audioText": "For six items, label each antecedent as object or place before completing.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-defining-information-2"
    }
