  "teaching": [
    {
      "id": "en.n3.class-93.t01",
      "en": "Sara will support the garden because families need a quiet place.",
      "es": "Sara apoyará el jardín porque las familias necesitan un lugar tranquilo.",
      "explanationEs": "Support + nombre: apoyar una idea. Because da la razón.",
      "segments": [
        "Sara will support the garden because",
        "families need a quiet place."
      ],
      "audioText": "Sara will support the garden because families need a quiet place.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-community-project-3"
    },
    {
      "id": "en.n3.class-93.t02",
      "en": "Carlos will agree, but only if the council has a safety plan; that is his condition.",
      "es": "Carlos estará de acuerdo, pero solo si el ayuntamiento tiene un plan de seguridad: esa es su condición.",
      "explanationEs": "Only if marca una condición necesaria; después va presente.",
      "segments": [
        "Carlos will agree, but only if the council",
        "has a safety plan; that is his condition."
      ],
      "audioText": "Carlos will agree, but only if the council has a safety plan; that is his condition.",
