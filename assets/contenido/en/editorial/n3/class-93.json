      "languageCode": "en",
      "patternId": "n3-community-project-3"
    },
    {
      "id": "en.n3.class-93.t04",
      "en": "Tom will support the garden as long as it closes at six.",
      "es": "Tom apoyará el jardín con tal de que cierre a las seis.",
      "explanationEs": "As long as + presente: condición. No se usa will después.",
      "segments": [
