  "teaching": [
    {
      "id": "en.n3.class-41.t01",
      "en": "A process describes how a result is produced.",
      "es": "Un proceso describe cómo se produce un resultado.",
      "explanationEs": "La pasiva centra el elemento afectado.",
      "segments": [
        {
          "en": "A process describes how",
          "es": "Un proceso describe cómo"
        },
        {
          "en": "a result is produced.",
          "es": "se produce un resultado."
        }
      ],
      "audioText": "A process describes how a result is produced.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-1"
    },
    {
      "id": "en.n3.class-41.t02",
      "en": "The result comes before the passive verb.",
      "es": "El resultado aparece antes del verbo pasivo.",
      "explanationEs": "Ese sujeto recibe la acción.",
      "segments": [
        {
          "en": "The result comes",
          "es": "El resultado aparece"
        },
        {
          "en": "before the passive verb.",
          "es": "antes del verbo pasivo."
        }
      ],
      "audioText": "The result comes before the passive verb.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-1"
    },
    {
      "id": "en.n3.class-41.t03",
      "en": "Present passive in a process uses am, is or are plus a participle.",
      "es": "La pasiva presente usa am, is o are más participio.",
      "explanationEs": "La forma de be concuerda con el sujeto.",
      "segments": [
        {
          "en": "Present passive in a process uses",
          "es": "La pasiva presente usa am,"
        },
        {
          "en": "am, is or are plus a participle.",
          "es": "is o are más participio."
        }
      ],
      "audioText": "Present passive in a process uses am, is or are plus a participle.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-processes-services-1"
    },
    {
      "id": "en.n3.class-41.t04",
      "en": "The agent can be omitted when it is unknown or unimportant.",
      "es": "El agente puede omitirse cuando no se conoce o no importa.",
      "explanationEs": "By introduce al agente solo si es útil.",
