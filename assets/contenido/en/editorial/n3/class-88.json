  "teaching": [
    {
      "id": "en.n3.class-88.t01",
      "en": "A proposal names one local problem and one measure.",
      "es": "Una propuesta nombra un problema y una medida.",
      "explanationEs": "Keep problem and solution separate.",
      "segments": [
        {
          "en": "A proposal names one",
          "es": "Una propuesta nombra un"
        },
        {
          "en": "local problem and one measure.",
          "es": "problema y una medida."
        }
      ],
      "audioText": "A proposal names one local problem and one measure.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-3"
    },
    {
      "id": "en.n3.class-88.t02",
      "en": "The cost includes an amount and funding source.",
      "es": "El coste incluye monto y fuente de fondos.",
      "explanationEs": "Do not omit who pays.",
      "segments": [
        {
          "en": "The cost includes an",
          "es": "El coste incluye monto"
        },
        {
          "en": "amount and funding source.",
          "es": "y fuente de fondos."
        }
      ],
      "audioText": "The cost includes an amount and funding source.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-3"
    },
    {
      "id": "en.n3.class-88.t03",
      "en": "A benefit is expected, not guaranteed.",
      "es": "Un beneficio se espera, no se garantiza.",
      "explanationEs": "Use cautious language.",
      "segments": [
        {
          "en": "A benefit is",
          "es": "Un beneficio se"
        },
        {
          "en": "expected, not guaranteed.",
          "es": "espera, no se garantiza."
        }
      ],
      "audioText": "A benefit is expected, not guaranteed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-3"
    },
    {
      "id": "en.n3.class-88.t04",
      "en": "Each resident may support or question a different part.",
      "es": "Cada residente puede apoyar o cuestionar una parte distinta.",
      "explanationEs": "Attribute each view correctly.",
      "segments": [
        {
          "en": "Each resident may support",
          "es": "Cada residente puede apoyar"
        },
        {
          "en": "or question a different part.",
          "es": "o cuestionar una parte distinta."
        }
      ],
      "audioText": "Each resident may support or question a different part.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-3"
    },
    {
      "id": "en.n3.class-88.t05",
      "en": "An indicator shows whether the measure changes the problem.",
      "es": "Un indicador muestra si la medida cambia el problema.",
      "explanationEs": "Counts over time support follow-up.",
      "segments": [
        {
          "en": "An indicator shows whether",
          "es": "Un indicador muestra si"
        },
        {
          "en": "the measure changes the problem.",
          "es": "la medida cambia el problema."
        }
      ],
      "audioText": "An indicator shows whether the measure changes the problem.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-3"
    },
    {
      "id": "en.n3.class-88.t06",
      "en": "Problem: single-use bottles near the playground. Measure: two refill stations. Cost: £1,800 from the park fund. Expected benefit: fewer bottles. Bo’s concern: evening maintenance noise.",
