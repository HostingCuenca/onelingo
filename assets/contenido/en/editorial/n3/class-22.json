    },
    {
      "id": "en.n3.class-22.t05",
      "en": "Unless we call, reception will release our late booking.",
      "es": "Si no llamamos, recepción liberará nuestra reserva tardía.",
      "explanationEs": "La excepción conserva presente tras unless y will en el resultado.",
      "segments": [
