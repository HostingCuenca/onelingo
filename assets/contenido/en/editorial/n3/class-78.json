  "teaching": [
    {
      "id": "en.n3.class-78.t01",
      "en": "A stance shows whether the reviewer recommends the work.",
      "es": "Una postura muestra si el reseñador recomienda la obra.",
      "explanationEs": "Look for recommend, suggest or would not choose.",
      "segments": [
        {
          "en": "A stance shows whether",
          "es": "Una postura muestra si"
        },
        {
          "en": "the reviewer recommends the work.",
          "es": "el reseñador recomienda la obra."
        }
      ],
      "audioText": "A stance shows whether the reviewer recommends the work.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-media-reviews-3"
    },
    {
      "id": "en.n3.class-78.t02",
      "en": "A reason names a specific feature as evidence.",
      "es": "Una razón nombra un rasgo específico como evidencia.",
      "explanationEs": "Plot, acting or dialogue can support a stance.",
      "segments": [
        {
          "en": "A reason names a",
          "es": "Una razón nombra un"
        },
        {
          "en": "specific feature as evidence.",
          "es": "rasgo específico como evidencia."
        }
      ],
      "audioText": "A reason names a specific feature as evidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-media-reviews-3"
    },
    {
      "id": "en.n3.class-78.t03",
      "en": "However often introduces a reservation.",
      "es": "However suele introducir una reserva.",
      "explanationEs": "The reservation limits the praise.",
      "segments": [
        {
          "en": "However often",
          "es": "However suele"
        },
        {
          "en": "introduces a reservation.",
          "es": "introducir una reserva."
        }
      ],
      "audioText": "However often introduces a reservation.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-media-reviews-3"
    },
    {
      "id": "en.n3.class-78.t04",
      "en": "A possible audience can limit a negative review.",
      "es": "Una audiencia posible puede limitar una reseña negativa.",
      "explanationEs": "May suit identifies who could still enjoy it.",
      "segments": [
        {
          "en": "A possible audience can",
          "es": "Una audiencia posible puede"
        },
        {
          "en": "limit a negative review.",
          "es": "limitar una reseña negativa."
        }
      ],
      "audioText": "A possible audience can limit a negative review.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-media-reviews-3"
    },
    {
      "id": "en.n3.class-78.t05",
      "en": "Use words from the review to justify an inference.",
      "es": "Usa palabras de la reseña para justificar una inferencia.",
      "explanationEs": "Do not guess a reason not present in the text.",
      "segments": [
        {
          "en": "Use words from the",
          "es": "Usa palabras de la"
        },
        {
          "en": "review to justify an inference.",
