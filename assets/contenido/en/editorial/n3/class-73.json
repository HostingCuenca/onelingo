  "teaching": [
    {
      "id": "en.n3.class-73.t01",
      "en": "A fact has a confirmed or recorded marker.",
      "es": "Un hecho tiene un marcador confirmado o registrado.",
      "explanationEs": "Confirmed and shows point to evidence.",
      "segments": [
        {
          "en": "A fact has a",
          "es": "Un hecho tiene un"
        },
        {
          "en": "confirmed or recorded marker.",
          "es": "marcador confirmado o registrado."
        }
      ],
      "audioText": "A fact has a confirmed or recorded marker.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    },
    {
      "id": "en.n3.class-73.t02",
      "en": "An opinion reports a person’s view.",
      "es": "Una opinión informa la perspectiva de alguien.",
      "explanationEs": "Thinks and believes identify a viewpoint.",
      "segments": [
        {
          "en": "An opinion reports",
          "es": "Una opinión informa"
        },
        {
          "en": "a person’s view.",
          "es": "la perspectiva de alguien."
        }
      ],
      "audioText": "An opinion reports a person’s view.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    },
    {
      "id": "en.n3.class-73.t03",
      "en": "May marks uncertainty.",
      "es": "May marca incertidumbre.",
      "explanationEs": "It leaves the future or result open.",
      "segments": [
        {
          "en": "May",
          "es": "May"
        },
        {
          "en": "marks uncertainty.",
          "es": "marca incertidumbre."
        }
      ],
      "audioText": "May marks uncertainty.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    },
    {
      "id": "en.n3.class-73.t04",
      "en": "Use the exact marker word from the note as evidence.",
      "es": "Usa la palabra exacta del marcador como evidencia.",
      "explanationEs": "A classification needs a visible marker.",
      "segments": [
        {
          "en": "Use the exact marker word",
          "es": "Usa la palabra exacta"
        },
        {
          "en": "from the note as evidence.",
          "es": "del marcador como evidencia."
        }
      ],
      "audioText": "Use the exact marker word from the note as evidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    },
    {
      "id": "en.n3.class-73.t05",
      "en": "A recorded fact is not the same as a guess.",
      "es": "Un hecho registrado no es igual que una conjetura.",
      "explanationEs": "Separate evidence from what someone believes.",
      "segments": [
        {
          "en": "A recorded fact is not",
          "es": "Un hecho registrado no"
        },
        {
          "en": "the same as a guess.",
          "es": "es igual que una conjetura."
        }
      ],
      "audioText": "A recorded fact is not the same as a guess.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    },
    {
      "id": "en.n3.class-73.t06",
      "en": "Confirmed fact, personal opinion and possible event use different markers.",
      "es": "Hecho confirmado, opinión personal y evento posible usan marcadores distintos.",
      "explanationEs": "Classify the claim and quote its marker.",
      "segments": [
        {
          "en": "Confirmed fact, personal opinion and",
          "es": "Hecho confirmado, opinión personal y"
        },
        {
          "en": "possible event use different markers.",
          "es": "evento posible usan marcadores distintos."
        }
      ],
      "audioText": "Confirmed fact, personal opinion and possible event use different markers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-news-sources-3"
    }
  ],
