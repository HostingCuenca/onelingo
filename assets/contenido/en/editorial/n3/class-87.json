  "teaching": [
    {
      "id": "en.n3.class-87.t01",
      "en": "A passive process focuses on the measure.",
      "es": "Un proceso pasivo enfoca la medida.",
      "explanationEs": "Use is or are plus a past participle.",
      "segments": [
        {
          "en": "A passive process",
          "es": "Un proceso pasivo"
        },
        {
          "en": "focuses on the measure.",
          "es": "enfoca la medida."
        }
      ],
      "audioText": "A passive process focuses on the measure.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-2"
    },
    {
      "id": "en.n3.class-87.t02",
      "en": "If introduces a real condition.",
      "es": "If introduce una condición real.",
      "explanationEs": "The measure must happen before the result can be checked.",
      "segments": [
        {
          "en": "If introduces",
          "es": "If introduce"
        },
        {
          "en": "a real condition.",
          "es": "una condición real."
        }
      ],
      "audioText": "If introduces a real condition.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-2"
    },
    {
      "id": "en.n3.class-87.t03",
      "en": "May gives a limited expected effect.",
      "es": "May expresa un efecto esperado limitado.",
      "explanationEs": "Avoid guaranteeing a result.",
      "segments": [
        {
          "en": "May gives a",
          "es": "May expresa un"
        },
        {
          "en": "limited expected effect.",
          "es": "efecto esperado limitado."
        }
      ],
      "audioText": "May gives a limited expected effect.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-2"
    },
    {
      "id": "en.n3.class-87.t04",
      "en": "In a passive process, singular subjects take is; plural subjects take are.",
      "es": "En un proceso pasivo, sujetos singulares usan is; plurales usan are.",
      "explanationEs": "Check agreement before the participle.",
      "segments": [
        {
          "en": "In a passive process, singular subjects",
          "es": "En un proceso pasivo, sujetos"
        },
        {
          "en": "take is; plural subjects take are.",
          "es": "singulares usan is; plurales usan are."
        }
      ],
      "audioText": "In a passive process, singular subjects take is; plural subjects take are.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-2"
    },
    {
      "id": "en.n3.class-87.t05",
      "en": "A proposal needs process, condition and limited result.",
      "es": "Una propuesta necesita proceso, condición y resultado limitado.",
      "explanationEs": "All three parts make the claim responsible.",
      "segments": [
        {
          "en": "A proposal needs process,",
          "es": "Una propuesta necesita proceso,"
        },
        {
          "en": "condition and limited result.",
          "es": "condición y resultado limitado."
        }
      ],
      "audioText": "A proposal needs process, condition and limited result.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n3-local-environment-2"
    },
    {
      "id": "en.n3.class-87.t06",
      "en": "If leaks are repaired, water use may fall; the process is passive and the result remains limited.",
      "es": "Si se reparan fugas, puede bajar el consumo; el proceso es pasivo y el resultado limitado.",
