  "teaching": [
    {
      "id": "en.n9.class-52.t01",
      "en": "We recommend that the council approve the budget this month.",
      "es": "Recomendamos que el consejo apruebe el presupuesto este mes.",
      "explanationEs": "Recommend that + sujeto + verbo base: approve, sin -s aunque el sujeto sea singular.",
      "segments": [
        "We recommend that the council",
        "approve the budget this month."
      ],
      "audioText": "We recommend that the council approve the budget this month.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    },
    {
      "id": "en.n9.class-52.t02",
      "en": "Mia and I suggest postponing the concert until the weather improves.",
      "es": "Mia y yo sugerimos aplazar el concierto hasta que mejore el tiempo.",
      "explanationEs": "Suggest + -ing cuando no hace falta nombrar quién lo hará.",
      "segments": [
        "Mia and I suggest postponing the",
        "concert until the weather improves."
      ],
      "audioText": "Mia and I suggest postponing the concert until the weather improves.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    },
    {
      "id": "en.n9.class-52.t03",
      "en": "I suggest that the organisers check the stage twice.",
      "es": "Sugiero que los organizadores revisen el escenario dos veces.",
      "explanationEs": "Suggest that + sujeto + verbo base. No existe «suggest to do».",
      "segments": [
        "I suggest that the organisers",
        "check the stage twice."
      ],
      "audioText": "I suggest that the organisers check the stage twice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    },
    {
      "id": "en.n9.class-52.t04",
      "en": "We propose that the gates open at noon.",
      "es": "Proponemos que las puertas abran al mediodía.",
      "explanationEs": "Propose funciona igual: propose that + base o propose + -ing.",
      "segments": [
        "We propose that the",
        "gates open at noon."
      ],
      "audioText": "We propose that the gates open at noon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    },
    {
      "id": "en.n9.class-52.t05",
      "en": "We insist that every volunteer wear a badge.",
      "es": "Insistimos en que cada voluntario lleve una identificación.",
      "explanationEs": "Insist that + verbo base: wear, no wears.",
      "segments": [
        "We insist that every",
        "volunteer wear a badge."
      ],
      "audioText": "We insist that every volunteer wear a badge.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    },
    {
      "id": "en.n9.class-52.t06",
      "en": "It is essential that the stage be ready by Friday.",
      "es": "Es imprescindible que el escenario esté listo el viernes.",
      "explanationEs": "It is essential that + base form: be, no is.",
      "segments": [
        "It is essential that the",
        "stage be ready by Friday."
      ],
      "audioText": "It is essential that the stage be ready by Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-2"
    }
  ],
