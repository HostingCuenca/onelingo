      "languageCode": "en",
      "patternId": "n9-tone-register-2"
    },
    {
      "id": "en.n9.class-17.t02",
      "en": "I will look into the complaint and get back to you by Friday.",
      "es": "Miraré la queja y te contestaré antes del viernes.",
      "explanationEs": "Look into y get back to son phrasal verbs: suenan más naturales y cercanos.",
