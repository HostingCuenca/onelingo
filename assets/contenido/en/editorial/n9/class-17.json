      "languageCode": "en",
      "patternId": "n9-tone-register-2"
    },
    {
      "id": "en.n9.class-17.t05",
      "en": "The phrase «return back» is redundant, because return already means go back.",
      "es": "La expresión «return back» es redundante, porque return ya significa volver.",
      "explanationEs": "Redundante: back no añade nada, así que se quita.",
      "segments": [
