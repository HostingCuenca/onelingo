    {
      "id": "en.n9.class-17.t04",
      "en": "If you need assistance, please contact our team.",
      "es": "Si necesita asistencia, por favor contacte con nuestro equipo.",
      "explanationEs": "Assistance es más formal que help; se ve en avisos y mensajes de empresa.",
