    },
    {
      "id": "en.n9.class-17.t03",
      "en": "Guests may purchase drinks at the bar.",
      "es": "Los invitados pueden comprar bebidas en la barra.",
      "explanationEs": "Purchase es la versión formal de buy; en el habla diaria solemos decir buy.",
