    },
    {
      "id": "en.n9.class-76.t05",
      "en": "The garden project is on the back burner until spring.",
      "es": "El proyecto del jardín queda en pausa hasta la primavera.",
      "explanationEs": "On the back burner: como una olla en el fondo de la cocina, no se atiende por ahora.",
      "segments": [
        "The garden project is on",
        "the back burner until spring."
      ],
      "audioText": "The garden project is on the back burner until spring.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-idioms-everyday-1"
    },
    {
      "id": "en.n9.class-76.t06",
      "en": "Don't worry about the exam; it will be a piece of cake.",
      "es": "No te preocupes por el examen; será pan comido.",
      "explanationEs": "A piece of cake: algo muy fácil. Idiom: su sentido no se deduce palabra por palabra.",
