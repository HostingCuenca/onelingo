    },
    {
      "id": "en.n9.class-76.t02",
      "en": "The client changed the plan, so we are back to square one.",
      "es": "El cliente cambió el plan, así que volvemos a empezar de cero.",
      "explanationEs": "Back to square one viene de los juegos de mesa: hay que volver a la casilla inicial.",
      "segments": [
        "The client changed the plan, so",
        "we are back to square one."
      ],
      "audioText": "The client changed the plan, so we are back to square one.",
