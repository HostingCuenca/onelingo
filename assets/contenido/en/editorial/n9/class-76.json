    },
    {
      "id": "en.n9.class-76.t03",
      "en": "I have sent my offer; now the ball is in your court.",
      "es": "He enviado mi oferta; ahora te toca a ti decidir.",
      "explanationEs": "The ball is in your court viene del tenis: la siguiente jugada es de la otra persona.",
      "segments": [
        "I have sent my offer; now",
        "the ball is in your court."
      ],
      "audioText": "I have sent my offer; now the ball is in your court.",
