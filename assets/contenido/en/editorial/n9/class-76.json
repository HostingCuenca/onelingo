  "teaching": [
    {
      "id": "en.n9.class-76.t01",
      "en": "Before we start, let's check that we are all on the same page.",
      "es": "Antes de empezar, comprobemos que todos estamos en la misma página.",
      "explanationEs": "On the same page: todos tienen la misma información y están de acuerdo.",
