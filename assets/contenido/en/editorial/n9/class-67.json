  "teaching": [
    {
      "id": "en.n9.class-67.t01",
      "en": "What would it take to reach your goal this month?",
      "es": "¿Qué haría falta para alcanzar tu meta este mes?",
      "explanationEs": "What would it take to + verbo: pregunta abierta sobre lo necesario.",
