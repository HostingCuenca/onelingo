      "languageCode": "en",
      "patternId": "n9-risk-probability-3"
    },
    {
      "id": "en.n9.class-43.t02",
      "en": "Visibility will drop sharply in cloud after noon.",
      "es": "La visibilidad caerá bruscamente entre nubes después del mediodía.",
      "explanationEs": "Will drop: previsto casi con seguridad. Sharply indica que el cambio será rápido.",
      "segments": [
        "Visibility will drop sharply",
        "in cloud after noon."
      ],
