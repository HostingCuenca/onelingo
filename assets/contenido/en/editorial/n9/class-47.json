  "teaching": [
    {
      "id": "en.n9.class-47.t01",
      "en": "Borrowers shall return all loans within three weeks.",
      "es": "Los usuarios devolverán todos los préstamos en un plazo de tres semanas.",
      "explanationEs": "Shall en un reglamento = obligación formal («deberán»); no es el shall de ofrecimiento (Shall I help?).",
      "segments": [
        "Borrowers shall return all",
        "loans within three weeks."
      ],
      "audioText": "Borrowers shall return all loans within three weeks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-2"
    },
    {
      "id": "en.n9.class-47.t02",
      "en": "Membership cards may not be lent to another person.",
      "es": "Las tarjetas de socio no podrán prestarse a otra persona.",
      "explanationEs": "May not + be + participio: prohibición formal en pasiva; no se nombra a quien obedece.",
      "segments": [
        "Membership cards may not be",
        "lent to another person."
      ],
      "audioText": "Membership cards may not be lent to another person.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-2"
    },
    {
      "id": "en.n9.class-47.t03",
      "en": "Overdue items are to be returned before the library closes.",
      "es": "Los artículos con retraso se devolverán antes de que cierre la biblioteca.",
      "explanationEs": "Is/are to be + participio: orden oficial e impersonal.",
      "segments": [
        "Overdue items are to be",
        "returned before the library closes."
      ],
      "audioText": "Overdue items are to be returned before the library closes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-2"
    },
    {
      "id": "en.n9.class-47.t04",
      "en": "Damaged books must be reported to the staff.",
      "es": "Los libros dañados deberán comunicarse al personal.",
      "explanationEs": "Must be + participio: obligación en pasiva; el libro es el sujeto.",
      "segments": [
        "Damaged books must be",
        "reported to the staff."
      ],
      "audioText": "Damaged books must be reported to the staff.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-2"
    },
    {
      "id": "en.n9.class-47.t05",
      "en": "Loans may be renewed once, provided that nobody has reserved the book.",
      "es": "Los préstamos podrán renovarse una vez, siempre que nadie haya reservado el libro.",
      "explanationEs": "May be + participio: permiso formal en pasiva; provided that añade la condición.",
      "segments": [
        "Loans may be renewed once, provided",
        "that nobody has reserved the book."
      ],
      "audioText": "Loans may be renewed once, provided that nobody has reserved the book.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-2"
    }
