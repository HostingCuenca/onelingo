  "teaching": [
    {
      "id": "en.n9.class-03.t01",
      "en": "An echo question repeats part of what you heard: 'You moved to Quito?'",
      "es": "Una pregunta eco repite parte de lo que oíste: «¿Te mudaste a Quito?».",
      "explanationEs": "El eco sube al final y pide que el otro amplíe: es una señal de interés.",
      "segments": [
        "An echo question repeats part of what",
        "you heard: 'You moved to Quito?'"
      ],
      "audioText": "An echo question repeats part of what you heard: 'You moved to Quito?'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    },
    {
      "id": "en.n9.class-03.t02",
      "en": "An enthusiastic voice rises and falls, but a flat voice stays on one note.",
      "es": "Una voz entusiasta sube y baja, pero una voz plana se queda en una sola nota.",
      "explanationEs": "El tono cuenta tanto como las palabras.",
      "segments": [
        "An enthusiastic voice rises and falls, but",
        "a flat voice stays on one note."
      ],
      "audioText": "An enthusiastic voice rises and falls, but a flat voice stays on one note.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    },
    {
      "id": "en.n9.class-03.t03",
      "en": "When a person hesitates before answering, the interest may be only courtesy.",
      "es": "Cuando una persona duda antes de responder, el interés puede ser solo cortesía.",
      "explanationEs": "Courtesy = cortesía: hacer lo correcto sin interés real.",
      "segments": [
        "When a person hesitates before answering,",
        "the interest may be only courtesy."
      ],
      "audioText": "When a person hesitates before answering, the interest may be only courtesy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    },
    {
      "id": "en.n9.class-03.t04",
      "en": "'That's interesting' can be a lukewarm reply, especially with no question after it.",
      "es": "«Qué interesante» puede ser una respuesta tibia, sobre todo si no va seguida de una pregunta.",
      "explanationEs": "En inglés británico, «interesting» a solas suele ser muy frío.",
      "segments": [
        "'That's interesting' can be a lukewarm reply,",
        "especially with no question after it."
      ],
      "audioText": "'That's interesting' can be a lukewarm reply, especially with no question after it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    },
    {
      "id": "en.n9.class-03.t05",
      "en": "An eager listener will nod, lean forward and ask for more.",
      "es": "Un oyente interesado asentirá, se inclinará hacia delante y pedirá más.",
      "explanationEs": "Eager indica ganas de saber más; nod es asentir con la cabeza.",
      "segments": [
        "An eager listener will nod, lean",
        "forward and ask for more."
      ],
      "audioText": "An eager listener will nod, lean forward and ask for more.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    },
    {
      "id": "en.n9.class-03.t06",
      "en": "A bored listener looks at the clock, sighs and gives one-word answers.",
      "es": "Un oyente aburrido mira el reloj, suspira y da respuestas de una palabra.",
      "explanationEs": "Bored describe cómo se siente el oyente; boring, lo que le resulta aburrido.",
      "segments": [
        "A bored listener looks at the",
        "clock, sighs and gives one-word answers."
      ],
      "audioText": "A bored listener looks at the clock, sighs and gives one-word answers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-3"
    }
  ],
