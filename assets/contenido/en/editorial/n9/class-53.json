  "teaching": [
    {
      "id": "en.n9.class-53.t01",
      "en": "The proposal is vague: it says «many people» but gives no evidence.",
      "es": "La propuesta es vaga: dice «mucha gente» pero no da ninguna prueba.",
      "explanationEs": "Vague señala un punto débil: faltan cifras, fechas o datos concretos.",
      "segments": [
        "The proposal is vague: it says",
        "«many people» but gives no evidence."
      ],
      "audioText": "The proposal is vague: it says «many people» but gives no evidence.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    },
    {
      "id": "en.n9.class-53.t02",
      "en": "Finishing the garden in two weeks is unrealistic with only three volunteers.",
      "es": "Terminar el huerto en dos semanas es poco realista con solo tres voluntarios.",
      "explanationEs": "Unrealistic: el plazo o los medios no alcanzan para lo que se promete.",
      "segments": [
        "Finishing the garden in two weeks",
        "is unrealistic with only three volunteers."
      ],
      "audioText": "Finishing the garden in two weeks is unrealistic with only three volunteers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    },
    {
      "id": "en.n9.class-53.t03",
      "en": "This plan rests on one assumption: that the council will pay.",
      "es": "Este plan se apoya en un supuesto: que el consejo pagará.",
      "explanationEs": "Rest on an assumption: algo que se da por cierto sin comprobarlo.",
      "segments": [
        "This plan rests on one assumption:",
        "that the council will pay."
      ],
      "audioText": "This plan rests on one assumption: that the council will pay.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    },
    {
      "id": "en.n9.class-53.t04",
      "en": "The authors overlook one risk: there is no contingency if the tools arrive late.",
      "es": "Los autores pasan por alto un riesgo: no hay plan de contingencia si las herramientas llegan tarde.",
      "explanationEs": "Overlook un riesgo + contingency: falta el plan B.",
      "segments": [
        "The authors overlook one risk: there is",
        "no contingency if the tools arrive late."
      ],
      "audioText": "The authors overlook one risk: there is no contingency if the tools arrive late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    },
    {
      "id": "en.n9.class-53.t05",
      "en": "Is the plan feasible with a budget of only 500 dollars?",
      "es": "¿Es viable el plan con un presupuesto de solo 500 dólares?",
      "explanationEs": "Feasible significa «se puede hacer en la práctica».",
      "segments": [
        "Is the plan feasible with a",
        "budget of only 500 dollars?"
      ],
      "audioText": "Is the plan feasible with a budget of only 500 dollars?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    },
    {
      "id": "en.n9.class-53.t06",
      "en": "We should anticipate three questions: who pays, who builds and who cleans up?",
      "es": "Deberíamos anticipar tres preguntas: quién paga, quién construye y quién limpia.",
      "explanationEs": "Anticipate: prever las preguntas de quien decide y preparar la respuesta.",
      "segments": [
        "We should anticipate three questions: who pays,",
        "who builds and who cleans up?"
      ],
      "audioText": "We should anticipate three questions: who pays, who builds and who cleans up?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-3"
    }
  ],
