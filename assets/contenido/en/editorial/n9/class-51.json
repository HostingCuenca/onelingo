  "teaching": [
    {
      "id": "en.n9.class-51.t01",
      "en": "The objective of this proposal is to turn the empty square into a weekend market.",
      "es": "El objetivo de esta propuesta es convertir la plaza vacía en un mercado de fin de semana.",
      "explanationEs": "The objective is to… abre la propuesta y dice qué se quiere lograr.",
      "segments": [
        "The objective of this proposal is to turn",
        "the empty square into a weekend market."
      ],
      "audioText": "The objective of this proposal is to turn the empty square into a weekend market.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    },
    {
      "id": "en.n9.class-51.t02",
      "en": "The main benefit is that families will have a safe place to meet.",
      "es": "El principal beneficio es que las familias tendrán un lugar seguro donde reunirse.",
      "explanationEs": "The main benefit is that… nombra quién gana y qué gana.",
      "segments": [
        "The main benefit is that families will",
        "have a safe place to meet."
      ],
      "audioText": "The main benefit is that families will have a safe place to meet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    },
    {
      "id": "en.n9.class-51.t03",
      "en": "We outline three steps: clean the square, build twenty stalls and open in June.",
      "es": "Esbozamos tres pasos: limpiar la plaza, montar veinte puestos y abrir en junio.",
      "explanationEs": "We outline… presenta el plan a grandes rasgos, en pasos ordenados.",
      "segments": [
        "We outline three steps: clean the square,",
        "build twenty stalls and open in June."
      ],
      "audioText": "We outline three steps: clean the square, build twenty stalls and open in June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    },
    {
      "id": "en.n9.class-51.t04",
      "en": "We recommend holding the market on Saturdays, when most people are free.",
      "es": "Recomendamos celebrar el mercado los sábados, cuando casi todos están libres.",
      "explanationEs": "We recommend + -ing: el autor aconseja y justifica en la misma frase.",
      "segments": [
        "We recommend holding the market on",
        "Saturdays, when most people are free."
      ],
      "audioText": "We recommend holding the market on Saturdays, when most people are free.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    },
    {
      "id": "en.n9.class-51.t05",
      "en": "We request a grant of 4,000 dollars from the council to pay for the stalls.",
      "es": "Solicitamos una subvención de 4.000 dólares al consejo para pagar los puestos.",
      "explanationEs": "We request… formula la petición, casi siempre al final.",
      "segments": [
        "We request a grant of 4,000 dollars from",
        "the council to pay for the stalls."
      ],
      "audioText": "We request a grant of 4,000 dollars from the council to pay for the stalls.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    },
    {
      "id": "en.n9.class-51.t06",
      "en": "Tonight Ana will give a short pitch, but the written proposal has all the details.",
      "es": "Esta noche Ana hará una presentación breve, pero la propuesta escrita tiene todos los detalles.",
      "explanationEs": "Pitch es la versión oral y corta; proposal es el documento completo.",
      "segments": [
        "Tonight Ana will give a short pitch, but",
        "the written proposal has all the details."
      ],
      "audioText": "Tonight Ana will give a short pitch, but the written proposal has all the details.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-proposals-timelines-1"
    }
  ],
