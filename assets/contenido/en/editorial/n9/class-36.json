    {
      "id": "en.n9.class-36.t01",
      "en": "The aim of this report is to examine the sleep habits of secondary students.",
      "es": "El objetivo de este informe es examinar los hábitos de sueño de los estudiantes de secundaria.",
      "explanationEs": "The aim of this report is to + verbo base es el marcador típico de la introducción.",
      "segments": [
        "The aim of this report is to",
        "examine the sleep habits of secondary students."
      ],
      "audioText": "The aim of this report is to examine the sleep habits of secondary students.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-1"
    },
    {
      "id": "en.n9.class-36.t02",
      "en": "The method was an online survey, and every respondent answered ten questions.",
      "es": "El método fue una encuesta en línea y cada encuestado respondió diez preguntas.",
      "explanationEs": "La parte del método explica cómo se recogieron los datos; respondent es la persona que contesta una encuesta.",
      "segments": [
        "The method was an online survey,",
        "and every respondent answered ten questions."
      ],
      "audioText": "The method was an online survey, and every respondent answered ten questions.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-1"
    },
    {
      "id": "en.n9.class-36.t03",
      "en": "The main findings show that 62 percent of students sleep less than eight hours.",
      "es": "Los principales resultados muestran que el 62 % de los estudiantes duerme menos de ocho horas.",
      "explanationEs": "Findings es plural: lleva show, no shows. Esta parte da los datos sin opinar.",
      "segments": [
        "The main findings show that 62 percent",
        "of students sleep less than eight hours."
      ],
      "audioText": "The main findings show that 62 percent of students sleep less than eight hours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-1"
    },
    {
      "id": "en.n9.class-36.t04",
      "en": "The conclusion is that late screen use may affect sleep, although the sample is small.",
      "es": "La conclusión es que usar pantallas tarde puede afectar al sueño, aunque la muestra es pequeña.",
      "explanationEs": "La conclusión interpreta los resultados con prudencia (may) y reconoce un límite.",
      "segments": [
        "The conclusion is that late screen use may",
        "affect sleep, although the sample is small."
      ],
      "audioText": "The conclusion is that late screen use may affect sleep, although the sample is small.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-1"
    },
    {
      "id": "en.n9.class-36.t05",
      "en": "The report makes one recommendation: schools should start classes a little later.",
      "es": "El informe hace una recomendación: los colegios deberían empezar las clases un poco más tarde.",
      "explanationEs": "La recomendación dice qué hacer a partir de la conclusión; suele llevar should o it is recommended that.",
      "segments": [
        "The report makes one recommendation: schools",
        "should start classes a little later."
      ],
      "audioText": "The report makes one recommendation: schools should start classes a little later.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-1"
    }
