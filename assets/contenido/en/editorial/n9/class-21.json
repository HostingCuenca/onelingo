  "teaching": [
    {
      "id": "en.n9.class-21.t01",
      "en": "As chair, Ana opens the meeting and reads the first item on the agenda.",
      "es": "Como presidenta, Ana abre la reunión y lee el primer punto del orden del día.",
      "explanationEs": "Quien preside (chair) abre, da los turnos y cierra la sesión.",
      "segments": [
        "As chair, Ana opens the meeting and",
        "reads the first item on the agenda."
      ],
      "audioText": "As chair, Ana opens the meeting and reads the first item on the agenda.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-1"
    },
    {
      "id": "en.n9.class-21.t02",
      "en": "The secretary writes the minutes, so every member can check what was agreed.",
      "es": "La secretaria redacta el acta para que cada miembro pueda comprobar lo acordado.",
      "explanationEs": "Minutes es el acta escrita de la reunión; no significa «minutos» aquí.",
      "segments": [
        "The secretary writes the minutes, so every",
        "member can check what was agreed."
      ],
      "audioText": "The secretary writes the minutes, so every member can check what was agreed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-1"
    },
    {
      "id": "en.n9.class-21.t03",
      "en": "I would like to propose that we move the next meeting to Thursday.",
      "es": "Me gustaría proponer que traslademos la próxima reunión al jueves.",
      "explanationEs": "I would like to propose + that + oración: abre una propuesta con cortesía.",
      "segments": [
        "I would like to propose that we",
        "move the next meeting to Thursday."
      ],
      "audioText": "I would like to propose that we move the next meeting to Thursday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-1"
    },
    {
      "id": "en.n9.class-21.t04",
      "en": "Sorry to interrupt, but could I clarify one point before we vote?",
      "es": "Perdón por interrumpir, pero ¿podría aclarar un punto antes de votar?",
      "explanationEs": "Sorry to + verbo base pide permiso; could I… suaviza la petición.",
      "segments": [
        "Sorry to interrupt, but could I",
        "clarify one point before we vote?"
      ],
      "audioText": "Sorry to interrupt, but could I clarify one point before we vote?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-1"
    },
    {
      "id": "en.n9.class-21.t05",
      "en": "Mia, let me finish this item, and then you can clarify your question.",
      "es": "Mia, déjame terminar este punto y luego podrás aclarar tu pregunta.",
      "explanationEs": "El chair controla los turnos: let me finish / then you can…",
      "segments": [
        "Mia, let me finish this item, and",
        "then you can clarify your question."
      ],
      "audioText": "Mia, let me finish this item, and then you can clarify your question.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-1"
    }
