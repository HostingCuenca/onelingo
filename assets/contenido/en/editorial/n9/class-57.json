  "teaching": [
    {
      "id": "en.n9.class-57.t01",
      "en": "We are willing to sign for two years in exchange for a lower rent.",
      "es": "Estamos dispuestos a firmar por dos años a cambio de un alquiler más bajo.",
      "explanationEs": "Is willing to + verbo: muestras que cedes. In exchange for + nombre: lo que pides a cambio.",
      "segments": [
        "We are willing to sign for two",
        "years in exchange for a lower rent."
      ],
      "audioText": "We are willing to sign for two years in exchange for a lower rent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-2"
    },
    {
      "id": "en.n9.class-57.t02",
      "en": "The landlord will waive the deposit on the understanding that the rent is paid on the first of each month.",
      "es": "El propietario renunciará al depósito con la condición de que el alquiler se pague el día uno de cada mes.",
      "explanationEs": "On the understanding that + cláusula con sujeto: la condición acordada.",
      "segments": [
        "The landlord will waive the deposit on the understanding that",
        "the rent is paid on the first of each month."
      ],
      "audioText": "The landlord will waive the deposit on the understanding that the rent is paid on the first of each month.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-2"
    },
    {
      "id": "en.n9.class-57.t03",
      "en": "If you could include parking, we could accept the whole package.",
      "es": "Si pudieras incluir el aparcamiento, podríamos aceptar todo el paquete.",
      "explanationEs": "If you could…, we could…: propuesta suave; could en las dos mitades.",
      "segments": [
        "If you could include parking, we",
        "could accept the whole package."
      ],
      "audioText": "If you could include parking, we could accept the whole package.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-2"
    },
    {
      "id": "en.n9.class-57.t04",
      "en": "I would be willing to move my holiday dates, provided that you pay for the hotel.",
      "es": "Estaría dispuesto a mover las fechas de mis vacaciones, siempre que tú pagues el hotel.",
      "explanationEs": "Provided that es otra fórmula condicional; tras ella, presente.",
      "segments": [
        "I would be willing to move my holiday",
        "dates, provided that you pay for the hotel."
      ],
      "audioText": "I would be willing to move my holiday dates, provided that you pay for the hotel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-2"
    },
    {
      "id": "en.n9.class-57.t05",
      "en": "So, to sum up the package: two years at a lower rent in exchange for paying on time.",
      "es": "Así que, resumiendo el paquete: dos años con un alquiler más bajo a cambio de pagar puntualmente.",
      "explanationEs": "Package junta varias cesiones en un único trato.",
      "segments": [
        "So, to sum up the package: two years at",
        "a lower rent in exchange for paying on time."
      ],
      "audioText": "So, to sum up the package: two years at a lower rent in exchange for paying on time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-2"
    }
  ],
