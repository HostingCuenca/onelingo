  "teaching": [
    {
      "id": "en.n9.class-86.t01",
      "en": "I'm afraid I can't agree with that plan.",
      "es": "Me temo que no puedo estar de acuerdo con ese plan.",
      "explanationEs": "I'm afraid + oración abre un desacuerdo sin atacar; no lleva of (I'm afraid of significa «tengo miedo de»).",
      "segments": [
        "I'm afraid I can't",
        "agree with that plan."
      ],
      "audioText": "I'm afraid I can't agree with that plan.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    },
    {
      "id": "en.n9.class-86.t02",
      "en": "Perhaps we could look at another option first.",
      "es": "Quizá podríamos mirar primero otra opción.",
      "explanationEs": "Perhaps + could: propones en lugar de ordenar.",
      "segments": [
        "Perhaps we could look",
        "at another option first."
      ],
      "audioText": "Perhaps we could look at another option first.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    },
    {
      "id": "en.n9.class-86.t03",
      "en": "The price is slightly higher than I expected, and the date is rather early.",
      "es": "El precio es algo más alto de lo que esperaba, y la fecha es bastante temprana.",
      "explanationEs": "slightly y rather suavizan la crítica: «algo» y «bastante».",
      "segments": [
        "The price is slightly higher than I",
        "expected, and the date is rather early."
      ],
      "audioText": "The price is slightly higher than I expected, and the date is rather early.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    },
    {
      "id": "en.n9.class-86.t04",
      "en": "I appreciate your idea, but I suppose the cost is a problem.",
      "es": "Agradezco tu idea, pero supongo que el costo es un problema.",
      "explanationEs": "appreciate reconoce lo bueno primero; suppose suaviza la afirmación.",
      "segments": [
        "I appreciate your idea, but I",
        "suppose the cost is a problem."
      ],
      "audioText": "I appreciate your idea, but I suppose the cost is a problem.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    },
    {
      "id": "en.n9.class-86.t05",
      "en": "Frankly, I tend to think a shorter trip would be safer.",
      "es": "Sinceramente, tiendo a pensar que un viaje más corto sería más seguro.",
      "explanationEs": "frankly abre con franqueza y tend to suaviza la opinión.",
      "segments": [
        "Frankly, I tend to think a",
        "shorter trip would be safer."
      ],
      "audioText": "Frankly, I tend to think a shorter trip would be safer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    },
    {
      "id": "en.n9.class-86.t06",
      "en": "I suggest we ask everyone, and I wonder whether the date is fixed.",
      "es": "Sugiero que preguntemos a todos, y me pregunto si la fecha ya está fijada.",
      "explanationEs": "suggest y wonder proponen y preguntan en lugar de imponer.",
      "segments": [
        "I suggest we ask everyone, and I",
        "wonder whether the date is fixed."
      ],
      "audioText": "I suggest we ask everyone, and I wonder whether the date is fixed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-1"
    }
