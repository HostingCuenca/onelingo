  "teaching": [
    {
      "id": "en.n9.class-68.t01",
      "en": "I noticed that you rushed your last two passes.",
      "es": "Me fijé en que hiciste con prisa tus dos últimos pases.",
      "explanationEs": "Específica: describe un hecho que se vio, no una opinión.",
