  "teaching": [
    {
      "id": "en.n9.class-87.t01",
      "en": "The plan seems somewhat expensive for a small club.",
      "es": "El plan parece algo caro para un club pequeño.",
      "explanationEs": "seem + adjetivo: presentas una impresión; somewhat baja la fuerza.",
      "segments": [
        "The plan seems somewhat expensive",
        "for a small club."
      ],
      "audioText": "The plan seems somewhat expensive for a small club.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    },
    {
      "id": "en.n9.class-87.t02",
      "en": "Some members appear to have a different view.",
      "es": "Algunos socios parecen tener una opinión distinta.",
      "explanationEs": "appear to + verbo: tomas distancia, describes cómo parece.",
      "segments": [
        "Some members appear to",
        "have a different view."
      ],
      "audioText": "Some members appear to have a different view.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    },
    {
      "id": "en.n9.class-87.t03",
      "en": "That is arguably the safest option, albeit not the cheapest.",
      "es": "Esa es posiblemente la opción más segura, aunque no la más barata.",
      "explanationEs": "albeit + adjetivo o grupo breve: concesión corta.",
      "segments": [
        "That is arguably the safest",
        "option, albeit not the cheapest."
      ],
      "audioText": "That is arguably the safest option, albeit not the cheapest.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    },
    {
      "id": "en.n9.class-87.t04",
      "en": "Notwithstanding the cost, I think the trip is worth it.",
      "es": "A pesar del costo, creo que el viaje merece la pena.",
      "explanationEs": "notwithstanding + nombre: reconoce un punto contrario y sigue con tu posición.",
      "segments": [
        "Notwithstanding the cost, I think",
        "the trip is worth it."
      ],
      "audioText": "Notwithstanding the cost, I think the trip is worth it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    },
    {
      "id": "en.n9.class-87.t05",
      "en": "Could you tell me whether the budget is already fixed?",
      "es": "¿Podrías decirme si el presupuesto ya está fijado?",
      "explanationEs": "Pregunta indirecta: whether + orden de afirmación.",
      "segments": [
        "Could you tell me whether",
        "the budget is already fixed?"
      ],
      "audioText": "Could you tell me whether the budget is already fixed?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    },
    {
      "id": "en.n9.class-87.t06",
      "en": "This might possibly need more time than we have.",
      "es": "Esto quizá necesite más tiempo del que tenemos.",
      "explanationEs": "might + possibly: dos suavizantes para una sola idea.",
      "segments": [
        "This might possibly need more",
        "time than we have."
      ],
      "audioText": "This might possibly need more time than we have.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-2"
    }
  ],
