  "teaching": [
    {
      "id": "en.n9.class-01.t01",
      "en": "'How do you know the bride?' is a safe opener at a wedding.",
      "es": "«¿De qué conoces a la novia?» es una apertura segura en una boda.",
      "explanationEs": "Un opener pregunta por el contexto compartido: es ligero y fácil de contestar.",
      "segments": [
        "'How do you know the bride?' is",
        "a safe opener at a wedding."
      ],
      "audioText": "'How do you know the bride?' is a safe opener at a wedding.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    },
    {
      "id": "en.n9.class-01.t02",
      "en": "At a wedding you mingle for hours, so every new acquaintance is a chance to talk.",
      "es": "En una boda socializas durante horas, así que cada conocido nuevo es una oportunidad de hablar.",
      "explanationEs": "Acquaintance es alguien a quien conoces poco; no equivale a friend.",
      "segments": [
        "At a wedding you mingle for hours, so",
        "every new acquaintance is a chance to talk."
      ],
      "audioText": "At a wedding you mingle for hours, so every new acquaintance is a chance to talk.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    },
    {
      "id": "en.n9.class-01.t03",
      "en": "She sounded genuine when she asked, 'Oh, really? How did that happen?'",
      "es": "Sonaba sincera cuando preguntó: «¿Ah, sí? ¿Cómo pasó eso?».",
      "explanationEs": "El interés genuino se nota en el eco («Oh, really?») y en la pregunta de detalle.",
      "segments": [
        "She sounded genuine when she asked,",
        "'Oh, really? How did that happen?'"
      ],
      "audioText": "She sounded genuine when she asked, 'Oh, really? How did that happen?'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    },
    {
      "id": "en.n9.class-01.t04",
      "en": "A short answer and a quick look at the phone are a cue that someone wants to leave.",
      "es": "Una respuesta corta y una mirada rápida al móvil son una señal de que alguien quiere irse.",
      "explanationEs": "Cue es una pista que te ayuda a leer la situación.",
      "segments": [
        "A short answer and a quick look at the",
        "phone are a cue that someone wants to leave."
      ],
      "audioText": "A short answer and a quick look at the phone are a cue that someone wants to leave.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    },
    {
      "id": "en.n9.class-01.t05",
      "en": "If the talk gets awkward, steer it back to something easy, like the food or the music.",
      "es": "Si la charla se vuelve incómoda, reconduce hacia algo fácil, como la comida o la música.",
      "explanationEs": "Steer it back = volver con suavidad a un tema cómodo.",
      "segments": [
        "If the talk gets awkward, steer it back to",
        "something easy, like the food or the music."
      ],
      "audioText": "If the talk gets awkward, steer it back to something easy, like the food or the music.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    },
    {
      "id": "en.n9.class-01.t06",
      "en": "A warm closing is brief: 'It was great chatting, I'll let you get back to your friends.'",
      "es": "Un cierre cálido es breve: «Fue genial charlar, te dejo volver con tus amigos».",
      "explanationEs": "El cierre agradece, da un motivo y no se alarga.",
      "segments": [
        "A warm closing is brief: 'It was great chatting,",
        "I'll let you get back to your friends.'"
      ],
      "audioText": "A warm closing is brief: 'It was great chatting, I'll let you get back to your friends.'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-1"
    }
  ],
