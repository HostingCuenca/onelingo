  "teaching": [
    {
      "id": "en.n9.class-71.t01",
      "en": "We need books, we need quiet, and we need a place to belong.",
      "es": "Necesitamos libros, necesitamos silencio y necesitamos un lugar al que pertenecer.",
      "explanationEs": "Rule of three: tres elementos con la misma forma dan ritmo y dejan la idea completa.",
      "segments": [
        "We need books, we need quiet, and",
        "we need a place to belong."
      ],
      "audioText": "We need books, we need quiet, and we need a place to belong.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    },
    {
      "id": "en.n9.class-71.t02",
      "en": "Who will speak for this library when the doors are closed?",
      "es": "¿Quién hablará por esta biblioteca cuando las puertas estén cerradas?",
      "explanationEs": "Rhetorical question: nadie responde en voz alta; el público piensa y se implica.",
      "segments": [
        "Who will speak for this library",
        "when the doors are closed?"
      ],
      "audioText": "Who will speak for this library when the doors are closed?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    },
    {
      "id": "en.n9.class-71.t03",
      "en": "Some people see old shelves; we see a bright future.",
      "es": "Unos ven estantes viejos; nosotros vemos un futuro brillante.",
      "explanationEs": "Contrast: dos visiones opuestas hacen más fuerte la tuya.",
      "segments": [
        "Some people see old shelves;",
        "we see a bright future."
      ],
      "audioText": "Some people see old shelves; we see a bright future.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    },
    {
      "id": "en.n9.class-71.t04",
      "en": "We will not stay silent. We will not step back. We will not give up. We will not let it close.",
      "es": "No nos quedaremos callados. No retrocederemos. No nos rendiremos. No dejaremos que cierre.",
      "explanationEs": "Repetition: repetir el comienzo da ritmo y fuerza a la idea.",
      "segments": [
        "We will not stay silent. We will not step back. We",
        "will not give up. We will not let it close."
      ],
      "audioText": "We will not stay silent. We will not step back. We will not give up. We will not let it close.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    },
    {
      "id": "en.n9.class-71.t05",
      "en": "Imagine a child in the dark, holding a book like a lantern.",
      "es": "Imagina a un niño en la oscuridad, sosteniendo un libro como un farol.",
      "explanationEs": "Vivid image: una imagen concreta hace que el público vea la idea.",
      "segments": [
        "Imagine a child in the dark,",
        "holding a book like a lantern."
      ],
      "audioText": "Imagine a child in the dark, holding a book like a lantern.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    },
    {
      "id": "en.n9.class-71.t06",
      "en": "You, the audience, are the only voice this library has.",
      "es": "Ustedes, el público, son la única voz que tiene esta biblioteca.",
      "explanationEs": "Direct address: you habla al público y lo hace parte del mensaje.",
      "segments": [
        "You, the audience, are the",
        "only voice this library has."
      ],
      "audioText": "You, the audience, are the only voice this library has.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-1"
    }
  ],
