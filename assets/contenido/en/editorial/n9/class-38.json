  "teaching": [
    {
      "id": "en.n9.class-38.t01",
      "en": "It is a fact that 62 percent of the students sleep less than eight hours.",
      "es": "Es un hecho que el 62 % de los estudiantes duerme menos de ocho horas.",
      "explanationEs": "Fact: algo que se puede comprobar, con cifras o fuente. En inglés es obligatorio el sujeto it en It is a fact that…",
      "segments": [
        "It is a fact that 62 percent of",
        "the students sleep less than eight hours."
      ],
      "audioText": "It is a fact that 62 percent of the students sleep less than eight hours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    },
    {
      "id": "en.n9.class-38.t02",
      "en": "We can assume the school cut homework, but that is an inference, not a fact.",
      "es": "Podemos suponer que el colegio redujo los deberes, pero eso es una inferencia, no un hecho.",
      "explanationEs": "Una inferencia se deduce de los hechos; assume y suggest son pistas de que no está comprobada.",
      "segments": [
        "We can assume the school cut homework, but",
        "that is an inference, not a fact."
      ],
      "audioText": "We can assume the school cut homework, but that is an inference, not a fact.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    },
    {
      "id": "en.n9.class-38.t03",
      "en": "In my opinion, the school should start later; unfortunately, nobody asked the students.",
      "es": "En mi opinión, el colegio debería empezar más tarde; por desgracia, nadie preguntó a los estudiantes.",
      "explanationEs": "In my opinion, should y unfortunately son pistas de opinión: valoran en lugar de comprobar.",
      "segments": [
        "In my opinion, the school should start",
        "later; unfortunately, nobody asked the students."
      ],
      "audioText": "In my opinion, the school should start later; unfortunately, nobody asked the students.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    },
    {
      "id": "en.n9.class-38.t04",
      "en": "According to the school nurse, the source of the figure is a national survey.",
      "es": "Según la enfermera del colegio, la fuente de la cifra es una encuesta nacional.",
      "explanationEs": "According to + persona o documento atribuye el dato; la source permite comprobarlo. No se dice «according to me».",
      "segments": [
        "According to the school nurse, the source",
        "of the figure is a national survey."
      ],
      "audioText": "According to the school nurse, the source of the figure is a national survey.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    },
    {
      "id": "en.n9.class-38.t05",
      "en": "Presumably, late screen use explains the drop, but the certainty is low.",
      "es": "Presumiblemente, el uso tardío de pantallas explica la caída, pero el grado de certeza es bajo.",
      "explanationEs": "Presumably marca una inferencia: probable, no comprobada.",
      "segments": [
        "Presumably, late screen use explains the",
        "drop, but the certainty is low."
      ],
      "audioText": "Presumably, late screen use explains the drop, but the certainty is low.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    },
    {
      "id": "en.n9.class-38.t06",
      "en": "Reportedly, the school has cut homework by a third, although I cannot confirm it.",
      "es": "Según se dice, el colegio ha reducido los deberes en un tercio, aunque no puedo confirmarlo.",
      "explanationEs": "Reportedly atribuye la información a otros sin confirmarla: ni es un hecho comprobado ni una opinión propia.",
      "segments": [
        "Reportedly, the school has cut homework by",
        "a third, although I cannot confirm it."
      ],
      "audioText": "Reportedly, the school has cut homework by a third, although I cannot confirm it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-reports-hedging-3"
    }
  ],
