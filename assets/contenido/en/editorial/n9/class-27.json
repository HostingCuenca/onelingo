  "teaching": [
    {
      "id": "en.n9.class-27.t01",
      "en": "The panel enquired about my volunteer work and asked me to describe one project.",
      "es": "El comité preguntó por mi trabajo voluntario y me pidió que describiera un proyecto.",
      "explanationEs": "Enquire about + nombre resume una pregunta sobre un tema en un solo verbo.",
      "segments": [
        "The panel enquired about my volunteer work",
        "and asked me to describe one project."
      ],
      "audioText": "The panel enquired about my volunteer work and asked me to describe one project.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-2"
    },
    {
      "id": "en.n9.class-27.t02",
      "en": "They wanted to know whether I could work at weekends.",
      "es": "Querían saber si podía trabajar los fines de semana.",
      "explanationEs": "Wanted to know + whether + sujeto + verbo: una pregunta de sí o no, sin did ni inversión.",
      "segments": [
        "They wanted to know whether",
        "I could work at weekends."
      ],
      "audioText": "They wanted to know whether I could work at weekends.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-2"
    },
    {
      "id": "en.n9.class-27.t03",
      "en": "The panel wanted to probe my reasons, so I was asked to describe them in detail.",
      "es": "El comité quiso indagar en mis razones, así que me pidieron que las describiera con detalle.",
      "explanationEs": "Probe es seguir preguntando sobre lo mismo; be asked to + verbo recoge una petición.",
      "segments": [
        "The panel wanted to probe my reasons, so",
        "I was asked to describe them in detail."
      ],
      "audioText": "The panel wanted to probe my reasons, so I was asked to describe them in detail.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-2"
    },
    {
      "id": "en.n9.class-27.t04",
      "en": "In a report, I keep what the panel will want to know and skip the small talk.",
      "es": "En un informe conservo lo que el comité querrá saber y omito la charla.",
      "explanationEs": "Un informe resume el sentido y conserva lo que quiere saber el lector; no copia la conversación.",
      "segments": [
        "In a report, I keep what the panel will",
        "want to know and skip the small talk."
      ],
      "audioText": "In a report, I keep what the panel will want to know and skip the small talk.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-2"
    },
    {
      "id": "en.n9.class-27.t05",
      "en": "A concise report says: They asked why I had applied and how long I had worked there.",
      "es": "Un informe conciso dice: preguntaron por qué había solicitado y cuánto tiempo llevaba trabajando allí.",
      "explanationEs": "Con wh- el orden es afirmativo (why I had applied) y el tiempo retrocede.",
      "segments": [
        "A concise report says: They asked why I had",
        "applied and how long I had worked there."
      ],
      "audioText": "A concise report says: They asked why I had applied and how long I had worked there.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-2"
    }
  ],
