  "teaching": [
    {
      "id": "en.n9.class-66.t01",
      "en": "Pass the ball sooner and stay in your position.",
      "es": "Pasa el balón antes y mantén tu posición.",
      "explanationEs": "Instrucción: imperativo directo que dice qué hacer ahora.",
      "segments": [
        "Pass the ball sooner and",
        "stay in your position."
      ],
      "audioText": "Pass the ball sooner and stay in your position.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-leading-coaching-1"
    },
    {
      "id": "en.n9.class-66.t02",
      "en": "I love your effort today; you never gave up.",
      "es": "Me encanta tu esfuerzo de hoy; nunca te rendiste.",
      "explanationEs": "Ánimo: reconoce el esfuerzo y motiva, sin dar órdenes.",
      "segments": [
        "I love your effort today;",
        "you never gave up."
      ],
      "audioText": "I love your effort today; you never gave up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-leading-coaching-1"
    },
    {
      "id": "en.n9.class-66.t03",
      "en": "Your strength is your speed, but your passes were late in the second half.",
      "es": "Tu punto fuerte es tu velocidad, pero tus pases llegaron tarde en la segunda parte.",
      "explanationEs": "Retroalimentación: un punto fuerte + un dato concreto sobre lo que mejorar.",
      "segments": [
        "Your strength is your speed, but your",
        "passes were late in the second half."
      ],
      "audioText": "Your strength is your speed, but your passes were late in the second half.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-leading-coaching-1"
    },
    {
      "id": "en.n9.class-66.t04",
      "en": "You can improve by looking up before you pass.",
      "es": "Puedes mejorar levantando la vista antes de pasar.",
      "explanationEs": "La retroalimentación útil termina con algo que se puede hacer.",
      "segments": [
        "You can improve by looking",
        "up before you pass."
      ],
      "audioText": "You can improve by looking up before you pass.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-leading-coaching-1"
    },
    {
      "id": "en.n9.class-66.t05",
      "en": "Keep going, you are doing great under pressure!",
      "es": "¡Sigue así, lo estás haciendo genial bajo presión!",
      "explanationEs": "Ánimo: Keep going y You are doing great motivan en el momento.",
      "segments": [
        "Keep going, you are",
        "doing great under pressure!"
      ],
      "audioText": "Keep going, you are doing great under pressure!",
      "audioMode": "tts",
