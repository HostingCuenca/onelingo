  "teaching": [
    {
      "id": "en.n9.class-56.t01",
      "en": "In a negotiation, a position is what you ask for, and an interest is why you ask.",
      "es": "En una negociación, la postura es lo que pides y el interés es por qué lo pides.",
      "explanationEs": "Position = la petición; interest = la razón. Preguntar why distingue ambas.",
      "segments": [
        "In a negotiation, a position is what you ask",
        "for, and an interest is why you ask."
      ],
      "audioText": "In a negotiation, a position is what you ask for, and an interest is why you ask.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-1"
    },
    {
      "id": "en.n9.class-56.t02",
      "en": "The tenant's position is «lower the rent», but her underlying interest is to save money for her course.",
      "es": "La postura de la inquilina es «bajar el alquiler», pero su interés de fondo es ahorrar para su curso.",
      "explanationEs": "Underlying interest: la necesidad real que hay debajo de la petición.",
      "segments": [
        "The tenant's position is «lower the rent», but her",
        "underlying interest is to save money for her course."
      ],
      "audioText": "The tenant's position is «lower the rent», but her underlying interest is to save money for her course.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-1"
    },
    {
      "id": "en.n9.class-56.t03",
      "en": "The seller's priority is a quick sale, so he is flexible about the price.",
      "es": "La prioridad del vendedor es vender rápido, así que es flexible con el precio.",
      "explanationEs": "Priority = lo que más importa; flexible about = se puede ceder en eso.",
      "segments": [
        "The seller's priority is a quick sale,",
        "so he is flexible about the price."
      ],
      "audioText": "The seller's priority is a quick sale, so he is flexible about the price.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-1"
    },
    {
      "id": "en.n9.class-56.t04",
      "en": "We both want a quiet flat, so we have common ground and can negotiate from there.",
      "es": "Los dos queremos un piso tranquilo, así que tenemos un punto en común y podemos negociar desde ahí.",
      "explanationEs": "Common ground es incontable: sin a. Negotiate from there: partir de lo compartido.",
      "segments": [
        "We both want a quiet flat, so we",
        "have common ground and can negotiate from there."
      ],
      "audioText": "We both want a quiet flat, so we have common ground and can negotiate from there.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-1"
    },
    {
      "id": "en.n9.class-56.t05",
      "en": "Before we start, tell me your priority: the date, the price or the place.",
      "es": "Antes de empezar, dime tu prioridad: la fecha, el precio o el lugar.",
      "explanationEs": "Preguntar por la prioridad de la otra parte revela en qué puede ceder.",
      "segments": [
        "Before we start, tell me your priority:",
        "the date, the price or the place."
      ],
      "audioText": "Before we start, tell me your priority: the date, the price or the place.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-1"
    }
  ],
