  "id": "en.n9.class-56",
  "title": {
    "en": "Positions and interests",
    "es": "Posturas e intereses"
  },
  "objectives": {
    "es": [
      "Distinguir en una negociación lo que alguien pide (postura) de lo que necesita (interés) y localizar el punto en común."
    ]
  },
