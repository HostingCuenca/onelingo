  "teaching": [
    {
      "id": "en.n9.class-26.t01",
      "en": "The panel asks every candidate why they want the scholarship.",
      "es": "El comité pregunta a cada candidato por qué quiere la beca.",
      "explanationEs": "Why do you want…? es una pregunta de motivación: busca tus razones.",
      "segments": [
        "The panel asks every candidate",
        "why they want the scholarship."
      ],
      "audioText": "The panel asks every candidate why they want the scholarship.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-1"
    },
    {
      "id": "en.n9.class-26.t02",
      "en": "Tell me about a time when you led a team: this question helps the panel assess your past behaviour.",
      "es": "Cuéntame una vez en que lideraste un equipo: esta pregunta ayuda al comité a evaluar tu conducta pasada.",
      "explanationEs": "Tell me about a time when + pasado pide un hecho real, no una opinión.",
      "segments": [
        "Tell me about a time when you led a team:",
        "this question helps the panel assess your past behaviour."
      ],
      "audioText": "Tell me about a time when you led a team: this question helps the panel assess your past behaviour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-1"
    },
    {
      "id": "en.n9.class-26.t03",
      "en": "A hypothetical question such as What would you do if the bus did not arrive? shows how you think.",
      "es": "Una pregunta hipotética como ¿Qué harías si el autobús no llegara? muestra cómo piensas.",
      "explanationEs": "What would you do if + pasado: se responde con would + tu decisión.",
      "segments": [
        "A hypothetical question such as What would you do if",
        "the bus did not arrive? shows how you think."
      ],
      "audioText": "A hypothetical question such as What would you do if the bus did not arrive? shows how you think.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-1"
    },
    {
      "id": "en.n9.class-26.t04",
      "en": "Your answer to a motivation question should reveal a clear reason, not only a wish.",
      "es": "Tu respuesta a una pregunta de motivación debe revelar una razón clara, no solo un deseo.",
      "explanationEs": "Reveal: dejar ver algo; una razón concreta convence más que «me gusta».",
      "segments": [
        "Your answer to a motivation question should reveal",
        "a clear reason, not only a wish."
      ],
      "audioText": "Your answer to a motivation question should reveal a clear reason, not only a wish.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-1"
    },
    {
      "id": "en.n9.class-26.t05",
      "en": "A good candidate names one strength and gives one example.",
      "es": "Un buen candidato nombra un punto fuerte y da un ejemplo.",
      "explanationEs": "Strength + example: la cualidad sola no convence; el ejemplo la prueba.",
      "segments": [
        "A good candidate names one",
        "strength and gives one example."
      ],
      "audioText": "A good candidate names one strength and gives one example.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-interviews-1"
    }
  ],
