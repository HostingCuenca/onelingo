  "teaching": [
    {
      "id": "en.n9.class-83.t01",
      "en": "The introduction of free lunches led to a rise in attendance.",
      "es": "La introducción de comidas gratuitas llevó a un aumento de la asistencia.",
      "explanationEs": "introduction y attendance esconden acciones: alguien introdujo algo y más alumnos asistieron.",
      "segments": [
        "The introduction of free lunches led",
        "to a rise in attendance."
      ],
      "audioText": "The introduction of free lunches led to a rise in attendance.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    },
    {
      "id": "en.n9.class-83.t02",
      "en": "The closure of the clinic caused concern among residents.",
      "es": "El cierre de la clínica causó preocupación entre los vecinos.",
      "explanationEs": "closure oculta al agente: alguien cerró la clínica, pero la frase no dice quién.",
      "segments": [
        "The closure of the clinic",
        "caused concern among residents."
      ],
      "audioText": "The closure of the clinic caused concern among residents.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    },
    {
      "id": "en.n9.class-83.t03",
      "en": "Approval of the plan came after a long investigation.",
      "es": "La aprobación del plan llegó después de una larga investigación.",
      "explanationEs": "approval e investigation vuelven a los verbos approve e investigate.",
      "segments": [
        "Approval of the plan came",
        "after a long investigation."
      ],
      "audioText": "Approval of the plan came after a long investigation.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    },
    {
      "id": "en.n9.class-83.t04",
      "en": "A decrease in complaints followed the publication of the results.",
      "es": "Una disminución de las quejas siguió a la publicación de los resultados.",
      "explanationEs": "decrease, complaint y publication esconden acciones y personas.",
      "segments": [
        "A decrease in complaints followed",
        "the publication of the results."
      ],
      "audioText": "A decrease in complaints followed the publication of the results.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    },
    {
      "id": "en.n9.class-83.t05",
      "en": "The council closed the clinic, so residents voiced their concern.",
      "es": "El ayuntamiento cerró la clínica, así que los vecinos expresaron su preocupación.",
      "explanationEs": "Versión con verbos: ahora aparecen el agente (the council) y la acción (closed).",
      "segments": [
        "The council closed the clinic,",
        "so residents voiced their concern."
      ],
      "audioText": "The council closed the clinic, so residents voiced their concern.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    },
    {
      "id": "en.n9.class-83.t06",
      "en": "Because the council approved the plan, fewer residents sent a complaint.",
      "es": "Como el ayuntamiento aprobó el plan, menos vecinos enviaron una queja.",
      "explanationEs": "Desmontar es volver a los verbos y decir quién hizo cada cosa.",
      "segments": [
        "Because the council approved the plan,",
        "fewer residents sent a complaint."
      ],
      "audioText": "Because the council approved the plan, fewer residents sent a complaint.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-nominal-style-3"
    }
  ],
