  "teaching": [
    {
      "id": "en.n9.class-22.t01",
      "en": "I support Mia's idea, and I would like to build on it.",
      "es": "Apoyo la idea de Mia y me gustaría desarrollarla.",
      "explanationEs": "Build on + idea: partes de lo que ya se dijo y añades algo nuevo.",
      "segments": [
        "I support Mia's idea, and I",
        "would like to build on it."
      ],
      "audioText": "I support Mia's idea, and I would like to build on it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    },
    {
      "id": "en.n9.class-22.t02",
      "en": "That is a fair point, and I can go along with the new date.",
      "es": "Es un argumento razonable y puedo aceptar la nueva fecha.",
      "explanationEs": "Go along with + nombre: aceptas lo propuesto, aunque no sea tu primera opción.",
      "segments": [
        "That is a fair point, and I",
        "can go along with the new date."
      ],
      "audioText": "That is a fair point, and I can go along with the new date.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    },
    {
      "id": "en.n9.class-22.t03",
      "en": "I have some reservations about the price, because it is higher than last year.",
      "es": "Tengo algunas reservas sobre el precio, porque es más alto que el año pasado.",
      "explanationEs": "Have reservations about + nombre: dudas educadas, sin decir «no».",
      "segments": [
        "I have some reservations about the price,",
        "because it is higher than last year."
      ],
      "audioText": "I have some reservations about the price, because it is higher than last year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    },
    {
      "id": "en.n9.class-22.t04",
      "en": "I am not convinced that one meeting a month is enough.",
      "es": "No estoy convencido de que una reunión al mes sea suficiente.",
      "explanationEs": "Not convinced that + oración: desacuerdo suave sobre un hecho o un plan.",
      "segments": [
        "I am not convinced that one",
        "meeting a month is enough."
      ],
      "audioText": "I am not convinced that one meeting a month is enough.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    },
    {
      "id": "en.n9.class-22.t05",
      "en": "My main concern is the cost, so could we find a compromise?",
      "es": "Mi principal preocupación es el coste, así que, ¿podemos buscar un término medio?",
      "explanationEs": "Concern nombra el problema; compromise ofrece una salida a ambas partes.",
      "segments": [
        "My main concern is the cost,",
        "so could we find a compromise?"
      ],
      "audioText": "My main concern is the cost, so could we find a compromise?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    },
    {
      "id": "en.n9.class-22.t06",
      "en": "Tom will be speaking to the council on Friday, so I have no objection to waiting.",
      "es": "Tom hablará con el ayuntamiento el viernes, así que no tengo objeción en esperar.",
      "explanationEs": "Will be + -ing presenta algo que estará en marcha en un momento futuro.",
      "segments": [
        "Tom will be speaking to the council on",
        "Friday, so I have no objection to waiting."
      ],
      "audioText": "Tom will be speaking to the council on Friday, so I have no objection to waiting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-2"
    }
  ],
