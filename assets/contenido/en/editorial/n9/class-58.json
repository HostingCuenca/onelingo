  "teaching": [
    {
      "id": "en.n9.class-58.t01",
      "en": "In principle, I can agree to 900 dollars, but that is only tentative until I speak to my partner.",
      "es": "En principio puedo aceptar 900 dólares, pero es solo provisional hasta que hable con mi socio.",
      "explanationEs": "In principle y tentative avisan de que todavía no hay compromiso firme.",
      "segments": [
        "In principle, I can agree to 900 dollars, but that",
        "is only tentative until I speak to my partner."
      ],
      "audioText": "In principle, I can agree to 900 dollars, but that is only tentative until I speak to my partner.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-3"
    },
    {
      "id": "en.n9.class-58.t02",
      "en": "We can offer 900 dollars a month, subject to a two-year contract.",
      "es": "Podemos ofrecer 900 dólares al mes, sujeto a un contrato de dos años.",
      "explanationEs": "Subject to + nombre: la oferta depende de una condición previa.",
      "segments": [
        "We can offer 900 dollars a",
        "month, subject to a two-year contract."
      ],
      "audioText": "We can offer 900 dollars a month, subject to a two-year contract.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-3"
    },
    {
      "id": "en.n9.class-58.t03",
      "en": "Let's meet halfway: I offer 950 and you fix the heating.",
      "es": "Lleguemos a un punto medio: yo ofrezco 950 y tú arreglas la calefacción.",
      "explanationEs": "Meet halfway: cada parte cede una parte.",
      "segments": [
        "Let's meet halfway: I offer 950",
        "and you fix the heating."
      ],
      "audioText": "Let's meet halfway: I offer 950 and you fix the heating.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-3"
    },
    {
      "id": "en.n9.class-58.t04",
      "en": "I cannot commit to that date yet, but I will confirm by Friday.",
      "es": "Todavía no puedo comprometerme con esa fecha, pero la confirmaré el viernes.",
      "explanationEs": "Commit to + nombre: prometer algo firme. Sin reflexivo en inglés.",
      "segments": [
        "I cannot commit to that date yet,",
        "but I will confirm by Friday."
      ],
      "audioText": "I cannot commit to that date yet, but I will confirm by Friday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-3"
    },
    {
      "id": "en.n9.class-58.t05",
      "en": "Once we both sign the contract, it is binding, so read it carefully.",
      "es": "Una vez que los dos firmemos el contrato, es vinculante, así que léelo con cuidado.",
      "explanationEs": "Binding = obliga a las dos partes.",
      "segments": [
        "Once we both sign the contract, it",
        "is binding, so read it carefully."
      ],
      "audioText": "Once we both sign the contract, it is binding, so read it carefully.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-negotiating-agreements-3"
    }
  ],
