  "teaching": [
    {
      "id": "en.n9.class-88.t01",
      "en": "When Sara says “That might be difficult”, she wants to decline without being rude.",
      "es": "Cuando Sara dice «Eso podría ser difícil», quiere rechazar sin ser grosera.",
      "explanationEs": "«That might be difficult» casi siempre es un no cortés.",
      "segments": [
        "When Sara says “That might be difficult”,",
        "she wants to decline without being rude."
      ],
      "audioText": "When Sara says “That might be difficult”, she wants to decline without being rude.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    },
    {
      "id": "en.n9.class-88.t02",
      "en": "“I'll think about it” often shows that the speaker is hesitant.",
      "es": "«Lo pensaré» suele mostrar que quien habla está indeciso.",
      "explanationEs": "hesitant: duda, no ha dicho que sí.",
      "segments": [
        "“I'll think about it” often shows",
        "that the speaker is hesitant."
      ],
      "audioText": "“I'll think about it” often shows that the speaker is hesitant.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    },
    {
      "id": "en.n9.class-88.t03",
      "en": "Carlos sounded reluctant, even though his words were friendly.",
      "es": "Carlos sonó reacio, aunque sus palabras eran amables.",
      "explanationEs": "reluctant: no quiere hacerlo, pero no lo dice con palabras.",
      "segments": [
        "Carlos sounded reluctant, even though",
        "his words were friendly."
      ],
      "audioText": "Carlos sounded reluctant, even though his words were friendly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    },
    {
      "id": "en.n9.class-88.t04",
      "en": "Listen to the tone: a flat voice can turn a friendly sentence into a no.",
      "es": "Escucha el tono: una voz plana puede convertir una frase amable en un no.",
      "explanationEs": "El tono cambia el significado de una frase.",
      "segments": [
        "Listen to the tone: a flat voice can",
        "turn a friendly sentence into a no."
      ],
      "audioText": "Listen to the tone: a flat voice can turn a friendly sentence into a no.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    },
    {
      "id": "en.n9.class-88.t05",
      "en": "Ana took the hint and stopped asking about the party.",
      "es": "Ana captó la indirecta y dejó de preguntar por la fiesta.",
      "explanationEs": "take the hint: entender lo que alguien dice sin decirlo.",
      "segments": [
        "Ana took the hint and",
        "stopped asking about the party."
      ],
      "audioText": "Ana took the hint and stopped asking about the party.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    },
    {
      "id": "en.n9.class-88.t06",
      "en": "It is polite to decline with a reason, but listeners must interpret what is left unsaid.",
      "es": "Es cortés rechazar con una razón, pero quien escucha debe interpretar lo que queda sin decir.",
      "explanationEs": "interpret: leer entre líneas lo que queda sin decir.",
      "segments": [
        "It is polite to decline with a reason,",
        "but listeners must interpret what is left unsaid."
      ],
      "audioText": "It is polite to decline with a reason, but listeners must interpret what is left unsaid.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-tactful-disagreement-3"
    }
  ],
