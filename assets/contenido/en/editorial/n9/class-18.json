  "teaching": [
    {
      "id": "en.n9.class-18.t01",
      "en": "Tom's message sounded blunt: «Give me the file today.»",
      "es": "El mensaje de Tom sonó brusco: «Give me the file today.»",
      "explanationEs": "Blunt: una orden directa, sin marcadores de cortesía.",
