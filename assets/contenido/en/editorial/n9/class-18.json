      "languageCode": "en",
      "patternId": "n9-tone-register-3"
    },
    {
      "id": "en.n9.class-18.t02",
      "en": "Could you send me the file when you can? I would appreciate it.",
      "es": "¿Podrías enviarme el archivo cuando puedas? Te lo agradecería.",
      "explanationEs": "Could you + I would appreciate it: la petición ya suena cortés.",
      "segments": [
