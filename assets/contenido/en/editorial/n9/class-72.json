  "teaching": [
    {
      "id": "en.n9.class-72.t01",
      "en": "What this river needs is not promises but volunteers.",
      "es": "Lo que este río necesita no son promesas, sino voluntarios.",
      "explanationEs": "Cleft con what: What + sujeto + verbo + is + la idea que destacas.",
      "segments": [
        "What this river needs is",
        "not promises but volunteers."
      ],
      "audioText": "What this river needs is not promises but volunteers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    },
    {
      "id": "en.n9.class-72.t02",
      "en": "It is our children who will pay for this litter.",
      "es": "Son nuestros hijos quienes pagarán por esta basura.",
      "explanationEs": "It is + idea destacada + who/that: pone el foco en quién o qué.",
      "segments": [
        "It is our children who",
        "will pay for this litter."
      ],
      "audioText": "It is our children who will pay for this litter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    },
    {
      "id": "en.n9.class-72.t03",
      "en": "Never before have so many neighbours joined a clean-up.",
      "es": "Nunca antes se habían sumado tantos vecinos a una limpieza.",
      "explanationEs": "Never before al inicio: el auxiliar (have) va antes del sujeto.",
      "segments": [
        "Never before have so many",
        "neighbours joined a clean-up."
      ],
      "audioText": "Never before have so many neighbours joined a clean-up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    },
    {
      "id": "en.n9.class-72.t04",
      "en": "Not only is the river dirty, it is also dangerous.",
      "es": "El río no solo está sucio, también es peligroso.",
      "explanationEs": "Not only al inicio: is va antes del sujeto the river.",
      "segments": [
        "Not only is the river",
        "dirty, it is also dangerous."
      ],
      "audioText": "Not only is the river dirty, it is also dangerous.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    },
    {
      "id": "en.n9.class-72.t05",
      "en": "We do care about this river, and we do want answers.",
      "es": "Sí nos importa este río, y sí queremos respuestas.",
      "explanationEs": "Do + verbo base: el do enfático afirma con fuerza; con he/she es does.",
      "segments": [
        "We do care about this river,",
        "and we do want answers."
      ],
      "audioText": "We do care about this river, and we do want answers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    },
    {
      "id": "en.n9.class-72.t06",
      "en": "Only when the water is clean will our children swim here.",
      "es": "Solo cuando el agua esté limpia nadarán aquí nuestros hijos.",
      "explanationEs": "Only when al inicio: en la segunda parte el auxiliar will va antes del sujeto.",
      "segments": [
        "Only when the water is clean",
        "will our children swim here."
      ],
      "audioText": "Only when the water is clean will our children swim here.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-persuasion-emphasis-2"
    }
