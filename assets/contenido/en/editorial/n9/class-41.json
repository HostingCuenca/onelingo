  "teaching": [
    {
      "id": "en.n9.class-41.t01",
      "en": "The forecast says it will definitely snow on the mountain tonight.",
      "es": "El pronóstico dice que sin duda nevará en la montaña esta noche.",
      "explanationEs": "Will definitely + verbo: certeza casi total; el adverbio va después de will.",
      "segments": [
        "The forecast says it will definitely",
        "snow on the mountain tonight."
      ],
      "audioText": "The forecast says it will definitely snow on the mountain tonight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-risk-probability-1"
    },
    {
      "id": "en.n9.class-41.t02",
      "en": "Heavy rain is highly likely on Saturday, so the warning is serious.",
      "es": "La lluvia fuerte es muy probable el sábado, así que el aviso es serio.",
      "explanationEs": "Highly likely: probabilidad alta. Likely es adjetivo: is likely to + verbo.",
      "segments": [
        "Heavy rain is highly likely on",
        "Saturday, so the warning is serious."
      ],
      "audioText": "Heavy rain is highly likely on Saturday, so the warning is serious.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-risk-probability-1"
    },
    {
      "id": "en.n9.class-41.t03",
      "en": "It will probably be cloudy, but it probably won't rain.",
      "es": "Probablemente estará nublado, pero probablemente no lloverá.",
      "explanationEs": "Will probably, pero probably won't: con la negación el adverbio va antes de won't.",
      "segments": [
        "It will probably be cloudy,",
        "but it probably won't rain."
      ],
      "audioText": "It will probably be cloudy, but it probably won't rain.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-risk-probability-1"
    },
    {
      "id": "en.n9.class-41.t04",
      "en": "Ice is unlikely before noon, but it is still a hazard after dark.",
      "es": "Es poco probable que haya hielo antes del mediodía, pero sigue siendo un peligro al anochecer.",
      "explanationEs": "Unlikely = poco probable. Hazard nombra el peligro; la probabilidad es otra cosa.",
      "segments": [
        "Ice is unlikely before noon, but it",
        "is still a hazard after dark."
      ],
      "audioText": "Ice is unlikely before noon, but it is still a hazard after dark.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-risk-probability-1"
    },
    {
      "id": "en.n9.class-41.t05",
      "en": "There is a slim chance of sunshine, so take a raincoat.",
      "es": "Hay una posibilidad escasa de sol, así que lleva un impermeable.",
      "explanationEs": "A slim chance: baja pero no nula. No chance significa imposible.",
      "segments": [
        "There is a slim chance of",
        "sunshine, so take a raincoat."
      ],
      "audioText": "There is a slim chance of sunshine, so take a raincoat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-risk-probability-1"
    }
