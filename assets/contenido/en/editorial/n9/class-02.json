  "teaching": [
    {
      "id": "en.n9.class-02.t01",
      "en": "A bland introduction gives only your name and job, so nobody remembers it.",
      "es": "Una presentación sosa da solo tu nombre y tu trabajo, así que nadie la recuerda.",
      "explanationEs": "Bland describe algo sin sabor: aquí, una presentación sin nada personal.",
      "segments": [
        "A bland introduction gives only your name",
        "and job, so nobody remembers it."
      ],
      "audioText": "A bland introduction gives only your name and job, so nobody remembers it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-2"
    },
    {
      "id": "en.n9.class-02.t02",
      "en": "Add a hook: 'I'm Sara, a nurse who is learning to surf at forty.'",
      "es": "Añade un gancho: «Soy Sara, enfermera, y estoy aprendiendo a hacer surf a los cuarenta».",
      "explanationEs": "El hook es un dato concreto y sorprendente que se queda en la memoria.",
      "segments": [
        "Add a hook: 'I'm Sara, a nurse",
        "who is learning to surf at forty.'"
      ],
      "audioText": "Add a hook: 'I'm Sara, a nurse who is learning to surf at forty.'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-2"
    },
    {
      "id": "en.n9.class-02.t03",
      "en": "One small quirk makes you memorable: 'I bake bread at five every morning.'",
      "es": "Una pequeña rareza te hace memorable: «Hago pan a las cinco de la mañana».",
      "explanationEs": "Quirk es un hábito peculiar y simpático; memorable = fácil de recordar.",
      "segments": [
        "One small quirk makes you memorable: 'I",
        "bake bread at five every morning.'"
      ],
      "audioText": "One small quirk makes you memorable: 'I bake bread at five every morning.'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-2"
    },
    {
      "id": "en.n9.class-02.t04",
      "en": "Keep the pitch short and end with a question: 'I design gardens. What about you?'",
      "es": "Mantén la presentación breve y termina con una pregunta: «Diseño jardines. ¿Y tú?».",
      "explanationEs": "Un pitch cabe en diez segundos; la pregunta final devuelve la palabra.",
      "segments": [
        "Keep the pitch short and end with a",
        "question: 'I design gardens. What about you?'"
      ],
      "audioText": "Keep the pitch short and end with a question: 'I design gardens. What about you?'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-2"
    },
    {
      "id": "en.n9.class-02.t05",
      "en": "A tag like 'isn't it?' invites the other person to agree: 'It's a lovely venue, isn't it?'",
      "es": "Una coletilla como «isn't it?» invita al otro a estar de acuerdo: «Es un lugar precioso, ¿verdad?».",
      "explanationEs": "Frase afirmativa + coletilla negativa; venue es el lugar donde se celebra el evento.",
      "segments": [
        "A tag like 'isn't it?' invites the other person",
        "to agree: 'It's a lovely venue, isn't it?'"
      ],
      "audioText": "A tag like 'isn't it?' invites the other person to agree: 'It's a lovely venue, isn't it?'",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-networking-rapport-2"
    }
  ],
