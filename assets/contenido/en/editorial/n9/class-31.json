  "teaching": [
    {
      "id": "en.n9.class-31.t01",
      "en": "As the chart shows, attendance rose steadily from 400 to 900 over the season.",
      "es": "Como muestra el gráfico, la asistencia subió de forma constante de 400 a 900 a lo largo de la temporada.",
      "explanationEs": "As the chart shows abre la descripción; rose steadily dice que subió sin saltos; from… to… da el inicio y el final.",
      "segments": [
        "As the chart shows, attendance rose steadily",
        "from 400 to 900 over the season."
      ],
      "audioText": "As the chart shows, attendance rose steadily from 400 to 900 over the season.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-data-storytelling-1"
    },
    {
      "id": "en.n9.class-31.t02",
      "en": "Daily steps rose sharply by 20 percent in June, and that month was the peak of the year.",
      "es": "Los pasos diarios subieron bruscamente un 20 % en junio, y ese mes fue el punto máximo del año.",
      "explanationEs": "By + cifra dice cuánto cambió (en español «en un 20 %»). Peak es el punto más alto de la línea.",
      "segments": [
        "Daily steps rose sharply by 20 percent in June,",
        "and that month was the peak of the year."
      ],
      "audioText": "Daily steps rose sharply by 20 percent in June, and that month was the peak of the year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-data-storytelling-1"
    },
    {
      "id": "en.n9.class-31.t03",
      "en": "Temperatures fluctuate between 12 and 18 degrees in spring, so there is no clear trend.",
      "es": "Las temperaturas fluctúan entre 12 y 18 grados en primavera, así que no hay una tendencia clara.",
      "explanationEs": "Fluctuate describe una línea en zigzag; trend es la dirección general de la línea.",
      "segments": [
        "Temperatures fluctuate between 12 and 18 degrees in",
        "spring, so there is no clear trend."
      ],
      "audioText": "Temperatures fluctuate between 12 and 18 degrees in spring, so there is no clear trend.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-data-storytelling-1"
    },
    {
      "id": "en.n9.class-31.t04",
      "en": "Roughly two thirds of the fans come by bus, so the majority travel together.",
      "es": "Aproximadamente dos tercios de los aficionados vienen en autobús, así que la mayoría viaja junta.",
      "explanationEs": "Roughly suaviza la cifra porque no es exacta. Majority significa más de la mitad, y dos tercios la superan.",
      "segments": [
        "Roughly two thirds of the fans come",
        "by bus, so the majority travel together."
      ],
      "audioText": "Roughly two thirds of the fans come by bus, so the majority travel together.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-data-storytelling-1"
    },
    {
      "id": "en.n9.class-31.t05",
      "en": "Only a quarter of the students walk to school, and that proportion has not changed.",
      "es": "Solo una cuarta parte de los estudiantes va andando al colegio, y esa proporción no ha cambiado.",
      "explanationEs": "A quarter es el 25 %. Proportion es la parte que algo representa dentro del total.",
      "segments": [
        "Only a quarter of the students walk to",
        "school, and that proportion has not changed."
      ],
      "audioText": "Only a quarter of the students walk to school, and that proportion has not changed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-data-storytelling-1"
    }
