      "patternId": "n9-conflict-repair-3"
    },
    {
      "id": "en.n9.class-63.t04",
      "en": "Your tone is hurting me more than your words.",
      "es": "Tu tono me hace más daño que tus palabras.",
      "explanationEs": "El tono importa tanto como las palabras: se puede señalar con calma.",
      "segments": [
        "Your tone is hurting me",
        "more than your words."
      ],
      "audioText": "Your tone is hurting me more than your words.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-3"
    },
    {
      "id": "en.n9.class-63.t05",
      "en": "Let's take a break and repair this calmly.",
      "es": "Hagamos una pausa y arreglemos esto con calma.",
      "explanationEs": "Proponer una pausa baja la tensión; repair es el verbo de arreglar una relación.",
      "segments": [
        "Let's take a break",
        "and repair this calmly."
      ],
      "audioText": "Let's take a break and repair this calmly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-3"
    },
