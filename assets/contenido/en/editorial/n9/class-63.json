  "teaching": [
    {
      "id": "en.n9.class-63.t01",
      "en": "Please don't interrupt me; let me finish.",
      "es": "Por favor, no me interrumpas; déjame terminar.",
      "explanationEs": "Interrumpir y hablar por encima del otro es una señal de que la discusión se agrava.",
      "segments": [
        "Please don't interrupt me;",
        "let me finish."
      ],
      "audioText": "Please don't interrupt me; let me finish.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-3"
    },
    {
      "id": "en.n9.class-63.t02",
      "en": "That sarcastic comment will escalate the argument.",
      "es": "Ese comentario sarcástico hará que la discusión vaya a más.",
      "explanationEs": "El sarcasmo dice lo contrario de lo que siente y hiere: agrava la discusión.",
      "segments": [
        "That sarcastic comment will",
        "escalate the argument."
      ],
      "audioText": "That sarcastic comment will escalate the argument.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-3"
    },
    {
      "id": "en.n9.class-63.t03",
      "en": "Fair point. I was defensive, and I'm sorry.",
      "es": "Buen punto. Estaba a la defensiva y lo siento.",
      "explanationEs": "Fair point reconoce lo razonable de la otra persona: señal de reparación.",
      "segments": [
        "Fair point. I was",
        "defensive, and I'm sorry."
      ],
      "audioText": "Fair point. I was defensive, and I'm sorry.",
