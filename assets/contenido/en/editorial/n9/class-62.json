  "teaching": [
    {
      "id": "en.n9.class-62.t01",
      "en": "What I'm hearing is that you feel overwhelmed by the chores.",
      "es": "Lo que te escucho decir es que te sientes agobiado por las tareas de la casa.",
      "explanationEs": "What I'm hearing is that + emoción: nombra lo que sientes, sin juzgar.",
      "segments": [
        "What I'm hearing is that you",
        "feel overwhelmed by the chores."
      ],
      "audioText": "What I'm hearing is that you feel overwhelmed by the chores.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-2"
    },
    {
      "id": "en.n9.class-62.t02",
      "en": "It sounds like you feel left out, and you need to be asked first.",
      "es": "Parece que te sientes excluido y necesitas que te pregunten antes.",
      "explanationEs": "It sounds like + emoción + necesidad: refleja las dos cosas.",
      "segments": [
        "It sounds like you feel left out,",
        "and you need to be asked first."
      ],
      "audioText": "It sounds like you feel left out, and you need to be asked first.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-2"
    },
    {
      "id": "en.n9.class-62.t03",
      "en": "So you need more help, and you wish we shared the chores. Is that right?",
      "es": "Entonces necesitas más ayuda y desearías que repartiéramos las tareas. ¿Es así?",
      "explanationEs": "Termina comprobando: Is that right? / Did I get that right?",
      "segments": [
        "So you need more help, and you wish",
        "we shared the chores. Is that right?"
      ],
      "audioText": "So you need more help, and you wish we shared the chores. Is that right?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-2"
    },
    {
      "id": "en.n9.class-62.t04",
      "en": "It sounds like you wish we had more time together.",
      "es": "Parece que desearías que tuviéramos más tiempo juntos.",
      "explanationEs": "Wish + pasado simple: un deseo sobre algo que no es así ahora.",
      "segments": [
        "It sounds like you wish",
        "we had more time together."
      ],
      "audioText": "It sounds like you wish we had more time together.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-2"
    },
    {
      "id": "en.n9.class-62.t05",
      "en": "If only we had talked sooner, you would not feel so alone.",
      "es": "Si hubiéramos hablado antes, no te sentirías tan solo.",
      "explanationEs": "If only expresa arrepentimiento propio; se reformula con calma, sin defenderse.",
      "segments": [
        "If only we had talked sooner,",
        "you would not feel so alone."
      ],
      "audioText": "If only we had talked sooner, you would not feel so alone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-conflict-repair-2"
    },
    {
      "id": "en.n9.class-62.t06",
      "en": "I can see why you feel left out. Did I get that right?",
      "es": "Entiendo por qué te sientes excluido. ¿Lo he entendido bien?",
      "explanationEs": "Validar la emoción no significa darle la razón en todo.",
      "segments": [
