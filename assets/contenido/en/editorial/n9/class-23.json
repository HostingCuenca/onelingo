  "teaching": [
    {
      "id": "en.n9.class-23.t01",
      "en": "Carlos is in favour of the new bike lane, but Mia is opposed to it.",
      "es": "Carlos está a favor del nuevo carril bici, pero Mia se opone.",
      "explanationEs": "Be in favour of / be opposed to + nombre: así se declara una postura.",
      "segments": [
        "Carlos is in favour of the new bike",
        "lane, but Mia is opposed to it."
      ],
      "audioText": "Carlos is in favour of the new bike lane, but Mia is opposed to it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-3"
    },
    {
      "id": "en.n9.class-23.t02",
      "en": "The proposal is to close the street on Sundays, and the vote is on 12 May.",
      "es": "La propuesta es cerrar la calle los domingos y la votación es el 12 de mayo.",
      "explanationEs": "Proposal es la idea sobre la mesa; the proposal is to + verbo la resume.",
      "segments": [
        "The proposal is to close the street on",
        "Sundays, and the vote is on 12 May."
      ],
      "audioText": "The proposal is to close the street on Sundays, and the vote is on 12 May.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-3"
    },
    {
      "id": "en.n9.class-23.t03",
      "en": "Leo's position is clear, but I am afraid I cannot agree.",
      "es": "La postura de Leo está clara, pero me temo que no puedo estar de acuerdo.",
      "explanationEs": "I am afraid I cannot agree es una señal de desacuerdo educado.",
      "segments": [
        "Leo's position is clear, but I",
        "am afraid I cannot agree."
      ],
      "audioText": "Leo's position is clear, but I am afraid I cannot agree.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-3"
    },
    {
      "id": "en.n9.class-23.t04",
      "en": "I take your point, Leo, but the proposal costs too much.",
      "es": "Entiendo tu punto, Leo, pero la propuesta cuesta demasiado.",
      "explanationEs": "I take your point, but… reconoce lo dicho y discrepa a continuación.",
      "segments": [
        "I take your point, Leo, but",
        "the proposal costs too much."
      ],
      "audioText": "I take your point, Leo, but the proposal costs too much.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-community-meetings-3"
    },
    {
      "id": "en.n9.class-23.t05",
      "en": "Sara will volunteer to write to the council, and the deadline is Friday.",
      "es": "Sara se ofrecerá a escribir al ayuntamiento y el plazo es el viernes.",
      "explanationEs": "Will + verbo con el nombre de la persona: quien se ofrece queda como responsable.",
      "segments": [
        "Sara will volunteer to write to the",
        "council, and the deadline is Friday."
