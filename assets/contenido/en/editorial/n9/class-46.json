  "teaching": [
    {
      "id": "en.n9.class-46.t01",
      "en": "All students are required to wear the school uniform.",
      "es": "Todos los alumnos deben llevar el uniforme escolar.",
      "explanationEs": "Be required to + verbo: obligación formal; el reglamento no dice «debes», sino «se exige».",
      "segments": [
        "All students are required to",
        "wear the school uniform."
      ],
      "audioText": "All students are required to wear the school uniform.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    },
    {
      "id": "en.n9.class-46.t02",
      "en": "Attendance at the morning assembly is compulsory.",
      "es": "La asistencia a la asamblea de la mañana es obligatoria.",
      "explanationEs": "Compulsory (y mandatory) son adjetivos de obligación propios de los reglamentos.",
      "segments": [
        "Attendance at the morning",
        "assembly is compulsory."
      ],
      "audioText": "Attendance at the morning assembly is compulsory.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    },
    {
      "id": "en.n9.class-46.t03",
      "en": "Mobile phones are prohibited in the classroom.",
      "es": "Los teléfonos móviles están prohibidos en el aula.",
      "explanationEs": "Is/are prohibited: prohibición formal; equivale a must not.",
      "segments": [
        "Mobile phones are prohibited",
        "in the classroom."
      ],
      "audioText": "Mobile phones are prohibited in the classroom.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    },
    {
      "id": "en.n9.class-46.t04",
      "en": "Students are permitted to use the library after four.",
      "es": "Los alumnos pueden usar la biblioteca después de las cuatro.",
      "explanationEs": "Are permitted to + verbo: permiso formal; equivale a may o are allowed to.",
      "segments": [
        "Students are permitted to use",
        "the library after four."
      ],
      "audioText": "Students are permitted to use the library after four.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    },
    {
      "id": "en.n9.class-46.t05",
      "en": "Wearing a tie is optional, so you don't have to wear one.",
      "es": "Llevar corbata es opcional, así que no tienes que llevarla.",
      "explanationEs": "Optional y don't have to: no es obligatorio. No significa que esté prohibido.",
      "segments": [
        "Wearing a tie is optional, so",
        "you don't have to wear one."
      ],
      "audioText": "Wearing a tie is optional, so you don't have to wear one.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    },
    {
      "id": "en.n9.class-46.t06",
      "en": "Staff must not park in front of the gate.",
      "es": "El personal no debe aparcar frente a la puerta.",
      "explanationEs": "Must not = prohibido. Ojo: no equivale a don't have to, que solo dice «no hace falta».",
      "segments": [
        "Staff must not park in",
        "front of the gate."
      ],
      "audioText": "Staff must not park in front of the gate.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n9-public-rules-1"
    }
  ],
