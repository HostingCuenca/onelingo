  "teaching": [
    {
      "id": "en.n7.class-32.t01",
      "en": "I'd have thought the heating was included in the rent.",
      "es": "Habría pensado que la calefacción estaba incluida en el alquiler.",
      "explanationEs": "I'd have thought + pasado: expresas sorpresa porque esperabas otra cosa, sin decir «no».",
      "segments": [
        "I'd have thought the heating",
        "was included in the rent."
      ],
      "audioText": "I'd have thought the heating was included in the rent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-2"
    },
    {
      "id": "en.n7.class-32.t02",
      "en": "I'm not sure I'd agree that the bills should be split equally.",
      "es": "No estoy seguro de estar de acuerdo con que las facturas se dividan a partes iguales.",
      "explanationEs": "I'm not sure I'd agree = «no estoy seguro de estar de acuerdo»: un no más suave.",
      "segments": [
        "I'm not sure I'd agree that",
        "the bills should be split equally."
      ],
      "audioText": "I'm not sure I'd agree that the bills should be split equally.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-2"
    },
    {
      "id": "en.n7.class-32.t03",
      "en": "I'd tend to think the flat is too noisy after midnight.",
      "es": "Yo tendería a pensar que el piso es demasiado ruidoso después de medianoche.",
      "explanationEs": "I'd tend to + verbo base presenta tu opinión como tendencia, no como verdad absoluta.",
      "segments": [
        "I'd tend to think the flat",
        "is too noisy after midnight."
      ],
      "audioText": "I'd tend to think the flat is too noisy after midnight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-2"
    },
    {
      "id": "en.n7.class-32.t04",
      "en": "We agreed to pay the rent on the first, didn't we?",
      "es": "Acordamos pagar el alquiler el día uno, ¿verdad?",
      "explanationEs": "La cola didn't we? comprueba un dato que ya creías acordado, sin acusar.",
      "segments": [
        "We agreed to pay the rent",
        "on the first, didn't we?"
      ],
      "audioText": "We agreed to pay the rent on the first, didn't we?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-2"
    },
    {
      "id": "en.n7.class-32.t05",
      "en": "I'd have thought the landlord would call us first.",
      "es": "Habría pensado que el casero nos llamaría primero.",
      "explanationEs": "Después de have va el participio thought; el hecho esperado usa would o pasado.",
      "segments": [
        "I'd have thought the landlord",
        "would call us first."
      ],
      "audioText": "I'd have thought the landlord would call us first.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-2"
    }
