  "teaching": [
    {
      "id": "en.n7.class-56.t01",
      "en": "I can offer you eighty dollars for the bike.",
      "es": "Puedo ofrecerte ochenta dólares por la bici.",
      "explanationEs": "I can offer you + cantidad: es una oferta concreta.",
      "segments": [
        "I can offer you eighty",
        "dollars for the bike."
      ],
      "audioText": "I can offer you eighty dollars for the bike.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-1"
    },
    {
      "id": "en.n7.class-56.t02",
      "en": "That is more than I can afford; would you take seventy?",
      "es": "Eso es más de lo que puedo pagar; ¿aceptarías setenta?",
      "explanationEs": "More than I can afford rechaza con educación; would you take + cantidad es una contraoferta.",
      "segments": [
        "That is more than I can",
        "afford; would you take seventy?"
      ],
      "audioText": "That is more than I can afford; would you take seventy?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-1"
    },
    {
      "id": "en.n7.class-56.t03",
      "en": "I can give you a discount if you pick it up today.",
      "es": "Puedo hacerte un descuento si vienes a recogerla hoy.",
      "explanationEs": "Give you a discount + if: es una concesión con condición.",
      "segments": [
        "I can give you a discount",
        "if you pick it up today."
      ],
      "audioText": "I can give you a discount if you pick it up today.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-1"
    },
    {
      "id": "en.n7.class-56.t04",
      "en": "I am afraid that is my final price.",
      "es": "Me temo que ese es mi precio definitivo.",
      "explanationEs": "I am afraid suaviza el rechazo; final price cierra la negociación.",
      "segments": [
        "I am afraid that",
        "is my final price."
      ],
      "audioText": "I am afraid that is my final price.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-1"
    },
    {
      "id": "en.n7.class-56.t05",
      "en": "The bike is worth the money, because it is almost new.",
      "es": "La bici vale lo que cuesta, porque es casi nueva.",
      "explanationEs": "Be worth + dinero justifica el precio con una razón.",
      "segments": [
