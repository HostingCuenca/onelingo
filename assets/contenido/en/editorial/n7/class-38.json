  "teaching": [
    {
      "id": "en.n7.class-38.t01",
      "en": "My heart is a suitcase, packed and by the door.",
      "es": "Mi corazón es una maleta, hecha y junto a la puerta.",
      "explanationEs": "Metáfora: el cantante está listo para irse, con nervios e ilusión.",
      "segments": [
        "My heart is a suitcase,",
        "packed and by the door."
      ],
      "audioText": "My heart is a suitcase, packed and by the door.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-3"
    },
    {
      "id": "en.n7.class-38.t02",
      "en": "The city is a river, and I can't swim anymore.",
      "es": "La ciudad es un río y ya no puedo nadar.",
      "explanationEs": "Metáfora de agobio: la vida en la ciudad lo supera. Not… anymore = «ya no».",
      "segments": [
        "The city is a river,",
        "and I can't swim anymore."
      ],
      "audioText": "The city is a river, and I can't swim anymore.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-3"
    },
    {
      "id": "en.n7.class-38.t03",
      "en": "You are my lighthouse, shining through the rain.",
      "es": "Eres mi faro, que brilla a través de la lluvia.",
      "explanationEs": "El faro es alguien que te guía y te da seguridad en medio del mal tiempo.",
      "segments": [
        "You are my lighthouse,",
        "shining through the rain."
      ],
      "audioText": "You are my lighthouse, shining through the rain.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-3"
    },
    {
      "id": "en.n7.class-38.t04",
      "en": "I'm a little boat that's sailing home again.",
      "es": "Soy un pequeño barco que navega de nuevo hacia casa.",
      "explanationEs": "Sentido figurado: después de un mal momento, vuelve la calma. Home va sin to.",
      "segments": [
        "I'm a little boat",
        "that's sailing home again."
      ],
      "audioText": "I'm a little boat that's sailing home again.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-3"
    },
    {
      "id": "en.n7.class-38.t05",
      "en": "In the lyrics, the verse shows a tired singer, but the chorus brings hope.",
      "es": "En la letra, la estrofa muestra a un cantante cansado, pero el estribillo trae esperanza.",
      "explanationEs": "La estrofa cuenta el problema y el estribillo repite la idea principal.",
      "segments": [
        "In the lyrics, the verse shows a",
        "tired singer, but the chorus brings hope."
      ],
      "audioText": "In the lyrics, the verse shows a tired singer, but the chorus brings hope.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-3"
    }
