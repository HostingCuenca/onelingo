  "teaching": [
    {
      "id": "en.n7.class-16.t01",
      "en": "The fault was undoubtedly caused by the storm.",
      "es": "El fallo fue, sin duda, causado por la tormenta.",
      "explanationEs": "Undoubtedly (o certainly) expresa casi un 100 % de certeza: el hablante no tiene dudas.",
      "segments": [
        "The fault was undoubtedly",
        "caused by the storm."
      ],
      "audioText": "The fault was undoubtedly caused by the storm.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-1"
    },
    {
      "id": "en.n7.class-16.t02",
      "en": "In all likelihood, the power will be back by midnight.",
      "es": "Con toda probabilidad, la luz volverá antes de medianoche.",
      "explanationEs": "In all likelihood = muy probable; va al inicio de la frase, con coma.",
      "segments": [
        "In all likelihood, the power",
        "will be back by midnight."
      ],
      "audioText": "In all likelihood, the power will be back by midnight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-1"
    },
    {
      "id": "en.n7.class-16.t03",
      "en": "The engineers are presumably working on the cable now.",
      "es": "Los técnicos están presumiblemente trabajando en el cable ahora.",
      "explanationEs": "Presumably es una suposición razonable: se basa en lo que se sabe, pero no está confirmada.",
      "segments": [
        "The engineers are presumably working",
        "on the cable now."
      ],
      "audioText": "The engineers are presumably working on the cable now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-1"
    },
    {
      "id": "en.n7.class-16.t04",
      "en": "The blackout was possibly caused by an animal, but we cannot be sure.",
      "es": "El apagón lo causó posiblemente un animal, pero no podemos estar seguros.",
      "explanationEs": "Possibly deja abierta la posibilidad: puede que sí y puede que no.",
      "segments": [
        "The blackout was possibly caused by an",
        "animal, but we cannot be sure."
      ],
      "audioText": "The blackout was possibly caused by an animal, but we cannot be sure.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-1"
    },
    {
      "id": "en.n7.class-16.t05",
      "en": "The cable was conceivably cut by a fox, but nobody has seen one.",
      "es": "El cable lo cortó, en teoría, un zorro, pero nadie ha visto ninguno.",
      "explanationEs": "Conceivably = es imaginable, pero poco creíble: certeza baja.",
      "segments": [
        "The cable was conceivably cut by a",
        "fox, but nobody has seen one."
      ],
      "audioText": "The cable was conceivably cut by a fox, but nobody has seen one.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-1"
    },
    {
      "id": "en.n7.class-16.t06",
      "en": "It is doubtful that the lights will come on before morning.",
      "es": "Es dudoso que la luz vuelva antes de la mañana.",
      "explanationEs": "It is doubtful that + oración expresa poca probabilidad; el adjetivo va tras it is.",
      "segments": [
