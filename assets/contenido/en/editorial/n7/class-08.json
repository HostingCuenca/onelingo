  "teaching": [
    {
      "id": "en.n7.class-08.t01",
      "en": "Our itinerary says we leave Lima at six and land in Madrid at noon.",
      "es": "Nuestro itinerario dice que salimos de Lima a las seis y aterrizamos en Madrid a mediodía.",
      "explanationEs": "El itinerario fija el orden y las horas de un viaje.",
      "segments": [
        "Our itinerary says we leave Lima at",
        "six and land in Madrid at noon."
      ],
      "audioText": "Our itinerary says we leave Lima at six and land in Madrid at noon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    },
    {
      "id": "en.n7.class-08.t02",
      "en": "The flight was delayed, so we waited at the stopover for five hours.",
      "es": "El vuelo se retrasó, así que esperamos en la escala cinco horas.",
      "explanationEs": "For + duración dice cuánto tiempo duró la espera.",
      "segments": [
        "The flight was delayed, so we waited",
        "at the stopover for five hours."
      ],
      "audioText": "The flight was delayed, so we waited at the stopover for five hours.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    },
    {
      "id": "en.n7.class-08.t03",
      "en": "We waited until the gate opened.",
      "es": "Esperamos hasta que se abrió la puerta de embarque.",
      "explanationEs": "Until marca el punto en el que termina la espera.",
      "segments": [
        "We waited until",
        "the gate opened."
      ],
      "audioText": "We waited until the gate opened.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    },
    {
      "id": "en.n7.class-08.t04",
      "en": "No sooner had we sat down than the boarding call started.",
      "es": "Apenas nos habíamos sentado cuando empezó la llamada de embarque.",
      "explanationEs": "No sooner had + sujeto + participio… than une dos hechos casi seguidos; el primero va con had.",
      "segments": [
        "No sooner had we sat down",
        "than the boarding call started."
      ],
      "audioText": "No sooner had we sat down than the boarding call started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    },
    {
      "id": "en.n7.class-08.t05",
      "en": "Hardly had we landed when my phone rang.",
      "es": "Apenas habíamos aterrizado cuando sonó mi teléfono.",
      "explanationEs": "Hardly had… when funciona igual que no sooner… than.",
      "segments": [
        "Hardly had we landed",
        "when my phone rang."
      ],
      "audioText": "Hardly had we landed when my phone rang.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    },
    {
      "id": "en.n7.class-08.t06",
      "en": "Ever since that trip, I have hated stopovers.",
      "es": "Desde aquel viaje, odio las escalas.",
      "explanationEs": "Ever since + momento dice desde cuándo dura algo hasta hoy; el verbo va en present perfect.",
      "segments": [
        "Ever since that trip,",
        "I have hated stopovers."
      ],
      "audioText": "Ever since that trip, I have hated stopovers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-3"
    }
