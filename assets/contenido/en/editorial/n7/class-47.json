    {
      "id": "en.n7.class-47.t01",
      "en": "In view of the noise, the school should close the road.",
      "es": "Dado el ruido, el colegio debería cerrar la calle.",
      "explanationEs": "In view of + sustantivo (the noise): fundamento que todos conocen; con una oración se dice in view of the fact that.",
      "segments": [
        "In view of the noise, the",
        "school should close the road."
      ],
      "audioText": "In view of the noise, the school should close the road.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-2"
    },
    {
      "id": "en.n7.class-47.t02",
      "en": "The school decided to ban phones on the grounds that they distract students.",
      "es": "El colegio decidió prohibir los móviles alegando que distraen a los estudiantes.",
      "explanationEs": "On the grounds that + oración completa: el motivo oficial de una decisión.",
      "segments": [
        "The school decided to ban phones on",
        "the grounds that they distract students."
      ],
      "audioText": "The school decided to ban phones on the grounds that they distract students.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-2"
    },
    {
      "id": "en.n7.class-47.t03",
      "en": "Homework is useful insofar as it helps students practise.",
      "es": "Los deberes son útiles en la medida en que ayudan a los estudiantes a practicar.",
      "explanationEs": "Insofar as + oración: la afirmación vale solo hasta cierto punto.",
      "segments": [
        "Homework is useful insofar as",
        "it helps students practise."
      ],
      "audioText": "Homework is useful insofar as it helps students practise.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-2"
    },
    {
      "id": "en.n7.class-47.t04",
      "en": "Seeing that the test is on Friday, we should revise tonight.",
      "es": "Visto que el examen es el viernes, deberíamos repasar esta noche.",
      "explanationEs": "Seeing that + oración: el motivo ya es conocido; suena más conversacional.",
      "segments": [
        "Seeing that the test is on",
        "Friday, we should revise tonight."
      ],
      "audioText": "Seeing that the test is on Friday, we should revise tonight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-2"
    },
    {
      "id": "en.n7.class-47.t05",
      "en": "You need to justify a rule before you ask people to follow it.",
      "es": "Tienes que justificar una norma antes de pedir a la gente que la cumpla.",
      "explanationEs": "Justify = dar fundamento; estos conectores sirven para eso.",
      "segments": [
