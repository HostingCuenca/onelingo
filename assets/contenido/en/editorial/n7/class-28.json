      "patternId": "n7-cohesion-reference-3"
    },
    {
      "id": "en.n7.class-28.t05",
      "en": "Leo packed his backpack before sunrise, and Mia did too.",
      "es": "Leo hizo su mochila antes del amanecer y Mia también.",
      "explanationEs": "Did too evita repetir todo el verbo: Mia packed her backpack too.",
      "segments": [
        "Leo packed his backpack before",
        "sunrise, and Mia did too."
