  "teaching": [
    {
      "id": "en.n7.class-46.t01",
      "en": "My claim is that schools should start later.",
      "es": "Mi tesis es que las clases deberían empezar más tarde.",
      "explanationEs": "Claim = lo que defiendes; en una frase, suele ir al principio del párrafo.",
      "segments": [
        "My claim is that",
        "schools should start later."
      ],
      "audioText": "My claim is that schools should start later.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    },
    {
      "id": "en.n7.class-46.t02",
      "en": "My first reason is that teenagers need more sleep.",
      "es": "Mi primera razón es que los adolescentes necesitan dormir más.",
      "explanationEs": "Reason = por qué defiendes la tesis.",
      "segments": [
        "My first reason is that",
        "teenagers need more sleep."
      ],
      "audioText": "My first reason is that teenagers need more sleep.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    },
    {
      "id": "en.n7.class-46.t03",
      "en": "For example, many students fall asleep in the first lesson.",
      "es": "Por ejemplo, muchos estudiantes se duermen en la primera clase.",
      "explanationEs": "Example = un caso real que hace creíble la razón; for example va al inicio de la frase.",
      "segments": [
        "For example, many students fall",
        "asleep in the first lesson."
      ],
      "audioText": "For example, many students fall asleep in the first lesson.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    },
    {
      "id": "en.n7.class-46.t04",
      "en": "A fact or a number is stronger evidence than a feeling.",
      "es": "Un dato o una cifra es una prueba más fuerte que una sensación.",
      "explanationEs": "Fact = dato comprobable; evidence = lo que demuestra que la razón es cierta.",
      "segments": [
        "A fact or a number is",
        "stronger evidence than a feeling."
      ],
      "audioText": "A fact or a number is stronger evidence than a feeling.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    },
    {
      "id": "en.n7.class-46.t05",
      "en": "To argue well, a writer makes sure that every reason supports the claim.",
      "es": "Para argumentar bien, quien escribe se asegura de que cada razón respalde la tesis.",
      "explanationEs": "Support = respaldar: una razón que no apoya la tesis cambia de tema.",
      "segments": [
        "To argue well, a writer makes sure",
        "that every reason supports the claim."
      ],
      "audioText": "To argue well, a writer makes sure that every reason supports the claim.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    },
    {
      "id": "en.n7.class-46.t06",
      "en": "A clear paragraph can end with a short conclusion that repeats the claim.",
      "es": "Un párrafo claro puede terminar con una conclusión breve que repite la tesis.",
      "explanationEs": "Conclusion = cierre que recuerda la tesis con otras palabras.",
      "segments": [
        "A clear paragraph can end with a",
        "short conclusion that repeats the claim."
      ],
      "audioText": "A clear paragraph can end with a short conclusion that repeats the claim.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-argument-structure-1"
    }
  ],
