  "teaching": [
    {
      "id": "en.n7.class-87.t01",
      "en": "I want to emphasise one word: this offer is FREE.",
      "es": "Quiero destacar una palabra: esta oferta es GRATIS.",
      "explanationEs": "Las mayúsculas marcan la palabra con acento enfático: sube el tono y suena más larga.",
      "segments": [
        "I want to emphasise one",
        "word: this offer is FREE."
      ],
      "audioText": "I want to emphasise one word: this offer is FREE.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    },
    {
      "id": "en.n7.class-87.t02",
      "en": "He stressed the word THOUSAND: we need ten thousand volunteers, not ten.",
      "es": "Acentuó la palabra THOUSAND: necesitamos diez mil voluntarios, no diez.",
      "explanationEs": "El acento enfático va en la palabra que corrige o contrasta con lo anterior.",
      "segments": [
        "He stressed the word THOUSAND: we",
        "need ten thousand volunteers, not ten."
      ],
      "audioText": "He stressed the word THOUSAND: we need ten thousand volunteers, not ten.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    },
    {
      "id": "en.n7.class-87.t03",
      "en": "Take a short pause before the key number, and the audience will listen.",
      "es": "Haz una pausa corta antes de la cifra clave y el público escuchará.",
      "explanationEs": "La pausa antes de la cifra crea expectativa; después de ella, deja tiempo al público para pensar.",
      "segments": [
        "Take a short pause before the key",
        "number, and the audience will listen."
      ],
      "audioText": "Take a short pause before the key number, and the audience will listen.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    },
    {
      "id": "en.n7.class-87.t04",
      "en": "Keep a steady pace: if you speak too fast, nobody can follow you.",
      "es": "Mantén un ritmo constante: si hablas demasiado rápido, nadie puede seguirte.",
      "explanationEs": "Pace es la velocidad al hablar; baja el ritmo en los datos clave.",
      "segments": [
        "Keep a steady pace: if you speak",
        "too fast, nobody can follow you."
      ],
      "audioText": "Keep a steady pace: if you speak too fast, nobody can follow you.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    },
    {
      "id": "en.n7.class-87.t05",
      "en": "Let your intonation fall at the end of a statement: we open at nine.",
      "es": "Deja que tu entonación baje al final de una afirmación: abrimos a las nueve.",
      "explanationEs": "Entonación descendente: la frase queda cerrada.",
      "segments": [
        "Let your intonation fall at the end",
        "of a statement: we open at nine."
      ],
      "audioText": "Let your intonation fall at the end of a statement: we open at nine.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    },
    {
      "id": "en.n7.class-87.t06",
      "en": "Does your voice rise at the end of a question like: are you ready?",
      "es": "¿Sube tu voz al final de una pregunta como: are you ready?",
      "explanationEs": "Entonación ascendente: pregunta de sí o no.",
      "segments": [
        "Does your voice rise at the end",
        "of a question like: are you ready?"
      ],
      "audioText": "Does your voice rise at the end of a question like: are you ready?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-2"
    }
