  "teaching": [
    {
      "id": "en.n7.class-82.t01",
      "en": "Could you possibly send me the schedule today?",
      "es": "¿Podrías enviarme el horario hoy, si es posible?",
      "explanationEs": "Could you possibly + verbo base suaviza la petición; possibly añade cortesía.",
      "segments": [
        "Could you possibly send",
        "me the schedule today?"
      ],
      "audioText": "Could you possibly send me the schedule today?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    },
    {
      "id": "en.n7.class-82.t02",
      "en": "I was wondering if you could do me a favour and check the report.",
      "es": "Me preguntaba si podrías hacerme un favor y revisar el informe.",
      "explanationEs": "I was wondering if + could: petición muy indirecta; el pasado aumenta la distancia y la cortesía.",
      "segments": [
        "I was wondering if you could do",
        "me a favour and check the report."
      ],
      "audioText": "I was wondering if you could do me a favour and check the report.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    },
    {
      "id": "en.n7.class-82.t03",
      "en": "Would you mind checking the draft before Friday?",
      "es": "¿Te importaría revisar el borrador antes del viernes?",
      "explanationEs": "Would you mind + verbo con -ing; para aceptar se responde Not at all.",
      "segments": [
        "Would you mind checking",
        "the draft before Friday?"
      ],
      "audioText": "Would you mind checking the draft before Friday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    },
    {
      "id": "en.n7.class-82.t04",
      "en": "Do you know whether the manager is available on Monday?",
      "es": "¿Sabes si el encargado está disponible el lunes?",
      "explanationEs": "Pregunta indirecta: whether/if + sujeto + verbo, sin do ni inversión.",
      "segments": [
        "Do you know whether the",
        "manager is available on Monday?"
      ],
      "audioText": "Do you know whether the manager is available on Monday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    },
    {
      "id": "en.n7.class-82.t05",
      "en": "Unfortunately, I am not available on Monday, but I can call you on Tuesday.",
      "es": "Por desgracia, no estoy disponible el lunes, pero puedo llamarte el martes.",
      "explanationEs": "Unfortunately + rechazo, but + alternativa: rechazar con tacto ofrece una solución.",
      "segments": [
        "Unfortunately, I am not available on Monday,",
        "but I can call you on Tuesday."
      ],
      "audioText": "Unfortunately, I am not available on Monday, but I can call you on Tuesday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    },
    {
      "id": "en.n7.class-82.t06",
      "en": "I would really appreciate it if you could reply today.",
      "es": "Te agradecería mucho que pudieras responder hoy.",
      "explanationEs": "I would appreciate it if + could: petición muy formal y cortés.",
      "segments": [
        "I would really appreciate it",
        "if you could reply today."
      ],
      "audioText": "I would really appreciate it if you could reply today.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-2"
    }
  ],
