  "teaching": [
    {
      "id": "en.n7.class-36.t01",
      "en": "Take an umbrella: it's raining cats and dogs!",
      "es": "¡Lleva paraguas: está lloviendo a cántaros!",
      "explanationEs": "Modismo opaco: las palabras no explican el sentido; la pista es el contexto (el paraguas).",
      "segments": [
        "Take an umbrella: it's",
        "raining cats and dogs!"
      ],
      "audioText": "Take an umbrella: it's raining cats and dogs!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-1"
    },
    {
      "id": "en.n7.class-36.t02",
      "en": "I'm under the weather today, so I'm staying in bed.",
      "es": "Hoy estoy algo enfermo, así que me quedo en la cama.",
      "explanationEs": "Under the weather = un poco enfermo. Weather es el tiempo atmosférico, no el tiempo del reloj.",
      "segments": [
        "I'm under the weather today,",
        "so I'm staying in bed."
      ],
      "audioText": "I'm under the weather today, so I'm staying in bed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-1"
    },
    {
      "id": "en.n7.class-36.t03",
      "en": "The test was a piece of cake: I finished in ten minutes.",
      "es": "El examen fue pan comido: terminé en diez minutos.",
      "explanationEs": "Modismo transparente: un pastel se come sin esfuerzo, así que significa «muy fácil».",
      "segments": [
        "The test was a piece of",
        "cake: I finished in ten minutes."
      ],
      "audioText": "The test was a piece of cake: I finished in ten minutes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-1"
    },
    {
      "id": "en.n7.class-36.t04",
      "en": "Don't spill the beans about the surprise party!",
      "es": "¡No reveles el secreto de la fiesta sorpresa!",
      "explanationEs": "Spill the beans = revelar un secreto. Es opaco: el sentido literal no ayuda.",
      "segments": [
        "Don't spill the beans",
        "about the surprise party!"
      ],
      "audioText": "Don't spill the beans about the surprise party!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-1"
    },
    {
      "id": "en.n7.class-36.t05",
      "en": "After losing three games, the coach threw in the towel.",
      "es": "Después de perder tres partidos, el entrenador tiró la toalla.",
      "explanationEs": "Throw in the towel = rendirse. Viene del boxeo, igual que en español.",
      "segments": [
        "After losing three games, the",
        "coach threw in the towel."
      ],
      "audioText": "After losing three games, the coach threw in the towel.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-1"
    },
    {
      "id": "en.n7.class-36.t06",
      "en": "I sent my proposal; now the ball is in your court.",
      "es": "Envié mi propuesta; ahora te toca a ti decidir.",
      "explanationEs": "The ball is in your court = te toca actuar. Viene del tenis.",
      "segments": [
