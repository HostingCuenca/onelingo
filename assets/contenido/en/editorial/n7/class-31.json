  "teaching": [
    {
      "id": "en.n7.class-31.t01",
      "en": "I see it differently, but I understand why you want a rota.",
      "es": "Yo lo veo distinto, pero entiendo por qué quieres un cuadro de turnos.",
      "explanationEs": "I see it differently es un desacuerdo suave: no dice «te equivocas».",
      "segments": [
        "I see it differently, but I",
        "understand why you want a rota."
      ],
      "audioText": "I see it differently, but I understand why you want a rota.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-1"
    },
    {
      "id": "en.n7.class-31.t02",
      "en": "That's a fair point, but the kitchen is still dirty.",
      "es": "Es un argumento razonable, pero la cocina sigue sucia.",
      "explanationEs": "Fair point reconoce la idea del otro antes del but: acuerdo parcial.",
      "segments": [
        "That's a fair point, but",
        "the kitchen is still dirty."
      ],
      "audioText": "That's a fair point, but the kitchen is still dirty.",
      "audioMode": "tts",
