      "patternId": "n7-diplomatic-disagreement-1"
    },
    {
      "id": "en.n7.class-31.t03",
      "en": "I agree up to a point, but the rota is too strict for me.",
      "es": "Estoy de acuerdo hasta cierto punto, pero el cuadro de turnos es demasiado estricto para mí.",
      "explanationEs": "Up to a point y partly limitan el acuerdo sin rechazarlo.",
      "segments": [
        "I agree up to a point, but",
        "the rota is too strict for me."
      ],
      "audioText": "I agree up to a point, but the rota is too strict for me.",
      "audioMode": "tts",
