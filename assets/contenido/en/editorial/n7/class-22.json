  "teaching": [
    {
      "id": "en.n7.class-22.t01",
      "en": "The roof should have been inspected years ago.",
      "es": "El techo debería haberse inspeccionado hace años.",
      "explanationEs": "should have been + participio: algo correcto que no se hizo.",
      "segments": [
        "The roof should have",
        "been inspected years ago."
      ],
      "audioText": "The roof should have been inspected years ago.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-formal-passive-style-2"
    },
    {
      "id": "en.n7.class-22.t02",
      "en": "The old hall must have been neglected for decades.",
      "es": "El viejo salón tiene que haber sido descuidado durante décadas.",
      "explanationEs": "must have been + participio: deducción casi segura sobre el pasado.",
      "segments": [
        "The old hall must have",
        "been neglected for decades."
      ],
      "audioText": "The old hall must have been neglected for decades.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-formal-passive-style-2"
    },
    {
      "id": "en.n7.class-22.t03",
      "en": "That crack could have been repaired before the winter.",
      "es": "Esa grieta podría haberse reparado antes del invierno.",
      "explanationEs": "could have been + participio: era posible, pero no ocurrió.",
      "segments": [
        "That crack could have been",
        "repaired before the winter."
      ],
      "audioText": "That crack could have been repaired before the winter.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-formal-passive-style-2"
    },
    {
      "id": "en.n7.class-22.t04",
      "en": "Luckily, nobody got injured when part of the roof fell.",
      "es": "Por suerte, nadie resultó herido cuando cayó parte del techo.",
      "explanationEs": "get + participio: suceso inesperado, más informal que be.",
      "segments": [
        "Luckily, nobody got injured when",
        "part of the roof fell."
      ],
      "audioText": "Luckily, nobody got injured when part of the roof fell.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-formal-passive-style-2"
    },
    {
      "id": "en.n7.class-22.t05",
      "en": "The theatre got damaged in the storm, so it had to be closed urgently.",
      "es": "El teatro se dañó en la tormenta, así que hubo que cerrarlo con urgencia.",
      "explanationEs": "get + participio cuenta el suceso; had to be closed es otra pasiva con modal.",
      "segments": [
        "The theatre got damaged in the storm,",
        "so it had to be closed urgently."
      ],
      "audioText": "The theatre got damaged in the storm, so it had to be closed urgently.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-formal-passive-style-2"
    },
    {
      "id": "en.n7.class-22.t06",
      "en": "If the roof had not been repaired, the hall could have collapsed.",
      "es": "Si el techo no hubiera sido reparado, el salón podría haberse derrumbado.",
