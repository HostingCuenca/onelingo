  "teaching": [
    {
      "id": "en.n7.class-57.t01",
      "en": "Would you consider reducing the rent by fifty dollars?",
      "es": "¿Consideraría reducir el alquiler en cincuenta dólares?",
      "explanationEs": "Would you consider + verbo en -ing: propuesta tentativa, más suave que una exigencia.",
      "segments": [
        "Would you consider reducing the",
        "rent by fifty dollars?"
      ],
      "audioText": "Would you consider reducing the rent by fifty dollars?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-2"
    },
    {
      "id": "en.n7.class-57.t02",
      "en": "What if we split the deposit into two payments?",
      "es": "¿Y si dividiéramos el depósito en dos pagos?",
      "explanationEs": "What if we + presente o pasado simple plantea una idea sin imponerla.",
      "segments": [
        "What if we split the",
        "deposit into two payments?"
      ],
      "audioText": "What if we split the deposit into two payments?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-2"
    },
    {
      "id": "en.n7.class-57.t03",
      "en": "How about if we pay the rent on the first of each month?",
      "es": "¿Qué tal si pagamos el alquiler el día uno de cada mes?",
      "explanationEs": "How about if we + verbo: sugerencia amable con una condición clara.",
      "segments": [
        "How about if we pay the rent",
        "on the first of each month?"
      ],
      "audioText": "How about if we pay the rent on the first of each month?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-2"
    },
    {
      "id": "en.n7.class-57.t04",
      "en": "Would the landlord consider fixing the heating?",
      "es": "¿Consideraría el casero arreglar la calefacción?",
      "explanationEs": "La fórmula también funciona con una tercera persona: would + sujeto + consider + -ing.",
      "segments": [
        "Would the landlord consider",
        "fixing the heating?"
      ],
      "audioText": "Would the landlord consider fixing the heating?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-2"
    },
    {
      "id": "en.n7.class-57.t05",
      "en": "What if we signed a longer contract for a lower monthly rent?",
      "es": "¿Y si firmáramos un contrato más largo a cambio de un alquiler mensual más bajo?",
      "explanationEs": "What if + pasado simple suena más hipotético y amable que What if we sign.",
      "segments": [
        "What if we signed a longer",
        "contract for a lower monthly rent?"
      ],
      "audioText": "What if we signed a longer contract for a lower monthly rent?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-negotiation-2"
    }
  ],
