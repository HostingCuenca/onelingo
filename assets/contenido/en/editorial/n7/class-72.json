  "teaching": [
    {
      "id": "en.n7.class-72.t01",
      "en": "'Don't wake the baby,' Mia whispered.",
      "es": "—No despiertes al bebé —susurró Mia.",
      "explanationEs": "Whispered: voz muy baja, para que nadie más oiga.",
      "segments": [
        "'Don't wake the",
        "baby,' Mia whispered."
      ],
      "audioText": "'Don't wake the baby,' Mia whispered.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    },
    {
      "id": "en.n7.class-72.t02",
      "en": "'Not again,' Tom muttered, looking at his phone.",
      "es": "—Otra vez no —murmuró Tom entre dientes, mirando su teléfono.",
      "explanationEs": "Muttered: hablar entre dientes, casi para uno mismo y con descontento.",
      "segments": [
        "'Not again,' Tom muttered,",
        "looking at his phone."
      ],
      "audioText": "'Not again,' Tom muttered, looking at his phone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    },
    {
      "id": "en.n7.class-72.t03",
      "en": "'Give me the keys,' Carlos snapped.",
      "es": "—Dame las llaves —espetó Carlos.",
      "explanationEs": "Snapped: respuesta brusca, cortante y enfadada.",
      "segments": [
        "'Give me the",
        "keys,' Carlos snapped."
      ],
      "audioText": "'Give me the keys,' Carlos snapped.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    },
    {
      "id": "en.n7.class-72.t04",
      "en": "Leo hinted that he would like a lift, but he never asked directly.",
      "es": "Leo insinuó que le gustaría que lo llevaran, pero nunca lo pidió directamente.",
      "explanationEs": "Hinted + that + oración: dices algo de forma indirecta, sin pedirlo.",
      "segments": [
        "Leo hinted that he would like a",
        "lift, but he never asked directly."
      ],
      "audioText": "Leo hinted that he would like a lift, but he never asked directly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    },
    {
      "id": "en.n7.class-72.t05",
      "en": "'It is easy for you to say,' Tom replied bitterly.",
      "es": "—Para ti es fácil decirlo —respondió Tom con amargura.",
      "explanationEs": "El adverbio (bitterly) añade una emoción a un verbo de habla neutro como replied.",
      "segments": [
        "'It is easy for you",
        "to say,' Tom replied bitterly."
      ],
      "audioText": "'It is easy for you to say,' Tom replied bitterly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    },
    {
      "id": "en.n7.class-72.t06",
      "en": "Sara answered sharply that she had no time for excuses.",
      "es": "Sara respondió con brusquedad que no tenía tiempo para excusas.",
      "explanationEs": "Adverbio + that + oración: el tono va en el adverbio y el contenido en la oración.",
      "segments": [
        "Sara answered sharply that she",
        "had no time for excuses."
      ],
      "audioText": "Sara answered sharply that she had no time for excuses.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-literature-2"
    }
