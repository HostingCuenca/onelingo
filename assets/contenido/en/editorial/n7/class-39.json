    {
      "id": "en.n7.class-39.t01",
      "en": "Monday was a storm: three exams and no free minute.",
      "es": "El lunes fue una tormenta: tres exámenes y ni un minuto libre.",
      "explanationEs": "Metáfora apoyada en un dato real: la imagen (storm) y el hecho (three exams) van juntos.",
      "segments": [
        "Monday was a storm: three",
        "exams and no free minute."
      ],
      "audioText": "Monday was a storm: three exams and no free minute.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-4"
    },
    {
      "id": "en.n7.class-39.t02",
      "en": "This week is a marathon: I have to keep going until Sunday.",
      "es": "Esta semana es un maratón: tengo que seguir hasta el domingo.",
      "explanationEs": "Marathon expresa esfuerzo largo. Después de los dos puntos, explica qué significa.",
      "segments": [
        "This week is a marathon: I",
        "have to keep going until Sunday."
      ],
      "audioText": "This week is a marathon: I have to keep going until Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-4"
    },
    {
      "id": "en.n7.class-39.t03",
      "en": "On Tuesday I was as busy as a bee: I had to juggle work and study.",
      "es": "El martes estaba tan ocupado como una abeja: tuve que compaginar trabajo y estudio.",
      "explanationEs": "Símil con as… as. Juggle lleva objeto directo: juggle work and study, sin with.",
      "segments": [
        "On Tuesday I was as busy as a",
        "bee: I had to juggle work and study."
      ],
      "audioText": "On Tuesday I was as busy as a bee: I had to juggle work and study.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-4"
    },
    {
      "id": "en.n7.class-39.t04",
      "en": "On Saturday I broke the ice at the party by asking about her cat.",
      "es": "El sábado rompí el hielo en la fiesta preguntando por su gato.",
      "explanationEs": "Break the ice = empezar una conversación incómoda. Se usa con un hecho que lo explica.",
      "segments": [
        "On Saturday I broke the ice at",
        "the party by asking about her cat."
      ],
      "audioText": "On Saturday I broke the ice at the party by asking about her cat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-4"
    },
    {
      "id": "en.n7.class-39.t05",
      "en": "If you overdo the images, the reader gets lost.",
      "es": "Si te pasas con las imágenes, el lector se pierde.",
      "explanationEs": "Con una o dos imágenes por párrafo basta; el texto debe entenderse también sin ellas.",
      "segments": [
        "If you overdo the images,",
        "the reader gets lost."
