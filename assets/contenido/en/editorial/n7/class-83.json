  "teaching": [
    {
      "id": "en.n7.class-83.t01",
      "en": "The minutes list every action, the person responsible and the date.",
      "es": "El acta recoge cada acción, la persona responsable y la fecha.",
      "explanationEs": "Un resumen de reunión conecta tres datos: acción, responsable y fecha.",
      "segments": [
        "The minutes list every action, the",
        "person responsible and the date."
      ],
      "audioText": "The minutes list every action, the person responsible and the date.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    },
    {
      "id": "en.n7.class-83.t02",
      "en": "Tom will circulate the minutes to all attendees by Tuesday.",
      "es": "Tom hará llegar el acta a todos los asistentes antes del martes.",
      "explanationEs": "Will + verbo indica un compromiso asumido en la reunión; by + día es el plazo.",
      "segments": [
        "Tom will circulate the minutes",
        "to all attendees by Tuesday."
      ],
      "audioText": "Tom will circulate the minutes to all attendees by Tuesday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    },
    {
      "id": "en.n7.class-83.t03",
      "en": "The budget report is due on Thursday.",
      "es": "El informe del presupuesto debe entregarse el jueves.",
      "explanationEs": "Be due + día significa que hay que entregarlo ese día (o antes).",
      "segments": [
        "The budget report is",
        "due on Thursday."
      ],
      "audioText": "The budget report is due on Thursday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    },
    {
      "id": "en.n7.class-83.t04",
      "en": "Mia has been assigned the task of contacting the new volunteers.",
      "es": "A Mia le han asignado la tarea de contactar con los nuevos voluntarios.",
      "explanationEs": "Has been assigned es pasiva: dice quién recibe la tarea sin decir quién la repartió.",
      "segments": [
        "Mia has been assigned the task",
        "of contacting the new volunteers."
      ],
      "audioText": "Mia has been assigned the task of contacting the new volunteers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    },
    {
      "id": "en.n7.class-83.t05",
      "en": "It was agreed that Sara would book the room before the next meeting.",
      "es": "Se acordó que Sara reservaría la sala antes de la próxima reunión.",
      "explanationEs": "It was agreed that + would: el acta cuenta en pasado lo que se decidió y se hará después.",
      "segments": [
        "It was agreed that Sara would book",
        "the room before the next meeting."
      ],
      "audioText": "It was agreed that Sara would book the room before the next meeting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    },
    {
      "id": "en.n7.class-83.t06",
      "en": "Action point: Leo to update the schedule before the next meeting.",
      "es": "Punto de acción: Leo actualizará el horario antes de la próxima reunión.",
      "explanationEs": "En las actas se usa Nombre + to + verbo para las tareas pendientes; aquí action es la tarea.",
      "segments": [
        "Action point: Leo to update the",
        "schedule before the next meeting."
      ],
      "audioText": "Action point: Leo to update the schedule before the next meeting.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-3"
    }
