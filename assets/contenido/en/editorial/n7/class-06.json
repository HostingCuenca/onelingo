  "teaching": [
    {
      "id": "en.n7.class-06.t01",
      "en": "The film starts in Madrid, but a flashback takes us to Sara's childhood.",
      "es": "La película empieza en Madrid, pero un flashback nos lleva a la infancia de Sara.",
      "explanationEs": "Un flashback es un salto atrás; al volver a lo anterior, el relato cambia de tiempo verbal.",
      "segments": [
        "The film starts in Madrid, but a",
        "flashback takes us to Sara's childhood."
      ],
      "audioText": "The film starts in Madrid, but a flashback takes us to Sara's childhood.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    },
    {
      "id": "en.n7.class-06.t02",
      "en": "Sara was waiting at the gate; earlier, she had lost her passport.",
      "es": "Sara esperaba en la puerta de embarque; antes había perdido su pasaporte.",
      "explanationEs": "Had + participio marca un hecho anterior a otro del pasado; earlier lo refuerza.",
      "segments": [
        "Sara was waiting at the gate;",
        "earlier, she had lost her passport."
      ],
      "audioText": "Sara was waiting at the gate; earlier, she had lost her passport.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    },
    {
      "id": "en.n7.class-06.t03",
      "en": "She had been looking for it for an hour, and meanwhile the other passengers were boarding.",
      "es": "Llevaba una hora buscándolo y, mientras tanto, los demás pasajeros embarcaban.",
      "explanationEs": "Had been + -ing presenta una acción que venía durando; meanwhile y were + -ing marcan lo simultáneo.",
      "segments": [
        "She had been looking for it for an",
        "hour, and meanwhile the other passengers were boarding."
      ],
      "audioText": "She had been looking for it for an hour, and meanwhile the other passengers were boarding.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    },
    {
      "id": "en.n7.class-06.t04",
      "en": "Eventually, she found it in her coat, and she ran to the gate.",
      "es": "Por fin lo encontró en el abrigo y corrió a la puerta de embarque.",
      "explanationEs": "Eventually marca el final de la espera; el relato avanza en pasado simple.",
      "segments": [
        "Eventually, she found it in her coat,",
        "and she ran to the gate."
      ],
      "audioText": "Eventually, she found it in her coat, and she ran to the gate.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    },
    {
      "id": "en.n7.class-06.t05",
      "en": "Previously, she had never missed a flight.",
      "es": "Antes de eso, nunca había perdido un vuelo.",
      "explanationEs": "Previously + had + participio mira atrás desde un momento del pasado.",
      "segments": [
        "Previously, she had never",
        "missed a flight."
      ],
      "audioText": "Previously, she had never missed a flight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    },
    {
      "id": "en.n7.class-06.t06",
      "en": "Afterwards, she laughed about it with her brother.",
      "es": "Después, se rio de ello con su hermano.",
      "explanationEs": "Afterwards marca lo que ocurre después, contado en pasado simple.",
      "segments": [
        "Afterwards, she laughed about",
        "it with her brother."
      ],
      "audioText": "Afterwards, she laughed about it with her brother.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-complex-chronology-1"
    }
  ],
