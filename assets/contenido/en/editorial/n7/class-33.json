  "teaching": [
    {
      "id": "en.n7.class-33.t01",
      "en": "Sure, thanks for the invitation; Friday works for me.",
      "es": "Claro, gracias por la invitación; el viernes me viene bien.",
      "explanationEs": "Sure + una razón práctica: aceptación clara, sin reservas.",
      "segments": [
        "Sure, thanks for the invitation;",
        "Friday works for me."
      ],
      "audioText": "Sure, thanks for the invitation; Friday works for me.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-3"
    },
    {
      "id": "en.n7.class-33.t02",
      "en": "I suppose so, as long as we finish before midnight.",
      "es": "Supongo que sí, siempre que terminemos antes de medianoche.",
      "explanationEs": "I suppose so es un sí poco entusiasta; as long as añade una condición: acuerdo a medias.",
      "segments": [
        "I suppose so, as long",
        "as we finish before midnight."
      ],
      "audioText": "I suppose so, as long as we finish before midnight.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-3"
    },
    {
      "id": "en.n7.class-33.t03",
      "en": "I agree on one condition: no guests after ten.",
      "es": "Acepto con una condición: nada de invitados después de las diez.",
      "explanationEs": "On one condition anuncia el límite de un sí.",
      "segments": [
        "I agree on one condition:",
        "no guests after ten."
      ],
      "audioText": "I agree on one condition: no guests after ten.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-3"
    },
    {
      "id": "en.n7.class-33.t04",
      "en": "I'd love to, but I'm afraid I can't on Saturday.",
      "es": "Me encantaría, pero me temo que el sábado no puedo.",
      "explanationEs": "I'd love to, but… suena a sí, pero es un no cortés.",
      "segments": [
        "I'd love to, but I'm",
        "afraid I can't on Saturday."
      ],
      "audioText": "I'd love to, but I'm afraid I can't on Saturday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-3"
    },
    {
      "id": "en.n7.class-33.t05",
      "en": "I'm tempted, but maybe another time.",
      "es": "Me tienta, pero quizá en otra ocasión.",
      "explanationEs": "Another time deja la puerta abierta y rechaza la propuesta de ahora.",
      "segments": [
        "I'm tempted, but",
        "maybe another time."
      ],
      "audioText": "I'm tempted, but maybe another time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-diplomatic-disagreement-3"
    },
    {
      "id": "en.n7.class-33.t06",
      "en": "Thanks, but I have to decline; we'll see next month.",
      "es": "Gracias, pero tengo que rechazarlo; ya veremos el mes que viene.",
      "explanationEs": "Decline es rechazar con cortesía; we'll see no promete nada.",
      "segments": [
        "Thanks, but I have to",
        "decline; we'll see next month."
      ],
      "audioText": "Thanks, but I have to decline; we'll see next month.",
      "audioMode": "tts",
