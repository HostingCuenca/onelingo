  "teaching": [
    {
      "id": "en.n7.class-93.t01",
      "en": "The lyrics suggest that the singer feels alone in a big city.",
      "es": "La letra sugiere que el cantante se siente solo en una ciudad grande.",
      "explanationEs": "Suggest + that: la letra no lo dice abiertamente, tú lo interpretas.",
      "segments": [
        "The lyrics suggest that the singer",
        "feels alone in a big city."
      ],
      "audioText": "The lyrics suggest that the singer feels alone in a big city.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-integrated-workshop-3"
    },
    {
      "id": "en.n7.class-93.t02",
      "en": "The lighthouse is a metaphor for staying strong when everything changes.",
      "es": "El faro es una metáfora de mantenerse firme cuando todo cambia.",
      "explanationEs": "Metaphor for + idea: una cosa se describe como otra para mostrar un sentido más profundo.",
      "segments": [
        "The lighthouse is a metaphor for",
        "staying strong when everything changes."
      ],
      "audioText": "The lighthouse is a metaphor for staying strong when everything changes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-integrated-workshop-3"
    },
    {
      "id": "en.n7.class-93.t03",
      "en": "The tone of the chorus is hopeful, even though the rest of the song sounds sad.",
      "es": "El tono del estribillo es esperanzado, aunque el resto de la canción suena triste.",
      "explanationEs": "El tono puede cambiar entre el estribillo y el resto de la canción.",
      "segments": [
        "The tone of the chorus is hopeful, even",
        "though the rest of the song sounds sad."
      ],
      "audioText": "The tone of the chorus is hopeful, even though the rest of the song sounds sad.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-integrated-workshop-3"
    },
    {
      "id": "en.n7.class-93.t04",
      "en": "The voice in the song sounds bitter, as if the singer had been let down.",
      "es": "La voz de la canción suena amarga, como si el cantante hubiera sido decepcionado.",
      "explanationEs": "Sound + adjetivo; as if + had + participio para una causa imaginada en el pasado.",
      "segments": [
        "The voice in the song sounds bitter, as",
        "if the singer had been let down."
      ],
      "audioText": "The voice in the song sounds bitter, as if the singer had been let down.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-integrated-workshop-3"
    },
    {
      "id": "en.n7.class-93.t05",
      "en": "For me, the song is nostalgic: it makes me think of the town where I grew up.",
      "es": "Para mí, la canción es nostálgica: me hace pensar en el pueblo donde crecí.",
      "explanationEs": "For me, + opinión: marca tu reacción personal, distinta de lo que sugiere la letra.",
      "segments": [
        "For me, the song is nostalgic: it makes me",
        "think of the town where I grew up."
      ],
