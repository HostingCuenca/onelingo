  "teaching": [
    {
      "id": "en.n7.class-81.t01",
      "en": "The purpose of this email is to ask you to cover Saturday's shift.",
      "es": "El propósito de este correo es pedirte que cubras el turno del sábado.",
      "explanationEs": "The purpose of this email is to + verbo dice para qué escriben; ask you to + verbo es lo que esperan de ti.",
      "segments": [
        "The purpose of this email is to",
        "ask you to cover Saturday's shift."
      ],
      "audioText": "The purpose of this email is to ask you to cover Saturday's shift.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-1"
    },
    {
      "id": "en.n7.class-81.t02",
      "en": "Please submit your hours by Friday at noon; the deadline is firm.",
      "es": "Por favor, entrega tus horas antes del viernes a mediodía; el plazo es firme.",
      "explanationEs": "Please + verbo base pide una acción; by + día y hora fija el plazo.",
      "segments": [
        "Please submit your hours by Friday",
        "at noon; the deadline is firm."
      ],
      "audioText": "Please submit your hours by Friday at noon; the deadline is firm.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-1"
    },
    {
      "id": "en.n7.class-81.t03",
      "en": "I am sending the draft as an attachment. Could you approve it before Monday?",
      "es": "Te envío el borrador como archivo adjunto. ¿Podrías aprobarlo antes del lunes?",
      "explanationEs": "Could you + verbo base es una petición cortés; before + día marca hasta cuándo.",
      "segments": [
        "I am sending the draft as an",
        "attachment. Could you approve it before Monday?"
      ],
      "audioText": "I am sending the draft as an attachment. Could you approve it before Monday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-1"
    },
    {
      "id": "en.n7.class-81.t04",
      "en": "This is a reminder that the training starts at nine tomorrow.",
      "es": "Este es un recordatorio de que la formación empieza mañana a las nueve.",
      "explanationEs": "Un reminder solo informa o recuerda: aquí no se pide ninguna acción.",
      "segments": [
        "This is a reminder that the",
        "training starts at nine tomorrow."
      ],
      "audioText": "This is a reminder that the training starts at nine tomorrow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-professional-communication-1"
    },
    {
      "id": "en.n7.class-81.t05",
      "en": "It is urgent: the client needs an answer today.",
      "es": "Es urgente: el cliente necesita una respuesta hoy.",
      "explanationEs": "Urgent y today señalan que el plazo es inmediato.",
      "segments": [
