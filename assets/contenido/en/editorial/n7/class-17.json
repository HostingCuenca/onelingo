  "teaching": [
    {
      "id": "en.n7.class-17.t01",
      "en": "The mayor allegedly accepted gifts from a builder, but he continues to deny it.",
      "es": "El alcalde presuntamente aceptó regalos de un constructor, pero sigue negándolo.",
      "explanationEs": "Allegedly indica que alguien lo acusa, sin pruebas: mientras nadie sea declarado guilty (culpable), el periodista no lo afirma por su cuenta.",
      "segments": [
        "The mayor allegedly accepted gifts from a",
        "builder, but he continues to deny it."
      ],
      "audioText": "The mayor allegedly accepted gifts from a builder, but he continues to deny it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-2"
    },
    {
      "id": "en.n7.class-17.t02",
      "en": "The museum is supposedly open until nine, but the door was locked.",
      "es": "Se supone que el museo abre hasta las nueve, pero la puerta estaba cerrada.",
      "explanationEs": "Supposedly = así debería ser o así se dice, pero hay dudas de que sea cierto.",
      "segments": [
        "The museum is supposedly open until",
        "nine, but the door was locked."
      ],
      "audioText": "The museum is supposedly open until nine, but the door was locked.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-2"
    },
    {
      "id": "en.n7.class-17.t03",
      "en": "The visit is ostensibly a holiday, but the council is paying for it.",
      "es": "La visita es, en apariencia, unas vacaciones, pero la paga el ayuntamiento.",
      "explanationEs": "Ostensibly = la razón oficial o aparente; sugiere que el motivo real es otro.",
      "segments": [
        "The visit is ostensibly a holiday, but",
        "the council is paying for it."
      ],
      "audioText": "The visit is ostensibly a holiday, but the council is paying for it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-2"
    },
    {
      "id": "en.n7.class-17.t04",
      "en": "The company has reportedly lost three million pounds.",
      "es": "La empresa ha perdido, según se informa, tres millones de libras.",
      "explanationEs": "Reportedly = lo cuentan los medios o las fuentes; el hablante no lo ha comprobado.",
      "segments": [
        "The company has reportedly",
        "lost three million pounds."
      ],
      "audioText": "The company has reportedly lost three million pounds.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-2"
    },
    {
      "id": "en.n7.class-17.t05",
      "en": "Council reportedly plans to close library.",
      "es": "El ayuntamiento planea cerrar la biblioteca, según se informa.",
      "explanationEs": "En un headline (titular) se omiten los artículos; el adverbio va antes del verbo principal.",
      "segments": [
        "Council reportedly plans",
        "to close library."
      ],
      "audioText": "Council reportedly plans to close library.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-epistemic-language-2"
    }
  ],
