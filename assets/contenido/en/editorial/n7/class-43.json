  "teaching": [
    {
      "id": "en.n7.class-43.t01",
      "en": "A warm voice uses friendly words and speaks directly to the reader.",
      "es": "Una voz cálida usa palabras amables y habla directamente a quien lee.",
      "explanationEs": "Warm = cercana: palabras amables, tú y yo en el texto.",
      "segments": [
        "A warm voice uses friendly words",
        "and speaks directly to the reader."
      ],
      "audioText": "A warm voice uses friendly words and speaks directly to the reader.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    },
    {
      "id": "en.n7.class-43.t02",
      "en": "A dry voice states the facts in short, calm sentences.",
      "es": "Una voz seca expone los hechos en frases cortas y serenas.",
      "explanationEs": "Dry = sobria, sin adornos ni bromas.",
      "segments": [
        "A dry voice states the",
        "facts in short, calm sentences."
      ],
      "audioText": "A dry voice states the facts in short, calm sentences.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    },
    {
      "id": "en.n7.class-43.t03",
      "en": "An ironic voice says one thing and means the opposite: Great, another Monday.",
      "es": "Una voz irónica dice una cosa y quiere decir lo contrario: «Genial, otro lunes».",
      "explanationEs": "Ironic = dice lo contrario de lo que piensa; el contexto lo delata.",
      "segments": [
        "An ironic voice says one thing and",
        "means the opposite: Great, another Monday."
      ],
      "audioText": "An ironic voice says one thing and means the opposite: Great, another Monday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    },
    {
      "id": "en.n7.class-43.t04",
      "en": "The tone is the feeling of the text, and the rhythm is how fast its sentences move.",
      "es": "El tono es la sensación del texto y el ritmo es la rapidez con que avanzan sus frases.",
      "explanationEs": "Tone = sentimiento general; rhythm = longitud y velocidad de las frases.",
      "segments": [
        "The tone is the feeling of the text, and",
        "the rhythm is how fast its sentences move."
      ],
      "audioText": "The tone is the feeling of the text, and the rhythm is how fast its sentences move.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    },
    {
      "id": "en.n7.class-43.t05",
      "en": "A playful writer asks questions and makes jokes to surprise you.",
      "es": "Quien escribe con tono juguetón hace preguntas y bromas para sorprenderte.",
      "explanationEs": "Playful = animada, con preguntas, bromas y exclamaciones.",
      "segments": [
        "A playful writer asks questions and",
        "makes jokes to surprise you."
      ],
      "audioText": "A playful writer asks questions and makes jokes to surprise you.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    },
    {
      "id": "en.n7.class-43.t06",
      "en": "To describe a voice, name it and quote one clue from the text.",
      "es": "Para describir una voz, nómbrala y cita una pista del texto.",
      "explanationEs": "Quote = copiar unas palabras exactas; clue = la pista que demuestra la voz.",
      "segments": [
        "To describe a voice, name it and",
        "quote one clue from the text."
      ],
      "audioText": "To describe a voice, name it and quote one clue from the text.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-3"
    }
  ],
