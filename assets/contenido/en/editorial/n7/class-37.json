  "teaching": [
    {
      "id": "en.n7.class-37.t01",
      "en": "The lake was as cold as ice this morning.",
      "es": "El lago estaba tan frío como el hielo esta mañana.",
      "explanationEs": "as + adjetivo + as + nombre: símil de intensidad.",
      "segments": [
        "The lake was as cold",
        "as ice this morning."
      ],
      "audioText": "The lake was as cold as ice this morning.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-2"
    },
    {
      "id": "en.n7.class-37.t02",
      "en": "The box is as light as a feather.",
      "es": "La caja es tan ligera como una pluma.",
      "explanationEs": "Con un nombre contable singular, lleva a: as light as a feather.",
      "segments": [
        "The box is as",
        "light as a feather."
      ],
      "audioText": "The box is as light as a feather.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-2"
    },
    {
      "id": "en.n7.class-37.t03",
      "en": "My brother roared like a lion when we scored.",
      "es": "Mi hermano rugió como un león cuando marcamos.",
      "explanationEs": "verbo + like + nombre: símil de acción.",
      "segments": [
        "My brother roared like a",
        "lion when we scored."
      ],
      "audioText": "My brother roared like a lion when we scored.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-2"
    },
    {
      "id": "en.n7.class-37.t04",
      "en": "I was as quiet as a mouse, so nobody heard me.",
      "es": "Estuve tan callado como un ratón, así que nadie me oyó.",
      "explanationEs": "As quiet as a mouse es un símil muy fijo; cambia el adjetivo y el animal, y suena raro.",
      "segments": [
        "I was as quiet as a",
        "mouse, so nobody heard me."
      ],
      "audioText": "I was as quiet as a mouse, so nobody heard me.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-2"
    },
    {
      "id": "en.n7.class-37.t05",
      "en": "Sara is our rock: she stays calm when we have a problem.",
      "es": "Sara es nuestra roca: mantiene la calma cuando tenemos un problema.",
      "explanationEs": "Metáfora directa: dice que Sara es una roca, sin as ni like.",
      "segments": [
        "Sara is our rock: she stays",
        "calm when we have a problem."
      ],
      "audioText": "Sara is our rock: she stays calm when we have a problem.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-figurative-language-2"
    }
