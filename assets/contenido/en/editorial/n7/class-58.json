      "languageCode": "en",
      "patternId": "n7-negotiation-3"
    },
    {
      "id": "en.n7.class-58.t02",
      "en": "The pet question is still open; I will get back to you.",
      "es": "La cuestión de las mascotas sigue abierta; te responderé.",
