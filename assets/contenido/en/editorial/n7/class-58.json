      "languageCode": "en",
      "patternId": "n7-negotiation-3"
    },
    {
      "id": "en.n7.class-58.t03",
      "en": "I accept on one condition: you pay the deposit by Friday.",
      "es": "Acepto con una condición: pagas el depósito antes del viernes.",
      "explanationEs": "On one condition anuncia un requisito; by Friday es el plazo.",
