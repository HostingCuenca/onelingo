      "patternId": "n7-negotiation-3"
    },
    {
      "id": "en.n7.class-58.t04",
      "en": "We will renew the contract unless the rent goes up.",
      "es": "Renovaremos el contrato a menos que suba el alquiler.",
      "explanationEs": "Unless equivale a if not: la condición se cumple si no ocurre lo que sigue.",
