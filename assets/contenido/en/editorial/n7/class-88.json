  "teaching": [
    {
      "id": "en.n7.class-88.t01",
      "en": "She began with an anecdote about her first day as a volunteer.",
      "es": "Empezó con una anécdota sobre su primer día como voluntaria.",
      "explanationEs": "Una anécdota es una historia breve y personal; hace que el público se identifique.",
      "segments": [
        "She began with an anecdote about",
        "her first day as a volunteer."
      ],
      "audioText": "She began with an anecdote about her first day as a volunteer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    },
    {
      "id": "en.n7.class-88.t02",
      "en": "The vivid details made the story easy to picture.",
      "es": "Los detalles vívidos hicieron fácil imaginar la historia.",
      "explanationEs": "Vivid = que crea una imagen clara en la mente; make + objeto + verbo base.",
      "segments": [
        "The vivid details made the",
        "story easy to picture."
      ],
      "audioText": "The vivid details made the story easy to picture.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    },
    {
      "id": "en.n7.class-88.t03",
      "en": "By repeating the phrase «not today», he made the message memorable.",
      "es": "Al repetir la frase «hoy no», hizo el mensaje memorable.",
      "explanationEs": "By + -ing explica cómo se consigue el efecto: la repetición ayuda a recordar.",
      "segments": [
        "By repeating the phrase «not today»,",
        "he made the message memorable."
      ],
      "audioText": "By repeating the phrase «not today», he made the message memorable.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    },
    {
      "id": "en.n7.class-88.t04",
      "en": "The contrast between a dirty river and a clean one helps to persuade the audience.",
      "es": "El contraste entre un río sucio y uno limpio ayuda a persuadir al público.",
      "explanationEs": "Un contraste pone dos imágenes opuestas frente a frente; helps to + verbo dice para qué sirve.",
      "segments": [
        "The contrast between a dirty river and a",
        "clean one helps to persuade the audience."
      ],
      "audioText": "The contrast between a dirty river and a clean one helps to persuade the audience.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    },
    {
      "id": "en.n7.class-88.t05",
      "en": "Her rhetorical question, «Who will act if we do not?», made everyone think.",
      "es": "Su pregunta retórica, «¿Quién actuará si no lo hacemos?», hizo pensar a todos.",
      "explanationEs": "Una pregunta retórica no espera respuesta: invita a reflexionar.",
      "segments": [
        "Her rhetorical question, «Who will act if",
        "we do not?», made everyone think."
      ],
      "audioText": "Her rhetorical question, «Who will act if we do not?», made everyone think.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    },
    {
      "id": "en.n7.class-88.t06",
      "en": "These techniques engage the audience because they create emotion and curiosity.",
      "es": "Estos recursos captan al público porque crean emoción y curiosidad.",
      "explanationEs": "Engage = captar y mantener la atención; se explica con because + efecto.",
      "segments": [
        "These techniques engage the audience because",
        "they create emotion and curiosity."
      ],
      "audioText": "These techniques engage the audience because they create emotion and curiosity.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-public-speaking-3"
    }
  ],
