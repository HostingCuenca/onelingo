    {
      "id": "en.n7.class-92.t01",
      "en": "Had I known about the delay, I would have called the office earlier.",
      "es": "Si hubiera sabido del retraso, habría llamado antes a la oficina.",
      "explanationEs": "Condicional pasado: if + had + participio, o la inversión Had I known; nunca if + would have.",
      "segments": [
        "Had I known about the delay, I",
        "would have called the office earlier."
      ],
      "audioText": "Had I known about the delay, I would have called the office earlier.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-integrated-workshop-2"
    },
    {
      "id": "en.n7.class-92.t02",
      "en": "She admitted making mistakes in the draft.",
      "es": "Admitió haber cometido errores en el borrador.",
      "explanationEs": "Admit + verbo con -ing (o that + oración): no admit + persona + to.",
