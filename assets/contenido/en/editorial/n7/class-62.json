  "teaching": [
    {
      "id": "en.n7.class-62.t01",
      "en": "The neighbours accused the company of dumping waste in the river.",
      "es": "Los vecinos acusaron a la empresa de verter residuos en el río.",
      "explanationEs": "Accuse + persona + of + verbo en -ing; no se dice «accused to dump».",
      "segments": [
        "The neighbours accused the company of",
        "dumping waste in the river."
      ],
      "audioText": "The neighbours accused the company of dumping waste in the river.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-media-2"
    },
    {
      "id": "en.n7.class-62.t02",
      "en": "The spokesperson denied dumping anything and said the photos were old.",
      "es": "El portavoz negó haber vertido nada y dijo que las fotos eran antiguas.",
      "explanationEs": "Deny va seguido de un verbo en -ing: denied dumping.",
      "segments": [
        "The spokesperson denied dumping anything and",
        "said the photos were old."
      ],
      "audioText": "The spokesperson denied dumping anything and said the photos were old.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-media-2"
    },
    {
      "id": "en.n7.class-62.t03",
      "en": "The manager admitted leaving a gate open, but he insisted on paying for the clean-up.",
      "es": "El gerente admitió haber dejado una puerta abierta, pero insistió en pagar la limpieza.",
      "explanationEs": "Admitted + -ing reconoce un hecho; insisted on + -ing muestra firmeza.",
      "segments": [
        "The manager admitted leaving a gate open, but",
        "he insisted on paying for the clean-up."
      ],
      "audioText": "The manager admitted leaving a gate open, but he insisted on paying for the clean-up.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-media-2"
    },
    {
      "id": "en.n7.class-62.t04",
      "en": "The company claimed to have checked the river every week.",
      "es": "La empresa aseguró haber revisado el río cada semana.",
      "explanationEs": "Claim to have + participio: afirma algo ya hecho sin garantizar que sea verdad.",
      "segments": [
        "The company claimed to have",
        "checked the river every week."
      ],
      "audioText": "The company claimed to have checked the river every week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-media-2"
    },
    {
      "id": "en.n7.class-62.t05",
      "en": "Its statement does not say who is responsible.",
      "es": "Su comunicado no dice quién es el responsable.",
      "explanationEs": "El comunicado es el texto oficial de la empresa; responsible = con la responsabilidad.",
      "segments": [
        "Its statement does not",
        "say who is responsible."
      ],
      "audioText": "Its statement does not say who is responsible.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-media-2"
    }
  ],
