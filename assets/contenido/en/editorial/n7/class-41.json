  "teaching": [
    {
      "id": "en.n7.class-41.t01",
      "en": "This sentence is wordy: it needs twelve words to say what four words can say.",
      "es": "Esta frase está recargada: necesita doce palabras para decir lo que cuatro pueden decir.",
      "explanationEs": "Wordy = usa más palabras de las necesarias sin añadir información.",
      "segments": [
        "This sentence is wordy: it needs twelve words",
        "to say what four words can say."
      ],
      "audioText": "This sentence is wordy: it needs twelve words to say what four words can say.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    },
    {
      "id": "en.n7.class-41.t02",
      "en": "The phrase \"end result\" is redundant, because a result always comes at the end.",
      "es": "La expresión \"end result\" es redundante, porque un resultado siempre llega al final.",
      "explanationEs": "Redundant = repite una idea que ya contiene otra palabra.",
      "segments": [
        "The phrase \"end result\" is redundant, because",
        "a result always comes at the end."
      ],
      "audioText": "The phrase \"end result\" is redundant, because a result always comes at the end.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    },
    {
      "id": "en.n7.class-41.t03",
      "en": "A concise email keeps the point and cuts the padding.",
      "es": "Un correo conciso conserva la idea principal y corta el relleno.",
      "explanationEs": "Padding = palabras que llenan espacio sin aportar datos.",
      "segments": [
        "A concise email keeps the",
        "point and cuts the padding."
      ],
      "audioText": "A concise email keeps the point and cuts the padding.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    },
    {
      "id": "en.n7.class-41.t04",
      "en": "Instead of \"give consideration to\", use the direct verb consider.",
      "es": "En lugar de \"give consideration to\", usa el verbo directo consider.",
      "explanationEs": "Direct = el verbo dice la acción sin rodeos; consider ya contiene la idea de consideration.",
      "segments": [
        "Instead of \"give consideration to\",",
        "use the direct verb consider."
      ],
      "audioText": "Instead of \"give consideration to\", use the direct verb consider.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    },
    {
      "id": "en.n7.class-41.t05",
      "en": "Do not repeat the same idea: \"completely finished\" is just \"finished\".",
      "es": "No repitas la misma idea: \"completely finished\" es simplemente \"finished\".",
      "explanationEs": "Finished ya significa «del todo»; completely no añade nada.",
      "segments": [
        "Do not repeat the same idea:",
        "\"completely finished\" is just \"finished\"."
      ],
      "audioText": "Do not repeat the same idea: \"completely finished\" is just \"finished\".",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    },
    {
      "id": "en.n7.class-41.t06",
      "en": "A plain word is often stronger than a long phrase.",
      "es": "Una palabra sencilla suele ser más fuerte que una expresión larga.",
      "explanationEs": "Plain = sencillo: una palabra sencilla como because suele ser más fuerte que una expresión larga como due to the fact that.",
      "segments": [
        "A plain word is often",
        "stronger than a long phrase."
      ],
      "audioText": "A plain word is often stronger than a long phrase.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-style-1"
    }
  ],
