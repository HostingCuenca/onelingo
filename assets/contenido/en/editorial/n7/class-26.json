  "teaching": [
    {
      "id": "en.n7.class-26.t01",
      "en": "We took the ferry to the island, and this saved us a long detour.",
      "es": "Tomamos el ferri a la isla y eso nos ahorró un largo desvío.",
      "explanationEs": "This señala toda la idea anterior: tomar el ferri.",
      "segments": [
        "We took the ferry to the island,",
        "and this saved us a long detour."
      ],
      "audioText": "We took the ferry to the island, and this saved us a long detour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-cohesion-reference-1"
    },
    {
      "id": "en.n7.class-26.t02",
      "en": "The hostel and the hotel were both full; the former was cheaper, but the latter had better scenery.",
      "es": "El albergue y el hotel estaban llenos; el primero era más barato, pero el segundo tenía mejor paisaje.",
      "explanationEs": "The former = el primero nombrado (hostel); the latter = el último (hotel).",
      "segments": [
        "The hostel and the hotel were both full; the",
        "former was cheaper, but the latter had better scenery."
      ],
      "audioText": "The hostel and the hotel were both full; the former was cheaper, but the latter had better scenery.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-cohesion-reference-1"
    },
    {
      "id": "en.n7.class-26.t03",
      "en": "The coast is beautiful, but such scenery is hard to reach without a car.",
      "es": "La costa es preciosa, pero ese tipo de paisaje es difícil de alcanzar sin coche.",
      "explanationEs": "Such + nombre = ese tipo de cosa ya descrita.",
      "segments": [
        "The coast is beautiful, but such scenery",
        "is hard to reach without a car."
      ],
      "audioText": "The coast is beautiful, but such scenery is hard to reach without a car.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-cohesion-reference-1"
    },
    {
      "id": "en.n7.class-26.t04",
      "en": "We missed the last ferry. That was a mistake, and that detour cost us a day.",
      "es": "Perdimos el último ferri. Eso fue un error, y ese desvío nos costó un día.",
      "explanationEs": "That señala algo ya dicho y suele añadir una valoración.",
      "segments": [
        "We missed the last ferry. That was a",
        "mistake, and that detour cost us a day."
      ],
      "audioText": "We missed the last ferry. That was a mistake, and that detour cost us a day.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n7-cohesion-reference-1"
    },
    {
      "id": "en.n7.class-26.t05",
      "en": "Our itinerary included a mountain village and a fishing port; the latter was my favourite.",
      "es": "Nuestro itinerario incluía un pueblo de montaña y un puerto pesquero; este último fue mi favorito.",
      "explanationEs": "Con dos elementos, the latter es el segundo: el puerto.",
      "segments": [
        "Our itinerary included a mountain village and a",
        "fishing port; the latter was my favourite."
      ],
      "audioText": "Our itinerary included a mountain village and a fishing port; the latter was my favourite.",
      "audioMode": "tts",
      "languageCode": "en",
