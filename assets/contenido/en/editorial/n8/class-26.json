  "teaching": [
    {
      "id": "en.n8.class-26.t01",
      "en": "Dear Mr Hill, I would be grateful if you could repair the heater.",
      "es": "Estimado señor Hill, le agradecería que reparara la calefacción.",
      "explanationEs": "Formal: Dear + apellido y would be grateful if you could…",
      "segments": [
        "Dear Mr Hill, I would be grateful",
        "if you could repair the heater."
      ],
      "audioText": "Dear Mr Hill, I would be grateful if you could repair the heater.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    },
    {
      "id": "en.n8.class-26.t02",
      "en": "Hey Sam, can you sort the heater out? Cheers!",
      "es": "Oye, Sam, ¿puedes arreglar la calefacción? ¡Gracias!",
      "explanationEs": "Informal: Hey, can you…?, el verbo frasal sort out y Cheers.",
      "segments": [
        "Hey Sam, can you sort",
        "the heater out? Cheers!"
      ],
      "audioText": "Hey Sam, can you sort the heater out? Cheers!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    },
    {
      "id": "en.n8.class-26.t03",
      "en": "The landlord prefers a formal greeting, such as Dear Mr Hill.",
      "es": "El casero prefiere un saludo formal, como Estimado señor Hill.",
      "explanationEs": "El saludo es la primera marca de registro.",
      "segments": [
        "The landlord prefers a formal greeting,",
        "such as Dear Mr Hill."
      ],
      "audioText": "The landlord prefers a formal greeting, such as Dear Mr Hill.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    },
    {
      "id": "en.n8.class-26.t04",
      "en": "A contraction such as I'm or don't makes a message sound informal.",
      "es": "Una contracción como I'm o don't hace que un mensaje suene informal.",
      "explanationEs": "Contracciones (I'm, can't) y jerga apuntan a un mensaje informal.",
      "segments": [
        "A contraction such as I'm or",
        "don't makes a message sound informal."
      ],
      "audioText": "A contraction such as I'm or don't makes a message sound informal.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    },
    {
      "id": "en.n8.class-26.t05",
      "en": "Being polite does not mean being formal: please and thank you work in both.",
      "es": "Ser educado no significa ser formal: please y thank you sirven en ambos.",
      "explanationEs": "Educado ≠ formal: la cortesía existe en los dos registros.",
      "segments": [
        "Being polite does not mean being formal:",
        "please and thank you work in both."
      ],
      "audioText": "Being polite does not mean being formal: please and thank you work in both.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    },
    {
      "id": "en.n8.class-26.t06",
      "en": "My friends use slang, so the register is informal.",
      "es": "Mis amigos usan jerga, así que el registro es informal.",
      "explanationEs": "Register = nivel de formalidad; slang (jerga) es una marca informal.",
      "segments": [
        "My friends use slang, so",
        "the register is informal."
      ],
      "audioText": "My friends use slang, so the register is informal.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-1"
    }
  ],
