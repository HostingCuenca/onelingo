  "teaching": [
    {
      "id": "en.n8.class-86.t01",
      "en": "Good morning, everyone. Today I want to present the results of our neighbourhood survey.",
      "es": "Buenos días a todos. Hoy quiero presentar los resultados de nuestra encuesta del barrio.",
      "explanationEs": "Apertura: saludo + Today I want to present… anuncia el tema de la charla.",
      "segments": [
        "Good morning, everyone. Today I want to",
        "present the results of our neighbourhood survey."
      ],
      "audioText": "Good morning, everyone. Today I want to present the results of our neighbourhood survey.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    },
    {
      "id": "en.n8.class-86.t02",
      "en": "I will outline the talk in three parts, and firstly I will explain how we collected the data.",
      "es": "Expondré la charla en tres partes y, en primer lugar, explicaré cómo recogimos los datos.",
      "explanationEs": "I will outline… anuncia el esquema; firstly abre la primera parte.",
      "segments": [
        "I will outline the talk in three parts, and",
        "firstly I will explain how we collected the data."
      ],
      "audioText": "I will outline the talk in three parts, and firstly I will explain how we collected the data.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    },
    {
      "id": "en.n8.class-86.t03",
      "en": "Let's move on to the results.",
      "es": "Pasemos a los resultados.",
      "explanationEs": "Transición: Let's move on to + parte; en inglés no se dice «pass to».",
      "segments": [
        "Let's move on",
        "to the results."
      ],
      "audioText": "Let's move on to the results.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    },
    {
      "id": "en.n8.class-86.t04",
      "en": "Now I'd like to turn to the question of noise.",
      "es": "Ahora me gustaría pasar al tema del ruido.",
      "explanationEs": "Now I'd like to turn to + tema: transición algo más formal.",
      "segments": [
        "Now I'd like to turn",
        "to the question of noise."
      ],
      "audioText": "Now I'd like to turn to the question of noise.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    },
    {
      "id": "en.n8.class-86.t05",
      "en": "To sum up, most neighbours want safer streets and quieter nights.",
      "es": "En resumen, la mayoría de los vecinos quiere calles más seguras y noches más tranquilas.",
      "explanationEs": "Cierre: To sum up, + la idea principal, en una o dos frases.",
      "segments": [
        "To sum up, most neighbours want",
        "safer streets and quieter nights."
      ],
      "audioText": "To sum up, most neighbours want safer streets and quieter nights.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    },
    {
      "id": "en.n8.class-86.t06",
      "en": "Finally, I will take any questions you may have.",
      "es": "Por último, responderé a las preguntas que tengan.",
      "explanationEs": "Finally anuncia el último paso; después se invita a hacer preguntas.",
      "segments": [
        "Finally, I will take any",
        "questions you may have."
      ],
      "audioText": "Finally, I will take any questions you may have.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-1"
    }
