      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    },
    {
      "id": "en.n8.class-42.t02",
      "en": "Dad hit the roof when he saw the window; he was furious.",
      "es": "Papá se puso furioso cuando vio la ventana; estaba furioso.",
      "explanationEs": "El verbo del modismo va en pasado (hit); the roof se queda igual.",
      "segments": [
        "Dad hit the roof when he",
        "saw the window; he was furious."
      ],
      "audioText": "Dad hit the roof when he saw the window; he was furious.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    },
    {
      "id": "en.n8.class-42.t03",
      "en": "Are you trying to pull my leg? You must be joking!",
      "es": "¿Me estás tomando el pelo? ¡Debes de estar bromeando!",
      "explanationEs": "El posesivo concuerda con la persona: pull my leg, pull your leg, pull his leg.",
      "segments": [
        "Are you trying to pull my",
        "leg? You must be joking!"
      ],
      "audioText": "Are you trying to pull my leg? You must be joking!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    },
    {
      "id": "en.n8.class-42.t04",
      "en": "We eat out once in a blue moon; we rarely have enough money.",
      "es": "Salimos a comer muy de vez en cuando; rara vez tenemos bastante dinero.",
      "explanationEs": "Once in a blue moon es un modismo fijo: no admite cambios de palabras ni de orden.",
      "segments": [
        "We eat out once in a blue",
        "moon; we rarely have enough money."
      ],
      "audioText": "We eat out once in a blue moon; we rarely have enough money.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    },
    {
      "id": "en.n8.class-42.t05",
      "en": "The offer came out of the blue, and it was unexpected.",
      "es": "La oferta llegó de repente, y fue inesperada.",
      "explanationEs": "Out of the blue también es fijo: siempre con the y en singular.",
      "segments": [
        "The offer came out of the",
        "blue, and it was unexpected."
      ],
      "audioText": "The offer came out of the blue, and it was unexpected.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    },
    {
      "id": "en.n8.class-42.t06",
      "en": "By and large, I like surprises, but this unexpected call came out of the blue.",
      "es": "En general me gustan las sorpresas, pero esta llamada inesperada llegó de repente.",
      "explanationEs": "By and large = en general; es fija y suele ir al principio de la frase.",
      "segments": [
        "By and large, I like surprises, but this",
        "unexpected call came out of the blue."
      ],
      "audioText": "By and large, I like surprises, but this unexpected call came out of the blue.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-2"
    }
