  "teaching": [
    {
      "id": "en.n8.class-11.t01",
      "en": "It's a bit cold in here can be a hint that you should close the window.",
      "es": "«Hace un poco de frío aquí» puede ser una indirecta para que cierres la ventana.",
      "explanationEs": "La frase habla de la temperatura (literal), pero el hablante pide algo (implícito).",
      "segments": [
        "It's a bit cold in here can be",
        "a hint that you should close the window."
      ],
      "audioText": "It's a bit cold in here can be a hint that you should close the window.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-1"
    },
    {
      "id": "en.n8.class-11.t02",
      "en": "Some of us have been working all morning can imply that you have not helped.",
      "es": "«Algunos llevamos toda la mañana trabajando» puede dar a entender que tú no has ayudado.",
      "explanationEs": "Imply: la frase no acusa, pero el oyente deduce la crítica.",
      "segments": [
        "Some of us have been working all morning",
        "can imply that you have not helped."
      ],
      "audioText": "Some of us have been working all morning can imply that you have not helped.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-1"
    },
    {
      "id": "en.n8.class-11.t03",
      "en": "The literal meaning of Great timing is positive, but her tone shows that she is annoyed.",
      "es": "El significado literal de «qué buen momento» es positivo, pero su tono muestra que está molesta.",
      "explanationEs": "Literal es lo que dicen las palabras; el tono puede cambiar el mensaje.",
      "segments": [
        "The literal meaning of Great timing is positive,",
        "but her tone shows that she is annoyed."
      ],
      "audioText": "The literal meaning of Great timing is positive, but her tone shows that she is annoyed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-1"
    },
    {
      "id": "en.n8.class-11.t04",
      "en": "His reply was I'll think about it, and everyone understood that he meant no.",
      "es": "Su respuesta fue «lo pensaré» y todos entendieron que quería decir que no.",
      "explanationEs": "Una réplica educada puede esconder un rechazo; el contexto lo revela.",
      "segments": [
        "His reply was I'll think about it,",
        "and everyone understood that he meant no."
      ],
      "audioText": "His reply was I'll think about it, and everyone understood that he meant no.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-1"
    },
    {
      "id": "en.n8.class-11.t05",
      "en": "When people complain politely, the hidden message is often in the context, not in the words.",
      "es": "Cuando la gente se queja con educación, el mensaje oculto suele estar en el contexto, no en las palabras.",
      "explanationEs": "Hidden message: lo que no se dice; búscalo en quién habla y en qué situación.",
      "segments": [
        "When people complain politely, the hidden message is",
        "often in the context, not in the words."
      ],
      "audioText": "When people complain politely, the hidden message is often in the context, not in the words.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-1"
    }
  ],
