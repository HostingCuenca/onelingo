  "teaching": [
    {
      "id": "en.n8.class-08.t01",
      "en": "In my memoir, I wrote that I used to live in a tiny flat in Lisbon.",
      "es": "En mis memorias escribí que solía vivir en un piso diminuto en Lisboa.",
      "explanationEs": "Used to + verbo base cuenta un estado o hábito pasado que ya no existe.",
      "segments": [
        "In my memoir, I wrote that I used",
        "to live in a tiny flat in Lisbon."
      ],
      "audioText": "In my memoir, I wrote that I used to live in a tiny flat in Lisbon.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    },
    {
      "id": "en.n8.class-08.t02",
      "en": "Every morning I would walk to the river; it was a habit I loved.",
      "es": "Cada mañana caminaba hasta el río; era una costumbre que adoraba.",
      "explanationEs": "Would + verbo base cuenta una acción repetida en el pasado.",
      "segments": [
        "Every morning I would walk to the",
        "river; it was a habit I loved."
      ],
      "audioText": "Every morning I would walk to the river; it was a habit I loved.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    },
    {
      "id": "en.n8.class-08.t03",
      "en": "I was walking home when I realised I had lost my keys.",
      "es": "Volvía a casa andando cuando me di cuenta de que había perdido las llaves.",
      "explanationEs": "Was walking es la escena en curso; had lost es lo anterior.",
      "segments": [
        "I was walking home when I",
        "realised I had lost my keys."
      ],
      "audioText": "I was walking home when I realised I had lost my keys.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    },
    {
      "id": "en.n8.class-08.t04",
      "en": "By then I had already left the flat, so I gradually forgot the street.",
      "es": "Para entonces ya había dejado el piso, así que poco a poco olvidé la calle.",
      "explanationEs": "By then + had + participio sitúa un hecho anterior a otro punto del pasado.",
      "segments": [
        "By then I had already left the",
        "flat, so I gradually forgot the street."
      ],
      "audioText": "By then I had already left the flat, so I gradually forgot the street.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    },
    {
      "id": "en.n8.class-08.t05",
      "en": "At that time I was working in a tiny bakery.",
      "es": "En aquella época trabajaba en una panadería diminuta.",
      "explanationEs": "Was working presenta una etapa en curso en el pasado, como fondo de la historia.",
      "segments": [
        "At that time I was",
        "working in a tiny bakery."
      ],
      "audioText": "At that time I was working in a tiny bakery.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    },
    {
      "id": "en.n8.class-08.t06",
      "en": "Writing letters was her habit; now she no longer does it.",
      "es": "Escribir cartas era su costumbre; ahora ya no lo hace.",
      "explanationEs": "No longer marca que el hábito pasado terminó.",
      "segments": [
        "Writing letters was her habit; now",
        "she no longer does it."
      ],
      "audioText": "Writing letters was her habit; now she no longer does it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-time-perspective-3"
    }
  ],
