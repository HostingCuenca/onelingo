      "patternId": "n8-figurative-language-3"
    },
    {
      "id": "en.n8.class-38.t03",
      "en": "The second half was a rollercoaster, with three goals in ten minutes.",
      "es": "La segunda parte fue una montaña rusa, con tres goles en diez minutos.",
      "explanationEs": "A rollercoaster: muchas subidas y bajadas de emoción en poco tiempo.",
      "segments": [
        "The second half was a rollercoaster,",
        "with three goals in ten minutes."
      ],
      "audioText": "The second half was a rollercoaster, with three goals in ten minutes.",
