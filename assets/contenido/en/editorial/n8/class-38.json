  "teaching": [
    {
      "id": "en.n8.class-38.t01",
      "en": "City crushed United 3–0, and their defence was a wall.",
      "es": "El City aplastó al United 3-0 y su defensa fue un muro.",
      "explanationEs": "Crushed = ganó por mucho; a wall = no dejó pasar a nadie.",
      "segments": [
        "City crushed United 3–0, and",
        "their defence was a wall."
      ],
      "audioText": "City crushed United 3–0, and their defence was a wall.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-3"
    },
    {
      "id": "en.n8.class-38.t02",
      "en": "After the first goal, the visitors were a sinking ship.",
      "es": "Tras el primer gol, los visitantes eran un barco que se hunde.",
      "explanationEs": "A sinking ship: un equipo perdido que ya no puede reaccionar.",
      "segments": [
        "After the first goal, the",
        "visitors were a sinking ship."
      ],
      "audioText": "After the first goal, the visitors were a sinking ship.",
