    },
    {
      "id": "en.n8.class-38.t05",
      "en": "Storm clouds are gathering over the coast, so take an umbrella.",
      "es": "Se están acumulando nubarrones sobre la costa, así que lleva paraguas.",
      "explanationEs": "Are gathering: las nubes «se reúnen» como personas; el sentido real es que va a llover.",
      "segments": [
        "Storm clouds are gathering over the",
        "coast, so take an umbrella."
      ],
      "audioText": "Storm clouds are gathering over the coast, so take an umbrella.",
      "audioMode": "tts",
