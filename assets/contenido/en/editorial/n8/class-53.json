  "teaching": [
    {
      "id": "en.n8.class-53.t01",
      "en": "Leo sounds defensive because he answers every question with another question.",
      "es": "Leo suena a la defensiva porque responde a cada pregunta con otra pregunta.",
      "explanationEs": "Sounds + adjetivo (sin -ly): así describes la actitud que oyes.",
      "segments": [
        "Leo sounds defensive because he answers",
        "every question with another question."
      ],
      "audioText": "Leo sounds defensive because he answers every question with another question.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    },
    {
      "id": "en.n8.class-53.t02",
      "en": "Her tone is sarcastic: she says «great», but she does not mean it.",
      "es": "Su tono es sarcástico: dice «genial», pero no lo piensa.",
      "explanationEs": "El sarcasmo dice lo contrario de lo que se piensa; el tono y el contexto son las pistas.",
      "segments": [
        "Her tone is sarcastic: she says «great»,",
        "but she does not mean it."
      ],
      "audioText": "Her tone is sarcastic: she says «great», but she does not mean it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    },
    {
      "id": "en.n8.class-53.t03",
      "en": "The long pause is a clue that he is hesitant.",
      "es": "La pausa larga es una pista de que él duda.",
      "explanationEs": "Las pausas y los «well…» indican duda; la pista apoya tu juicio sobre la actitud.",
      "segments": [
        "The long pause is a",
        "clue that he is hesitant."
      ],
      "audioText": "The long pause is a clue that he is hesitant.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    },
    {
      "id": "en.n8.class-53.t04",
      "en": "Mia sounds anxious, so Tom tries to reassure her.",
      "es": "Mia suena ansiosa, así que Tom intenta tranquilizarla.",
      "explanationEs": "Reassure = tranquilizar dando seguridad; anxious = con ansiedad.",
      "segments": [
        "Mia sounds anxious, so Tom",
        "tries to reassure her."
      ],
      "audioText": "Mia sounds anxious, so Tom tries to reassure her.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    },
    {
      "id": "en.n8.class-53.t05",
      "en": "A dismissive attitude shows in short answers like «Whatever».",
      "es": "Una actitud desdeñosa se nota en respuestas cortas como «Lo que sea».",
      "explanationEs": "Dismissive = quita importancia a lo que dice el otro.",
      "segments": [
        "A dismissive attitude shows in",
        "short answers like «Whatever»."
      ],
      "audioText": "A dismissive attitude shows in short answers like «Whatever».",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    },
    {
      "id": "en.n8.class-53.t06",
      "en": "He is evasive: he never answers the question, so the teacher becomes suspicious.",
      "es": "Es evasivo: nunca responde a la pregunta, así que la profesora desconfía.",
      "explanationEs": "Evasive = esquiva las preguntas; suspicious = desconfía de lo que oye.",
      "segments": [
        "He is evasive: he never answers the",
        "question, so the teacher becomes suspicious."
      ],
      "audioText": "He is evasive: he never answers the question, so the teacher becomes suspicious.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-film-scenes-3"
    }
  ],
