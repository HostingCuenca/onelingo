  "teaching": [
    {
      "id": "en.n8.class-17.t01",
      "en": "The muddy footprints point to someone who came in from the garden.",
      "es": "Las huellas de barro apuntan a alguien que entró desde el jardín.",
      "explanationEs": "Point to: la evidencia apunta hacia una explicación sin afirmarla.",
      "segments": [
        "The muddy footprints point to someone",
        "who came in from the garden."
      ],
      "audioText": "The muddy footprints point to someone who came in from the garden.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-2"
    },
    {
      "id": "en.n8.class-17.t02",
      "en": "The photo from the camera lends weight to her story.",
      "es": "La foto de la cámara da peso a su versión.",
      "explanationEs": "Lend weight to: refuerza una tesis, la hace más creíble.",
      "segments": [
        "The photo from the camera",
        "lends weight to her story."
      ],
      "audioText": "The photo from the camera lends weight to her story.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-2"
    },
    {
      "id": "en.n8.class-17.t03",
      "en": "A second receipt casts doubt on his story.",
      "es": "Un segundo recibo pone en duda su versión.",
      "explanationEs": "Cast doubt on: debilita una tesis; doubt es incontable.",
      "segments": [
        "A second receipt casts",
        "doubt on his story."
      ],
      "audioText": "A second receipt casts doubt on his story.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-2"
    },
    {
      "id": "en.n8.class-17.t04",
      "en": "His story is consistent with the time on the receipt.",
      "es": "Su versión es coherente con la hora del recibo.",
      "explanationEs": "Be consistent with: encaja con la prueba, sin demostrarla.",
      "segments": [
        "His story is consistent with",
        "the time on the receipt."
      ],
      "audioText": "His story is consistent with the time on the receipt.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-2"
    },
    {
      "id": "en.n8.class-17.t05",
      "en": "The window was broken from outside, so the thief must have come through the garden.",
      "es": "La ventana se rompió desde fuera, así que el ladrón debe de haber entrado por el jardín.",
