  "teaching": [
    {
      "id": "en.n8.class-27.t01",
      "en": "We regret to inform you that the meeting has been postponed.",
      "es": "Lamentamos informarle de que la reunión se ha aplazado.",
      "explanationEs": "Formal: regret to inform + pasiva. Informal: We've put off the meeting.",
      "segments": [
        "We regret to inform you that",
        "the meeting has been postponed."
      ],
      "audioText": "We regret to inform you that the meeting has been postponed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    },
    {
      "id": "en.n8.class-27.t02",
      "en": "Applicants can obtain the form from the school office.",
      "es": "Los solicitantes pueden obtener el formulario en la secretaría del colegio.",
      "explanationEs": "Obtain es la versión formal de get.",
      "segments": [
        "Applicants can obtain the form",
        "from the school office."
      ],
      "audioText": "Applicants can obtain the form from the school office.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    },
    {
      "id": "en.n8.class-27.t03",
      "en": "Our staff will assist you with the application.",
      "es": "Nuestro personal le ayudará con la solicitud.",
      "explanationEs": "Assist = help en registro formal. Cuidado: no significa asistir a un evento.",
      "segments": [
        "Our staff will assist",
        "you with the application."
      ],
      "audioText": "Our staff will assist you with the application.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    },
    {
      "id": "en.n8.class-27.t04",
      "en": "All visitors require a valid ticket.",
      "es": "Todos los visitantes necesitan una entrada válida.",
      "explanationEs": "Require es la versión formal de need.",
      "segments": [
        "All visitors require",
        "a valid ticket."
      ],
      "audioText": "All visitors require a valid ticket.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    },
    {
      "id": "en.n8.class-27.t05",
      "en": "We apologise for the delay and have decided to postpone the trip.",
      "es": "Pedimos disculpas por el retraso y hemos decidido aplazar el viaje.",
      "explanationEs": "Apologise sustituye a say sorry; postpone sustituye a put off.",
      "segments": [
        "We apologise for the delay and",
        "have decided to postpone the trip."
      ],
      "audioText": "We apologise for the delay and have decided to postpone the trip.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    },
    {
      "id": "en.n8.class-27.t06",
      "en": "In an informal message we say: sorry, we've put off the trip.",
      "es": "En un mensaje informal decimos: lo siento, hemos aplazado el viaje.",
      "explanationEs": "Informal: contracciones, sorry y el verbo frasal put off.",
      "segments": [
        "In an informal message we say:",
        "sorry, we've put off the trip."
      ],
      "audioText": "In an informal message we say: sorry, we've put off the trip.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-2"
    }
  ],
