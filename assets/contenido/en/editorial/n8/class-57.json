  "teaching": [
    {
      "id": "en.n8.class-57.t01",
      "en": "Some experts claim that eight hours of sleep is too much.",
      "es": "Algunos expertos afirman que ocho horas de sueño son demasiadas.",
      "explanationEs": "Claim + that + oración: afirmas algo que otros pueden discutir.",
      "segments": [
        "Some experts claim that eight hours",
        "of sleep is too much."
      ],
      "audioText": "Some experts claim that eight hours of sleep is too much.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-2"
    },
    {
      "id": "en.n8.class-57.t02",
      "en": "Critics point out that the study is small, so the summary must be careful.",
      "es": "Los críticos señalan que el estudio es pequeño, así que el resumen debe ser prudente.",
      "explanationEs": "Point out + that: señalas un dato, normalmente para matizar lo que se dijo.",
      "segments": [
        "Critics point out that the study is",
        "small, so the summary must be careful."
      ],
      "audioText": "Critics point out that the study is small, so the summary must be careful.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-2"
    },
    {
      "id": "en.n8.class-57.t03",
      "en": "Many people admit checking their phones at night, but some deny doing it.",
      "es": "Mucha gente admite revisar el móvil por la noche, pero algunos niegan hacerlo.",
      "explanationEs": "Admit y deny + -ing: reconocer o negar una acción.",
      "segments": [
        "Many people admit checking their phones at",
        "night, but some deny doing it."
      ],
      "audioText": "Many people admit checking their phones at night, but some deny doing it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-2"
    },
    {
      "id": "en.n8.class-57.t04",
      "en": "Doctors suggest going to bed earlier, and they warn people not to drink coffee late.",
      "es": "Los médicos sugieren acostarse más temprano y advierten a la gente de que no tome café tarde.",
      "explanationEs": "Suggest + -ing; warn + persona + (not) to + verbo.",
      "segments": [
        "Doctors suggest going to bed earlier, and they",
        "warn people not to drink coffee late."
      ],
      "audioText": "Doctors suggest going to bed earlier, and they warn people not to drink coffee late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-2"
    },
    {
      "id": "en.n8.class-57.t05",
      "en": "Some guests refuse to answer, and others promise to reply later.",
      "es": "Algunos invitados se niegan a responder y otros prometen contestar más tarde.",
      "explanationEs": "Refuse y promise + to + verbo: negarse o comprometerse a hacer algo.",
      "segments": [
        "Some guests refuse to answer, and",
        "others promise to reply later."
      ],
      "audioText": "Some guests refuse to answer, and others promise to reply later.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-2"
    }
  ],
