    {
      "id": "en.n8.class-87.t01",
      "en": "Bus use rose sharply in March, from 2,000 to 3,500 passengers.",
      "es": "El uso del autobús subió bruscamente en marzo, de 2.000 a 3.500 pasajeros.",
      "explanationEs": "Rose sharply: verbo de subida + adverbio de intensidad; from… to… da el punto de partida y de llegada.",
      "segments": [
        "Bus use rose sharply in March,",
        "from 2,000 to 3,500 passengers."
      ],
      "audioText": "Bus use rose sharply in March, from 2,000 to 3,500 passengers.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-2"
    },
    {
      "id": "en.n8.class-87.t02",
      "en": "The number of cyclists fell slightly between May and June.",
      "es": "El número de ciclistas bajó ligeramente entre mayo y junio.",
      "explanationEs": "Slightly describe un cambio pequeño; fell es el pasado de fall.",
      "segments": [
        "The number of cyclists fell",
        "slightly between May and June."
      ],
      "audioText": "The number of cyclists fell slightly between May and June.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-2"
    },
    {
      "id": "en.n8.class-87.t03",
      "en": "Train use grew gradually over the whole year.",
      "es": "El uso del tren creció poco a poco durante todo el año.",
      "explanationEs": "Gradually: cambio lento y continuo; el periodo terminado va en pasado.",
      "segments": [
        "Train use grew gradually",
        "over the whole year."
      ],
      "audioText": "Train use grew gradually over the whole year.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-presentations-2"
    },
    {
      "id": "en.n8.class-87.t04",
      "en": "There was a steady rise in tram passengers, from 900 to 1,200.",
      "es": "Hubo una subida constante de pasajeros de tranvía, de 900 a 1.200.",
      "explanationEs": "There was a steady rise: sustantivo de tendencia con adjetivo; steady = sin saltos.",
      "segments": [
        "There was a steady rise in",
        "tram passengers, from 900 to 1,200."
      ],
      "audioText": "There was a steady rise in tram passengers, from 900 to 1,200.",
