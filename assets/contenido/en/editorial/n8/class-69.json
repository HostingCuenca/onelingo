  "teaching": [
    {
      "id": "en.n8.class-69.t01",
      "en": "I remember playing on my grandmother's porch every summer.",
      "es": "Recuerdo haber jugado en el porche de mi abuela cada verano.",
      "explanationEs": "Remember + -ing es el recuerdo de algo que ya ocurrió: me veo jugando en el porche.",
      "segments": [
        "I remember playing on my",
        "grandmother's porch every summer."
      ],
      "audioText": "I remember playing on my grandmother's porch every summer.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-4"
    },
    {
      "id": "en.n8.class-69.t02",
      "en": "I must remember to call her on Sunday.",
      "es": "Tengo que acordarme de llamarla el domingo.",
      "explanationEs": "Remember + to es no olvidar una tarea futura: es una obligación, no un recuerdo.",
      "segments": [
        "I must remember to",
        "call her on Sunday."
      ],
      "audioText": "I must remember to call her on Sunday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-4"
    },
    {
      "id": "en.n8.class-69.t03",
      "en": "I will never forget hearing the creak of that old gate.",
      "es": "Nunca olvidaré oír el chirrido de aquella vieja verja.",
      "explanationEs": "Forget + -ing es un recuerdo vivido que no se borra; creak añade un detalle de sonido.",
      "segments": [
        "I will never forget hearing the",
        "creak of that old gate."
      ],
      "audioText": "I will never forget hearing the creak of that old gate.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-4"
    },
    {
      "id": "en.n8.class-69.t04",
      "en": "I regret not saying goodbye to her.",
      "es": "Lamento no haberme despedido de ella.",
      "explanationEs": "Regret + -ing lamenta algo que hiciste o no hiciste; not va delante del -ing.",
      "segments": [
        "I regret not saying",
        "goodbye to her."
      ],
      "audioText": "I regret not saying goodbye to her.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-4"
    },
    {
      "id": "en.n8.class-69.t05",
      "en": "The scent of warm bread is a vivid memory for me.",
      "es": "El olor del pan caliente es para mí un recuerdo muy vívido.",
      "explanationEs": "Scent, warm y vivid son detalles de los sentidos: hacen que la escena se vea y se huela.",
      "segments": [
        "The scent of warm bread is",
        "a vivid memory for me."
      ],
      "audioText": "The scent of warm bread is a vivid memory for me.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-4"
    },
    {
      "id": "en.n8.class-69.t06",
      "en": "An echo of her voice still stays in my mind.",
      "es": "Un eco de su voz todavía permanece en mi mente.",
      "explanationEs": "Echo añade un detalle sonoro y lo une con la memoria: still marca que el recuerdo sigue ahí.",
      "segments": [
        "An echo of her voice",
        "still stays in my mind."
      ],
      "audioText": "An echo of her voice still stays in my mind.",
      "audioMode": "tts",
