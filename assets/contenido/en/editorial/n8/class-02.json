  "id": "en.n8.class-02",
  "title": {
    "en": "Linking, elision and stress",
    "es": "Enlaces, elisiones y acento de frase"
  },
  "objectives": {
    "es": [
      "Predecir cómo se enlazan y se omiten sonidos entre palabras (next day, old man, turn it off) y completar frases dictadas con la forma realmente pronunciada."
    ]
  },
