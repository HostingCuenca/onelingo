  "teaching": [
    {
      "id": "en.n8.class-02.t01",
      "en": "When people talk fast, they blend words, so 'pick it up' sounds like one word.",
      "es": "Cuando la gente habla rápido, une las palabras, y «pick it up» suena como una sola palabra.",
      "explanationEs": "Pick it up se oye «pi-ki-tup»: las palabras se funden.",
      "segments": [
        "When people talk fast, they blend words, so",
        "'pick it up' sounds like one word."
      ],
      "audioText": "When people talk fast, they blend words, so 'pick it up' sounds like one word.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    },
    {
      "id": "en.n8.class-02.t02",
      "en": "A final consonant joins the next vowel: 'turn it off' sounds like 'tur-ni-toff'.",
      "es": "Una consonante final se une a la vocal siguiente: «turn it off» suena «tur-ni-toff».",
      "explanationEs": "La n de turn y la t de it pasan a empezar la sílaba siguiente.",
      "segments": [
        "A final consonant joins the next vowel:",
        "'turn it off' sounds like 'tur-ni-toff'."
      ],
      "audioText": "A final consonant joins the next vowel: 'turn it off' sounds like 'tur-ni-toff'.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    },
    {
      "id": "en.n8.class-02.t03",
      "en": "Many speakers drop the t in 'next day', so you hear 'nex day'.",
      "es": "Muchos hablantes omiten la t de «next day», y se oye «nex day».",
      "explanationEs": "La t casi desaparece entre dos consonantes, pero se escribe.",
      "segments": [
        "Many speakers drop the t in 'next",
        "day', so you hear 'nex day'."
      ],
      "audioText": "Many speakers drop the t in 'next day', so you hear 'nex day'.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    },
    {
      "id": "en.n8.class-02.t04",
      "en": "We swallow the d in 'old man', and it sounds like 'ol man'.",
      "es": "Nos tragamos la d de «old man», y suena «ol man».",
      "explanationEs": "La d entre dos consonantes se debilita mucho.",
      "segments": [
        "We swallow the d in 'old man',",
        "and it sounds like 'ol man'."
      ],
      "audioText": "We swallow the d in 'old man', and it sounds like 'ol man'.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    },
    {
      "id": "en.n8.class-02.t05",
      "en": "In 'I can't find my keys', the stressed word is 'keys'.",
      "es": "En «I can't find my keys», la palabra acentuada es «keys».",
      "explanationEs": "Las palabras importantes se pronuncian más fuerte y largas.",
      "segments": [
        "In 'I can't find my keys',",
        "the stressed word is 'keys'."
      ],
      "audioText": "In 'I can't find my keys', the stressed word is 'keys'.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    },
    {
      "id": "en.n8.class-02.t06",
      "en": "You link 'last' and 'night' in fast speech, and the t almost disappears.",
      "es": "Enlazas «last» y «night» al hablar rápido, y la t casi desaparece.",
      "explanationEs": "Al enlazar dos palabras, la consonante débil se pierde.",
      "segments": [
        "You link 'last' and 'night' in fast",
        "speech, and the t almost disappears."
      ],
      "audioText": "You link 'last' and 'night' in fast speech, and the t almost disappears.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-connected-speech-2"
    }
  ],
