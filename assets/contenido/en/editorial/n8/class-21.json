  "teaching": [
    {
      "id": "en.n8.class-21.t01",
      "en": "This slogan uses repetition: clean rivers, clean streets, clean lives.",
      "es": "Este eslogan usa la repetición: ríos limpios, calles limpias, vidas limpias.",
      "explanationEs": "Repetición: la misma palabra (clean) vuelve a aparecer para que el eslogan se recuerde.",
      "segments": [
        "This slogan uses repetition: clean",
        "rivers, clean streets, clean lives."
      ],
      "audioText": "This slogan uses repetition: clean rivers, clean streets, clean lives.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    },
    {
      "id": "en.n8.class-21.t02",
      "en": "The advert uses contrast: the old bus is slow, but the new bus is fast.",
      "es": "El anuncio usa el contraste: el autobús viejo es lento, pero el nuevo es rápido.",
      "explanationEs": "Contraste: dos ideas opuestas en la misma frase para destacar la elección.",
      "segments": [
        "The advert uses contrast: the old bus is",
        "slow, but the new bus is fast."
      ],
      "audioText": "The advert uses contrast: the old bus is slow, but the new bus is fast.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    },
    {
      "id": "en.n8.class-21.t03",
      "en": "A rhetorical question does not need an answer because the audience already agrees.",
      "es": "Una pregunta retórica no necesita respuesta porque el público ya está de acuerdo.",
      "explanationEs": "Pregunta retórica: se formula para pensar, no para recibir una respuesta.",
      "segments": [
        "A rhetorical question does not need an",
        "answer because the audience already agrees."
      ],
      "audioText": "A rhetorical question does not need an answer because the audience already agrees.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    },
    {
      "id": "en.n8.class-21.t04",
      "en": "Each technique has a different effect on the reader.",
      "es": "Cada técnica tiene un efecto distinto en el lector.",
      "explanationEs": "Al analizar: primero nombra la técnica y después explica su efecto.",
      "segments": [
        "Each technique has a different",
        "effect on the reader."
      ],
      "audioText": "Each technique has a different effect on the reader.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    },
    {
      "id": "en.n8.class-21.t05",
      "en": "Repetition gives emphasis to the main idea, so the slogan is memorable.",
      "es": "La repetición da énfasis a la idea principal, así que el eslogan se recuerda.",
      "explanationEs": "Emphasis: la técnica subraya la idea clave; memorable = fácil de recordar.",
      "segments": [
        "Repetition gives emphasis to the main",
        "idea, so the slogan is memorable."
      ],
      "audioText": "Repetition gives emphasis to the main idea, so the slogan is memorable.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    },
    {
      "id": "en.n8.class-21.t06",
      "en": "The writer wants to persuade the reader to recycle more paper.",
      "es": "El autor quiere persuadir al lector para que recicle más papel.",
      "explanationEs": "Persuade someone to + verbo: persuadir a alguien de que haga algo.",
      "segments": [
        "The writer wants to persuade the",
        "reader to recycle more paper."
      ],
      "audioText": "The writer wants to persuade the reader to recycle more paper.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-1"
    }
  ],
