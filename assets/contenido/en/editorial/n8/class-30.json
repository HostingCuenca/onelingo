    },
    {
      "id": "en.n8.class-30.t04",
      "en": "We can find a solution together if we both listen.",
      "es": "Podemos encontrar una solución juntos si los dos escuchamos.",
      "explanationEs": "Solution: propuesta conjunta y concreta.",
