      "languageCode": "en",
      "patternId": "n8-style-register-5"
    },
    {
      "id": "en.n8.class-30.t02",
      "en": "A considerate reply begins with an apology: I am sorry that the music disturbed you.",
      "es": "Una respuesta considerada empieza con una disculpa: Siento que la música le molestara.",
      "explanationEs": "Apology + I am sorry that + hecho: sin reproches.",
      "segments": [
        "A considerate reply begins with an apology: I",
        "am sorry that the music disturbed you."
