  "teaching": [
    {
      "id": "en.n8.class-22.t01",
      "en": "The speaker uses parallelism: we want to learn, to share and to grow.",
      "es": "El orador usa paralelismo: queremos aprender, compartir y crecer.",
      "explanationEs": "Paralelismo: cada parte repite la misma forma (to + verbo).",
      "segments": [
        "The speaker uses parallelism: we want to",
        "learn, to share and to grow."
      ],
      "audioText": "The speaker uses parallelism: we want to learn, to share and to grow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    },
    {
      "id": "en.n8.class-22.t02",
      "en": "A tricolon gives the rhythm of three: safe streets, clean air, happy people.",
      "es": "Un tricolon da el ritmo de tres: calles seguras, aire limpio, gente feliz.",
      "explanationEs": "Tricolon: tres partes seguidas con la misma forma.",
      "segments": [
        "A tricolon gives the rhythm of three:",
        "safe streets, clean air, happy people."
      ],
      "audioText": "A tricolon gives the rhythm of three: safe streets, clean air, happy people.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    },
    {
      "id": "en.n8.class-22.t03",
      "en": "Antithesis puts opposite ideas in the same structure: young in years, old in wisdom.",
      "es": "La antítesis pone ideas opuestas en la misma estructura: joven en años, viejo en sabiduría.",
      "explanationEs": "Antítesis: opuestos (young/old) con estructura igual (adjetivo + in + nombre).",
      "segments": [
        "Antithesis puts opposite ideas in the same",
        "structure: young in years, old in wisdom."
      ],
      "audioText": "Antithesis puts opposite ideas in the same structure: young in years, old in wisdom.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    },
    {
      "id": "en.n8.class-22.t04",
      "en": "Every part has the same grammar, so the structure keeps its balance.",
      "es": "Cada parte tiene la misma gramática, así que la estructura mantiene su equilibrio.",
      "explanationEs": "Si una parte cambia de forma, se rompe el equilibrio.",
      "segments": [
        "Every part has the same grammar,",
        "so the structure keeps its balance."
      ],
      "audioText": "Every part has the same grammar, so the structure keeps its balance.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    },
    {
      "id": "en.n8.class-22.t05",
      "en": "The speaker was so calm that everybody listened.",
      "es": "El orador estaba tan tranquilo que todos escucharon.",
      "explanationEs": "Repaso: so + adjetivo + that = tan… que.",
      "segments": [
        "The speaker was so",
        "calm that everybody listened."
      ],
      "audioText": "The speaker was so calm that everybody listened.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    },
    {
      "id": "en.n8.class-22.t06",
      "en": "It was such a clear structure that everybody remembered it.",
      "es": "Era una estructura tan clara que todos la recordaron.",
      "explanationEs": "Repaso: such + a + adjetivo + nombre + that.",
      "segments": [
        "It was such a clear",
        "structure that everybody remembered it."
      ],
      "audioText": "It was such a clear structure that everybody remembered it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-2"
    }
  ],
