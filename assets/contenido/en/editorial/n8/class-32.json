  "teaching": [
    {
      "id": "en.n8.class-32.t01",
      "en": "Saying “unemployed” is blunt, so many people say “between jobs”.",
      "es": "Decir «desempleado» es brusco, así que mucha gente dice «entre trabajos».",
      "explanationEs": "Between jobs es un eufemismo: suaviza una situación difícil y deja abierta una salida.",
      "segments": [
        "Saying “unemployed” is blunt, so",
        "many people say “between jobs”."
      ],
      "audioText": "Saying “unemployed” is blunt, so many people say “between jobs”.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-2"
    },
    {
      "id": "en.n8.class-32.t02",
      "en": "Sadly, my elderly neighbour passed away last week.",
      "es": "Por desgracia, mi vecino mayor falleció la semana pasada.",
      "explanationEs": "Passed away es más suave que died; elderly es más amable que old.",
      "segments": [
        "Sadly, my elderly neighbour",
        "passed away last week."
      ],
      "audioText": "Sadly, my elderly neighbour passed away last week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-2"
    },
    {
      "id": "en.n8.class-32.t03",
      "en": "The company had to let three workers go, so the manager spoke gently.",
      "es": "La empresa tuvo que despedir a tres trabajadores, así que el jefe habló con delicadeza.",
      "explanationEs": "Let someone go es la forma suave de fire (He was let go = lo despidieron); gently describe el tono con que se da la noticia.",
      "segments": [
        "The company had to let three workers",
        "go, so the manager spoke gently."
      ],
      "audioText": "The company had to let three workers go, so the manager spoke gently.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-2"
    },
    {
      "id": "en.n8.class-32.t04",
      "en": "Saying “not the best” about a terrible film is a classic understatement.",
      "es": "Decir «no es lo mejor» de una película terrible es una atenuación clásica.",
      "explanationEs": "Not the best rebaja la opinión: el oyente entiende «malo».",
      "segments": [
        "Saying “not the best” about a",
        "terrible film is a classic understatement."
      ],
      "audioText": "Saying “not the best” about a terrible film is a classic understatement.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-2"
    },
    {
      "id": "en.n8.class-32.t05",
      "en": "“Cosy” is often a euphemism for “very small”.",
      "es": "«Acogedor» suele ser un eufemismo de «muy pequeño».",
      "explanationEs": "Los anuncios de pisos usan eufemismos: cosy, compact… El mensaje real es otro.",
      "segments": [
        "“Cosy” is often a",
        "euphemism for “very small”."
      ],
      "audioText": "“Cosy” is often a euphemism for “very small”.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-2"
    }
  ],
