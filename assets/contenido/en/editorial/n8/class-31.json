  "teaching": [
    {
      "id": "en.n8.class-31.t01",
      "en": "I don't suppose you could lend me your ladder.",
      "es": "No creo que pudieras prestarme tu escalera, ¿verdad?",
      "explanationEs": "I don't suppose you could + verbo base es la petición más indirecta: espera un «no» y deja una salida fácil.",
      "segments": [
        "I don't suppose you could",
        "lend me your ladder."
      ],
      "audioText": "I don't suppose you could lend me your ladder.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-1"
    },
    {
      "id": "en.n8.class-31.t02",
      "en": "Would it be at all possible to borrow the ladder until Sunday?",
      "es": "¿Sería posible en absoluto tomar prestada la escalera hasta el domingo?",
      "explanationEs": "Would it be (at all) possible to + verbo: muy formal; at all suaviza todavía más.",
      "segments": [
        "Would it be at all possible",
        "to borrow the ladder until Sunday?"
      ],
      "audioText": "Would it be at all possible to borrow the ladder until Sunday?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-1"
    },
    {
      "id": "en.n8.class-31.t03",
      "en": "I was wondering if you might do me a favour.",
      "es": "Me preguntaba si podrías hacerme un favor.",
      "explanationEs": "I was wondering if + might/could: el pasado crea distancia y suena cortés, no dudoso.",
      "segments": [
        "I was wondering if you",
        "might do me a favour."
      ],
      "audioText": "I was wondering if you might do me a favour.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-1"
    },
    {
      "id": "en.n8.class-31.t04",
      "en": "Would you mind lending me the ladder for an hour?",
      "es": "¿Te importaría prestarme la escalera una hora?",
      "explanationEs": "Would you mind + verbo en -ing: petición cortés y algo más indirecta que Could you…?",
      "segments": [
        "Would you mind lending me",
        "the ladder for an hour?"
      ],
      "audioText": "Would you mind lending me the ladder for an hour?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-1"
    },
    {
      "id": "en.n8.class-31.t05",
      "en": "Could you lend me the ladder?",
      "es": "¿Podrías prestarme la escalera?",
      "explanationEs": "Could you…? es la petición neutra: sirve con casi todos si el favor es pequeño.",
      "segments": [
        "Could you lend",
        "me the ladder?"
      ],
      "audioText": "Could you lend me the ladder?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-1"
    },
    {
