  "teaching": [
    {
      "id": "en.n8.class-16.t01",
      "en": "A writer can imply a problem without naming it.",
      "es": "Un autor puede insinuar un problema sin nombrarlo.",
      "explanationEs": "Imply lo hace quien habla o escribe: da a entender sin decirlo.",
      "segments": [
        "A writer can imply a",
        "problem without naming it."
      ],
      "audioText": "A writer can imply a problem without naming it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-1"
    },
    {
      "id": "en.n8.class-16.t02",
      "en": "From her silence, I infer that she is not happy.",
      "es": "Por su silencio, deduzco que no está contenta.",
      "explanationEs": "Infer lo hace quien escucha o lee: saca una conclusión por sí mismo.",
      "segments": [
        "From her silence, I infer",
        "that she is not happy."
      ],
      "audioText": "From her silence, I infer that she is not happy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-1"
    },
    {
      "id": "en.n8.class-16.t03",
      "en": "The survey results suggest that most students prefer online classes.",
      "es": "Los resultados de la encuesta sugieren que la mayoría de los estudiantes prefiere las clases en línea.",
      "explanationEs": "Suggest: los datos apuntan a algo posible, sin certeza.",
      "segments": [
        "The survey results suggest that",
        "most students prefer online classes."
      ],
      "audioText": "The survey results suggest that most students prefer online classes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-1"
    },
    {
      "id": "en.n8.class-16.t04",
      "en": "The thermometer readings indicate that the room is too hot.",
      "es": "Las lecturas del termómetro indican que la habitación está demasiado caliente.",
      "explanationEs": "Indicate: los datos señalan un hecho con más firmeza que suggest.",
      "segments": [
        "The thermometer readings indicate that",
        "the room is too hot."
      ],
      "audioText": "The thermometer readings indicate that the room is too hot.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-1"
    },
    {
      "id": "en.n8.class-16.t05",
      "en": "We need more evidence before we draw a conclusion.",
      "es": "Necesitamos más pruebas antes de sacar una conclusión.",
      "explanationEs": "Evidence es incontable: no lleva plural ni «a»; draw a conclusion = sacar una conclusión.",
      "segments": [
        "We need more evidence before",
        "we draw a conclusion."
      ],
      "audioText": "We need more evidence before we draw a conclusion.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-1"
    }
  ],
