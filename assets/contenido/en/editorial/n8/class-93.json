  "teaching": [
    {
      "id": "en.n8.class-93.t01",
      "en": "This lyric is about the bus ride home at night.",
      "es": "Esta letra trata del viaje a casa en autobús por la noche.",
      "explanationEs": "Lyric es el texto de una canción; empieza el análisis diciendo de qué trata.",
      "segments": [
        "This lyric is about the",
        "bus ride home at night."
      ],
      "audioText": "This lyric is about the bus ride home at night.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    },
    {
      "id": "en.n8.class-93.t02",
      "en": "The theme is comfort: the singer wants to feel safe at home.",
      "es": "El tema es el consuelo: la cantante quiere sentirse segura en casa.",
      "explanationEs": "El tema es la idea central; el tono (calm, tender) es la actitud o el ambiente.",
      "segments": [
        "The theme is comfort: the singer",
        "wants to feel safe at home."
      ],
      "audioText": "The theme is comfort: the singer wants to feel safe at home.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    },
    {
      "id": "en.n8.class-93.t03",
      "en": "Each verse adds a detail, and the chorus repeats “take me home”.",
      "es": "Cada estrofa añade un detalle y el estribillo repite «llévame a casa».",
      "explanationEs": "La repetición del estribillo subraya la idea principal.",
      "segments": [
        "Each verse adds a detail, and",
        "the chorus repeats “take me home”."
      ],
      "audioText": "Each verse adds a detail, and the chorus repeats “take me home”.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    },
    {
      "id": "en.n8.class-93.t04",
      "en": "“The city is a sleeping giant” is a metaphor.",
      "es": "«La ciudad es un gigante dormido» es una metáfora.",
      "explanationEs": "Metáfora: dice que A es B, sin like ni as.",
      "segments": [
        "“The city is a sleeping",
        "giant” is a metaphor."
      ],
      "audioText": "“The city is a sleeping giant” is a metaphor.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    },
    {
      "id": "en.n8.class-93.t05",
      "en": "“Like a paper boat on a slow, warm river” is a simile.",
      "es": "«Como un barquito de papel en un río lento y cálido» es un símil.",
      "explanationEs": "Símil: compara dos cosas con like o as.",
      "segments": [
        "“Like a paper boat on a",
        "slow, warm river” is a simile."
      ],
      "audioText": "“Like a paper boat on a slow, warm river” is a simile.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    },
    {
      "id": "en.n8.class-93.t06",
      "en": "The streetlamps whisper, so the lyric uses personification.",
      "es": "Las farolas susurran, así que la letra usa personificación.",
      "explanationEs": "Personificación: un objeto hace algo que solo hacen las personas.",
      "segments": [
        "The streetlamps whisper, so",
        "the lyric uses personification."
      ],
      "audioText": "The streetlamps whisper, so the lyric uses personification.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-3"
    }
  ],
