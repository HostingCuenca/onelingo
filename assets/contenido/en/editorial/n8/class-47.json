      "languageCode": "en",
      "patternId": "n8-english-varieties-2"
    },
    {
      "id": "en.n8.class-47.t02",
      "en": "We meet at the weekend in Britain, but Americans say on the weekend.",
      "es": "En Gran Bretaña quedamos «at the weekend», pero los estadounidenses dicen «on the weekend».",
      "explanationEs": "La preposición cambia: at (RU) / on (EE. UU.).",
      "segments": [
        "We meet at the weekend in Britain,",
        "but Americans say on the weekend."
