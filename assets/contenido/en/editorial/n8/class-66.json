  "teaching": [
    {
      "id": "en.n8.class-66.t01",
      "en": "I open the letter and my hands tremble.",
      "es": "Abro la carta y me tiemblan las manos.",
      "explanationEs": "El pronombre I es la pista de la primera persona: el narrador es un personaje y solo cuenta lo que vive y siente.",
      "segments": [
        "I open the letter",
        "and my hands tremble."
      ],
      "audioText": "I open the letter and my hands tremble.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    },
    {
      "id": "en.n8.class-66.t02",
      "en": "Mara opens the letter and wonders why her father has written.",
      "es": "Mara abre la carta y se pregunta por qué ha escrito su padre.",
      "explanationEs": "Tercera persona limitada: el narrador sigue a Mara y conocemos solo sus pensamientos.",
      "segments": [
        "Mara opens the letter and wonders",
        "why her father has written."
      ],
      "audioText": "Mara opens the letter and wonders why her father has written.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    },
    {
      "id": "en.n8.class-66.t03",
      "en": "The narrator tells us what Mara fears and what her father hides.",
      "es": "El narrador nos cuenta lo que teme Mara y lo que oculta su padre.",
      "explanationEs": "Aquí el narrador entra en dos mentes a la vez: es omnisciente.",
      "segments": [
        "The narrator tells us what Mara",
        "fears and what her father hides."
      ],
      "audioText": "The narrator tells us what Mara fears and what her father hides.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    },
    {
      "id": "en.n8.class-66.t04",
      "en": "A limited narrator shows one mind, but an omniscient narrator shows many.",
      "es": "Un narrador limitado muestra una sola mente, pero uno omnisciente muestra muchas.",
      "explanationEs": "Limited y omniscient se distinguen por cuántas mentes abre el narrador.",
      "segments": [
        "A limited narrator shows one mind,",
        "but an omniscient narrator shows many."
      ],
      "audioText": "A limited narrator shows one mind, but an omniscient narrator shows many.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    },
    {
      "id": "en.n8.class-66.t05",
      "en": "One clue is the pronoun: I points to first person, and she or he points to third person.",
      "es": "Una pista es el pronombre: I indica primera persona, y she o he indican tercera persona.",
      "explanationEs": "Un pronombre no basta: primero mira la persona (I / she) y luego cuántas mentes se abren.",
      "segments": [
        "One clue is the pronoun: I points to first",
        "person, and she or he points to third person."
      ],
      "audioText": "One clue is the pronoun: I points to first person, and she or he points to third person.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    },
    {
      "id": "en.n8.class-66.t06",
      "en": "Readers wonder whose voice they hear when the narrator never says I.",
      "es": "Los lectores se preguntan de quién es la voz que oyen cuando el narrador nunca dice yo.",
      "explanationEs": "La voz narrativa es el tono y el punto de vista de quien cuenta, aunque no diga I.",
      "segments": [
        "Readers wonder whose voice they hear",
        "when the narrator never says I."
      ],
      "audioText": "Readers wonder whose voice they hear when the narrator never says I.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-1"
    }
  ],
