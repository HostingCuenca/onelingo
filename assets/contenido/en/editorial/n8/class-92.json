  "teaching": [
    {
      "id": "en.n8.class-92.t01",
      "en": "You forgot the tickets again, didn't you?",
      "es": "Olvidaste otra vez las entradas, ¿verdad?",
      "explanationEs": "Tag: el verbo auxiliar cambia de polaridad (forgot → didn't you) y aquí reprocha, no pregunta.",
      "segments": [
        "You forgot the tickets",
        "again, didn't you?"
      ],
      "audioText": "You forgot the tickets again, didn't you?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    },
    {
      "id": "en.n8.class-92.t02",
      "en": "He must have missed the bus; he is never late.",
      "es": "Debe de haber perdido el autobús; nunca llega tarde.",
      "explanationEs": "must have + participio: deducción casi segura sobre el pasado. Lo contrario es can't have.",
      "segments": [
        "He must have missed the",
        "bus; he is never late."
      ],
      "audioText": "He must have missed the bus; he is never late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    },
    {
      "id": "en.n8.class-92.t03",
      "en": "I wish I had more time for my holiday.",
      "es": "Ojalá tuviera más tiempo para mis vacaciones.",
      "explanationEs": "wish + pasado simple: deseo sobre una situación presente que no es así.",
      "segments": [
        "I wish I had more",
        "time for my holiday."
      ],
      "audioText": "I wish I had more time for my holiday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    },
    {
      "id": "en.n8.class-92.t04",
      "en": "I wish I had listened to my sister.",
      "es": "Ojalá hubiera escuchado a mi hermana.",
      "explanationEs": "wish + had + participio: lamento por algo que pasó. Con would se expresa una queja: I wish you would stop.",
      "segments": [
        "I wish I had",
        "listened to my sister."
      ],
      "audioText": "I wish I had listened to my sister.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    },
    {
      "id": "en.n8.class-92.t05",
      "en": "It was Tom who broke the window, not Leo.",
      "es": "Fue Tom quien rompió la ventana, no Leo.",
      "explanationEs": "It was + persona + who/that: oración enfática que destaca quién hizo la acción.",
      "segments": [
        "It was Tom who broke",
        "the window, not Leo."
      ],
      "audioText": "It was Tom who broke the window, not Leo.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    },
    {
      "id": "en.n8.class-92.t06",
      "en": "The findings may indicate that sleep helps memory, but it could be argued that more evidence is needed.",
      "es": "Los resultados pueden indicar que dormir ayuda a la memoria, pero se podría sostener que hacen falta más pruebas.",
      "explanationEs": "Cautela académica: may indicate y it could be argued that suavizan la afirmación.",
      "segments": [
        "The findings may indicate that sleep helps memory, but",
        "it could be argued that more evidence is needed."
      ],
      "audioText": "The findings may indicate that sleep helps memory, but it could be argued that more evidence is needed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-2"
    }
