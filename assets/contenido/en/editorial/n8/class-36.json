    {
      "id": "en.n8.class-36.t01",
      "en": "The hotel gave us a warm welcome.",
      "es": "El hotel nos dio una cálida bienvenida.",
      "explanationEs": "A warm welcome es una metáfora: la bienvenida no tiene temperatura, pero transmite afecto.",
      "segments": [
        "The hotel gave us",
        "a warm welcome."
      ],
      "audioText": "The hotel gave us a warm welcome.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-1"
    },
    {
      "id": "en.n8.class-36.t02",
      "en": "Whenever it rains for a week, I feel down and my heart is heavy.",
      "es": "Cuando llueve toda una semana, me siento decaído y tengo el corazón pesado.",
      "explanationEs": "Feel down y heavy heart: la tristeza se expresa como peso o como dirección hacia abajo.",
      "segments": [
        "Whenever it rains for a week, I",
        "feel down and my heart is heavy."
      ],
      "audioText": "Whenever it rains for a week, I feel down and my heart is heavy.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-1"
    },
    {
      "id": "en.n8.class-36.t03",
      "en": "Time is running out, and a flood of emails is still waiting for me.",
      "es": "Se me acaba el tiempo y aún me espera una avalancha de correos.",
      "explanationEs": "Time is running out: el tiempo como algo que se vacía. A flood of = tantas cosas que te inundan.",
      "segments": [
        "Time is running out, and a flood",
        "of emails is still waiting for me."
      ],
      "audioText": "Time is running out, and a flood of emails is still waiting for me.",
