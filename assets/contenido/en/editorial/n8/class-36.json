    },
    {
      "id": "en.n8.class-36.t04",
      "en": "Ana had a bright idea: she used the old boxes as tables.",
      "es": "A Ana se le ocurrió una idea brillante: usó las cajas viejas como mesas.",
      "explanationEs": "Bright idea: la luz representa la inteligencia y la claridad.",
      "segments": [
        "Ana had a bright idea: she",
        "used the old boxes as tables."
      ],
      "audioText": "Ana had a bright idea: she used the old boxes as tables.",
      "audioMode": "tts",
