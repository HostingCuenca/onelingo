  "teaching": [
    {
      "id": "en.n8.class-37.t01",
      "en": "Tom is as busy as a bee during exams.",
      "es": "Tom está ocupadísimo en época de exámenes.",
      "explanationEs": "as + adjetivo + as compara con algo típico de esa cualidad: es un símil.",
      "segments": [
        "Tom is as busy as",
        "a bee during exams."
      ],
      "audioText": "Tom is as busy as a bee during exams.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-2"
    },
    {
      "id": "en.n8.class-37.t02",
      "en": "The storm roared like an angry lion.",
      "es": "La tormenta rugió como un león enfadado.",
      "explanationEs": "like + nombre también forma un símil; se traduce por «como».",
      "segments": [
        "The storm roared like",
        "an angry lion."
      ],
      "audioText": "The storm roared like an angry lion.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-2"
    },
    {
      "id": "en.n8.class-37.t03",
      "en": "The exam is a mountain, and I must climb it step by step.",
      "es": "El examen es una montaña y debo escalarlo paso a paso.",
      "explanationEs": "Metáfora: sin like ni as, afirma que una cosa es otra (X is a Y).",
      "segments": [
        "The exam is a mountain, and I",
        "must climb it step by step."
      ],
      "audioText": "The exam is a mountain, and I must climb it step by step.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-2"
    },
    {
      "id": "en.n8.class-37.t04",
      "en": "The wind seemed to whisper secrets to the trees.",
      "es": "El viento parecía susurrar secretos a los árboles.",
      "explanationEs": "Personificación: el viento hace algo humano (susurrar).",
      "segments": [
        "The wind seemed to whisper",
        "secrets to the trees."
      ],
      "audioText": "The wind seemed to whisper secrets to the trees.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-2"
    },
    {
      "id": "en.n8.class-37.t05",
      "en": "Our teacher says “as cold as ice” is a simile, and “the wind whispers” is personification.",
      "es": "Nuestra profesora dice que «as cold as ice» es un símil y que «the wind whispers» es personificación.",
      "explanationEs": "Símil = con conector; personificación = una cosa actúa como una persona.",
      "segments": [
        "Our teacher says “as cold as ice” is",
        "a simile, and “the wind whispers” is personification."
      ],
      "audioText": "Our teacher says “as cold as ice” is a simile, and “the wind whispers” is personification.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-2"
    }
  ],
