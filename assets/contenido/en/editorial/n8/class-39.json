  "teaching": [
    {
      "id": "en.n8.class-39.t01",
      "en": "Autumn is a golden painter: it colours every tree.",
      "es": "El otoño es un pintor dorado: colorea todos los árboles.",
      "explanationEs": "Metáfora original: Autumn is a…; el verbo colours desarrolla la imagen.",
      "segments": [
        "Autumn is a golden painter:",
        "it colours every tree."
      ],
      "audioText": "Autumn is a golden painter: it colours every tree.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-4"
    },
    {
      "id": "en.n8.class-39.t02",
      "en": "The fallen leaves lie on the path like a carpet.",
      "es": "Las hojas caídas yacen en el camino como una alfombra.",
      "explanationEs": "Símil: like + nombre. Un buen símil compara con algo concreto que se ve o se toca.",
      "segments": [
        "The fallen leaves lie on",
        "the path like a carpet."
      ],
      "audioText": "The fallen leaves lie on the path like a carpet.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-4"
    },
    {
      "id": "en.n8.class-39.t03",
      "en": "The leaves dance in the wind and then fall silent.",
      "es": "Las hojas bailan con el viento y luego se quedan en silencio.",
      "explanationEs": "Personificación: las hojas hacen algo humano, bailar.",
      "segments": [
        "The leaves dance in the",
        "wind and then fall silent."
      ],
      "audioText": "The leaves dance in the wind and then fall silent.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-4"
    },
    {
      "id": "en.n8.class-39.t04",
      "en": "I like this season because the air is cool and I can breathe slowly.",
      "es": "Me gusta esta estación porque el aire es fresco y puedo respirar despacio.",
      "explanationEs": "Because + motivo: así explicas por qué te gusta o por qué funciona tu imagen.",
      "segments": [
        "I like this season because the air",
        "is cool and I can breathe slowly."
      ],
      "audioText": "I like this season because the air is cool and I can breathe slowly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-figurative-language-4"
    },
    {
      "id": "en.n8.class-39.t05",
      "en": "I chose “carpet” because it shows how soft and thick the leaves are.",
      "es": "Elegí «alfombra» porque muestra lo suaves y gruesas que son las hojas.",
      "explanationEs": "I chose… because… es la frase breve para justificar tu imagen.",
      "segments": [
