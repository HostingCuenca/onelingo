  "teaching": [
    {
      "id": "en.n8.class-33.t01",
      "en": "It seems that your blood pressure is slightly high.",
      "es": "Parece que tu presión arterial está un poco alta.",
      "explanationEs": "It seems that y slightly suavizan la noticia: el mensaje real es «tienes la tensión alta».",
      "segments": [
        "It seems that your blood",
        "pressure is slightly high."
      ],
      "audioText": "It seems that your blood pressure is slightly high.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-3"
    },
    {
      "id": "en.n8.class-33.t02",
      "en": "The results are a bit worrying, to be honest.",
      "es": "Los resultados son algo preocupantes, para ser sincero.",
      "explanationEs": "A bit + adjetivo rebaja la noticia; a bit worrying puede significar «preocupante».",
      "segments": [
        "The results are a bit",
        "worrying, to be honest."
      ],
      "audioText": "The results are a bit worrying, to be honest.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-3"
    },
    {
      "id": "en.n8.class-33.t03",
      "en": "I wonder if we could try a different medicine.",
      "es": "Me pregunto si podríamos probar otra medicina.",
      "explanationEs": "I wonder if + could: parece una duda, pero el médico suele proponer un cambio.",
      "segments": [
        "I wonder if we could",
        "try a different medicine."
      ],
      "audioText": "I wonder if we could try a different medicine.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-3"
    },
    {
      "id": "en.n8.class-33.t04",
      "en": "I'd suggest you rest for a week.",
      "es": "Te sugeriría que descansaras una semana.",
      "explanationEs": "I'd suggest suena amable, pero el médico espera que lo hagas.",
      "segments": [
        "I'd suggest you rest",
        "for a week."
      ],
      "audioText": "I'd suggest you rest for a week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-indirect-language-3"
    },
    {
      "id": "en.n8.class-33.t05",
      "en": "The patient might need a second test next week.",
      "es": "Puede que el paciente necesite otra prueba la semana que viene.",
      "explanationEs": "Might suaviza: en una consulta suele significar que hay que hacerla.",
      "segments": [
