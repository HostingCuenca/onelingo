  "teaching": [
    {
      "id": "en.n8.class-67.t01",
      "en": "Mara looked at the clock. Was he really going to be late again?",
      "es": "Mara miró el reloj. ¿De verdad iba a llegar tarde otra vez?",
      "explanationEs": "La pregunta directa dentro de la narración en pasado es la voz de Mara: no hay «she asked herself».",
      "segments": [
        "Mara looked at the clock. Was he",
        "really going to be late again?"
      ],
      "audioText": "Mara looked at the clock. Was he really going to be late again?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    },
    {
      "id": "en.n8.class-67.t02",
      "en": "He would surely come tomorrow. Of course he would!",
      "es": "Seguro que vendría mañana. ¡Claro que vendría!",
      "explanationEs": "Tomorrow en un relato en pasado es marca de estilo libre: el narrador diría the next day.",
      "segments": [
        "He would surely come tomorrow.",
        "Of course he would!"
      ],
      "audioText": "He would surely come tomorrow. Of course he would!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    },
    {
      "id": "en.n8.class-67.t03",
      "en": "She stopped at the door. What a silly idea this was!",
      "es": "Se paró en la puerta. ¡Qué idea tan tonta era esta!",
      "explanationEs": "What a + exclamación es la voz de ella; this (y no that) acerca el texto a su mente.",
      "segments": [
        "She stopped at the door. What",
        "a silly idea this was!"
      ],
      "audioText": "She stopped at the door. What a silly idea this was!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    },
    {
      "id": "en.n8.class-67.t04",
      "en": "She had no doubt about it: he was coming, and nothing could stop him now.",
      "es": "No tenía ninguna duda: él venía y nada podía detenerlo ahora.",
      "explanationEs": "Now dentro de un relato en pasado muestra el punto de vista del personaje, no el del narrador.",
      "segments": [
        "She had no doubt about it: he was",
        "coming, and nothing could stop him now."
      ],
      "audioText": "She had no doubt about it: he was coming, and nothing could stop him now.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    },
    {
      "id": "en.n8.class-67.t05",
      "en": "She felt nervous, and her mind went back to that day. Was it really her fault?",
      "es": "Se sentía nerviosa y su mente volvió a aquel día. ¿De verdad era culpa suya?",
      "explanationEs": "Primero narración (felt nervous) y luego pensamiento en forma de pregunta directa, en pasado.",
      "segments": [
        "She felt nervous, and her mind went back",
        "to that day. Was it really her fault?"
      ],
      "audioText": "She felt nervous, and her mind went back to that day. Was it really her fault?",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    },
    {
      "id": "en.n8.class-67.t06",
      "en": "Mara thought that he would be late again. He would be late again!",
      "es": "Mara pensó que él llegaría tarde otra vez. ¡Llegaría tarde otra vez!",
      "explanationEs": "La primera frase es estilo indirecto (thought that); la segunda es estilo libre: sin verbo de pensar y con exclamación.",
      "segments": [
        "Mara thought that he would be late",
        "again. He would be late again!"
      ],
      "audioText": "Mara thought that he would be late again. He would be late again!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-literature-memory-2"
    }
  ],
