  "teaching": [
    {
      "id": "en.n8.class-18.t01",
      "en": "The house is very quiet now, wrote Gran, so I infer that she misses Clara.",
      "es": "«La casa está muy tranquila ahora», escribió la abuela, así que deduzco que echa de menos a Clara.",
      "explanationEs": "Quiet sugiere soledad: se infiere la emoción aunque el texto no la diga.",
      "segments": [
        "The house is very quiet now, wrote Gran,",
        "so I infer that she misses Clara."
      ],
      "audioText": "The house is very quiet now, wrote Gran, so I infer that she misses Clara.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-3"
    },
    {
      "id": "en.n8.class-18.t02",
      "en": "She watered the plants every day, which shows that she is reliable.",
      "es": "Regó las plantas todos los días, lo que muestra que es de fiar.",
      "explanationEs": "Una acción repetida apunta a un rasgo de carácter.",
      "segments": [
        "She watered the plants every day,",
        "which shows that she is reliable."
      ],
      "audioText": "She watered the plants every day, which shows that she is reliable.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-3"
    },
    {
      "id": "en.n8.class-18.t03",
      "en": "He called twice, but Gran told him that Clara was busy; maybe she wants to protect her.",
      "es": "Él llamó dos veces, pero la abuela le dijo que Clara estaba ocupada; quizá quiere protegerla.",
      "explanationEs": "Maybe introduce una inferencia prudente, no un hecho.",
      "segments": [
        "He called twice, but Gran told him that Clara",
        "was busy; maybe she wants to protect her."
      ],
      "audioText": "He called twice, but Gran told him that Clara was busy; maybe she wants to protect her.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-3"
    },
    {
      "id": "en.n8.class-18.t04",
      "en": "Gran says don't worry, but people who write that often worry themselves.",
      "es": "La abuela dice «no te preocupes», pero quienes escriben eso suelen estar preocupados.",
      "explanationEs": "Lo dicho puede contradecir lo sentido: infiere con cuidado.",
      "segments": [
        "Gran says don't worry, but people",
        "who write that often worry themselves."
      ],
      "audioText": "Gran says don't worry, but people who write that often worry themselves.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-3"
    },
    {
      "id": "en.n8.class-18.t05",
      "en": "A letter shows what the writer chooses to say, so we must quote the words that support our inference.",
      "es": "Una carta muestra lo que el autor decide decir, así que debemos citar las palabras que apoyan nuestra deducción.",
      "explanationEs": "Quote: cita la frase y explica qué deduces de ella.",
      "segments": [
        "A letter shows what the writer chooses to say, so",
        "we must quote the words that support our inference."
      ],
      "audioText": "A letter shows what the writer chooses to say, so we must quote the words that support our inference.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-inference-3"
    }
  ],
