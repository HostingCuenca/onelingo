  "teaching": [
    {
      "id": "en.n8.class-62.t01",
      "en": "Councillors vote to close the town pool.",
      "es": "Los concejales votan cerrar la piscina municipal.",
      "explanationEs": "Titular en presente: cuenta algo que ya ocurrió (en la noticia: voted). Se omite el artículo the delante de Councillors.",
      "segments": [
        "Councillors vote to close",
        "the town pool."
      ],
      "audioText": "Councillors vote to close the town pool.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-news-framing-2"
    },
    {
      "id": "en.n8.class-62.t02",
      "en": "Bus fare hike hits commuters.",
      "es": "La subida de la tarifa del autobús afecta a los viajeros diarios.",
      "explanationEs": "Hike es la palabra corta del titular para «subida». Bus fare hike es una pila de sustantivos: en español lo ordenamos al revés.",
      "segments": [
        "Bus fare hike",
        "hits commuters."
      ],
      "audioText": "Bus fare hike hits commuters.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-news-framing-2"
    },
    {
      "id": "en.n8.class-62.t03",
      "en": "School strike to start on Monday.",
      "es": "La huelga escolar empezará el lunes.",
      "explanationEs": "To + verbo en un titular es futuro planeado: is going to start. Se omiten a/the y el verbo be.",
      "segments": [
        "School strike to",
        "start on Monday."
      ],
      "audioText": "School strike to start on Monday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-news-framing-2"
    },
    {
      "id": "en.n8.class-62.t04",
      "en": "Police probe the cause of the fire.",
      "es": "La policía investiga la causa del incendio.",
      "explanationEs": "Probe (verbo o nombre) es típica de titular: es más corta que investigate.",
      "segments": [
        "Police probe the cause",
        "of the fire."
      ],
      "audioText": "Police probe the cause of the fire.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-news-framing-2"
    },
    {
      "id": "en.n8.class-62.t05",
      "en": "Bid to save the old cinema fails.",
      "es": "Un intento de salvar el viejo cine fracasa.",
      "explanationEs": "Bid to + verbo = intento de hacer algo. El titular omite A y usa presente para contar el hecho.",
      "segments": [
        "Bid to save the",
        "old cinema fails."
      ],
      "audioText": "Bid to save the old cinema fails.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-news-framing-2"
    },
    {
      "id": "en.n8.class-62.t06",
      "en": "The pool is expected to reopen in May, and the cost is reportedly high.",
      "es": "Se espera que la piscina reabra en mayo, y se dice que el coste es alto.",
      "explanationEs": "Is expected to + verbo base y reportedly son formas impersonales: dan la información sin nombrar al que la dice.",
      "segments": [
        "The pool is expected to reopen in",
        "May, and the cost is reportedly high."
      ],
      "audioText": "The pool is expected to reopen in May, and the cost is reportedly high.",
      "audioMode": "tts",
