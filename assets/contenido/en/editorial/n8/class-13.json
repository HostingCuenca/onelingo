  "teaching": [
    {
      "id": "en.n8.class-13.t01",
      "en": "After the flood, Tom said, We have a small problem.",
      "es": "Después de la inundación, Tom dijo: «Tenemos un pequeño problema».",
      "explanationEs": "Atenuación: minimiza algo grave para sonar tranquilo.",
      "segments": [
        "After the flood, Tom said,",
        "We have a small problem."
      ],
      "audioText": "After the flood, Tom said, We have a small problem.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-3"
    },
    {
      "id": "en.n8.class-13.t02",
      "en": "You're a bit late, said the boss to Leo, who arrived two hours after the meeting started.",
      "es": "«Llegas un poco tarde», dijo el jefe a Leo, que llegó dos horas después de que empezara la reunión.",
      "explanationEs": "A bit reduce la gravedad: es una atenuación que en realidad es un reproche.",
      "segments": [
        "You're a bit late, said the boss to Leo,",
        "who arrived two hours after the meeting started."
      ],
      "audioText": "You're a bit late, said the boss to Leo, who arrived two hours after the meeting started.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-3"
    },
    {
      "id": "en.n8.class-13.t03",
      "en": "What a brilliant idea, said Mia in a sarcastic voice when the plan failed.",
      "es": "«Qué idea tan genial», dijo Mia con voz sarcástica cuando el plan fracasó.",
      "explanationEs": "Ironía: palabras positivas en una situación negativa.",
      "segments": [
        "What a brilliant idea, said Mia in",
        "a sarcastic voice when the plan failed."
      ],
      "audioText": "What a brilliant idea, said Mia in a sarcastic voice when the plan failed.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-3"
    },
    {
      "id": "en.n8.class-13.t04",
      "en": "The irony is that the cooking teacher burned the dinner.",
      "es": "La ironía es que el profesor de cocina quemó la cena.",
      "explanationEs": "Irony: el resultado es lo contrario de lo esperado.",
      "segments": [
        "The irony is that the",
        "cooking teacher burned the dinner."
      ],
      "audioText": "The irony is that the cooking teacher burned the dinner.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-3"
    },
    {
      "id": "en.n8.class-13.t05",
      "en": "The critic called the concert not bad, which is high praise from him.",
      "es": "El crítico calificó el concierto de «nada mal», lo cual es un gran elogio viniendo de él.",
      "explanationEs": "Not bad suele significar «bastante bueno»: no se traduce literalmente.",
      "segments": [
        "The critic called the concert not bad,",
        "which is high praise from him."
      ],
      "audioText": "The critic called the concert not bad, which is high praise from him.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-implication-3"
    }
  ],
