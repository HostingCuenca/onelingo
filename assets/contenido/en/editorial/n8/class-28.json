  "teaching": [
    {
      "id": "en.n8.class-28.t01",
      "en": "«Finally!» sounds sarcastic when the reply comes late.",
      "es": "«¡Por fin!» suena sarcástico cuando la respuesta llega tarde.",
      "explanationEs": "Sarcastic: dice una cosa pero critica otra.",
      "segments": [
        "«Finally!» sounds sarcastic when",
        "the reply comes late."
      ],
      "audioText": "«Finally!» sounds sarcastic when the reply comes late.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    },
    {
      "id": "en.n8.class-28.t02",
      "en": "«Send it now» sounds demanding, but «Could you send it when you can?» sounds polite.",
      "es": "«Envíalo ahora» suena exigente, pero «¿Podrías enviarlo cuando puedas?» suena educado.",
      "explanationEs": "Demanding: orden directa, sin please.",
      "segments": [
        "«Send it now» sounds demanding, but «Could you",
        "send it when you can?» sounds polite."
      ],
      "audioText": "«Send it now» sounds demanding, but «Could you send it when you can?» sounds polite.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    },
    {
      "id": "en.n8.class-28.t03",
      "en": "«I was wondering if you could help» is a tentative request.",
      "es": "«Me preguntaba si podrías ayudar» es una petición prudente.",
      "explanationEs": "Tentative: pide con cuidado, sin imponer.",
      "segments": [
        "«I was wondering if you could",
        "help» is a tentative request."
      ],
      "audioText": "«I was wondering if you could help» is a tentative request.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    },
    {
      "id": "en.n8.class-28.t04",
      "en": "A blunt message has no greeting, no please and no thanks.",
      "es": "Un mensaje seco no tiene saludo, ni please ni gracias.",
      "explanationEs": "Blunt: directo hasta resultar brusco.",
      "segments": [
        "A blunt message has no greeting,",
        "no please and no thanks."
      ],
      "audioText": "A blunt message has no greeting, no please and no thanks.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    },
    {
      "id": "en.n8.class-28.t05",
      "en": "«As I already said» gives the message a cold tone.",
      "es": "«Como ya dije» da al mensaje un tono frío.",
      "explanationEs": "Tone = la actitud del mensaje; cold: distancia y reproche por repetir información.",
      "segments": [
        "«As I already said» gives",
        "the message a cold tone."
      ],
      "audioText": "«As I already said» gives the message a cold tone.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    },
    {
      "id": "en.n8.class-28.t06",
      "en": "«I'm so sorry about the mess» is an apologetic message.",
      "es": "«Siento mucho el desorden» es un mensaje de disculpa.",
      "explanationEs": "Apologetic: expresa arrepentimiento.",
      "segments": [
        "«I'm so sorry about the",
        "mess» is an apologetic message."
      ],
      "audioText": "«I'm so sorry about the mess» is an apologetic message.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-style-register-3"
    }
  ],
