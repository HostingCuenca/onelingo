  "teaching": [
    {
      "id": "en.n8.class-43.t01",
      "en": "It was awkward at first, so Ana told a joke to break the ice.",
      "es": "Al principio fue incómodo, así que Ana contó un chiste para romper el hielo.",
      "explanationEs": "Figurado: romper el hielo es relajar un ambiente tenso; aquí no hay hielo de verdad.",
      "segments": [
        "It was awkward at first, so Ana",
        "told a joke to break the ice."
      ],
      "audioText": "It was awkward at first, so Ana told a joke to break the ice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-3"
    },
    {
      "id": "en.n8.class-43.t02",
      "en": "The exam was a piece of cake: I finished in twenty minutes.",
      "es": "El examen fue pan comido: terminé en veinte minutos.",
      "explanationEs": "A piece of cake = algo facilísimo; no hay ningún pastel.",
      "segments": [
        "The exam was a piece of",
        "cake: I finished in twenty minutes."
      ],
      "audioText": "The exam was a piece of cake: I finished in twenty minutes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-3"
    },
    {
      "id": "en.n8.class-43.t03",
      "en": "We are tired, so let's call it a day and finish tomorrow.",
      "es": "Estamos cansados, así que dejémoslo por hoy y terminemos mañana.",
      "explanationEs": "Call it a day = parar de trabajar o estudiar por hoy.",
      "segments": [
        "We are tired, so let's call",
        "it a day and finish tomorrow."
      ],
      "audioText": "We are tired, so let's call it a day and finish tomorrow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-3"
    },
    {
      "id": "en.n8.class-43.t04",
      "en": "I gave you two options, so the ball is in your court: it's your decision.",
      "es": "Te di dos opciones, así que te toca a ti: es tu decisión.",
      "explanationEs": "Viene del tenis: la pelota está en tu campo, o sea, te toca mover ficha.",
      "segments": [
        "I gave you two options, so the ball",
        "is in your court: it's your decision."
      ],
      "audioText": "I gave you two options, so the ball is in your court: it's your decision.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-3"
    },
    {
      "id": "en.n8.class-43.t05",
      "en": "I need to hit the books tonight because the exam is tomorrow.",
      "es": "Tengo que ponerme a estudiar esta noche porque el examen es mañana.",
      "explanationEs": "Hit the books = estudiar con esfuerzo; no hay golpes.",
      "segments": [
        "I need to hit the books",
        "tonight because the exam is tomorrow."
      ],
      "audioText": "I need to hit the books tonight because the exam is tomorrow.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-3"
    },
    {
      "id": "en.n8.class-43.t06",
      "en": "In winter the boys broke the ice on the pond with a stick.",
      "es": "En invierno los niños rompieron el hielo del estanque con un palo.",
      "explanationEs": "Aquí es literal: hay hielo de verdad. El contexto (winter, pond, stick) lo confirma.",
      "segments": [
