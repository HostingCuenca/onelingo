  "teaching": [
    {
      "id": "en.n8.class-45.t01",
      "en": "Let me tell you an anecdote about my chaotic Monday.",
      "es": "Te voy a contar una anécdota de mi caótico lunes.",
      "explanationEs": "Anecdote = anécdota; esta fórmula abre la historia y avisa al oyente de lo que viene.",
      "segments": [
        "Let me tell you an",
        "anecdote about my chaotic Monday."
      ],
      "audioText": "Let me tell you an anecdote about my chaotic Monday.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    },
    {
      "id": "en.n8.class-45.t02",
      "en": "My morning was chaotic: first my bus broke down, and then my phone died. That was the last straw.",
      "es": "Mi mañana fue caótica: primero se averió mi autobús y luego se quedó sin batería mi teléfono. Fue la gota que colmó el vaso.",
      "explanationEs": "The last straw = lo último que hace que ya no puedas más.",
      "segments": [
        "My morning was chaotic: first my bus broke down, and",
        "then my phone died. That was the last straw."
      ],
      "audioText": "My morning was chaotic: first my bus broke down, and then my phone died. That was the last straw.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    },
    {
      "id": "en.n8.class-45.t03",
      "en": "Luckily, the meeting was cancelled, so the bad morning was a blessing in disguise.",
      "es": "Por suerte, la reunión se canceló, así que la mala mañana fue un mal que vino bien.",
      "explanationEs": "A blessing in disguise = algo malo que resulta ser bueno.",
      "segments": [
        "Luckily, the meeting was cancelled, so the",
        "bad morning was a blessing in disguise."
      ],
      "audioText": "Luckily, the meeting was cancelled, so the bad morning was a blessing in disguise.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    },
    {
      "id": "en.n8.class-45.t04",
      "en": "We ran to the station and, luckily, we arrived in the nick of time.",
      "es": "Corrimos a la estación y, por suerte, llegamos justo a tiempo.",
      "explanationEs": "In the nick of time = en el último momento, justo antes de que fuera tarde.",
      "segments": [
        "We ran to the station and, luckily,",
        "we arrived in the nick of time."
      ],
      "audioText": "We ran to the station and, luckily, we arrived in the nick of time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    },
    {
      "id": "en.n8.class-45.t05",
      "en": "In my anecdote, Dad hit the roof, which means he was very angry.",
      "es": "En mi anécdota, papá se puso furioso, lo que significa que estaba muy enfadado.",
      "explanationEs": "Which means + explicación sencilla aclara un modismo a quien no lo conoce.",
      "segments": [
        "In my anecdote, Dad hit the roof,",
        "which means he was very angry."
      ],
      "audioText": "In my anecdote, Dad hit the roof, which means he was very angry.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    },
    {
      "id": "en.n8.class-45.t06",
      "en": "She was on cloud nine; in other words, she was thrilled. What a great anecdote!",
      "es": "Estaba en el séptimo cielo; dicho de otra manera, estaba encantada. ¡Qué gran anécdota!",
      "explanationEs": "In other words reformula el modismo con palabras sencillas.",
      "segments": [
        "She was on cloud nine; in other words,",
        "she was thrilled. What a great anecdote!"
      ],
      "audioText": "She was on cloud nine; in other words, she was thrilled. What a great anecdote!",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-5"
    }
