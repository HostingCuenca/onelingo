  "teaching": [
    {
      "id": "en.n8.class-91.t01",
      "en": "Her warm tone made the bad news easier to hear.",
      "es": "Su tono cordial hizo más fácil oír la mala noticia.",
      "explanationEs": "El tono es la actitud del mensaje: cordial (warm), seco, enfadado o sarcástico.",
      "segments": [
        "Her warm tone made the",
        "bad news easier to hear."
      ],
      "audioText": "Her warm tone made the bad news easier to hear.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-1"
    },
    {
      "id": "en.n8.class-91.t02",
      "en": "“Wow, what lovely weather,” he said in a sarcastic voice, while it rained.",
      "es": "«Vaya, qué buen tiempo», dijo con voz sarcástica mientras llovía.",
      "explanationEs": "Sarcasmo: las palabras son positivas, pero el sentido es el contrario. Lo delata el contexto.",
      "segments": [
        "“Wow, what lovely weather,” he said in",
        "a sarcastic voice, while it rained."
      ],
      "audioText": "“Wow, what lovely weather,” he said in a sarcastic voice, while it rained.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-1"
    },
    {
      "id": "en.n8.class-91.t03",
      "en": "I would be grateful if you could confirm the date.",
      "es": "Le agradecería que pudiera confirmar la fecha.",
      "explanationEs": "Registro formal: would be grateful if you could + verbo base, sin contracciones.",
      "segments": [
        "I would be grateful if",
        "you could confirm the date."
      ],
      "audioText": "I would be grateful if you could confirm the date.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-1"
    },
    {
      "id": "en.n8.class-91.t04",
      "en": "His blunt reply, “No,” ended the chat.",
      "es": "Su respuesta brusca, «No», puso fin a la conversación.",
      "explanationEs": "Blunt: dice la idea sin suavizarla. Sin please ni motivo, suena seco.",
      "segments": [
        "His blunt reply, “No,”",
        "ended the chat."
      ],
      "audioText": "His blunt reply, “No,” ended the chat.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-1"
    },
    {
      "id": "en.n8.class-91.t05",
      "en": "She dropped a hint: “It's a bit cold in here.”",
      "es": "Dejó caer una indirecta: «Hace un poco de frío aquí.»",
      "explanationEs": "Indirecta: la frase describe un hecho, pero pide una acción (cerrar la ventana). Lo implícito se deduce.",
      "segments": [
        "She dropped a hint: “It's",
        "a bit cold in here.”"
      ],
      "audioText": "She dropped a hint: “It's a bit cold in here.”",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-integrated-projects-1"
    },
