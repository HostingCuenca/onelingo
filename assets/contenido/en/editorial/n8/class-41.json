  "teaching": [
    {
      "id": "en.n8.class-41.t01",
      "en": "I'm a bit under the weather today: I have a cold and I'm exhausted.",
      "es": "Hoy estoy un poco indispuesto: tengo un resfriado y estoy agotado.",
      "explanationEs": "Under the weather significa «un poco enfermo»; no habla del clima. Lo aclaran las pistas: a cold, exhausted.",
      "segments": [
        "I'm a bit under the weather today:",
        "I have a cold and I'm exhausted."
      ],
      "audioText": "I'm a bit under the weather today: I have a cold and I'm exhausted.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-1"
    },
    {
      "id": "en.n8.class-41.t02",
      "en": "Ana has been on cloud nine since she got the job, and she is thrilled.",
      "es": "Ana está en las nubes desde que consiguió el trabajo, y está encantada.",
      "explanationEs": "On cloud nine = muy feliz. Cuidado: «estar en las nubes» en español es estar distraído.",
      "segments": [
        "Ana has been on cloud nine since she",
        "got the job, and she is thrilled."
      ],
      "audioText": "Ana has been on cloud nine since she got the job, and she is thrilled.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-1"
    },
    {
      "id": "en.n8.class-41.t03",
      "en": "I often feel blue on gloomy days, when it rains for a week.",
      "es": "A menudo me siento decaído en los días grises, cuando llueve durante una semana.",
      "explanationEs": "Feel blue = sentirse triste. En inglés el azul se asocia con la tristeza.",
      "segments": [
        "I often feel blue on gloomy days,",
        "when it rains for a week."
      ],
      "audioText": "I often feel blue on gloomy days, when it rains for a week.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-1"
    },
    {
      "id": "en.n8.class-41.t04",
      "en": "I'm broke this month, but a cheap lunch won't break the bank.",
      "es": "Este mes estoy sin dinero, pero un almuerzo barato no me arruinará.",
      "explanationEs": "Break the bank = gastar tanto que te quedas sin dinero; se oye mucho en negativa.",
      "segments": [
        "I'm broke this month, but a",
        "cheap lunch won't break the bank."
      ],
      "audioText": "I'm broke this month, but a cheap lunch won't break the bank.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-1"
    },
    {
      "id": "en.n8.class-41.t05",
      "en": "A new guitar is costly: it could cost an arm and a leg.",
      "es": "Una guitarra nueva es costosa: podría costar un ojo de la cara.",
      "explanationEs": "Cost an arm and a leg = costar muchísimo. La imagen en inglés es un brazo y una pierna.",
      "segments": [
        "A new guitar is costly: it could",
        "cost an arm and a leg."
      ],
      "audioText": "A new guitar is costly: it could cost an arm and a leg.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-1"
    },
    {
      "id": "en.n8.class-41.t06",
      "en": "Try to save for a rainy day, or you will be broke when the car breaks down.",
      "es": "Intenta ahorrar para tiempos difíciles, o te quedarás sin dinero cuando el coche se averíe.",
      "explanationEs": "Save for a rainy day = guardar dinero para imprevistos.",
      "segments": [
        "Try to save for a rainy day, or you",
        "will be broke when the car breaks down."
      ],
      "audioText": "Try to save for a rainy day, or you will be broke when the car breaks down.",
