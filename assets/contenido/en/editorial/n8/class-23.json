  "teaching": [
    {
      "id": "en.n8.class-23.t01",
      "en": "The thesis is the main claim of the speech.",
      "es": "La tesis es la afirmación principal del discurso.",
      "explanationEs": "Thesis = claim principal que el orador defiende.",
      "segments": [
        "The thesis is the main",
        "claim of the speech."
      ],
      "audioText": "The thesis is the main claim of the speech.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-3"
    },
    {
      "id": "en.n8.class-23.t02",
      "en": "In the opening, the speaker states the thesis clearly.",
      "es": "En la apertura, el orador expone la tesis con claridad.",
      "explanationEs": "La tesis suele estar al principio.",
      "segments": [
        "In the opening, the speaker",
        "states the thesis clearly."
      ],
      "audioText": "In the opening, the speaker states the thesis clearly.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-3"
    },
    {
      "id": "en.n8.class-23.t03",
      "en": "The closing ends with a call to action: sign the petition today.",
      "es": "El cierre termina con una llamada a la acción: firma la petición hoy.",
      "explanationEs": "La llamada a la acción pide al público que haga algo concreto.",
      "segments": [
        "The closing ends with a call",
        "to action: sign the petition today."
      ],
      "audioText": "The closing ends with a call to action: sign the petition today.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-3"
    },
    {
      "id": "en.n8.class-23.t04",
      "en": "The speaker uses a rhetorical question to appeal to the audience's feelings.",
      "es": "El orador usa una pregunta retórica para apelar a los sentimientos del público.",
      "explanationEs": "Appeal to + nombre: apelar a.",
      "segments": [
        "The speaker uses a rhetorical question",
        "to appeal to the audience's feelings."
      ],
      "audioText": "The speaker uses a rhetorical question to appeal to the audience's feelings.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-rhetorical-analysis-3"
    },
    {
      "id": "en.n8.class-23.t05",
      "en": "She makes a claim, supports it with a tricolon and closes with a petition.",
      "es": "Hace una afirmación, la apoya con un tricolon y cierra con una petición.",
      "explanationEs": "Estructura: claim → técnica → petición.",
      "segments": [
        "She makes a claim, supports it with",
        "a tricolon and closes with a petition."
      ],
      "audioText": "She makes a claim, supports it with a tricolon and closes with a petition.",
      "audioMode": "tts",
