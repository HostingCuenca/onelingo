  "teaching": [
    {
      "id": "en.n8.class-73.t01",
      "en": "The moderator reads the motion and gives each speaker two minutes.",
      "es": "La moderadora lee la moción y da dos minutos a cada orador.",
      "explanationEs": "El moderador dirige el debate; la moción es la frase que se discute.",
      "segments": [
        "The moderator reads the motion and",
        "gives each speaker two minutes."
      ],
      "audioText": "The moderator reads the motion and gives each speaker two minutes.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    },
    {
      "id": "en.n8.class-73.t02",
      "en": "The motion is that homework should stop, and Tom is in favour of it.",
      "es": "La moción es que los deberes deberían terminar, y Tom está a favor.",
      "explanationEs": "In favour of = a favor de; against = en contra de.",
      "segments": [
        "The motion is that homework should stop,",
        "and Tom is in favour of it."
      ],
      "audioText": "The motion is that homework should stop, and Tom is in favour of it.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    },
    {
      "id": "en.n8.class-73.t03",
      "en": "Ana is against the motion, and her main argument is that students need practice.",
      "es": "Ana está en contra de la moción y su argumento principal es que los estudiantes necesitan práctica.",
      "explanationEs": "Against va sin preposición detrás: against the motion.",
      "segments": [
        "Ana is against the motion, and her",
        "main argument is that students need practice."
      ],
      "audioText": "Ana is against the motion, and her main argument is that students need practice.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    },
    {
      "id": "en.n8.class-73.t04",
      "en": "Tom's counterargument is that homework is tiring and takes too much time.",
      "es": "El contraargumento de Tom es que los deberes cansan y quitan demasiado tiempo.",
      "explanationEs": "El contraargumento responde a lo que dijo el otro orador.",
      "segments": [
        "Tom's counterargument is that homework is",
        "tiring and takes too much time."
      ],
      "audioText": "Tom's counterargument is that homework is tiring and takes too much time.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    },
    {
      "id": "en.n8.class-73.t05",
      "en": "The moderator asks each speaker for a closing statement.",
      "es": "La moderadora pide a cada orador una declaración de cierre.",
      "explanationEs": "Closing statement: la frase final donde cada orador resume su postura.",
      "segments": [
        "The moderator asks each speaker",
        "for a closing statement."
      ],
      "audioText": "The moderator asks each speaker for a closing statement.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    },
    {
      "id": "en.n8.class-73.t06",
      "en": "To sum up, the motion divides the class: some want rules and some want a ban.",
      "es": "En resumen, la moción divide a la clase: unos quieren normas y otros una prohibición.",
      "explanationEs": "To sum up abre el resumen final; es la señal del cierre.",
      "segments": [
        "To sum up, the motion divides the class:",
        "some want rules and some want a ban."
      ],
      "audioText": "To sum up, the motion divides the class: some want rules and some want a ban.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-debate-nuance-3"
    }
  ],
