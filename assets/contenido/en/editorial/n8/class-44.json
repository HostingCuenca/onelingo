  "teaching": [
    {
      "id": "en.n8.class-44.t01",
      "en": "I won't overdo it: one idiom in a short note is enough.",
      "es": "No voy a exagerar: con un modismo en una nota corta basta.",
      "explanationEs": "Overdo = exagerar. Pocos modismos bien elegidos suenan más naturales que muchos.",
      "segments": [
        "I won't overdo it: one idiom",
        "in a short note is enough."
      ],
      "audioText": "I won't overdo it: one idiom in a short note is enough.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-4"
    },
    {
      "id": "en.n8.class-44.t02",
      "en": "Her message to her friend was informal: We're all in the same boat, so let's study together.",
      "es": "El mensaje a su amiga era informal: Estamos todos en la misma situación, así que estudiemos juntos.",
      "explanationEs": "In the same boat = compartir una situación difícil; encaja en un mensaje informal.",
      "segments": [
        "Her message to her friend was informal: We're all",
        "in the same boat, so let's study together."
      ],
      "audioText": "Her message to her friend was informal: We're all in the same boat, so let's study together.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-4"
    },
    {
      "id": "en.n8.class-44.t03",
      "en": "The bank's letter is formal, so it uses plain words, not idioms.",
      "es": "La carta del banco es formal, así que usa palabras sencillas, no modismos.",
      "explanationEs": "En un texto formal se prefiere el inglés claro (plain English).",
      "segments": [
        "The bank's letter is formal, so",
        "it uses plain words, not idioms."
      ],
      "audioText": "The bank's letter is formal, so it uses plain words, not idioms.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-4"
    },
    {
      "id": "en.n8.class-44.t04",
      "en": "An idiom is appropriate for a friend, but not for a manager you don't know.",
      "es": "Un modismo es adecuado para un amigo, pero no para un jefe al que no conoces.",
      "explanationEs": "Appropriate = adecuado: depende de quién lee y de la situación.",
      "segments": [
        "An idiom is appropriate for a friend, but",
        "not for a manager you don't know."
      ],
      "audioText": "An idiom is appropriate for a friend, but not for a manager you don't know.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-4"
    },
    {
      "id": "en.n8.class-44.t05",
      "en": "I hate this appointment, but I will bite the bullet and go.",
      "es": "Odio esta cita, pero apretaré los dientes e iré.",
      "explanationEs": "Bite the bullet = hacer algo difícil o desagradable sin quejarte.",
      "segments": [
        "I hate this appointment, but I",
        "will bite the bullet and go."
      ],
      "audioText": "I hate this appointment, but I will bite the bullet and go.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-idiomatic-language-4"
    },
    {
      "id": "en.n8.class-44.t06",
      "en": "Many people get cold feet before a big speech, but her tone was calm.",
      "es": "Muchas personas se echan atrás antes de un discurso importante, pero su tono era tranquilo.",
      "explanationEs": "Get cold feet = echarse atrás por nervios; tone = el tono, cómo suena lo que dices.",
      "segments": [
        "Many people get cold feet before a",
        "big speech, but her tone was calm."
      ],
      "audioText": "Many people get cold feet before a big speech, but her tone was calm.",
