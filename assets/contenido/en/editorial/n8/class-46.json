  "teaching": [
    {
      "id": "en.n8.class-46.t01",
      "en": "In Britain you take the lift, but in the United States you take the elevator.",
      "es": "En Gran Bretaña se toma el «lift», pero en Estados Unidos se toma el «elevator».",
      "explanationEs": "Lift (RU) y elevator (EE. UU.) significan «ascensor».",
      "segments": [
        "In Britain you take the lift, but in",
        "the United States you take the elevator."
      ],
      "audioText": "In Britain you take the lift, but in the United States you take the elevator.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    },
    {
      "id": "en.n8.class-46.t02",
      "en": "Our flat is on the second floor, but my cousin's apartment in Boston is on the fifth.",
      "es": "Nuestro piso está en la segunda planta, pero el apartamento de mi primo en Boston está en la quinta.",
      "explanationEs": "Flat (RU) = apartment (EE. UU.).",
      "segments": [
        "Our flat is on the second floor, but my",
        "cousin's apartment in Boston is on the fifth."
      ],
      "audioText": "Our flat is on the second floor, but my cousin's apartment in Boston is on the fifth.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    },
    {
      "id": "en.n8.class-46.t03",
      "en": "Stay on the pavement, because a lorry is coming down the road.",
      "es": "Quédate en la acera, porque viene un camión por la calle.",
      "explanationEs": "Pavement y lorry son británicos; en EE. UU. se dice sidewalk y truck.",
      "segments": [
        "Stay on the pavement, because a",
        "lorry is coming down the road."
      ],
      "audioText": "Stay on the pavement, because a lorry is coming down the road.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    },
    {
      "id": "en.n8.class-46.t04",
      "en": "We waited in the queue with a cup of tea and a biscuit.",
      "es": "Esperamos en la cola con una taza de té y una galleta.",
      "explanationEs": "Queue y biscuit son británicos; en EE. UU. se dice line y cookie.",
      "segments": [
        "We waited in the queue with a",
        "cup of tea and a biscuit."
      ],
      "audioText": "We waited in the queue with a cup of tea and a biscuit.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    },
    {
      "id": "en.n8.class-46.t05",
      "en": "See you this arvo, mate! We are having a barbecue.",
      "es": "¡Nos vemos esta tarde, colega! Vamos a hacer una barbacoa.",
      "explanationEs": "Arvo es la forma australiana abreviada de afternoon; mate significa «amigo».",
      "segments": [
        "See you this arvo, mate!",
        "We are having a barbecue."
      ],
      "audioText": "See you this arvo, mate! We are having a barbecue.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    },
    {
      "id": "en.n8.class-46.t06",
      "en": "Fun in Dublin is called craic, and in Mumbai one hundred thousand is a lakh.",
      "es": "La diversión en Dublín se llama craic, y en Bombay cien mil es un lakh.",
      "explanationEs": "Craic es una palabra irlandesa; lakh es una unidad numérica del inglés de India (100 000).",
      "segments": [
        "Fun in Dublin is called craic, and in",
        "Mumbai one hundred thousand is a lakh."
      ],
      "audioText": "Fun in Dublin is called craic, and in Mumbai one hundred thousand is a lakh.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-english-varieties-1"
    }
  ],
