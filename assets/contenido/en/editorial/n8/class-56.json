  "teaching": [
    {
      "id": "en.n8.class-56.t01",
      "en": "The host opens the segment: «Welcome back to the show. To begin with, our topic is sleep.»",
      "es": "El presentador abre el segmento: «Bienvenidos de nuevo al programa. Para empezar, nuestro tema es el sueño.»",
      "explanationEs": "Welcome back y to begin with abren el segmento y presentan el tema.",
      "segments": [
        "The host opens the segment: «Welcome back to the",
        "show. To begin with, our topic is sleep.»"
      ],
      "audioText": "The host opens the segment: «Welcome back to the show. To begin with, our topic is sleep.»",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    },
    {
      "id": "en.n8.class-56.t02",
      "en": "«Anyway» and «moving on» are markers that change the topic.",
      "es": "«Bueno» y «pasando a otra cosa» son marcadores que cambian de tema.",
      "explanationEs": "Anyway y moving on cierran una idea y abren otra; se colocan al principio, con coma.",
      "segments": [
        "«Anyway» and «moving on» are",
        "markers that change the topic."
      ],
      "audioText": "«Anyway» and «moving on» are markers that change the topic.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    },
    {
      "id": "en.n8.class-56.t03",
      "en": "«By the way, our guest wrote a book» adds a small extra idea.",
      "es": "«Por cierto, nuestro invitado escribió un libro» añade una pequeña idea extra.",
      "explanationEs": "By the way = por cierto: sale un momento del tema principal para dar un dato.",
      "segments": [
        "«By the way, our guest wrote a",
        "book» adds a small extra idea."
      ],
      "audioText": "«By the way, our guest wrote a book» adds a small extra idea.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    },
    {
      "id": "en.n8.class-56.t04",
      "en": "«As I was saying, sleep matters» brings the topic back after an interruption.",
      "es": "«Como iba diciendo, el sueño importa» devuelve el tema tras una interrupción.",
      "explanationEs": "As I was saying = como iba diciendo: retoma una idea que se había interrumpido.",
      "segments": [
        "«As I was saying, sleep matters» brings",
        "the topic back after an interruption."
      ],
      "audioText": "«As I was saying, sleep matters» brings the topic back after an interruption.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    },
    {
      "id": "en.n8.class-56.t05",
      "en": "«So, to sum up» and «in short» introduce a summary of the episode.",
      "es": "«Así que, en resumen» y «en pocas palabras» introducen un resumen del episodio.",
      "explanationEs": "To sum up e in short resumen lo dicho; so también puede abrir una conclusión.",
      "segments": [
        "«So, to sum up» and «in short»",
        "introduce a summary of the episode."
      ],
      "audioText": "«So, to sum up» and «in short» introduce a summary of the episode.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    },
    {
      "id": "en.n8.class-56.t06",
      "en": "«Before we go, thank you for listening» closes the segment.",
      "es": "«Antes de despedirnos, gracias por escuchar» cierra el segmento.",
      "explanationEs": "Before we go y that is all for today cierran el segmento.",
      "segments": [
        "«Before we go, thank you",
        "for listening» closes the segment."
      ],
      "audioText": "«Before we go, thank you for listening» closes the segment.",
      "audioMode": "tts",
      "languageCode": "en",
      "patternId": "n8-short-audio-segments-1"
    }
  ],
