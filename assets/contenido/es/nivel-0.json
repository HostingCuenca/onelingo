{"idioma":"es","nivel":0,"generado":"2026-09-08T04:19:15.456Z","unidades":[{"numero":1,"tipo":"escritura","titulo":"Las letras A-M","descripcion":"El alfabeto español tiene 27 letras. Cada letra suena casi siempre igual: es fácil leer una vez que las conoces.","items":[{"simbolo":"A a","romanizacion":"a","significado":"vocal abierta, siempre suena \"a\"","ejemplo":"agua"},{"simbolo":"B b","romanizacion":"be","significado":"labios juntos; suena igual que la v","ejemplo":"boca"},{"simbolo":"C c","romanizacion":"ce","significado":"suena \"k\" ante a, o, u y \"z\" o \"s\" ante e, i","ejemplo":"casa"},{"simbolo":"D d","romanizacion":"de","significado":"suave, la lengua toca los dientes","ejemplo":"dedo"},{"simbolo":"E e","romanizacion":"e","significado":"vocal, siempre suena \"e\"","ejemplo":"elefante"},{"simbolo":"F f","romanizacion":"efe","significado":"suena \"f\"","ejemplo":"flor"},{"simbolo":"G g","romanizacion":"ge","significado":"suena \"g\" en \"gato\" y \"j\" en \"gente\"","ejemplo":"gato"},{"simbolo":"H h","romanizacion":"hache","significado":"es muda: no suena nunca","ejemplo":"hola"},{"simbolo":"I i","romanizacion":"i","significado":"vocal, siempre suena \"i\"","ejemplo":"isla"},{"simbolo":"J j","romanizacion":"jota","significado":"sonido fuerte de garganta","ejemplo":"jugo"},{"simbolo":"K k","romanizacion":"ka","significado":"suena \"k\"; solo en palabras extranjeras","ejemplo":"kilo"},{"simbolo":"L l","romanizacion":"ele","significado":"suena \"l\"","ejemplo":"luna"},{"simbolo":"M m","romanizacion":"eme","significado":"suena \"m\"","ejemplo":"mano"}],"examen":[{"pregunta":"¿Cómo se llama la letra \"H\"?","opciones":["hache","ha","jota","ge"],"correcta":0,"explicacion":"Es \"hache\" y no suena."},{"pregunta":"¿Qué letra es muda?","opciones":["h","j","g","k"],"correcta":0,"explicacion":"La h no se pronuncia."},{"pregunta":"La \"c\" en \"casa\" suena...","opciones":["k","s","z","ch"],"correcta":0,"explicacion":"Ante a, o, u suena \"k\"."}]},{"numero":2,"tipo":