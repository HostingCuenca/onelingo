cado":"bebé, niño","ejemplo":"ребёнок"},{"simbolo":"собака","romanizacion":"sabáka","significado":"perro","ejemplo":"большая собака"},{"simbolo":"кот","romanizacion":"kot","significado":"gato","ejemplo":"чёрный кот"},{"simbolo":"птица","romanizacion":"ptítsa","significado":"pájaro","ejemplo":"маленькая птица"},{"simbolo":"рыба","romanizacion":"rýba","significado":"pez, pescado","ejemplo":"рыба"},{"simbolo":"хлеб","romanizacion":"jlyep","significado":"pan","ejemplo":"хлеб с маслом (pan con mantequilla)"},{"simbolo":"яблоко","romanizacion":"yáblaka","significado":"manzana","ejemplo":"красное яблоко"},{"simbolo":"молоко","romanizacion":"malakó","significado":"leche","ejemplo":"стакан молока (un vaso de leche)"},{"simbolo":"яйцо","romanizacion":"yaytsó","significado":"huevo","ejemplo":"два яйца (dos huevos)"}],"examen":[{"pregunta":"¿Cómo se dice \"hermana\"?","opciones":["сестра","брат","мама","ребёнок"],"correcta":0,"explicacion":"Сестра es hermana."},{"pregunta":"Молоко (malakó) es...","opciones":["leche","pan","huevo","manzana"],"correcta":0,"explicacion":"Молоко es leche."},{"pregunta":"¿Qué animal es \"птица\"?","opciones":["pájaro","perro","gato","pez"],"correcta":0,"explicacion":"Птица es pájaro."}]},{"numero":8,"tipo":"vocabulario","titulo":"Verbos esenciales","descripcion":"Diez acciones básicas en infinitivo. Las frases vienen en el Nivel 1.","items":[{"simbolo":"быть","romanizacion":"byt'","significado":"ser, estar","ejemplo":"я (yo soy: sin verbo en presente)"},{"simbolo":"иметь / у меня есть","romanizacion":"u menyá yest'","significado":"tener","ejemplo":"у меня есть (yo tengo)"},{"simbolo":"идти","romanizacion":"idtí","significado":"ir (a pie)","ejemplo":"идти домой (ir a casa)"},{"simbolo":"прийти","romanizacion":"priytí","significado":"venir","ejemplo":"приди сюда (ven aquí)"},{"simbolo":"есть","romanizacion":"yest'","significado":"comer","ejemplo":"есть яблоко (comer una manzana)"},{"simbolo":"пить","romanizacion":"pit'","significado":"beber","ejemplo":"пить воду (beber agua)"},{"simbolo":"спать","romanizacion":"spat'","significado":"dormir","ejemplo":"хорошо спать (dormir bien)"},{"simbolo":"говорить","romanizacion":"gavarít'","significado":"hablar","ejemplo":"говорить по-русски (hablar ruso)"},{"simbolo":"хотеть","romanizacion":"jatyét'","significado":"querer","ejemplo":"я хочу воды (quiero agua)"},{"simbolo":"любить","romanizacion":"lyubít'","significado":"gustar, amar","ejemplo":"я люблю котов (me gustan los gatos)"}],"examen":[{"pregunta":"¿Cómo se dice \"comer\"?","opciones":["есть","пить","спать","идти"],"correcta":0,"explicacion":"Есть es comer."},{"pregunta":"Спать (spat') es...","opciones":["dormir","hablar","venir","querer"],"correcta":0,"explicacion":"Спать es dormir."},{"pregunta":"¿Cómo se dice \"beber\"?","opciones":["пить","есть","прийти","говорить"],"correcta":0,"explicacion":"Пить es beber."}]}]}