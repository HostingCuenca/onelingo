{"idioma":"zh","nivel":0,"generado":"2026-09-08T04:19:15.489Z","unidades":[{"numero":1,"tipo":"escritura","titulo":"Pinyin: las consonantes iniciales","descripcion":"El chino se escribe con caracteres, pero se aprende a pronunciar con el pinyin (letras latinas). Primero las 21 consonantes iniciales; varias no suenan como en español.","items":[{"simbolo":"b","romanizacion":"p suave (sin aire)","significado":"como una p sin soplo: 爸 bà (papá)","ejemplo":"爸爸 (bàba)"},{"simbolo":"p","romanizacion":"p con aire","significado":"con soplo fuerte: 怕 pà (temer)","ejemplo":"朋友 (péngyou)"},{"simbolo":"m","romanizacion":"m","significado":"como en español","ejemplo":"妈妈 (māma)"},{"simbolo":"f","romanizacion":"f","significado":"como en español","ejemplo":"饭 (fàn)"},{"simbolo":"d","romanizacion":"t suave (sin aire)","significado":"como una t sin soplo","ejemplo":"大 (dà)"},{"simbolo":"t","romanizacion":"t con aire","significado":"con soplo fuerte","ejemplo":"他 (tā)"},{"simbolo":"n","romanizacion":"n","significado":"como en español","ejemplo":"你 (nǐ)"},{"simbolo":"l","romanizacion":"l","significado":"como en español","ejemplo":"来 (lái)"},{"simbolo":"g","romanizacion":"k suave (sin aire)","significado":"como una k sin soplo","ejemplo":"狗 (gǒu)"},{"simbolo":"k","romanizacion":"k con aire","significado":"con soplo fuerte","ejemplo":"看 (kàn)"},{"simbolo":"h","romanizacion":"j suave","significado":"como una j española suave","ejemplo":"好 (hǎo)"},{"simbolo":"j","romanizacion":"ch suave (lengua plana)","significado":"\"ji\" suena como \"chi\" suave","ejemplo":"家 (jiā)"},{"simbolo":"q","romanizacion":"ch con aire","significado":"\"qi\" suena \"chi\" con soplo","ejemplo":"七 (qī)"},{"simbolo":"x","romanizacion":"sh suave (lengua plana)","significado":"\"xi\" suena entre \"si\" y \"shi\"","ejemplo":"谢谢 (xièxie)"},{"simbolo":"zh","romanizacion":"ch con la lengua atrás","significado":"punta de la lengua hacia el paladar","ejemplo":"中 (zhōng)"},{"simbolo":"ch","romanizacion":"ch con aire y lengua atrás","significado":"como zh pero con soplo","ejemplo":"吃 (chī)"},{"simbolo":"sh","romanizacion":"sh con la lengua atrás","significado":"como \"sh\" inglesa","ejemplo":"是 (shì)"},{"simbolo":"r","romanizacion":"r suave, como \"y\" francesa","significado":"la lengua atrás, sin vibrar","ejemplo":"人 (rén)"},{"simbolo":"z","romanizacion":"ds","significado":"como \"ds\" en \"adsorber\"","ejemplo":"字 (zì)"},{"simbolo":"c","romanizacion":"ts con aire","significado":"como \"ts\" con soplo","ejemplo":"菜 (cài)"},{"simbolo":"s","romanizacion":"s","significado":"como en español","ejemplo":"三 (sān)"}],"examen":[{"pregunta":"¿Cómo suena la \"x\" del pinyin en \"xièxie\"?","opciones":["entre \"s\" y \"sh\", suave","como \"ks\"","como \"j\"","como \"z\""],"correcta":0,"explicacion":"\"Xièxie\" se dice \"shie-shie\" suave."},{"pregunta":"La diferencia entre \"b\" y \"p\" en pinyin es...","opciones":["el soplo de aire","la vocal","el tono","nada"],"correcta":0,"explicacion":"\"p\" lleva aspiración fuerte."},{"pregunta":"¿Cómo suena \"q\" en \"qī\" (siete)?","opciones":["como \"ch\" con aire","como \"k\"","como \"q\" española","como \"g\""],"correcta":0,"explicacion":"\"Qī\" se dice \"chi\" con soplo."}]},{"numero":2,"tipo":"escritura","titulo":"Pinyin: las vocales finales","descripcion":"Las vocales y sus combinaciones. Ojo con \"e\" (como una \"e\" cerrada hacia \"o\"), \"i\" tras z, c, s (casi no suena) y \"ü\" (boca de u diciendo i).","items":[{"simbolo":"a","romanizacion":"a","significado":"como en español","ejemplo":"妈 (mā)"},{"simbolo":"o","romanizacion":"o","significado":"como en español, algo cerrada","ejemplo":"我 (wǒ)"},{"simbolo":"e","romanizacion":"e cerrada hacia \"o\"","significado":"como la \"e\" de \"de\" en francés","ejemplo":"饿 (è)"},{"simbolo":"i","romanizacion":"i","significado":"tras zh, ch, sh, r, z, c, s casi no suena: \"shi\" = \"sh\"","ejemplo":"你 (nǐ)"},{"simbolo":"u","romanizacion":"u","significado":"como en español","ejemplo":"五 (wǔ)"},{"simbolo":"ü","romanizacion":"i con boca de u","significado":"tras j, q, x se escribe \"u\" pero suena \"ü\"","ejemplo":"女 (nǚ)"},{"simbolo":"ai","romanizacion":"ai","significado":"\"爱 ài\" (amor)","ejemplo":"爱 (ài)"},{"simbolo":"ei","romanizacion":"ei","significado":"\"谁 shéi\" (quién)","ejemplo":"谁 (shéi)"},{"simbolo":"ao","romanizacion":"ao","significado":"\"好 hǎo\" (bueno)","ejemplo":"好 (hǎo)"},{"simbolo":"ou","romanizacion":"ou","significado":"\"狗 gǒu\" (perro)","ejemplo":"狗 (gǒu)"},{"simbolo":"an","romanizacion":"an","significado":"\"三 sān\" (tres)","ejemplo":"三 (sān)"},{"simbolo":"en","romanizacion":"en","significado":"\"很 hěn\" (muy)","ejemplo":"很 (hěn)"},{"simbolo":"ang","romanizacion":"ang (nasal)","significado":"la \"ng\" es nasal, sin decir la g","ejemplo":"忙 (máng)"},{"simbolo":"eng","romanizacion":"eng (nasal)","significado":"\"朋 péng\"","ejemplo":"朋友 (péngyou)"},{"simbolo":"ong","romanizacion":"ong (nasal)","significado":"\"中 zhōng\"","ejemplo":"中 (zhōng)"},{"simbolo":"er","romanizacion":"ar (lengua curvada)","significado":"\"二 èr\" (dos)","ejemplo":"二 (èr)"}],"examen":[{"pregunta":"¿Cómo suena la \"i\" en \"shì\"?","opciones":["casi no suena: \"sh\"","como i clara","como ai","como e"],"correcta":0,"explicacion":"Tras sh la i es muy corta."},{"pregunta":"¿Cómo suena \"ao\" en \"hǎo\"?","opciones":["ao","o","au larga","a"],"correcta":0,"explicacion":"\"Hǎo\" se dice \"jao\"."},{"pregunta":"La \"ü\" de \"nǚ\" se pronuncia...","opciones":["boca de u diciendo i","como u","como i","como iu"],"correcta":0,"explicacion":"Es un sonido nuevo para hispanohablantes."}]},{"numero":3,"tipo":"escritura","titulo":"Los cuatro tonos","descripcion":"En chino el tono cambia el significado. Hay cuatro tonos más uno neutro. Se marcan con acentos sobre la vocal: ā á ǎ à.","items":[{"simbolo":"mā (妈)","romanizacion":"tono 1: alto y plano","significado":"como si cantaras una nota sostenida","ejemplo":"妈 (mā) = mamá"},{"simbolo":"má (麻)","romanizacion":"tono 2: ascendente","significado":"como una pregunta: \"¿sí?\"","ejemplo":"麻 (má) = cáñamo"},{"simbolo":"mǎ (马)","romanizacion":"tono 3: baja y sube","significado":"desciende y vuelve a subir","ejemplo":"马 (mǎ) = caballo"},{"simbolo":"mà (骂)","romanizacion":"tono 4: descendente","significado":"corto y firme, como una orden","ejemplo":"骂 (mà) = regañar"},{"simbolo":"ma (吗)","romanizacion":"tono neutro","significado":"corto y sin fuerza, al final de la frase","ejemplo":"吗 (ma) = partícula de pregunta"},{"simbolo":"nǐ hǎo","romanizacion":"tono 3 + tono 3","significado":"dos terceros tonos seguidos: el primero se dice como segundo","ejemplo":"你好 (nǐ hǎo) = hola"},{"simbolo":"bù (不)","romanizacion":"tono 4","significado":"\"no\"; ante otro tono 4 cambia a bú","ejemplo":"不 (bù) = no"},{"simbolo":"yī (一)","romanizacion":"tono 1","significado":"\"uno\"; cambia de tono según la palabra siguiente","ejemplo":"一 (yī) = uno"}],"examen":[{"pregunta":"¿Cuántos tonos principales tiene el mandarín?","opciones":["cuatro","dos","seis","uno"],"correcta":0,"explicacion":"Cuatro tonos y un tono neutro."},{"pregunta":"\"mǎ\" (马) es...","opciones":["caballo","mamá","regañar","cáñamo"],"correcta":0,"explicacion":"Tercer tono: caballo."},{"pregunta":"El tono 4 (mà) se pronuncia...","opciones":["descendente y firme","alto y plano","ascendente","sin fuerza"],"correcta":0,"explicacion":"Como una orden corta."}]},{"numero":4,"tipo":"vocabulario","titulo":"Números del 0 al 10","descripcion":"Los primeros diez caracteres que aprende cualquier niño chino. Con ellos se forman todos los números.","items":[{"simbolo":"零","romanizacion":"líng","significado":"cero","ejemplo":"零 (líng), 一 (yī), 二 (èr)"},{"simbolo":"一","romanizacion":"yī","significado":"uno","ejemplo":"一 个 人 (una persona)"},{"simbolo":"二","romanizacion":"èr","significado":"dos","ejemplo":"二 月 (febrero)"},{"simbolo":"三","romanizacion":"sān","significado":"tres","ejemplo":"三 个 (tres cosas)"},{"simbolo":"四","romanizacion":"sì","significado":"cuatro","ejemplo":"四 个 (cuatro cosas)"},{"simbolo":"五","romanizacion":"wǔ","significado":"cinco","ejemplo":"五 个 (cinco cosas)"},{"simbolo":"六","romanizacion":"liù","significado":"seis","ejemplo":"六 月 (junio)"},{"simbolo":"七","romanizacion":"qī","significado":"siete","ejemplo":"七 天 (siete días)"},{"simbolo":"八","romanizacion":"bā","significado":"ocho","ejemplo":"八 个 (ocho cosas)"},{"simbolo":"九","romanizacion":"jiǔ","significado":"nueve","ejemplo":"九 个 人 (nueve personas)"},{"simbolo":"十","romanizacion":"shí","significado":"diez","ejemplo":"十 块 (diez yuanes)"}],"examen":[{"pregunta":"¿Qué número es 五 (wǔ)?","opciones":["5","4","6","9"],"correcta":0,"explicacion":"五 es cinco."},{"pregunta":"¿Cómo se escribe \"tres\"?","opciones":["三","二","四","十"],"correcta":0,"explicacion":"Tres rayas: 三."},{"pregunta":"八 (bā) es...","opciones":["8","3","6","2"],"correcta":0,"explicacion":"八 es ocho."}]},{"numero":5,"tipo":"vocabulario","titulo":"Colores","descripcion":"Los colores básicos, con el carácter 色 (sè, color).","items":[{"simbolo":"红色","romanizacion":"hóngsè","significado":"rojo","ejemplo":"红色 的 苹果 (manzana roja)"},{"simbolo":"蓝色","romanizacion":"lánsè","significado":"azul","ejemplo":"蓝色 的 天 (cielo azul)"},{"simbolo":"绿色","romanizacion":"lǜsè","significado":"verde","ejemplo":"绿色 的 草 (hierba verde)"},{"simbolo":"黄色","romanizacion":"huángsè","significado":"amarillo","ejemplo":"黄色 的 太阳 (sol amarillo)"},{"simbolo":"黑色","romanizacion":"hēisè","significado":"negro","ejemplo":"黑色 的 猫 (gato negro)"},{"simbolo":"白色","romanizacion":"báisè","significado":"blanco","ejemplo":"白色 的 雪 (nieve blanca)"},{"simbolo":"橙色","romanizacion":"chéngsè","significado":"naranja","ejemplo":"橙色 的 球 (pelota naranja)"},{"simbolo":"粉色","romanizacion":"fěnsè","significado":"rosa","ejemplo":"粉色 的 花 (flor rosa)"},{"simbolo":"棕色","romanizacion":"zōngsè","significado":"marrón","ejemplo":"棕色 的 头发 (pelo marrón)"},{"simbolo":"灰色","romanizacion":"huīsè","significado":"gris","ejemplo":"灰色 的 云 (nube gris)"}],"examen":[{"pregunta":"¿Cómo se dice \"verde\"?","opciones":["绿色 (lǜsè)","灰色 (huīsè)","蓝色 (lánsè)","棕色 (zōngsè)"],"correcta":0,"explicacion":"绿色 es verde."},{"pregunta":"黑色 (hēisè) es...","opciones":["negro","blanco","azul","marrón"],"correcta":0,"explicacion":"黑 es negro; 白 es blanco."},{"pregunta":"¿Qué carácter significa \"color\"?","opciones":["色 (sè)","红 (hóng)","的 (de)","白 (bái)"],"correcta":0,"explicacion":"Todos los colores terminan en 色."}]},{"numero":6,"tipo":"vocabulario","titulo":"Palabras del día a día","descripcion":"Las primeras palabras que necesitas: sí, no, hola, gracias, y cosas que ves cada día.","items":[{"simbolo":"是","romanizacion":"shì","significado":"sí, ser","ejemplo":"是。"},{"simbolo":"不","romanizacion":"bù","significado":"no","ejemplo":"不。"},{"simbolo":"你好","romanizacion":"nǐ hǎo","significado":"hola","ejemplo":"你好！"},{"simbolo":"再见","romanizacion":"zàijiàn","significado":"adiós","ejemplo":"再见！"},{"simbolo":"请","romanizacion":"qǐng","significado":"por favor","ejemplo":"请 坐。"},{"simbolo":"谢谢","romanizacion":"xièxie","significado":"gracias","ejemplo":"谢谢！"},{"simbolo":"对不起","romanizacion":"duìbuqǐ","significado":"perdón","ejemplo":"对不起！"},{"simbolo":"水","romanizacion":"shuǐ","significado":"agua","ejemplo":"一 杯 水 (un vaso de agua)"},{"simbolo":"家","romanizacion":"jiā","significado":"casa, hogar","ejemplo":"我 的 家 (mi casa)"},{"simbolo":"朋友","romanizacion":"péngyou","significado":"amigo","ejemplo":"我 的 朋友 (mi amigo)"},{"simbolo":"好","romanizacion":"hǎo","significado":"bueno, bien","ejemplo":"很 好 (muy bien)"},{"simbolo":"大","romanizacion":"dà","significado":"grande","ejemplo":"大 狗 (perro grande)"},{"simbolo":"小","romanizacion":"xiǎo","significado":"pequeño","ejemplo":"小 猫 (gato pequeño)"}],"examen":[{"pregunta":"¿Cómo se dice \"gracias\"?","opciones":["谢谢 (xièxie)","请 (qǐng)","对不起 (duìbuqǐ)","你好 (nǐ hǎo)"],"correcta":0,"explicacion":"谢谢 es gracias."},{"pregunta":"水 (shuǐ) es...","opciones":["agua","casa","amigo","perro"],"correcta":0,"explicacion":"水 es agua."},{"pregunta":"¿Cómo se dice \"pequeño\"?","opciones":["小 (xiǎo)","大 (dà)","好 (hǎo)","不 (bù)"],"correcta":0,"explicacion":"小 es pequeño; 大 es grande."}]},{"numero":7,"tipo":"vocabulario","titulo":"Familia, animales y comida","descripcion":"Vocabulario esencial en tres grupos que aparecen en todas las conversaciones.","items":[{"simbolo":"妈妈","romanizacion":"māma","significado":"mamá","ejemplo":"我 妈妈 (mi mamá)"},{"simbolo":"爸爸","romanizacion":"bàba","significado":"papá","ejemplo":"我 爸爸 (mi papá)"},{"simbolo":"哥哥","romanizacion":"gēge","significado":"hermano mayor","ejemplo":"我 哥哥"},{"simbolo":"妹妹","romanizacion":"mèimei","significado":"hermana menor","ejemplo":"我 妹妹"},{"simbolo":"宝宝","romanizacion":"bǎobao","significado":"bebé","ejemplo":"一 个 宝宝"},{"simbolo":"狗","romanizacion":"gǒu","significado":"perro","ejemplo":"大 狗 (perro grande)"},{"simbolo":"猫","romanizacion":"māo","significado":"gato","ejemplo":"黑 猫 (gato negro)"},{"simbolo":"鸟","romanizacion":"niǎo","significado":"pájaro","ejemplo":"小 鸟 (pajarito)"},{"simbolo":"鱼","romanizacion":"yú","significado":"pez, pescado","ejemplo":"一 条 鱼 (un pez)"},{"simbolo":"面包","romanizacion":"miànbāo","significado":"pan","ejemplo":"面包 和 黄油 (pan y mantequilla)"},{"simbolo":"苹果","romanizacion":"píngguǒ","significado":"manzana","ejemplo":"红 苹果 (manzana roja)"},{"simbolo":"牛奶","romanizacion":"niúnǎi","significado":"leche","ejemplo":"一 杯 牛奶 (un vaso de leche)"},{"simbolo":"鸡蛋","romanizacion":"jīdàn","significado":"huevo","ejemplo":"两 个 鸡蛋 (dos huevos)"}],"examen":[{"pregunta":"¿Cómo se dice \"hermana menor\"?","opciones":["妹妹 (mèimei)","哥哥 (gēge)","妈妈 (māma)","宝宝 (bǎobao)"],"correcta":0,"explicacion":"妹妹 es la hermana menor."},{"pregunta":"牛奶 (niúnǎi) es...","opciones":["leche","pan","huevo","manzana"],"correcta":0,"explicacion":"牛 (vaca) + 奶 (leche)."},{"pregunta":"¿Qué animal es 鸟 (niǎo)?","opciones":["pájaro","perro","gato","pez"],"correcta":0,"explicacion":"鸟 es pájaro."}]},{"numero":8,"tipo":"vocabulario","titulo":"Verbos esenciales","descripcion":"Diez acciones básicas. Los verbos chinos no cambian nunca: una sola forma para todo.","items":[{"simbolo":"是","romanizacion":"shì","significado":"ser","ejemplo":"我 是 (yo soy)"},{"simbolo":"有","romanizacion":"yǒu","significado":"tener","ejemplo":"我 有 (yo tengo)"},{"simbolo":"去","romanizacion":"qù","significado":"ir","ejemplo":"去 家 (ir a casa)"},{"simbolo":"来","romanizacion":"lái","significado":"venir","ejemplo":"来 这儿 (ven aquí)"},{"simbolo":"吃","romanizacion":"chī","significado":"comer","ejemplo":"吃 苹果 (comer manzana)"},{"simbolo":"喝","romanizacion":"hē","significado":"beber","ejemplo":"喝 水 (beber agua)"},{"simbolo":"睡觉","romanizacion":"shuìjiào","significado":"dormir","ejemplo":"睡觉 (dormir)"},{"simbolo":"说","romanizacion":"shuō","significado":"hablar, decir","ejemplo":"说 汉语 (hablar chino)"},{"simbolo":"要","romanizacion":"yào","significado":"querer","ejemplo":"我 要 水 (quiero agua)"},{"simbolo":"喜欢","romanizacion":"xǐhuan","significado":"gustar","ejemplo":"我 喜欢 猫 (me gustan los gatos)"}],"examen":[{"pregunta":"¿Cómo se dice \"comer\"?","opciones":["吃 (chī)","喝 (hē)","睡觉 (shuìjiào)","去 (qù)"],"correcta":0,"explicacion":"吃 es comer."},{"pregunta":"喝 (hē) es...","opciones":["beber","hablar","venir","querer"],"correcta":0,"explicacion":"喝 es beber."},{"pregunta":"¿Cómo se dice \"tener\"?","opciones":["有 (yǒu)","是 (shì)","喜欢 (xǐhuan)","要 (yào)"],"correcta":0,"explicacion":"有 es tener."}]}]}