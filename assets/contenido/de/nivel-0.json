{"idioma":"de","nivel":0,"generado":"2026-09-08T04:19:15.468Z","unidades":[{"numero":1,"tipo":"escritura","titulo":"Las letras A-M","descripcion":"El alemán usa el alfabeto latino más ä, ö, ü y ß. Casi todo se lee como se escribe, pero algunas letras suenan distinto que en español.","items":[{"simbolo":"A a","romanizacion":"a","significado":"como la a española","ejemplo":"Apfel (manzana)"},{"simbolo":"B b","romanizacion":"be","significado":"suena \"b\"; al final de palabra suena \"p\"","ejemplo":"Buch (libro)"},{"simbolo":"C c","romanizacion":"tse","significado":"sola es rara; casi siempre en \"ch\" o \"sch\"","ejemplo":"Café"},{"simbolo":"D d","romanizacion":"de","significado":"suena \"d\"; al final de palabra suena \"t\"","ejemplo":"Dank (gracias)"},{"simbolo":"E e","romanizacion":"e","significado":"como la e española; al final es muy suave","ejemplo":"Ente (pato)"},{"simbolo":"F f","romanizacion":"ef","significado":"suena \"f\"","ejemplo":"Fisch (pez)"},{"simbolo":"G g","romanizacion":"ge","significado":"siempre suena \"g\" de \"gato\"","ejemplo":"gut (bueno)"},{"simbolo":"H h","romanizacion":"ha","significado":"al inicio se pronuncia como una j muy suave; tras vocal alarga la vocal","ejemplo":"Haus (casa)"},{"simbolo":"I i","romanizacion":"i","significado":"como la i española","ejemplo":"Insel (isla)"},{"simbolo":"J j","romanizacion":"yot","significado":"suena como la y de \"yo\"","ejemplo":"ja (sí)"},{"simbolo":"K k","romanizacion":"ka","significado":"suena \"k\"","ejemplo":"Kind (niño)"},{"simbolo":"L l","romanizacion":"el","significado":"suena \"l\"","ejemplo":"Liebe (amor)"},{"simbolo":"M m","romanizacion":"em","significado":"suena \"m\"","ejemplo":"Mutter (madre)"}],"examen":[{"pregunta":"¿Cómo suena la \"J\" alemana en \"ja\"?","opciones":["como y","como j española","como ch","muda"],"correcta":0,"explicacion":"\"Ja\" se dice \"ya\"."},{"pregunta":"La \"H\" al inicio de \"Haus\"...","opciones":["se pronuncia suave, como una j ligera","es muda","suena ch","suena k"],"correcta":0,"explicacion":"Es aspirada."},{"pregunta":"La \"G\" alemana siempre suena...","opciones":["como g de gato","como j","como y","muda"],"correcta":0,"explicacion":"\"Gut\" se dice \"gut\"."}]},{"numero":2,"tipo":"escritura","titulo":"Las letras N-Z, ä, ö, ü y ß","descripcion":"Segunda mitad del alfabeto con las letras propias del alemán. La \"W\" suena \"v\", la \"V\" suena \"f\" y la \"Z\" suena \"ts\".","items":[{"simbolo":"N n","romanizacion":"en","significado":"suena \"n\"","ejemplo":"Name (nombre)"},{"simbolo":"O o","romanizacion":"o","significado":"como la o española","ejemplo":"Oma (abuela)"},{"simbolo":"P p","romanizacion":"pe","significado":"suena \"p\" con aire","ejemplo":"Papa (papá)"},{"simbolo":"Q q","romanizacion":"ku","significado":"siempre con u: \"qu\" suena \"kv\"","ejemplo":"Quelle (fuente)"},{"simbolo":"R r","romanizacion":"er","significado":"en la garganta; al final casi \"a\"","ejemplo":"rot (rojo)"},{"simbolo":"S s","romanizacion":"es","significado":"ante vocal suena \"z\" vibrante; sola suena \"s\"","ejemplo":"Sonne (sol)"},{"simbolo":"T t","romanizacion":"te","significado":"suena \"t\" con aire","ejemplo":"Tisch (mesa)"},{"simbolo":"U u","romanizacion":"u","significado":"como la u española","ejemplo":"Uhr (reloj)"},{"simbolo":"V v","romanizacion":"fau","significado":"suena \"f\"","ejemplo":"Vater (padre)"},{"simbolo":"W w","romanizacion":"ve","significado":"suena \"v\" (dientes en el labio)","ejemplo":"Wasser (agua)"},{"simbolo":"Z z","romanizacion":"tset","significado":"suena \"ts\"","ejemplo":"Zeit (tiempo)"},{"simbolo":"Ä ä","romanizacion":"e abierta","significado":"\"a\" con diéresis: suena como \"e\"","ejemplo":"Mädchen (chica)"},{"simbolo":"Ö ö","romanizacion":"e con boca de o","significado":"pon la boca como \"o\" y di \"e\"","ejemplo":"schön (bonito)"},{"simbolo":"Ü ü","romanizacion":"i con boca de u","significado":"pon la boca como \"u\" y di \"i\"","ejemplo":"Tür (puerta)"},{"simbolo":"ß","romanizacion":"ss","significado":"\"s\" fuerte tras vocal larga","ejemplo":"Straße (calle)"}],"examen":[{"pregunta":"¿Cómo suena la \"W\" en \"Wasser\"?","opciones":["v","u","b","gu"],"correcta":0,"explicacion":"\"Wasser\" se dice \"vaser\"."},{"pregunta":"¿Cómo suena la \"Z\" en \"Zeit\"?","opciones":["ts","z","s","th"],"correcta":0,"explicacion":"\"Zeit\" se dice \"tsait\"."},{"pregunta":"La \"ü\" se pronuncia...","opciones":["boca de u diciendo i","como u","como i","como ou"],"correcta":0,"explicacion":"Es un sonido nuevo."}]},{"numero":3,"tipo":"escritura","titulo":"Sonidos y combinaciones","descripcion":"Las combinaciones ch, sch, ei, ie, eu y au son la clave para leer alemán en voz alta.","items":[{"simbolo":"ch (ich)","romanizacion":"j muy suave, como un soplido","significado":"tras e, i, ä, ö, ü: \"ich\", \"nicht\"","ejemplo":"ich (yo)"},{"simbolo":"ch (Buch)","romanizacion":"j fuerte de garganta","significado":"tras a, o, u: \"Buch\", \"Nacht\"","ejemplo":"Buch (libro)"},{"simbolo":"sch","romanizacion":"sh","significado":"\"Schule\", \"schön\"","ejemplo":"Schule (escuela)"},{"simbolo":"ei","romanizacion":"ai","significado":"\"ei\" suena \"ai\": \"nein\" = \"nain\"","ejemplo":"nein (no)"},{"simbolo":"ie","romanizacion":"i larga","significado":"\"ie\" suena \"i\" larga: \"Liebe\"","ejemplo":"Liebe (amor)"},{"simbolo":"eu, äu","romanizacion":"oi","significado":"\"neun\" = \"noin\", \"Häuser\"","ejemplo":"neun (nueve)"},{"simbolo":"au","romanizacion":"au","significado":"como en español: \"Haus\"","ejemplo":"Haus (casa)"},{"simbolo":"sp, st (inicio)","romanizacion":"shp, sht","significado":"\"Sport\" = \"shport\", \"Straße\" = \"shtrase\"","ejemplo":"Straße (calle)"},{"simbolo":"-er final","romanizacion":"a suave","significado":"\"Mutter\" termina casi en \"a\"","ejemplo":"Mutter (madre)"},{"simbolo":"vocal doble / h","romanizacion":"vocal larga","significado":"\"Boot\", \"Zahl\": la vocal se alarga","ejemplo":"Zahl (número)"}],"examen":[{"pregunta":"¿Cómo suena \"ei\" en \"nein\"?",